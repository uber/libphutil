# ================= TAPTOOLS: START GENERATED CODE =================== #
IF(sBlock.Epilog.Execution @= 'Yes');
   LOGOUTPUT('ERROR', 'Block Process Execution Flag is Yes in TAP System Info Cube. Skipping this process...');
   PROCESSERROR;
ENDIF;
IF(nPrologProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "NULL"');
   LOGOUTPUT('DEBUG', 'PROGRESS: END PROLOG PROCEDURE');
   nPrologProcedureEndTime = NOW();
ENDIF;
IF(nMetadataProcedureStartTime > 0 & nMetadataProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: END METADATA PROCEDURE');
   nMetadataProcedureEndTime = NOW();
ENDIF;
IF(nDataProcedureStartTime > 0 & nDataProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: END DATA PROCEDURE');
   nDataProcedureEndTime = NOW();
ENDIF;
LOGOUTPUT('DEBUG', 'PROGRESS: START EPILOG PROCEDURE');
nEpilogProcedureStartTime = NOW();
# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****

sProcess = 'Ops.U4B.From Day Month';

EXECUTEPROCESS(sProcess
   , 'pStartDate', pStartDate
   , 'pEndDate', pEndDate
   , 'pMetrics', cMetricString
);
##Record Count update
CELLINCREMENTN(cRecordCount, cCubeDash, cRCube, 'FDS', cLoaddate, 'Actual', 'No Rate Type', rMetric);
# ================= TAPTOOLS: START GENERATED CODE =================== #
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: PrologProcedureRuntime: "' | NUMBERTOSTRING(ROUNDP((nPrologProcedureEndTime - nPrologProcedureStartTime) * 86400, 2)) | '"');
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: PrologProcedureMetadataOperations: "' | NUMBERTOSTRING(nPrologProcedureMetadataOperations) | '"');
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: PrologProcedureDataOperations: "' | NUMBERTOSTRING(nPrologProcedureDataOperations) | '"');

LOGOUTPUT('DEBUG', 'PROCESS_METRIC: MetadataProcedureRuntime: "' | NUMBERTOSTRING(ROUNDP((nMetadataProcedureEndTime - nMetadataProcedureStartTime) * 86400, 2)) | '"');
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: MetadataProcedureMetadataOperations: "' | NUMBERTOSTRING(nMetadataProcedureMetadataOperations) | '"');
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: MetadataProcedureRecordsStarted: "' | NUMBERTOSTRING(nMetadataProcedureRecordsStarted) | '"');
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: MetadataProcedureRecordsSkipped: "' | NUMBERTOSTRING(nMetadataProcedureRecordsSkipped) | '"');
