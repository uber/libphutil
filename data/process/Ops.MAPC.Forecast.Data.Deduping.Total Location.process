# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsStarted = nDataProcedureRecordsStarted + 1;
IF(nMetadataProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: END METADATA PROCEDURE');
   nMetadataProcedureEndTime = NOW();
ENDIF;
IF(nDataProcedureStartTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: START DATA PROCEDURE');
   nDataProcedureStartTime = NOW();
ENDIF;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****

i = 1;
nAmount = 0;
WHILE(i <= SUBSETGETSIZE(sDimLoc, sSubLoc));
   sLocation = SUBSETGETELEMENTNAME(sDimLoc, sSubLoc, i);

   IF(SCAN('(Mega Region)', sLocation) > 0);
      nAmount = nAmount + CELLGETN(sSrcCube, vVersion, vPeriod, vSource, vRateType, 'CustomLeaf:' | sLocation | ' Input', vLOB, vProductType, vMetric, vMeasure);
   ENDIF;

   i = i + 1;
END;

nUnDedupedRatio = CELLGETN(sSrcCube, 'Actual', pActualMonth, 'FDS', vRateType, 'CustomLeaf:' | vLocation | ' Input', vLOB, vProductType, vMetric, 'UnDedpued Ratio');
nDedupedamount = nAmount * nUnDedupedRatio;

# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #
CELLPUTN(nDedupedamount, sSrcCube, vVersion, vPeriod, vSource, vRateType, 'CustomLeaf:' | vLocation | ' Input', vLOB, vProductType, vMetric, vMeasure);
# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsCompleted = nDataProcedureRecordsCompleted + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

