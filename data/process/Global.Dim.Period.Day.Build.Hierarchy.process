# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

# ==================================================================== #
# Globals
# ==================================================================== #

cDim = 'Period';

cTopEle = 'Total Time - Day';

cRand = NUMBERTOSTRING(ROUND(RAND() * 100000));
cRand = FILL('0', 6 - LONG(cRand)) | cRand;

cView = EXPAND('zzTemp.%cRand%');
cSub = EXPAND('zzTemp.%cRand%');

# ==================================================================== #
# Create Subsets
# ==================================================================== #

sDim = cDim;
sHier = cDim;
sDimHier =cDim;

sSub = cSub | '.Input';
sMDX = EXPAND('{FILTER({TM1SORT( {TM1FILTERBYPATTERN( { [%sDim%].[%sDim%].Members }, "????-??-??")}, ASC)}, [%sDim%].[End of Period] >= 43101.000000)}');

SUBSETCREATE(sDimHier, sSub, 1);
SUBSETMDXSET(sDimHier, sSub, sMDX);
SUBSETMDXSET(sDimHier, sSub, '');

# ==================================================================== #
# Create Top Element
# ==================================================================== #

DIMENSIONELEMENTINSERT(cDim, DIMNM(sHier, 1), cTopEle, 'C');

# ==================================================================== #
# Create Rollups
# ==================================================================== #

sSub = cSub | '.Input';
sHier = cDim;

i = 1;
WHILE(i <= SUBSETGETSIZE(cDim, sSub));
   sEleLeaf = SUBSETGETELEMENTNAME(sHier, sSub, i);

   # Top/Year Element Relationship
   sElePar = cTopEle;
   sEle = ATTRS(sHier, sEleLeaf, 'Year Element');
   sEle='Day ' | sEle;
   DIMENSIONELEMENTINSERT(cDim, '', sEle, 'C');
   DIMENSIONELEMENTCOMPONENTADD(cDim, sElePar, sEle, 1);  

   # Year/Half Element Relationship
   sElePar = sEle;
   sEle = ATTRS(sHier, sEleLeaf, 'Half Element');
   sEle='Day ' | sEle;
   DIMENSIONELEMENTINSERT(cDim, '', sElePar, 'C');
   DIMENSIONELEMENTINSERT(cDim, '', sEle, 'C');
   DIMENSIONELEMENTCOMPONENTADD(cDim, sElePar, sEle, 1);

   # Half/Quarter Element Relationship
   sElePar = sEle;
   sEle = ATTRS(sHier, sEleLeaf, 'Quarter Element');
   sEle='Day ' | sEle;
   DIMENSIONELEMENTINSERT(cDim, '', sElePar, 'C');
   DIMENSIONELEMENTINSERT(cDim, '', sEle, 'C');
   DIMENSIONELEMENTCOMPONENTADD(cDim, sElePar, sEle, 1);

   # Quarter/Month Element Relationship
   sElePar = sEle;
   sEle = ATTRS(sHier, sEleLeaf, 'Month Element');
   sEle='Day ' | sEle;
   DIMENSIONELEMENTINSERT(cDim, '', sElePar, 'C');
   DIMENSIONELEMENTINSERT(cDim, '', sEle, 'C');
   DIMENSIONELEMENTCOMPONENTADD(cDim, sElePar, sEle, 1);


   # Month/Day Element Relationship
    sElePar = sEle;
    sEle = sEleLeaf;
    DIMENSIONELEMENTCOMPONENTADD(cDim, sElePar, sEle, 1);

   i = i + 1;
END;
# ================= TAPTOOLS: START GENERATED CODE =================== #
# ================= TAPTOOLS: END GENERATED CODE ===================== #

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
