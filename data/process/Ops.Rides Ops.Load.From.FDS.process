# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

# Process to load Rides opartional metrics from FDS to Rid Ops cube


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Define Constants
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cCube = 'Rides Ops';
cVersion = 'Actual';
cRateType = 'USD';
cMeasure = 'Amount';
cSource = 'FDS';
nRecords = 1;

cMetricString = '';

nDate = NOW;
NEWDATEFORMATTER('', 'PST', 'serial', 'full', 'datetime', '');
sOutputString = FORMATDATE(nDate, 0);



cUser = CELLGETS('System Info', 'SQL User Name GL Transactions', 'String');
cPassword = CELLGETS('System Info', 'SQL Password GL Transactions', 'String');


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Set Query
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

DatasourceUsername = cUser;
DatasourcePassword = cPassword;
sQuery = EXPAND('SELECT * FROM "%pTable%"');
DatasourceQuery = sQuery;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Subsets for View Zero Out
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cRandomIntA = NUMBERTOSTRING(INT(RAND() * 100000));
cSubset = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | 'test';
cViewName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
VIEWCREATE(cCube, cViewName, 1);

nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(cCube);

WHILE(nCtr <= nMax);
   sDim = TABDIM(cCube, nCtr);

   IF(sDim @= 'Version');
      sElement = 'Actual';
      SUBSETCREATE(sDim, cSubset, 1);
      SUBSETELEMENTINSERT(sDim, cSubset, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);

   ELSEIF(sDim @= 'Period');
      SUBSETCREATE(sDim, cSubset, 1);

      IF(pLevel @= 'Month');
         sPeriod = SUBST(pStartDate, 1, 7);
         WHILE(ATTRN(sDim, sPeriod, 'Start of Period') <= ATTRN(sDim, SUBST(pEndDate, 1, 7), 'Start of Period'));
            SUBSETELEMENTINSERT(sDim, cSubset, sPeriod, 1);
            sPeriod = ATTRS(sDim, sPeriod, 'Next Period');
         END;
      ELSEIF(pLevel @= 'Week');
         nPeriod = DAYNO(SUBST(pStartDate, 1, 10));
         nEndPeriod = DAYNO(SUBST(pEndDate, 1, 10));

         WHILE(nPeriod <= nEndPeriod);
            sDay = DATE(nPeriod, 1);
            nPar = ELPARN(sDim, sDay);
            cnt = 1;
            WHILE(cnt <= nPar);
               sPar = ELPAR(sDim, sDay, cnt);
               IF(ELISANC(sDim, 'Total Time - Week Day', sPar) = 1);
                  sWeek = 'WS ' | SUBST(sPar, 4, 10);
                  SUBSETELEMENTINSERT(sDim, cSubset, sWeek, 1);
               ENDIF;
               cnt = cnt + 1;
            END;
            nPeriod = DAYNO(SUBST(ATTRS(sDim, sWeek, 'Next Period'), 4, 10));
         END;

      ENDIF;

      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);

   ELSEIF(sDim @= 'Source');
      sElement = 'FDP';
      SUBSETCREATE(sDim, cSubset, 1);
      SUBSETELEMENTINSERT(sDim, cSubset, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);

   ELSEIF(sDim @= 'Rides Ops Metric');
      SUBSETCREATE(sDim, cSubset, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);

   ELSE;
      sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({TM1SUBSETALL([ ' | sDim | '] )}, 0)}, ASC)}';
      SUBSETCREATEBYMDX(cSubset, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ENDIF;

   nCtr = nCtr + 1;
END;





# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: METADATA PROCEDURE                                                   #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****




# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: METADATA PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Transformation
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#


# Month and Week

IF(pLevel @= 'Month');
   sPeriod = SUBST(vPeriod, 1, 7);
ELSE;
   sPeriod = 'WS ' | SUBST(vPeriod, 1, 10);
ENDIF;


IF(SUBSETELEMENTEXISTS('Period', cSubset, sPeriod) = 0);
   ITEMSKIP;
ENDIF;


# Location
sDim = 'Location';
IF(vLocation @= '\N' % vLocation @= '');
   ITEMSKIP;
ENDIF;
sLocation = 'V' | vLocation;

IF((ELISANC(sDim, 'Total Location by Country', vLocation) = 1 & ELLEV(sDim, vLocation) <> 0) % (ELISANC(sDim, 'Custom Consolidations', vLocation) = 1 & ELLEV(sDim, vLocation) <> 0) % (ELISANC(sDim, 'Total Location', vLocation) = 1 & ELLEV(sDim, vLocation) <> 0) % SCAN('(Country)', vLocation) > 0);
   sLocation = vLocation;
ELSEIF(vLocation @= 'global');
   sLocation = 'Total Location';
ELSEIF(vLocation @= 'global_ex_sea_and_russia');
   sLocation = 'Total Location ex SEA & Russia';
ELSE;
   sLocation = 'V' | vLocation;
ENDIF;

IF(DIMIX('Location', sLocation) = 0);
   ITEMSKIP;
ENDIF;


# Flow Type
sDim = 'Rides Flow Type';
IF(vFlowType @= 'nemoearner');
   ITEMSKIP;
ELSEIF(vFlowType @= '\N' % vFlowType @= '' % vFlowType @= 'None');
   sFlowType = 'Unspecified Flow Type';
ELSE;
   sFlowType = vFlowType;
ENDIF;

# Car Type
sDim = 'Rides Car Type';
IF(vCarType @= 'uber_eats');
   ITEMSKIP;
ELSEIF(vCarType @= '\N' % vCarType @= '');
   sCarType = 'Not Specified';
ELSE;
   sCarType = vCarType;
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Clear Target View
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
#Scanning the Input to find Period and metric combination to be zeroed out
sMetric = vMetric;

IF(pLevel @= 'Month');
   IF(sMetric @= 'Completed Trips' % sMetric @= 'Rider Miles');
      nGLOPS = 1;
   ENDIF;
ENDIF;

IF(SCAN(sMetric, cMetricString) = 0);
   cMetricString = cMetricString | sMetric | '|';
   SUBSETDELETEALLELEMENTS('Rides Ops Metric', cSubset);
   SUBSETELEMENTINSERT('Rides Ops Metric', cSubset, sMetric, 1);
   VIEWZEROOUT(cCube, cViewName);
ENDIF;


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Load Data
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

IF(pLevel @= 'Month');
   IF(sMetric @= 'Active Riders L28' % sMetric @= 'Weekly Active Riders' % sMetric @= 'Active Drivers L28' % sMetric @= 'Weekly Active Drivers');
      ITEMSKIP;
   ENDIF;
ELSE;
   IF(sMetric @= 'Active Riders' % sMetric @= 'Active Drivers');
      ITEMSKIP;
   ENDIF;
ENDIF;

sDim = 'Rate Type';
p = 1;
WHILE(p <= DIMSIZ(sDim));
   sRateType = DIMNM(sDim, p);
   IF(ELLEV(sDim, sRateType) = 0);
      IF(ELLEV('Location', sLocation) > 0);
         CELLPUTN(vValue, cCube, cVersion, sPeriod, cSource, sRatetype, 'CustomLeaf:' | sLocation | ' Input', sFlowType, sCarType, vMetric, cMeasure);
      ELSE;
         CELLPUTN(vValue, cCube, cVersion, sPeriod, cSource, sRatetype, sLocation, sFlowType, sCarType, vMetric, cMeasure);
         CELLPUTS(sOutputstring, 'Rides Ops Info', sMetric, sPeriod, 'Last Updated');
      ENDIF;
   ENDIF;
   p = p + 1;
END;



# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: EPILOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

IF(nGLOps = 1);
   EXECUTEPROCESS('Ops.DIQ.GL Reporting.Sync'
      , 'pInstance', 'PAC'
      , 'pProcess', 'DIQ.Call.Batch'
      , 'pParams', '[{"Name":"pDIQBatch","Value":"Batch - 1015"}]'
   );
ENDIF;


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: EPILOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #