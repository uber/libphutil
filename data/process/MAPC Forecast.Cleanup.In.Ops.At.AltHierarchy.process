# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Clear Data
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

IF(ELLEV('Line of Business', vLineofBusiness) > 0 & ELLEV('Location', vLocation) > 0);
   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   CELLPUTN(0, sCube, vVersion, vPeriod, vSource, vRateType, 'CustomLeaf:' | vLocation | ' Input', 'CustomLeaf:' | vLineofBusiness | ' Input', vProductType, vOpsMetric, vOpsMeasure);

ELSEIF(ELLEV('Line of Business', vLineofBusiness) = 0 & (SCAN('(Mega Region)', vLocation) > 0 % vLocation @= 'Total Location'));
   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   CELLPUTN(0, sCube, vVersion, vPeriod, vSource, vRateType, 'CustomLeaf:' | vLocation | ' Input', vLineofBusiness, vProductType, vOpsMetric, vOpsMeasure);

ENDIF;





# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsCompleted = nDataProcedureRecordsCompleted + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
