    "DataSource": {
        "Type": "TM1CubeView",
        "dataSourceNameForClient": "Ops",
        "dataSourceNameForServer": "Ops",
        "view": "All"
    },
    "HasSecurityAccess": false,
    "Name": "Temporary.Ops Snapshot.Intracube.Ops Adjustment.Copy",
    "Parameters": [
        {
            "Name": "pSnapshotVersion",
            "Prompt": "REQ: To Version",
            "Type": "String",
            "Value": ""
        },
        {
            "Name": "pMonth",
            "Prompt": "REQ: Leaf",
            "Type": "String",
            "Value": ""
        }
    ],
    "UIData": "",
    "Variables": [
        {
            "EndByte": 0,
            "Name": "vVersion",
            "Position": 1,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vPeriod",
            "Position": 2,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vSource",
            "Position": 3,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vRateType",
            "Position": 4,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vLocation",
            "Position": 5,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vLOB",
            "Position": 6,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vProductType",
            "Position": 7,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vOpsMetric",
            "Position": 8,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vMeasure",
            "Position": 9,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vValue",
            "Position": 10,
            "StartByte": 0,
            "Type": "Numeric"
        }
    ],
    "VariablesUIData": [
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
