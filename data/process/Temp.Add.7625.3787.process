#****Begin: Generated Statements***
#****End: Generated Statements****

sDim = 'Location';

IF(pAdd3787 = 1);
   DIMENSIONELEMENTCOMPONENTDELETEDIRECT(sDim, 'Italy (PU)', '7109');
   sElem = 'Malta (Territory)';
   IF(DIMIX(sDim, sElem) = 0);
      DIMENSIONELEMENTINSERTDIRECT(sDim, '', sElem, 'C');
   ENDIF;
   sElem = 'Malta (PU)';
   IF(DIMIX(sDim, sElem) = 0);
      DIMENSIONELEMENTINSERTDIRECT(sDim, '', sElem, 'C');
   ENDIF;
   DIMENSIONELEMENTCOMPONENTADDDIRECT(sDim, sElem, '3787', 1);
   DIMENSIONELEMENTCOMPONENTADDDIRECT(sDim, sElem, '7109', 1);
   DIMENSIONELEMENTCOMPONENTADDDIRECT(sDim, 'Malta (Territory)', sElem, 1);
   DIMENSIONELEMENTCOMPONENTADDDIRECT(sDim, 'Southern Europe (Sub Region)', 'Malta (Territory)', 1);
   DIMENSIONELEMENTCOMPONENTADDDIRECT(sDim, 'Country - Malta', '3787', 1);
ENDIF;

IF(pAdd7625 = 1);
   DIMENSIONELEMENTCOMPONENTADDDIRECT(sDim, 'Netherlands (PU)', '7625', 1);
   DIMENSIONELEMENTCOMPONENTADDDIRECT(sDim, 'Country - Netherlands', '7625', 1);
ENDIF;

