# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

# Process to load data in Ops cubes using upload UI


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Define Constants
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cCube = 'Ops';
cVersion = 'Actual';
cRateType = 'USD';
cMeasure = 'Amount';
cSource = 'FDS';
nRecords = 1;

sPassword = 'corpfin';
IF(pPWord @<> sPassword);
   PROCESSQUIT;
ENDIF;

cPeriodMetricLOBString = '';

nDate = NOW;
NEWDATEFORMATTER('', 'PST', 'serial', 'full', 'datetime', '');
sOutputString = FORMATDATE(nDate, 0);

nStart = 1;
nCurPos = 1;

cUser = CELLGETS('System Info', 'SQL User Name GL Transactions', 'String');
cPassword = CELLGETS('System Info', 'SQL Password GL Transactions', 'String');


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Set Query
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

DatasourceUsername = cUser;
DatasourcePassword = cPassword;
sQuery = EXPAND('SELECT * FROM "%pTable%"');
DatasourceQuery = sQuery;




# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: METADATA PROCEDURE                                                   #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

IF(pLevel @= 'Month');
   IF(vMetric @= 'Completed Trips' % vMetric @= 'Rider Miles');
      nGLOPS = 1;
   ENDIF;
ENDIF;


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: METADATA PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Transformation
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

# Month and Week

IF(pLevel @= 'Month');
   sPeriod = SUBST(vPeriod, 1, 7);
ELSE;
   sPeriod = 'WS ' | SUBST(vPeriod, 1, 10);
ENDIF;

# Location
sDim = 'Location';
IF(vLocation @= '\N' % vLocation @= '');
   ITEMSKIP;
ENDIF;
sLocation = 'V' | vLocation;

IF((ELISANC(sDim, 'Total Location by Country', vLocation) = 1 & ELLEV(sDim, vLocation) <> 0) % (ELISANC(sDim, 'Custom Consolidations', vLocation) = 1 & ELLEV(sDim, vLocation) <> 0) % (ELISANC(sDim, 'Total Location', vLocation) = 1 & ELLEV(sDim, vLocation) <> 0));
   sLocation = vLocation;
ELSEIF(vLocation @= 'global');
   sLocation = 'Total Location';
ELSEIF(vLocation @= 'global_ex_sea_and_russia');
   sLocation = 'Total Location ex SEA & Russia';
ELSE;
   sLocation = 'V' | vLocation;
ENDIF;

IF(DIMIX('Location', sLocation) = 0);
   ITEMSKIP;
ENDIF;

# LOB
sDim = 'Line of Business';
IF(vLOB @= '\N' % vLOB @= '' % vLOB @= 'NULL' % vLOB @= '0');
   sLOB = '0000';
ELSE;
   sLOB = vLOB;
ENDIF;

# Product Type
sDim = 'Product Type';
IF(vProductType @= '\N' % vProductType @= '' % vProductType @= 'NULL' % vProductType @= '0');
   sProductType = 'Not Specified';
ELSE;
   sProductType = vProductType;
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Clear Target View
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
#Scanning the Input to find Period , LOB and metric combination to be zeroed out

sMetric = vMetric;
IF(SCAN(sPeriod | '_' | sMetric | '_' | sLOB, cPeriodMetricLOBString) = 0);
   IF(LONG(cPeriodMetricLOBString) = 0);
      cPeriodMetricLOBString = sPeriod | '_' | sMetric | '_' | sLOB;
   ELSE;
      cPeriodMetricLOBString = cPeriodMetricLOBString | '|' | sPeriod | '_' | sMetric | '_' | sLOB;
   ENDIF;

   sLoopString = TRIM(cPeriodMetricLOBString);
   sLoopString = sLoopString | IF(SUBST(sLoopString, LONG(sLoopString), 1) @<> '|', '|', '');

   WHILE(nCurPos <= LONG(sLoopString));
      sCurChar = SUBST(sLoopString, nCurPos, 1);
      IF(sCurChar @= '|');
         sPeriodMetricLOBElement = SUBST(sLoopString, nStart, nCurPos - nStart);
         nSplit_1 = SCAN('_', sPeriodMetricLOBElement);
         sPeriodElement = SUBST(sPeriodMetricLOBElement, 1, (nSplit_1 - 1));
         sMetricLOBElement = SUBST(sPeriodMetricLOBElement, (nSplit_1 + 1), LONG(sPeriodMetricLOBElement) - nSplit_1);
         nSplit_2 = SCAN('_', sMetricLOBElement);
         sMetricElement = SUBST(sMetricLOBElement, 1, (nSplit_2 - 1));
         sLOBElement = SUBST(sMetricLOBElement, (nSplit_2 + 1), LONG(sMetricLOBElement) - nSplit_2);

         cRandomIntA = NUMBERTOSTRING(INT(RAND() * 100000));
         cViewName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
         cSubsetName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;

         VIEWCREATE(cCube, cViewName, 1);
         nCtr = 1;
         nMax = CUBEDIMENSIONCOUNTGET(cCube);
         WHILE(nCtr <= nMax);
            sDim = TABDIM(cCube, nCtr);
            IF(sDim @= 'Version');
               sElement = 'Actual';
               SUBSETCREATE(sDim, cSubsetName, 1);
               SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
               VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
            ELSEIF(sDim @= 'Period');
               sElement = sPeriodElement;
               SUBSETCREATE(sDim, cSubsetName, 1);
               SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
               VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
            ELSEIF(sDim @= 'Source');
               sElement = 'FDP';
               SUBSETCREATE(sDim, cSubsetName, 1);
               SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
               VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
            ELSEIF(sDim @= 'Line of Business');
               sElement = sLOBElement;
               SUBSETCREATE(sDim, cSubsetName, 1);
               SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
               VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
            ELSEIF(sDim @= 'Ops Metric');
               sElement = sMetricElement;
               SUBSETCREATE(sDim, cSubsetName, 1);
               SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
               VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
            ELSE;
               sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({TM1SUBSETALL([ ' | sDim | '] )}, 0)}, ASC)}';
               SUBSETCREATEBYMDX(cSubsetName, sMdx, 1);
               VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
            ENDIF;
            nCtr = nCtr + 1;
         END;
         VIEWZEROOUT(cCube, cViewName);
         nStart = nCurPos + 1;
      ENDIF;
      nCurPos = nCurPos + 1;
   END;
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Load Data
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

IF(pLevel @= 'Month');
   IF(sMetric @= 'Active Riders L28' % sMetric @= 'Weekly Active Riders' % sMetric @= 'Active Drivers L28' % sMetric @= 'Weekly Active Drivers');
      ITEMSKIP;
   ENDIF;
ELSE;
   IF(sMetric @= 'Active Riders' % sMetric @= 'Active Drivers');
      ITEMSKIP;
   ENDIF;
ENDIF;

sDim = 'Rate Type';
p = 1;
WHILE(p <= DIMSIZ(sDim));
   sRateType = DIMNM(sDim, p);
   IF(ELLEV(sDim, sRateType) = 0);
      IF(ELLEV('Line of Business', vLOB) > 0 & ELLEV('Location', sLocation) > 0);
         CELLPUTN(vValue, cCube, cVersion, sPeriod, cSource, sRatetype, 'CustomLeaf:' | sLocation | ' Input', 'CustomLeaf:Total Rides & Eats Input', sProductType, vMetric, cMeasure);
      ELSEIF(ELLEV('Line of Business', vLOB) > 0 & ELLEV('Location', sLocation) = 0);
         CELLPUTN(vValue, cCube, cVersion, sPeriod, cSource, sRatetype, sLocation, 'CustomLeaf:Total Rides & Eats Input', sProductType, vMetric, cMeasure);
      ELSEIF(ELLEV('Line of Business', vLOB) = 0 & ELLEV('Location', sLocation) > 0);
         CELLPUTN(vValue, cCube, cVersion, sPeriod, cSource, sRatetype, 'CustomLeaf:' | sLocation | ' Input', sLOB, sProductType, vMetric, cMeasure);
      ELSE;
         CELLINCREMENTN(vValue, cCube, cVersion, sPeriod, cSource, sRatetype, sLocation, sLOB, sProductType, vMetric, cMeasure);
      ENDIF;
   ENDIF;
   p = p + 1;
END;



# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: EPILOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

IF(nGLOps = 1);
   EXECUTEPROCESS('Ops.DIQ.GL Reporting.Sync'
      , 'pInstance', 'PAC'
      , 'pProcess', 'DIQ.Call.Batch'
      , 'pParams', '[{"Name":"pDIQBatch","Value":"Batch - 1015"}]'
   );
ENDIF;



# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: EPILOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #