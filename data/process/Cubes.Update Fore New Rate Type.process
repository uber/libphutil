    },
    "HasSecurityAccess": false,
    "Name": "Cubes.Update Fore New Rate Type",
    "Parameters": [
        {
            "Name": "pPeriod",
            "Prompt": "",
            "Type": "String",
            "Value": ""
        },
        {
            "Name": "pVersion",
            "Prompt": "",
            "Type": "String",
            "Value": ""
        },
        {
            "Name": "pRateType",
            "Prompt": "",
            "Type": "String",
            "Value": ""
        },
        {
            "Name": "pCube",
            "Prompt": "",
            "Type": "String",
            "Value": ""
        }
    ],
