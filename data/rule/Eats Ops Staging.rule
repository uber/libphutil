###############################################################################
### Cube: Eats Ops Staging
### Dimensions:
###     1: Version
###     2: Period
###     3: Source
### .   4: Currency
###     5: Rate Type
###     6: Location
###     7: Eats Product Type
###     8: Eats Restaurant Type
###     9: Eats Ops Metric
###     10:Eats Ops Staging Measure
###############################################################################

SKIPCHECK;

## USD and No Rate Type will be loaded into
['Rate Type':{'USD', 'No Rate Type'}, 'Amount'] = STET;

## Calculate Currency Conversion to Local Currency
['Local', 'Amount'] = N:
   IF(
      ATTRS('Location', !Location, 'Currency') @= !Currency
   ,
      IF(
         ELISANC('Period', 'Total Time - Month', !Period)=1
      ,
         ['Rate Type':'USD','Currency':'Total Currency','Amount'] /
         DB('Exchange Rate', 'Actual', !Period, ATTRS('Location', !Location, 'Currency'),'USD', 'Rate')
      ,
         ['Rate Type':'USD','Currency':'Total Currency','Amount'] /
         DB('Exchange Rate', 'Actual', Subst(!Period, 4, 7), ATTRS('Location', !Location, 'Currency'),'USD', 'Rate')
      )
   ,
      CONTINUE
   );


## Calculate FX Variance
['Amount'] = N:
   ['No Rate Type','Amount'] *
   IF(
      ELISANC('Period', 'Total Time - Month', !Period)=1
   ,
      DB('Exchange Rate by Rate Type', !Version, !Period, !Currency, !Rate Type, 'Amount')
   ,
      DB('Exchange Rate by Rate Type',!Version, Subst(!Period, 4, 7), !Currency, !Rate Type, 'Amount')
   );



FEEDERS;

##Feed Eats Ops

['Amount'] =>
   DB('Eats Ops', !Version, !Period, !Source, !Rate Type, !Location, !Eats Product Type, !Eats Restaurant Type, !Eats Ops Metric, 'Amount');


## Feed FX
['No Rate Type'] =>
   ['FX Rates'];
['Rate Type':'USD'] =>
   ['Local'];