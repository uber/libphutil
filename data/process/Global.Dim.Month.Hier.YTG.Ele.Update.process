# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROPERTIES                                                           #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
{
    "DataSource": {
        "Type": "None"
    },
    "HasSecurityAccess": false,
    "Name": "Global.Dim.Month.Hier.YTG.Ele.Update",
    "Parameters": [],
    "UIData": "CubeAction=1511\fDataAction=1503\fCubeLogChanges=0\f",
    "Variables": [],
    "VariablesUIData": []
}
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROPERTIES                                                             #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****



# ==================================================================== #
# Globals
# ==================================================================== #

cDimMonth = 'Month';

cRand = NUMBERTOSTRING(ROUND(RAND() * 100000));
cRand = FILL('0', 6 - LONG(cRand)) | cRand;

cView = EXPAND('zzTemp.%cRand%');
cSub = EXPAND('zzTemp.%cRand%');

# ==================================================================== #
# Create Subsets
# ==================================================================== #

sDim = cDimMonth;
sSub = cSub | '.Month';
sMDX = EXPAND('{TM1SORT( EXCEPT( {TM1FILTERBYPATTERN( [%sDim%].[%sDim%].Members, "????-??")},' | 'UNION({TM1FILTERBYPATTERN( [%sDim%].[%sDim%].Members, "????-H?")}, {TM1FILTERBYPATTERN( [%sDim%].[%sDim%].Members' | ', "????-Q?")})), ASC)}');
SUBSETCREATE(sDim, sSub, 0);
SUBSETMDXSET(sDim, sSub, sMDX);
SUBSETMDXSET(sDim, sSub, '');


# ==================================================================== #
# Create Rollups
# ==================================================================== #

sDim = cDimMonth;
sSub = cSub | '.Month';

sSuffix = ' YTG';

i = 1;
WHILE(i <= SUBSETGETSIZE(sDim, sSub));
   sEleLeaf = SUBSETGETELEMENTNAME(sDim, sSub, i);
   sType = ATTRS(sDim, sEleLeaf, 'Input Type');

   IF(sType @= 'Month');
      sYear = ATTRS(sDim, sEleLeaf, 'Year');
      sHalf = ATTRS(sDim, sEleLeaf, 'Half');
      sQuarter = ATTRS(sDim, sEleLeaf, 'Quarter');
      sMonth = ATTRS(sDim, sEleLeaf, 'Month');

      sElePar = 'Total Time - Month - Year to Go';
      sEle = sYear | sSuffix;

      IF(DIMIX(sDim, sElePar) = 0);

         DIMENSIONELEMENTINSERT(sDim, '', sElePar, 'C');
      ENDIF;
      IF(DIMIX(sDim, sEle) = 0);
         DIMENSIONELEMENTINSERT(sDim, '', sEle, 'C');
      ENDIF;

      DIMENSIONELEMENTCOMPONENTADD(sDim, sElePar, sEle, 0);

      sElePar = sYear | sSuffix;
      sEle = EXPAND('%sYear%-%sHalf%') | sSuffix;

      IF(DIMIX(sDim, sElePar) = 0);

         DIMENSIONELEMENTINSERT(sDim, '', sElePar, 'C');
      ENDIF;
      IF(DIMIX(sDim, sEle) = 0);

         DIMENSIONELEMENTINSERT(sDim, '', sEle, 'C');
      ENDIF;

      nWeight = IF(SCAN('H1', sEle) > 0, 1, 0);

      DIMENSIONELEMENTCOMPONENTADD(sDim, sElePar, sEle, nWeight);

      sElePar = EXPAND('%sYear%-%sHalf%') | sSuffix;
      sEle = EXPAND('%sYear%-%sQuarter%') | sSuffix;

      IF(DIMIX(sDim, sElePar) = 0);

         DIMENSIONELEMENTINSERT(sDim, '', sElePar, 'C');
      ENDIF;
      IF(DIMIX(sDim, sEle) = 0);

         DIMENSIONELEMENTINSERT(sDim, '', sEle, 'C');
      ENDIF;
      nWeight = IF(SCAN('Q1', sEle) > 0 % SCAN('Q3', sEle) > 0, 1, 0);

      DIMENSIONELEMENTCOMPONENTADD(sDim, sElePar, sEle, nWeight);


      sElePar = EXPAND('%sYear%-%sQuarter%') | sSuffix;
      sEle = sEleLeaf | sSuffix;

      IF(DIMIX(sDim, sElePar) = 0);

         DIMENSIONELEMENTINSERT(sDim, '', sElePar, 'C');
      ENDIF;
      IF(DIMIX(sDim, sEle) = 0);

         DIMENSIONELEMENTINSERT(sDim, '', sEle, 'C');
      ENDIF;
      nWeight = IF(SCAN('-01', sEle) > 0 % SCAN('-04', sEle) > 0 % SCAN('-07', sEle) > 0 % SCAN('-10', sEle) > 0, 1, 0);

      DIMENSIONELEMENTCOMPONENTADD(sDim, sElePar, sEle, nWeight);

      sElePar = sEleLeaf | sSuffix;

      IF(DIMIX(sDim, sElePar) = 0);

         DIMENSIONELEMENTINSERT(sDim, '', sElePar, 'C');
      ENDIF;

      p = 1;
      WHILE(p <= NUMBR(sMonth));
         sEle = sYear | '-' | FILL('0', 2 - LONG(NUMBERTOSTRING(p))) | NUMBERTOSTRING(p);
         nWeight = 1;

         DIMENSIONELEMENTCOMPONENTADD(sDim, sElePar, sEle, nWeight);

         p = p + 1;
      END;
   ENDIF;

   i = i + 1;
END;

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
