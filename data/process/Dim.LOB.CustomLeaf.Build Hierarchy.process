{
    "DataSource": {
        "Type": "TM1DimensionSubset",
        "dataSourceNameForClient": "Line of Business",
        "dataSourceNameForServer": "Line of Business",
        "subset": "All"
    },
    "HasSecurityAccess": false,
    "Name": "Dim.LOB.CustomLeaf.Build Hierarchy",
    "Parameters": [
        {
            "Name": "pDebug",
            "Prompt": "",
            "Type": "Numeric",
            "Value": 0
        }
    ],
    "UIData": "CubeAction=1511\fDataAction=1503\fCubeLogChanges=0\f",
    "Variables": [
        {
            "EndByte": 0,
            "Name": "vLOB",
            "Position": 1,
            "StartByte": 0,
            "Type": "String"
        }
    ],
    "VariablesUIData": [
        "VarType=32\fColType=827\f"
    ]
}
