###############################################################################
### Cube: Ops Snapshot
### Dimensions:
###     1: Version
###     2: Period
###     3: Source
###     4. Rate Type
###     5: Location
###     6: Line of Business
###     7. Product Type
###     8: Ops Metric
###     9: Ops Measure
###############################################################################

SKIPCHECK;

[ ] = 
  IF
      ( 
         ELISANC ('Version', 'Snapshot Version', !Version) > 0 & ELISANC ('Ops Metric', 'MAPC Metrics',!Ops Metric) > 0
      ,
         CONTINUE
      ,
         STET
      );
      
['Ops Measure':'Amount'] = C: 
    IF(
        ELLEV('Source',!Source)>0
        , 
          CONSOLIDATECHILDREN('Source')
        , 
          CONTINUE
    );          

['Ops Measure':'Amount'] = C:
    IF(
       ELLEV('Period', !Period) > 0
    ,
       0
    ,
       IF(
          ELLEV ('Line of Business', !Line of Business) > 0 & ELLEV ('Location', !Location) > 0
       ,
          DB('Ops Snapshot', !Version, !Period, !Source, !Rate Type,  'CustomLeaf':!Location | ' Input', 'CustomLeaf':!Line of Business | ' Input', !Product Type, !Ops Metric, !Ops Measure)
       ,
        CONTINUE
      )
    );

['Ops Measure':'Amount'] = C:
     IF(
        ELLEV ('Line of Business', !Line of Business) = 0 & ELLEV ('Location', !Location) > 0
     ,
        DB('Ops Snapshot', !Version, !Period, !Source, !Rate Type,  'CustomLeaf':!Location | ' Input', !Line of Business, !Product Type, !Ops Metric, !Ops Measure)
     ,
      CONTINUE
    );
    
['Ops Measure':'Amount'] = C:
     IF(
        ELLEV ('Line of Business', !Line of Business) > 0 & ELLEV ('Location', !Location) = 0
     ,
        DB('Ops Snapshot', !Version, !Period, !Source, !Rate Type,  !Location, 'CustomLeaf':!Line of Business | ' Input', !Product Type, !Ops Metric, !Ops Measure)
     ,
      CONTINUE
    );

