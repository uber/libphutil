###############################################################################
### Cube: Rides Ops
### Dimensions:
###     1: Version
###     2: Period
###     3: Source
###     4. Rate Type
###     5: Location
###     6: Rides Flow Type
###     7. Rides Car Type
###     8: Rides Ops Metric
###     9: Rides Ops Measure
###############################################################################

FEEDSTRINGS;
SKIPCHECK;

[ ] =
   IF(
      ATTRS ( 'Version', !Version, 'Active' ) @= ''
   ,
      STET
   ,
      CONTINUE
   );

# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# Budget Data from Planning
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['Version' : {'2020 Plan',  'Forecast Excl Actuals'}] =  STET;


# =-=-=-=-=-=-=-=-=-=-=-=-=-=- =-=-=-=-=-=-=-=-=-=-=-=-=-=- =-=-=-= #
# POP, YOY, POP %, YOY %, % of Gross Bookings, % of Adjusted Net Revenue
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- =-=-=-=-=-=-=-=-=-=-=-=-=-=- =-=-=-= #

['% of Gross Bookings'] = ['Amount'] \ ['Gross Bookings','Amount'];

['% of Adjusted Net Revenue'] = ['Amount'] \ ['Adjusted Net Revenue', 'Amount'];


['PoP Growth'] =
   (
     ['Amount'] -
     DB('Rides Ops', !Version, ATTRS('Period', !Period, 'Period-1'), !Source, !Rate Type, !Location, !Rides Flow Type, !Rides Car Type, !Rides Ops Metric, 'Amount')
   ) *
      IF(
      ATTRN('Rides Ops Metric', !Rides Ops Metric, 'Var Multiplier') = -1
      ,
      -1
      ,
      1);

['YoY Growth'] =
   (
      ['Amount'] -
      DB('Rides Ops', !Version, ATTRS('Period', !Period, 'Year-1'), !Source, !Rate Type, !Location, !Rides Flow Type, !Rides Car Type, !Rides Ops Metric, 'Amount')
   ) *
      IF(
      ATTRN('Rides Ops Metric', !Rides Ops Metric, 'Var Multiplier') = -1
      ,
      -1
      ,
      1);

['PoP Growth %'] =
  MIN(
    MAX(
         ['PoP Growth'] \
         ABS (DB('Rides Ops', !Version, ATTRS('Period', !Period, 'Period-1'), !Source, !Rate Type, !Location, !Rides Flow Type, !Rides Car Type, !Rides Ops Metric, 'Amount'))
         ,
        -9.99
      )
   ,
    9.99
  );

['YoY Growth %'] =
  MIN(
    MAX(
          ['YoY Growth'] \
          ABS (DB('Rides Ops', !Version, ATTRS('Period', !Period, 'Year-1'), !Source, !Rate Type, !Location, !Rides Flow Type, !Rides Car Type, !Rides Ops Metric, 'Amount'))
          ,
         -9.99
        )
      ,
    9.99
  );


#=-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-=-=-=-=-#
#>--- Amount Measure in (K) & (M)
#=-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-=-=-=-=-#

['Rides Ops Measure':'Amount (K)'] = C:
   ['Amount'] \ 1000;

['Rides Ops Measure':'Amount (M)'] = C:
    ['Amount'] \ 1000000;


# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# Consolidation  Level  Calcs
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['Rides Ops Measure':'Amount' ] = C:
   IF(
      ATTRS('Rides Ops Metric', !Rides Ops Metric, 'Aggregate_Location_Flag') @= 'Y'
   ,
      IF(
         ELLEV('Period', !Period) > 0
      ,
         0
     ,
         IF(
            (ELLEV ('Location', !Location) > 0)
         ,
            DB('Rides Ops', !Version, !Period, !Source, !Rate Type, 'CustomLeaf':!Location | ' Input', !Rides Flow Type, !Rides Car Type, !Rides Ops Metric, 'Amount')
         ,
            STET
        )
      )
   ,
      CONTINUE
   );


# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# Leaf Level  Calcs
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['Rides Ops Measure' : 'Amount' ] = N:
   IF(
      ATTRS('Rides Ops Metric', !Rides OPS Metric, 'Fx_Flag') @= 'Y'
   ,
      DB('Rides Ops Staging', !Version, !Period, !Source, 'Total Currency', !Rate Type, !Location, !Rides Flow Type, !Rides Car Type, !Rides OPS Metric, 'Amount')
   ,
      STET
   );

FEEDERS;

#['Location':'CustomLeaf':'Total Location']=> DB('Rides Ops',!Version,!Period,!Source,!Rate Type,!Location,!Rides Flow Type,!Rides Car Type,'Active Drivers',!Rides Ops Measure);

## Feed Ops

['Amount'] => DB('Ops', !Version, !Period, !Source, !Rate Type, !Location, '1001', !Rides Car Type, !Rides Ops Metric,'Amount');
['Expresspool','Amount'] => DB('Ops', !Version, !Period, !Source, !Rate Type, !Location, '1002', !Rides Car Type, !Rides Ops Metric,'Amount');
['Pool','Amount'] => DB('Ops', !Version, !Period, !Source, !Rate Type, !Location, '1002', !Rides Car Type, !Rides Ops Metric,'Amount');
['P2P','Rider Miles', 'Amount'] => DB('Ops',!Version,!Period,!Source,!Rate Type,!Location,'1001',!Rides Car Type,'P2P Rider Miles','Amount');
['Non P2P','Rider Miles', 'Amount'] => DB('Ops',!Version,!Period,!Source,!Rate Type,!Location,'1001',!Rides Car Type,'Non-P2P Rider Miles','Amount');
['Expresspool', 'P2P','Rider Miles', 'Amount'] => DB('Ops',!Version,!Period,!Source,!Rate Type,!Location,'1002',!Rides Car Type,'P2P Rider Miles','Amount');
['Pool', 'Non P2P','Rider Miles', 'Amount'] => DB('Ops',!Version,!Period,!Source,!Rate Type,!Location,'1002',!Rides Car Type,'Non-P2P Rider Miles','Amount');



