# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROPERTIES                                                           #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
{
    "DataSource": {
        "Type": "TM1CubeView",
        "dataSourceNameForClient": "Rides Ops",
        "dataSourceNameForServer": "Rides Ops",
        "view": "Default"
    },
    "HasSecurityAccess": false,
    "Name": "}Drill_Rides_Ops_Drill",
    "Parameters": [
        {
            "Name": "cubename",
            "Prompt": "",
            "Type": "String",
            "Value": "Ops"
        },
        {
            "Name": "pVersion",
            "Prompt": "",
            "Type": "String",
            "Value": "Actual"
        },
        {
            "Name": "pPeriod",
            "Prompt": "",
            "Type": "String",
            "Value": "2020-01"
        },
        {
            "Name": "pSource",
            "Prompt": "",
            "Type": "String",
            "Value": "FDP"
        },
        {
            "Name": "pRateType",
            "Prompt": "",
            "Type": "String",
            "Value": "USD"
        },
        {
            "Name": "pLocation",
            "Prompt": "",
            "Type": "String",
            "Value": "1001"
        },
        {
            "Name": "pLOB",
            "Prompt": "",
            "Type": "String",
            "Value": "1001"
        },
        {
            "Name": "pProductType",
            "Prompt": "",
            "Type": "String",
            "Value": "Black Car"
        },
        {
            "Name": "pMetric",
            "Prompt": "",
            "Type": "String",
            "Value": "Net Inflows"
        },
        {
            "Name": "pMeasure",
            "Prompt": "",
            "Type": "String",
            "Value": "Amount"
        }
    ],
    "UIData": "CubeAction=1511\fDataAction=1503\fCubeLogChanges=0\f",
    "Variables": [],
    "VariablesUIData": [
        "IgnoredInputVarName=Version\fVarType=32\fColType=1165\f",
        "IgnoredInputVarName=Period\fVarType=32\fColType=1165\f",
        "IgnoredInputVarName=Source\fVarType=32\fColType=1165\f",
        "IgnoredInputVarName=V4\fVarType=32\fColType=1165\f",
        "IgnoredInputVarName=Location\fVarType=32\fColType=1165\f",
        "IgnoredInputVarName=V6\fVarType=32\fColType=1165\f",
        "IgnoredInputVarName=V7\fVarType=32\fColType=1165\f",
        "IgnoredInputVarName=V8\fVarType=32\fColType=1165\f",
        "IgnoredInputVarName=V9\fVarType=32\fColType=1165\f",
        "IgnoredInputVarName=Value\fVarType=33\fColType=1165\f"
    ]
}
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROPERTIES                                                             #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****



cCube = 'Rides Ops';
CustomDrill = 1;


cRandomIntA = NUMBERTOSTRING(INT(RAND() * 100000 * RAND()));
cViewName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
cSubsetName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;

VIEWCREATE(cCube, cViewName);
nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(cCube);
WHILE(nCtr <= nMax);
   sDim = TABDIM(cCube, nCtr);
   IF(sDim @= 'Version');
      sElement = pVersion;
      SUBSETCREATE(sDim, cSubsetName);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Period');
      sElement = pPeriod;
      SUBSETCREATE(sDim, cSubsetName);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Source');
      sElement = pSource;
      SUBSETCREATE(sDim, cSubsetName);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Rate Type');
      sElement = pRateType;
      SUBSETCREATE(sDim, cSubsetName);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Location');
      sElement = pLocation;
      SUBSETCREATE(sDim, cSubsetName);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Rides Flow Type');
      sElement = 'Total Rides Flow Type';
      SUBSETCREATE(sDim, cSubsetName);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Rides Car Type');
      IF(pLOB @= '1002');
         IF(pProductType @= 'Total Product Type' % pProductType @= 'Low Cost');
            sElement = 'Shared Rides';
         ELSE;
            sElement = pProductType;
         ENDIF;
      ELSEIF(pLOB @= '1001');
         IF(pProductType @= 'Total Product Type');
            sElement = 'Total Rides Car Type';
         ELSE;
            sElement = pProductType;
         ENDIF;
      ENDIF;
      SUBSETCREATE(sDim, cSubsetName);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Rides Ops Metric');
      sElement = pMetric;
      SUBSETCREATE(sDim, cSubsetName);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Rides Ops Measure');
      sElement = pMeasure;
      SUBSETCREATE(sDim, cSubsetName);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ENDIF;
   nCtr = nCtr + 1;
END;


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
## Set View as DataSource             ##
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

DISABLEMTQVIEWCONSTRUCT();

DatasourceNameForServer = cCube;
DatasourceType = 'VIEW';
DatasourceCubeView = cViewName;

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: METADATA PROCEDURE                                                   #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: METADATA PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: EPILOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #

IF(CustomDrill = 0);
   #****Begin: Generated Statements***
   RETURNVIEWHANDLE('Rides Ops', 'Default');
   #****End: Generated Statements****

ELSE;
   RETURNVIEWHANDLE(cCube, cViewName);
ENDIF;

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: EPILOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #