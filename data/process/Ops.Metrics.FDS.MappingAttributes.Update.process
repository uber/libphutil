# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Define Variables
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

sCube = 'Operational PL Mapping';
nSiz = CUBEDIMENSIONCOUNTGET(sCube);

cRand = NUMBERTOSTRING(ROUND(RAND() * 100000));
cRand = FILL('0', 6 - LONG(cRand)) | cRand;
cRand = NUMBERTOSTRING(NOW()) | '.' | cRand;
cRandomIntA = cRand;

# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Create Source View
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

cViewName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | ' Source';
cSubsetName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | 'Source';

VIEWCREATE(sCube, cViewName, 1);

cnt = 1;

WHILE(cnt <= nSiz);

   sDim = TABDIM(sCube, cnt);

   IF(sDim @= 'Line of Business');
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, 'Delivery', 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, 'Mobility', 1);
      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ELSEIF(sDim @= 'Operational PL Mapping Measure');
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, 'TM1 Metric', 1);
      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ELSE;
      sMdx = EXPAND('{TM1FilterByLevel( {TM1SubsetAll([%sDim%].[%sDim%])}, 0) }');
      SUBSETCREATEBYMDX(cSubsetName, sMdx, 1);
      SUBSETMDXSET(sDim, cSubsetName, '');
      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ENDIF;

   cnt = cnt + 1;

END;


# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Zero out the FDS Attribute of Mobilty , Delivery and U4B Ops metrics before update
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

sMobCube = '}ElementAttributes_Mobility Ops Metrics';
sDelCube = '}ElementAttributes_Delivery Ops Metrics';
sU4BCube = '}ElementAttributes_U4B Ops Metrics';

TargetViewName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | ' Target';
TargetSubsetName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | ' Target';

#### Zero out FDS attribute of Mobility Ops metrics

VIEWCREATE(sMobCube, TargetViewName, 1);

sDim = 'Mobility Ops Metrics';
sMdx = EXPAND('{TM1FilterByLevel( {TM1SubsetAll([%sDim%].[%sDim%])}, 0) }');
SUBSETCREATEBYMDX(TargetSubsetName, sMdx, 1);
SUBSETMDXSET(sDim, TargetSubsetName, '');
VIEWSUBSETASSIGN(sMobCube, TargetViewName, sDim, TargetSubsetName);

sDim = '}ElementAttributes_Mobility Ops Metrics';
SUBSETCREATE(sDim, TargetSubsetName, 1);
SUBSETELEMENTINSERT(sDim, TargetSubsetName, 'FDS', 1);
VIEWSUBSETASSIGN(sMobCube, TargetViewName, sDim, TargetSubsetName);

VIEWZEROOUT(sMobCube, TargetViewName);

#### Zero out FDS attribute of Delivery Ops metrics

VIEWCREATE(sDelCube, TargetViewName, 1);

sDim = 'Delivery Ops Metrics';
sMdx = EXPAND('{TM1FilterByLevel( {TM1SubsetAll([%sDim%].[%sDim%])}, 0) }');
SUBSETCREATEBYMDX(TargetSubsetName, sMdx, 1);
SUBSETMDXSET(sDim, TargetSubsetName, '');
VIEWSUBSETASSIGN(sDelCube, TargetViewName, sDim, TargetSubsetName);

sDim = '}ElementAttributes_Delivery Ops Metrics';
SUBSETCREATE(sDim, TargetSubsetName, 1);
SUBSETELEMENTINSERT(sDim, TargetSubsetName, 'FDS', 1);
VIEWSUBSETASSIGN(sDelCube, TargetViewName, sDim, TargetSubsetName);

VIEWZEROOUT(sDelCube, TargetViewName);

#### Zero out FDS attribute of U4B Ops metrics

VIEWCREATE(sU4BCube, TargetViewName, 1);

sDim = 'U4B Ops Metrics';
sMdx = EXPAND('{TM1FilterByLevel( {TM1SubsetAll([%sDim%].[%sDim%])}, 0) }');
SUBSETCREATEBYMDX(TargetSubsetName, sMdx, 1);
SUBSETMDXSET(sDim, TargetSubsetName, '');
VIEWSUBSETASSIGN(sU4BCube, TargetViewName, sDim, TargetSubsetName);

sDim = '}ElementAttributes_U4B Ops Metrics';
SUBSETCREATE(sDim, TargetSubsetName, 1);
SUBSETELEMENTINSERT(sDim, TargetSubsetName, 'FDS', 1);
VIEWSUBSETASSIGN(sU4BCube, TargetViewName, sDim, TargetSubsetName);

VIEWZEROOUT(sU4BCube, TargetViewName);

# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Data source
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
cCube = 'Operational PL Mapping';

VIEWEXTRACTSKIPZEROESSET(cCube, cViewName, 1);
VIEWEXTRACTSKIPRULEVALUESSET(cCube, cViewName, 1);
VIEWEXTRACTSKIPCALCSSET(cCube, cViewName, 0);

DatasourceNameForServer = cCube;
DatasourceType = 'VIEW';
DatasourceCubeView = cViewName;
# ================= TAPTOOLS: START GENERATED CODE =================== #
nPrologProcedureEndTime = NOW();
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "' | DatasourceType | '"');
