# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROPERTIES                                                           #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
{
    "DataSource": {
        "Type": "None"
    },
    "HasSecurityAccess": false,
    "Name": "System.Dim.Sync Dimension",
    "Parameters": [
        {
            "Name": "pDimension",
            "Prompt": "REQ: Dimension Name",
            "Type": "String",
            "Value": "Currency"
        },
        {
            "Name": "pInstance",
            "Prompt": "REQ: Instance NameREQ: Instance Name",
            "Type": "String",
            "Value": "Analytics"
        },
        {
            "Name": "pIsInstance",
            "Prompt": "REQ: Instance Name As a Prefix",
            "Type": "Numeric",
            "Value": 0
        }
    ],
    "UIData": "CubeAction=1511\fDataAction=1503\fCubeLogChanges=0\f",
    "Variables": [],
    "VariablesUIData": []
}
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROPERTIES                                                             #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****



# ==================================================================== #
# Globals
# ==================================================================== #

cRand = NUMBERTOSTRING(ROUND(RAND() * 100000));
cRand = FILL('0', 6 - LONG(cRand)) | cRand;
cRand = NUMBERTOSTRING(NOW()) | '.' | cRand;
cProcess = GETPROCESSNAME();

cView = 'zzTemp' | '.' | cRand;
cSub = 'zzTemp' | '.' | cRand;

cPythonExe = CELLGETS('TAP System Info', 'Python Executable', 'Value');

cScriptRun = CELLGETS('TAP System Info', 'Scripts Shared Path', 'Value') | '/tap/' | 'system-dimension-sync.py';

cServer = CELLGETS('TAP Application Info', LOWER(EXPAND('%pInstance%')), 'Endpoint');
cPort = '443';

cDimension = TRIM(pDimension);
cPath = '/var/tm1/' | LOWER(EXPAND('%pInstance%')) | '/files/shared' | '/' | CELLGETS('TAP System Info', 'Service Name', 'Value');
IF(pIsInstance = 1);
   cFile = LOWER(EXPAND('%cProcess%_%pInstance%.%cDimension%.txt'));
ELSE;
   cFile = LOWER(EXPAND('%cProcess%_%cDimension%.txt'));
ENDIF;
cTemplateScriptRun = '%cPythonExe% "%cScriptRun%" --server="%cServer%" --port="%cPort%"  --dimension="%cDimension%" --path="%cPath%" --file="%cFile%" ';

cNow = NOW();

# ==================================================================== #
# Run Command
# ==================================================================== #

sCommand = EXPAND(cTemplateScriptRun);
EXECUTECOMMAND(sCommand, 1);

# ==================================================================== #
# Break if no file
# ==================================================================== #
sServiceName = CELLGETS('TAP System Info', 'Service Name', 'Value');
cPath = '/var/tm1/' | sServiceName | '/files/shared/' | sServiceName;
sFile = cPath | '/' | cFile;
IF(FILEEXISTS(sFile) = 0);
   PROCESSERROR();
ENDIF;

# ==================================================================== #
# Clear Data
# ==================================================================== #
IF(pIsInstance = 1);
   sDimension = TRIM(pInstance) | '.' | cDimension;
ELSE;
   sDimension = cDimension;
ENDIF;

sEleString = '';

sCube = '}ElementAttributes_' | sDimension;
sDim = sCube;

IF(CUBEEXISTS(sCube) = 1);
   CUBECLEARDATA(sCube);
ENDIF;

# ==================================================================== #
# Clear Existing Attributes, Load File
# ==================================================================== #

EXECUTEPROCESS('Bedrock.Dim.Import'
   , 'pSourceDir', cPath
   , 'pSourceFile', cFile
   , 'pDimension', sDimension
   , 'pDebug', 0
);


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: METADATA PROCEDURE                                                   #
