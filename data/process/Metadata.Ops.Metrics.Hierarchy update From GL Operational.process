#****End: Generated Statements****


nIndex = 1;
nLimit = ELCOMPN(pSourceDim, vElement);
WHILE(nIndex <= nLimit);
   sElName = ELCOMP(pSourceDim, vElement, nIndex);
   sDecendant = ELEMENTCOMPONENT(pSourceDim, '', vElement, nIndex);
