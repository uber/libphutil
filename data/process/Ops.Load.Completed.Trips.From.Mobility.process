# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Constants 
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

cCube = 'Mobility';
cTrgCube = 'Ops';
cVersion = pVersion;
cPeriod = SUBST(pStartDate, 1, 7);
cLOB = cCube;
cSource = 'FDS';
cOpsMetric = 'Completed Trips';

cRand = NUMBERTOSTRING(ROUND(RAND() * 100000));
cRand = FILL('0', 6 - LONG(cRand)) | cRand;
cRand = NUMBERTOSTRING(NOW()) | '.' | cRand;
cRandomIntA = cRand;

# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Process cancellation 
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

IF(DAYNO(SUBST(cPeriod, 1, 4) | '-' | SUBST(cPeriod, 6, 2) | '-' | '01') < 22705);
   PROCESSBREAK;
ENDIF;

# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Clear Target View 
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

sCube = cTrgCube;
nSiz = CUBEDIMENSIONCOUNTGET(sCube);

cViewTrg = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | ' Target';
cSubsetTrg = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | ' Target';

VIEWCREATE(sCube, cViewTrg, 1);

cnt = 1;

WHILE(cnt <= nSiz);

   sDim = TABDIM(sCube, cnt);

   IF(sDim @= 'Period');
      SUBSETCREATE(sDim, cSubsetTrg, 1);

      # Month 
      sPeriod = SUBST(pStartDate, 1, 7);
      nLoopCounter = 1;
      WHILE(ATTRN(sDim, sPeriod, 'Start of Period') <= ATTRN(sDim, SUBST(pEndDate, 1, 7), 'Start of Period'));
         SUBSETELEMENTINSERT(sDim, cSubsetTrg, sPeriod, 1);
         sPeriod = ATTRS(sDim, sPeriod, 'Next Period');
         nLoopCounter = nLoopCounter + 1;
         IF(sPeriod @= '' % nLoopCounter > 120);
            LOGOUTPUT('ERROR', 'Period + 1 attribute value is setup incorrectly in Period dimension. Please check');
            PROCESSQUIT;
         ENDIF;
      END;


      # Week 
      nPeriod = DAYNO(SUBST(pStartDate, 1, 10));
      nEndPeriod = DAYNO(SUBST(pEndDate, 1, 10));

      WHILE(nPeriod <= nEndPeriod);
         sDay = DATE(nPeriod, 1);
         nPar = ELPARN(sDim, sDay);
         cnt = 1;
         WHILE(cnt <= nPar);
            sPar = ELPAR(sDim, sDay, cnt);
            IF(ELISANC(sDim, 'Total Time - Week Day', sPar) = 1);
               sWeek = 'WS ' | SUBST(sPar, 4, 10);
               SUBSETELEMENTINSERT(sDim, cSubsetTrg, sWeek, 1);
            ENDIF;
            cnt = cnt + 1;
         END;
         nPeriod = DAYNO(SUBST(ATTRS(sDim, sWeek, 'Next Period'), 4, 10));
      END;

      VIEWSUBSETASSIGN(sCube, cViewTrg, sDim, cSubsetTrg);

   ELSEIF(sDim @= 'Ops Measure');
      SUBSETCREATE(sDim, cSubsetTrg, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetTrg, 'Amount', 1);
      VIEWSUBSETASSIGN(sCube, cViewTrg, sDim, cSubsetTrg);

   ELSEIF(sDim @= 'Ops Metric');
      SUBSETCREATE(sDim, cSubsetTrg, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetTrg, cOpsMetric, 1);
      VIEWSUBSETASSIGN(sCube, cViewTrg, sDim, cSubsetTrg);

   ELSEIF(sDim @= 'Version');
      SUBSETCREATE(sDim, cSubsetTrg, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetTrg, cVersion, 1);
      VIEWSUBSETASSIGN(sCube, cViewTrg, sDim, cSubsetTrg);

   ELSEIF(sDim @= 'Line of Business');
      sMdx = '{TM1FILTERBYLEVEL({TM1DRILLDOWNMEMBER( {[Line of Business].[' | cLob | ']} , ALL, RECURSIVE)},0)}';
      SUBSETCREATEBYMDX(cSubsetTrg, sMdx, 1);
      SUBSETMDXSET(sDim, cSubsetTrg, '');
      VIEWSUBSETASSIGN(sCube, cViewTrg, sDim, cSubsetTrg);

   ELSEIF(sDim @= 'Location');
      sMdx = '{TM1FILTERBYLEVEL({TM1DRILLDOWNMEMBER( {[Location].[Total Location Incl Discontinued]} , ALL, RECURSIVE)},0)}';
      SUBSETCREATEBYMDX(cSubsetTrg, sMdx, 1);
      SUBSETMDXSET(sDim, cSubsetTrg, '');
      VIEWSUBSETASSIGN(sCube, cViewTrg, sDim, cSubsetTrg);

   ELSEIF(sDim @= 'Source');
      SUBSETCREATE(sDim, cSubsetTrg, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetTrg, cSource, 1);
      VIEWSUBSETASSIGN(sCube, cViewTrg, sDim, cSubsetTrg);

   ELSE;
      sMdx = EXPAND('{TM1FilterByLevel( {TM1SubsetAll([%sDim%].[%sDim%])}, 0) }');
      SUBSETCREATEBYMDX(cSubsetTrg, sMdx, 1);
      SUBSETMDXSET(sDim, cSubsetTrg, '');
      VIEWSUBSETASSIGN(sCube, cViewTrg, sDim, cSubsetTrg);

   ENDIF;

   cnt = cnt + 1;
END;

# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Create Source View
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
sCube = cCube;
nSiz = CUBEDIMENSIONCOUNTGET(sCube);

cViewSrc = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | ' Source';
cSubsetSrc = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | ' Source';

VIEWCREATE(sCube, cViewSrc, 1);

cnt = 1;

WHILE(cnt <= nSiz);

   sDim = TABDIM(sCube, cnt);

   IF(sDim @= 'Period');
      SUBSETCREATE(sDim, cSubsetSrc, 1);

      # Month 
      sPeriod = SUBST(pStartDate, 1, 7);
      nLoopCounter = 1;
      WHILE(ATTRN(sDim, sPeriod, 'Start of Period') <= ATTRN(sDim, SUBST(pEndDate, 1, 7), 'Start of Period'));
         SUBSETELEMENTINSERT(sDim, cSubsetSrc, sPeriod, 1);
         sPeriod = ATTRS(sDim, sPeriod, 'Next Period');
         nLoopCounter = nLoopCounter + 1;
         IF(sPeriod @= '' % nLoopCounter > 120);
            LOGOUTPUT('ERROR', 'Period + 1 attribute value is setup incorrectly in Period dimension. Please check');
            PROCESSQUIT;
         ENDIF;
      END;

      # Week 
      nPeriod = DAYNO(SUBST(pStartDate, 1, 10));
      nEndPeriod = DAYNO(SUBST(pEndDate, 1, 10));

      WHILE(nPeriod <= nEndPeriod);
         sDay = DATE(nPeriod, 1);
         nPar = ELPARN(sDim, sDay);
         cnt = 1;
         WHILE(cnt <= nPar);
            sPar = ELPAR(sDim, sDay, cnt);
            IF(ELISANC(sDim, 'Total Time - Week Day', sPar) = 1);
               sWeek = 'WS ' | SUBST(sPar, 4, 10);
               SUBSETELEMENTINSERT(sDim, cSubsetSrc, sWeek, 1);
            ENDIF;
            cnt = cnt + 1;
         END;
         nPeriod = DAYNO(SUBST(ATTRS(sDim, sWeek, 'Next Period'), 4, 10));
      END;

      VIEWSUBSETASSIGN(sCube, cViewSrc, sDim, cSubsetSrc);

   ELSEIF(sDim @= cCube | ' Measure');
      SUBSETCREATE(sDim, cSubsetSrc, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetSrc, 'Amount', 1);
      VIEWSUBSETASSIGN(sCube, cViewSrc, sDim, cSubsetSrc);

   ELSEIF(sDim @= cCube | ' Ops Metrics');
      SUBSETCREATE(sDim, cSubsetSrc, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetSrc, cOpsMetric, 1);
      VIEWSUBSETASSIGN(sCube, cViewSrc, sDim, cSubsetSrc);

   ELSEIF(sDim @= 'Version');
      SUBSETCREATE(sDim, cSubsetSrc, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetSrc, cVersion, 1);
      VIEWSUBSETASSIGN(sCube, cViewSrc, sDim, cSubsetSrc);

   ELSEIF(sDim @= 'Line of Business');
      sMdx = '{TM1FILTERBYLEVEL({TM1DRILLDOWNMEMBER( {[Line of Business].[' | cLob | ']} , ALL, RECURSIVE)},0)}';
      SUBSETCREATEBYMDX(cSubsetSrc, sMdx, 1);
      SUBSETMDXSET(sDim, cSubsetSrc, '');
      VIEWSUBSETASSIGN(sCube, cViewSrc, sDim, cSubsetSrc);

   ELSEIF(sDim @= 'Location');
      sMdx = '{TM1FILTERBYLEVEL({TM1DRILLDOWNMEMBER( {[Location].[Total Location Incl Discontinued]} , ALL, RECURSIVE)},0)}';
      SUBSETCREATEBYMDX(cSubsetSrc, sMdx, 1);
      SUBSETMDXSET(sDim, cSubsetSrc, '');
      VIEWSUBSETASSIGN(sCube, cViewSrc, sDim, cSubsetSrc);

   ELSEIF(sDim @= 'Department');
      sMdx = '{TM1FILTERBYLEVEL({TM1DRILLDOWNMEMBER( {[Department].[Total Org]} , ALL, RECURSIVE)},0)}';
      SUBSETCREATEBYMDX(cSubsetSrc, sMdx, 1);
      SUBSETMDXSET(sDim, cSubsetSrc, '');
      VIEWSUBSETASSIGN(sCube, cViewSrc, sDim, cSubsetSrc);

   ELSEIF(sDim @= 'Source');
      SUBSETCREATE(sDim, cSubsetSrc, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetSrc, cSource, 1);
      VIEWSUBSETASSIGN(sCube, cViewSrc, sDim, cSubsetSrc);

   ELSE;
      sMdx = EXPAND('{TM1FilterByLevel( {TM1SubsetAll([%sDim%].[%sDim%])}, 0) }');
      SUBSETCREATEBYMDX(cSubsetSrc, sMdx, 1);
      SUBSETMDXSET(sDim, cSubsetSrc, '');
      VIEWSUBSETASSIGN(sCube, cViewSrc, sDim, cSubsetSrc);


   ENDIF;

   cnt = cnt + 1;
END;

# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Clear Target View
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

VIEWZEROOUT(cTrgCube, cViewTrg);

# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Data source
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

VIEWEXTRACTSKIPZEROESSET(cCube, cViewSrc, 1);
VIEWEXTRACTSKIPRULEVALUESSET(cCube, cViewSrc, 1);
VIEWEXTRACTSKIPCALCSSET(cCube, cViewSrc, 1);

DatasourceNameForServer = cCube;
DatasourceType = 'VIEW';
DatasourceCubeView = cViewSrc;
# ================= TAPTOOLS: START GENERATED CODE =================== #
nPrologProcedureEndTime = NOW();
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "' | DatasourceType | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceNameForServer: "' | DatasourceNameForServer | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceCubeView: "' | DatasourceCubeView | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceDimensionSubset: "' | DatasourceDimensionSubset | '"');
LOGOUTPUT('DEBUG', 'PROGRESS: END PROLOG PROCEDURE');
