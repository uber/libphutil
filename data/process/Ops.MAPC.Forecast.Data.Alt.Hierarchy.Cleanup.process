###### Deduped Forecast Data Cleanup #################################################################################

# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #
CELLPUTN(0, 'MAPC', vVersion, vPeriod, 'Planning', vRateType, 'CustomLeaf:' | vLocation | ' Input', '1001', 'Unspecified Product Type', vMetric, 'Amount');
# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #
CELLPUTN(0, 'MAPC', vVersion, vPeriod, 'Planning', vRateType, 'CustomLeaf:' | vLocation | ' Input', '2001', 'Unspecified Product Type', vMetric, 'Amount');
# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #
CELLPUTN(0, 'MAPC', vVersion, vPeriod, 'Planning', vRateType, 'CustomLeaf:' | vLocation | ' Input', 'CustomLeaf:Total Rides & Eats Input', 'Unspecified Product Type', vMetric, 'Amount');

# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsCompleted = nDataProcedureRecordsCompleted + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
