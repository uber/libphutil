   nPrologProcedureEndTime = NOW();
ENDIF;
IF(nMetadataProcedureStartTime > 0 & nMetadataProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: END METADATA PROCEDURE');
   nMetadataProcedureEndTime = NOW();
ENDIF;
IF(nDataProcedureStartTime > 0 & nDataProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: END DATA PROCEDURE');
   nDataProcedureEndTime = NOW();
ENDIF;
