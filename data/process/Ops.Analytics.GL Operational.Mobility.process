# ================= TAPTOOLS: START GENERATED CODE =================== #
sProcessName = GETPROCESSNAME();
IF(sProcessName @<> 'TAP.Call.Queue.Add Job To Queue' & sProcessName @<> 'TAP.CubeSaveData' & sProcessName @<> 'TAP.Call.Save' & sProcessName @<> 'TAP.Call.Save.Wrapper' & sProcessName @<> 'TAP.Call.CubeSaveData.Wrapper' & sProcessName @<> 'TAP.Call.Tests' & sProcessName @<> 'TAP.Call.Init' & sProcessName @<> 'TAP.Call.Export Application Stats' & sProcessName @<> 'TAP.Cube.Export Data to File' & SCAN('}drill', LOWER(sProcessName)) = 0);
   sSDA.Status = CELLGETS('TAP System Info', 'Block Process Execution', 'Value');
   IF(sSDA.Status @= 'Yes');
      PROCESSBREAK;
   ENDIF;
ENDIF;
LOGOUTPUT('DEBUG', 'PARAMETER: pMonth: "' | pMonth | '"');
LOGOUTPUT('DEBUG', 'PARAMETER: pLob: "' | pLob | '"');
LOGOUTPUT('DEBUG', 'PARAMETER: pRateType: "' | pRateType | '"');
LOGOUTPUT('DEBUG', 'PROGRESS: START PROLOG PROCEDURE');
nMetadataProcedureRecordsStarted = 0;
nMetadataProcedureRecordsSkipped = 0;
nMetadataProcedureRecordsRejected = 0;
nMetadataProcedureRecordsCompleted = 0;
nDataProcedureRecordsStarted = 0;
nDataProcedureRecordsSkipped = 0;
nDataProcedureRecordsRejected = 0;
nDataProcedureRecordsCompleted = 0;
nPrologProcedureDataOperations = 0;
nDataProcedureDataOperations = 0;
nTotalDataOperations = 0;
nPrologProcedureMetadataOperations = 0;
nMetadataProcedureMetadataOperations = 0;
nDataProcedureMetadataOperations = 0;
nEpilogProcedureMetadataOperations = 0;
nTotalProcedureMetadataOperations = 0;
nPrologProcedureStartTime = NOW();
nPrologProcedureEndTime = 0;
nMetadataProcedureStartTime = 0;
nMetadataProcedureEndTime = 0;
nDataProcedureStartTime = 0;
nDataProcedureEndTime = 0;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****




sCube = 'Analytics.GL Operational';
nSiz = CUBEDIMENSIONCOUNTGET(sCube);

cRand = NUMBERTOSTRING(ROUND(RAND() * 100000));
cRand = FILL('0', 6 - LONG(cRand)) | cRand;
cRand = NUMBERTOSTRING(NOW()) | '.' | cRand;
cRandomIntA = cRand;

# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Create Source View
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

cViewName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | ' Source';
cSubsetName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | 'Source';

VIEWCREATE(sCube, cViewName, 1);


cnt = 1;

WHILE(cnt <= nSiz);

   sDim = TABDIM(sCube, cnt);

   IF(sDim @= 'Analytics.Line of Business');
      sMdx = '{TM1FILTERBYLEVEL({TM1DRILLDOWNMEMBER( {[Analytics.Line of Business].[' | pLob | ']} , ALL, RECURSIVE)},0)}';
      SUBSETCREATEBYMDX(cSubsetName, sMdx, 1);
      SUBSETMDXSET(sDim, cSubsetName, '');
      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ELSEIF(sDim @= 'Analytics.Month');
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, pMonth, 1);
      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ELSEIF(sDim @= 'Analytics.Version');
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, 'Actual', 1);
      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ELSEIF(sDim @= 'Analytics.Source');
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, 'Total External Excl Sig Adj', 1);
      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ELSEIF(sDim @= 'Analytics.Account');
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, 'Ops P&L', 1);
      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ELSEIF(sDim @= 'ANALYTICS.Location');
      sMdx = '{TM1FILTERBYLEVEL({TM1DRILLDOWNMEMBER( {[ANALYTICS.Location].[Total Location Incl Discontinued]} , ALL, RECURSIVE)},0)}';
      SUBSETCREATEBYMDX(cSubsetName, sMdx, 1);
      SUBSETMDXSET(sDim, cSubsetName, '');
      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ELSEIF(sDim @= 'ANALYTICS.Department');
      sMdx = '{TM1FILTERBYLEVEL({TM1DRILLDOWNMEMBER( {[ANALYTICS.Department].[Total Department]} , ALL, RECURSIVE)},0)}';
      SUBSETCREATEBYMDX(cSubsetName, sMdx, 1);
      SUBSETMDXSET(sDim, cSubsetName, '');
      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ELSEIF(sDim @= 'Analytics.Product Type');
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, 'Total Product Type', 1);
      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ELSEIF(sDim @= 'Analytics.GL Operational Measure');
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, 'Amount', 1);
      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ELSEIF(sDim @= 'Analytics.Rate Type');
      SUBSETCREATE(sDim, cSubsetName, 1);
      nCurr = 1;
      nPos = 1;
      nMax = LONG(pRateType);

      WHILE(nCurr <= nMax);
         IF(SUBST(pRatetype, nCurr, 1) @= '|');
            sRateType = SUBST(pRateType, nPos, (nCurr - nPos));
            sElem = TRIM(sRateType);
            SUBSETELEMENTINSERT(sDim, cSubsetName, sElem, 1);
            nPos = nCurr + 1;
         ENDIF;
         nCurr = nCurr + 1;
      END;

      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ELSE;
      sMdx = EXPAND('{TM1FilterByLevel( {TM1SubsetAll([%sDim%].[%sDim%])}, 0) }');
      SUBSETCREATEBYMDX(cSubsetName, sMdx, 1);
      SUBSETMDXSET(sDim, cSubsetName, '');
      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ENDIF;

   cnt = cnt + 1;

END;


# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Create Target View
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
sCube = 'Mobility';
nSiz = CUBEDIMENSIONCOUNTGET(sCube);

cViewTar = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | ' Target';
cSubsetTar = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | ' Target';

VIEWCREATE(sCube, cViewTar, 1);

cnt = 1;

WHILE(cnt <= nSiz);

   sDim = TABDIM(sCube, cnt);

   IF(sDim @= 'Period');
      SUBSETCREATE(sDim, cSubsetTar, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetTar, pMonth, 1);
      VIEWSUBSETASSIGN(sCube, cViewTar, sDim, cSubsetTar);

   ELSEIF(sDim @= 'Mobility Measure');
      SUBSETCREATE(sDim, cSubsetTar, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetTar, 'Amount', 1);
      VIEWSUBSETASSIGN(sCube, cViewTar, sDim, cSubsetTar);

   ELSEIF(sDim @= 'Version');
      SUBSETCREATE(sDim, cSubsetTar, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetTar, 'Actual', 1);
      VIEWSUBSETASSIGN(sCube, cViewTar, sDim, cSubsetTar);

   ELSEIF(sDim @= 'Line of Business');
      sMdx = '{TM1FILTERBYLEVEL({TM1DRILLDOWNMEMBER( {[Line of Business].[' | pLob | ']} , ALL, RECURSIVE)},0)}';
      SUBSETCREATEBYMDX(cSubsetTar, sMdx, 1);
      SUBSETMDXSET(sDim, cSubsetTar, '');
      VIEWSUBSETASSIGN(sCube, cViewTar, sDim, cSubsetTar);

   ELSEIF(sDim @= 'Source');
      SUBSETCREATE(sDim, cSubsetTar, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetTar, 'Oracle', 1);
      VIEWSUBSETASSIGN(sCube, cViewTar, sDim, cSubsetTar);

   ELSEIF(sDim @= 'Product Type');
      SUBSETCREATE(sDim, cSubsetTar, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetTar, 'Unspecified product type', 1);
      VIEWSUBSETASSIGN(sCube, cViewTar, sDim, cSubsetTar);

   ELSEIF(sDim @= 'Moblity Features');
      SUBSETCREATE(sDim, cSubsetTar, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetTar, 'Unspecified Mobility Features', 1);
      VIEWSUBSETASSIGN(sCube, cViewTar, sDim, cSubsetTar);

   ELSEIF(sDim @= 'Rate Type');
      SUBSETCREATE(sDim, cSubsetTar, 1);

      nCurr = 1;
      nPos = 1;
      nMax = LONG(pRateType);

      WHILE(nCurr <= nMax);
         IF(SUBST(pRateType, nCurr, 1) @= '|');
            sRateType = SUBST(pRateType, nPos, (nCurr - nPos));
            sElem = TRIM(sRateType);
            SUBSETELEMENTINSERT(sDim, cSubsetTar, sElem, 1);
            nPos = nCurr + 1;
         ENDIF;
         nCurr = nCurr + 1;
      END;

      VIEWSUBSETASSIGN(sCube, cViewTar, sDim, cSubsetTar);


   ELSE;
      sMdx = EXPAND('{TM1FilterByLevel( {TM1SubsetAll([%sDim%].[%sDim%])}, 0) }');
      SUBSETCREATEBYMDX(cSubsetTar, sMdx, 1);
      SUBSETMDXSET(sDim, cSubsetTar, '');
      VIEWSUBSETASSIGN(sCube, cViewTar, sDim, cSubsetTar);


   ENDIF;

   cnt = cnt + 1;
END;




# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Clear Target View
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

VIEWZEROOUT(sCube, cViewTar);

# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Data source
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
cCube = 'Analytics.GL Operational';

VIEWEXTRACTSKIPZEROESSET(cCube, cViewName, 1);
VIEWEXTRACTSKIPRULEVALUESSET(cCube, cViewName, 1);
VIEWEXTRACTSKIPCALCSSET(cCube, cViewName, 0);

DatasourceNameForServer = cCube;
DatasourceType = 'VIEW';
DatasourceCubeView = cViewName;
# ================= TAPTOOLS: START GENERATED CODE =================== #
nPrologProcedureEndTime = NOW();
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "' | DatasourceType | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceNameForServer: "' | DatasourceNameForServer | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceCubeView: "' | DatasourceCubeView | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceDimensionSubset: "' | DatasourceDimensionSubset | '"');
LOGOUTPUT('DEBUG', 'PROGRESS: END PROLOG PROCEDURE');
# ================= TAPTOOLS: END GENERATED CODE ===================== #

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
