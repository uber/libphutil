# ================= TAPTOOLS: START GENERATED CODE =================== #
nMetadataProcedureRecordsStarted = nMetadataProcedureRecordsStarted + 1;
IF(nMetadataProcedureStartTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: START METADATA PROCEDURE');
   nMetadataProcedureStartTime = NOW();
ENDIF;
# ================= TAPTOOLS: END GENERATED CODE ===================== #
#****Begin: Generated Statements***
#****End: Generated Statements****

nIndex = 1;
nLimit = ELCOMPN(pSourceDim, vElement);
IF(DIMIX(pTargetDim, vElement) = 0);
   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nMetadataProcedureMetadataOperations = nMetadataProcedureMetadataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   DIMENSIONELEMENTINSERT(pTargetDim, '', vElement, 'C');
ENDIF;
WHILE(nIndex <= nLimit);
   sElName = ELCOMP(pSourceDim, vElement, nIndex);
   sDecendant = ELEMENTCOMPONENT(pSourceDim, '', vElement, nIndex);
   eleName = sDecendant;
   nElWeight = ELWEIGHT(pSourceDim, vElement, sDecendant);
   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nMetadataProcedureMetadataOperations = nMetadataProcedureMetadataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   DIMENSIONELEMENTCOMPONENTADD(pTargetDim, vElement, eleName, nElWeight);
   nIndex = nIndex + 1;
END;
# ================= TAPTOOLS: START GENERATED CODE =================== #
nMetadataProcedureRecordsCompleted = nMetadataProcedureRecordsCompleted + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
