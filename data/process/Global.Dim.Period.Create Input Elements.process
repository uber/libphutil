# BEGIN: PROPERTIES                                                           #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
{
    "DataSource": {
        "Type": "None"
    },
    "HasSecurityAccess": false,
    "Name": "Global.Dim.Period.Create Input Elements",
    "Parameters": [
        {
            "Name": "pTapQueueAdd",
            "Prompt": "OPT: Queue Enable (Y or N)",
            "Type": "String",
            "Value": ""
        },
        {
            "Name": "pTapQueueGroupId",
            "Prompt": "OPT: Queue Job ID (Unique)",
            "Type": "String",
            "Value": ""
        },
        {
            "Name": "pTapQueueJobId",
            "Prompt": "OPT: Queue Group ID (Shared)",
            "Type": "String",
            "Value": ""
        },
        {
            "Name": "pTapQueuePriority",
            "Prompt": "OPT: Queue Priority -100 to 100 (Priority)",
            "Type": "String",
            "Value": ""
        },
        {
            "Name": "pEndYear",
            "Prompt": "",
            "Type": "String",
            "Value": ""
        }
    ],
    "UIData": "CubeAction=1511\fDataAction=1503\fCubeLogChanges=0\f",
    "Variables": [],
    "VariablesUIData": []
}
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROPERTIES                                                             #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# ==================================================================== #
# Globals
# ==================================================================== #

cDim = 'Period';

cYearStart = '2010';
cYearEnd = pEndYear;

cPrefix = '';

# ==================================================================== #
# Create Month Elements
# ==================================================================== #

sDim = cDim;

i = DAYNO(EXPAND('%cYearStart%-01-01'));
nEnd = DAYNO(EXPAND('%cYearEnd%-12-31'));
WHILE(i <= nEnd);
   sEle = cPrefix | TIMST(i, '\Y-\m', 0);
   DIMENSIONELEMENTINSERT(sDim, '', sEle, 'N');
   i = i + 1;
END;

# ==================================================================== #
# Create Day Elements
# ==================================================================== #

i = DAYNO(EXPAND('%cYearStart%-01-01'));
nEnd = DAYNO(EXPAND('%cYearEnd%-12-31'));
WHILE(i <= nEnd);
   sEle = cPrefix | TIMST(i, '\Y-\m-\d', 0);
   IF(DIMIX('cDim',sEle)=0);
   	DIMENSIONELEMENTINSERT(sDim, '', sEle, 'N');
   ENDIF;
   i = i + 1;
END;



# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
