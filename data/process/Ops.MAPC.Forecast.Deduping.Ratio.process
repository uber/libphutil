# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
# MAPC Forecast Deduping - Ratio Calculation
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

# Summary: This Process calculates the deduping ratio, L3M and Undeduping Ratio at Location and LOb dimension Combination

# ==================================================================== #
# Globals
# ==================================================================== #

DatasourceASCIIQuoteCharacter = '';

cMonth = TRIM(pPeriod);
cMetric = TRIM(pMetric);

cRand = NUMBERTOSTRING(ROUND(RAND() * 100000));
cRand = FILL('0', 6 - LONG(cRand)) | cRand;
cRand = NUMBERTOSTRING(NOW()) | '.' | cRand;
cRandomIntA = cRand;
sCube = 'MAPC';


# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Create Source View
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

nSiz = CUBEDIMENSIONCOUNTGET(sCube);

cViewSrc = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | ' Source';
cSubsetSrc = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | ' Source';
VIEWCREATE(sCube, cViewSrc, 1);
nDimcount = 1;

WHILE(nDimcount <= nSiz);

   sDim = TABDIM(sCube, nDimcount);

   IF(sDim @= 'Period');
      SUBSETCREATE(sDim, cSubsetSrc, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetSrc, pPeriod, 1);
      VIEWSUBSETASSIGN(sCube, cViewSrc, sDim, cSubsetSrc);

   ELSEIF(sDim @= 'MAPC Measure');
      SUBSETCREATE(sDim, cSubsetSrc, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetSrc, 'Amount', 1);
      VIEWSUBSETASSIGN(sCube, cViewSrc, sDim, cSubsetSrc);

   ELSEIF(sDim @= 'Ops Metric');
      SUBSETCREATE(sDim, cSubsetSrc, 1);
      nCurr = 1;
      nPos = 1;
      nMax = LONG(pMetric);

      WHILE(nCurr <= nMax);
         IF(SUBST(pMetric, nCurr, 1) @= '|');
            sMetric = SUBST(pMetric, nPos, (nCurr - nPos));
            sElem = TRIM(sMetric);
            SUBSETELEMENTINSERT(sDim, cSubsetSrc, sElem, 1);
            nPos = nCurr + 1;
         ENDIF;
         nCurr = nCurr + 1;
      END;

      VIEWSUBSETASSIGN(sCube, cViewSrc, sDim, cSubsetSrc);

   ELSEIF(sDim @= 'Version');
      SUBSETCREATE(sDim, cSubsetSrc, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetSrc, pVersion, 1);
      VIEWSUBSETASSIGN(sCube, cViewSrc, sDim, cSubsetSrc);

   ELSEIF(sDim @= 'Product Type');
      SUBSETCREATE(sDim, cSubsetSrc, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetSrc, 'Unspecified Product Type', 1);
      VIEWSUBSETASSIGN(sCube, cViewSrc, sDim, cSubsetSrc);

   ELSEIF(sDim @= 'Rate Type');
      SUBSETCREATE(sDim, cSubsetSrc, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetSrc, 'USD', 1);
      VIEWSUBSETASSIGN(sCube, cViewSrc, sDim, cSubsetSrc);

   ELSEIF(sDim @= 'Line of Business');
      SUBSETCREATE(sDim, cSubsetSrc, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetSrc, 'Total Rides & Eats', 1);
      IF(SCAN('Country - ', pCountry) = 0);
         SUBSETELEMENTINSERT(sDim, cSubsetSrc, '1001', 2);
         SUBSETELEMENTINSERT(sDim, cSubsetSrc, '2001', 3);
      ENDIF;
      VIEWSUBSETASSIGN(sCube, cViewSrc, sDim, cSubsetSrc);

   ELSEIF(sDim @= 'Location');
      SUBSETCREATE(sDim, cSubsetSrc, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetSrc, pCountry, 1);
      VIEWSUBSETASSIGN(sCube, cViewSrc, sDim, cSubsetSrc);

   ELSEIF(sDim @= 'Source');
      SUBSETCREATE(sDim, cSubsetSrc, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetSrc, 'FDS', 1);
      VIEWSUBSETASSIGN(sCube, cViewSrc, sDim, cSubsetSrc);

   ELSE;
      sMdx = EXPAND('{TM1FilterByLevel( {TM1SubsetAll([%sDim%].[%sDim%])}, 0) }');
      SUBSETCREATEBYMDX(cSubsetSrc, sMdx, 1);
      SUBSETMDXSET(sDim, cSubsetSrc, '');
      VIEWSUBSETASSIGN(sCube, cViewSrc, sDim, cSubsetSrc);
   ENDIF;

   nDimcount = nDimcount + 1;
END;


# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Data source
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

VIEWEXTRACTSKIPZEROESSET(SCube, cViewSrc, 0);
VIEWEXTRACTSKIPRULEVALUESSET(SCube, cViewSrc, 0);
VIEWEXTRACTSKIPCALCSSET(sCube, cViewSrc, 0);

DatasourceNameForServer = sCube;
DatasourceType = 'VIEW';
DatasourceCubeView = cViewSrc;


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: METADATA PROCEDURE                                                   #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****






# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: METADATA PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

##### Define at which granularity of LOB the data needs to be Placed in Cube ######################################################

IF(ELLEV('Line of Business', vLOB) = 0);
   sLOB = vLOB;
ELSE;
   sLOB = 'CustomLeaf:Total Rides & Eats Input';
ENDIF;

##### Define at which granularity of Product Type the deduped data need to be taken from Ops cube ######################################################

IF(vLOB @= '2001');
   sProductType = 'EATS';
ELSEIF(vLOB @= '1001');
   sProductType = 'Not Specified';
ENDIF;

##### Deduping Ratio Calculation for Total Rides and Eats Input ########################################################


IF(ELLEV('Line of Business', vLOB) > 0);

   ####Deduping Ratio computation for country Total Rides and Eats

   sDedupedValue = CELLGETN('Ops', vVersion, vPeriod, 'Total Source', vRateType, vLocation, vLOB, 'Not Specified', vMetric, 'Amount');
   s1001Dedupedvalue = CELLGETN('Ops', vVersion, vPeriod, 'Total Source', vRateType, 'CustomLeaf:' | vLocation | ' Input', '1001', 'Not Specified', vMetric, 'Amount');
   s2001DedupedValue = CELLGETN('Ops', vVersion, vPeriod, 'Total Source', vRateType, 'CustomLeaf:' | vLocation | ' Input', '2001', 'EATS', vMetric, 'Amount');
   sLOBDedupedvalue = s1001Dedupedvalue + s2001DedupedValue;

   sDedupedRatio = 1 - (sDedupedValue \ sLOBDedupedvalue);
   IF(sDedupedRatio < 0);
      sDedupedRatio = 0;
   ENDIF;

   CELLPUTN(sDedupedRatio, 'MAPC', vVersion, vPeriod, 'FDS', vRateType, 'CustomLeaf:' | vLocation | ' Input', 'CustomLeaf:Total Rides & Eats Input', 'Unspecified Product Type', vMetric, 'Deduped Ratio');

ELSE;

   ####Deduping Ratio computation for Total Location, Mega Region 1001 and 2001
   sDedupedValue = CELLGETN('Ops', vVersion, vPeriod, 'Total Source', vRateType, 'CustomLeaf:' | vLocation | ' Input', vLOB, sProductType, vMetric, 'Amount');
   sFinalValue = CELLGETN('MAPC', vVersion, vPeriod, 'Total Source', vRateType, 'CustomLeaf:' | vLocation | ' Input', vLOB, 'Unspecified Product Type', vMetric, 'Amount');
   sDedupedRatio = 1 - (sDedupedValue \ sFinalValue);
   IF(sDedupedRatio < 0);
      sDedupedRatio = 0;
   ENDIF;
   CELLPUTN(sDedupedRatio, 'MAPC', vVersion, vPeriod, 'FDS', vRateType, 'CustomLeaf:' | vLocation | ' Input', vLOB, 'Unspecified Product Type', vMetric, 'Deduped Ratio');

ENDIF;

##### L3M Ratio Calculation based on average of current monthand previos 2 month ratios ################################################

sPrevMonth1 = ATTRS('Period', vPeriod, 'Period-1');
sDedupedRatio1 = CELLGETN('MAPC', vVersion, sPrevMonth1, 'Total Source', vRateType, 'CustomLeaf:' | vLocation | ' Input', sLOB, 'Unspecified Product Type', vMetric, 'Deduped Ratio');

sPrevMonth2 = ATTRS('Period', vPeriod, 'Period-2');
sDedupedRatio2 = CELLGETN('MAPC', vVersion, sPrevMonth2, 'Total Source', vRateType, 'CustomLeaf:' | vLocation | ' Input', sLOB, 'Unspecified Product Type', vMetric, 'Deduped Ratio');

sL3MRatio = (sDedupedRatio + sDedupedRatio1 + sDedupedRatio2) / 3;
CELLPUTN(sL3MRatio, 'MAPC', vVersion, vPeriod, 'FDS', vRateType, 'CustomLeaf:' | vLocation | ' Input', sLOB, 'Unspecified Product Type', vMetric, 'L3M Deduped Ratio');

#### UnDeduped Ratio From Deduped Ratio ###############
sUnDedupedRatio = 1 - sL3MRatio;

### Check if Undeduped ratio is zero, then mark it as 1 to ensure that the forecast data at consolidation still shows up when Actuals are zero ################

IF(sUnDedupedRatio = 0);
   sUndedupedRatio = 1;
ENDIF;

CELLPUTN(sUnDedupedRatio, 'MAPC', vVersion, vPeriod, 'FDS', vRateType, 'CustomLeaf:' | vLocation | ' Input', sLOB, 'Unspecified Product Type', vMetric, 'UnDedpued Ratio');

##Dummy indicator for feeding the deduping ratios
IF(SCAN('Country -', vLocation) > 0);
   sLeafcity = ELCOMP('Location', vLocation, ELCOMPN('Location', vLocation));
   sDummy = 0.0001;
   CELLPUTN(sDummy, 'MAPC', vVersion, vPeriod, 'FDS', vRateType, sLeafCity, '9004', 'Unspecified Product Type', vMetric, 'Deduped Ratio');
   CELLPUTN(sDummy, 'MAPC', vVersion, vPeriod, 'FDS', vRateType, sLeafCity, '9004', 'Unspecified Product Type', vMetric, 'L3M Deduped Ratio');
   CELLPUTN(sDummy, 'MAPC', vVersion, vPeriod, 'FDS', vRateType, sLeafCity, '9004', 'Unspecified Product Type', vMetric, 'UnDedpued Ratio');
ENDIF;


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
