# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #

#****Begin: Generated Statements***
#****End: Generated Statements****


sCube = 'Mobility';
nSiz = CUBEDIMENSIONCOUNTGET(sCube);

cRand = NUMBERTOSTRING(ROUND(RAND() * 100000));
cRand = FILL('0', 6 - LONG(cRand)) | cRand;
cRand = NUMBERTOSTRING(NOW()) | '.' | cRand;
cRandomIntA = cRand;

sMonth = SUBST(TODAY(1), 1, 7);
sPrevMonth = ATTRS('Period', sMonth, 'Period-1');

# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Create Source View
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

cViewName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | ' Source';
cSubsetName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | 'Source';

VIEWCREATE(sCube, cViewName, 1);

cnt = 1;

WHILE(cnt <= nSiz);

   sDim = TABDIM(sCube, cnt);

   IF(sDim @= 'Period');
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sMonth, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sPrevMonth, 1);
      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ELSEIF(sDim @= 'Mobility Measure');
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, 'Amount', 1);
      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ELSEIF(sDim @= 'Version');
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, 'Actual', 1);
      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ELSEIF(sDim @= 'Source');
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, 'FDS Incl. Adj', 1);
      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ELSEIF(sDim @= 'Mobility Ops Metrics');
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, 'Completed Trips', 1);
      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ELSE;
      sMdx = EXPAND('{TM1FilterByLevel( {TM1SubsetAll([%sDim%].[%sDim%])}, 0) }');
      SUBSETCREATEBYMDX(cSubsetName, sMdx, 1);
      SUBSETMDXSET(sDim, cSubsetName, '');
      VIEWSUBSETASSIGN(sCube, cViewName, sDim, cSubsetName);

   ENDIF;

   cnt = cnt + 1;

END;


# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Create Target View
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

cViewTar = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | ' Target';
cSubsetTar = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | ' Target';

VIEWCREATE(sCube, cViewTar, 1);

cnt = 1;

WHILE(cnt <= nSiz);

   sDim = TABDIM(sCube, cnt);

   IF(sDim @= 'Period');
      SUBSETCREATE(sDim, cSubsetTar, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetTar, sMonth, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetTar, sPrevMonth, 1);
      VIEWSUBSETASSIGN(sCube, cViewTar, sDim, cSubsetTar);

   ELSEIF(sDim @= 'Mobility Measure');
      SUBSETCREATE(sDim, cSubsetTar, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetTar, 'Amount', 1);
      VIEWSUBSETASSIGN(sCube, cViewTar, sDim, cSubsetTar);

   ELSEIF(sDim @= 'Version');
      SUBSETCREATE(sDim, cSubsetTar, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetTar, 'Actual', 1);
      VIEWSUBSETASSIGN(sCube, cViewTar, sDim, cSubsetTar);

   ELSEIF(sDim @= 'Source');
      SUBSETCREATE(sDim, cSubsetTar, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetTar, 'Product PL', 1);
      VIEWSUBSETASSIGN(sCube, cViewTar, sDim, cSubsetTar);

   ELSEIF(sDim @= 'Mobility Ops Metrics');
      SUBSETCREATE(sDim, cSubsetTar, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetTar, 'Completed Trips', 1);
      VIEWSUBSETASSIGN(sCube, cViewTar, sDim, cSubsetTar);

   ELSE;
      sMdx = EXPAND('{TM1FilterByLevel( {TM1SubsetAll([%sDim%].[%sDim%])}, 0) }');
      SUBSETCREATEBYMDX(cSubsetTar, sMdx, 1);
      SUBSETMDXSET(sDim, cSubsetTar, '');
      VIEWSUBSETASSIGN(sCube, cViewTar, sDim, cSubsetTar);

   ENDIF;

   cnt = cnt + 1;
END;




# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Clear Target View
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

VIEWZEROOUT(sCube, cViewTar);

# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Data source
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#


VIEWEXTRACTSKIPZEROESSET(sCube, cViewName, 1);
VIEWEXTRACTSKIPRULEVALUESSET(sCube, cViewName, 1);
VIEWEXTRACTSKIPCALCSSET(sCube, cViewName, 0);

DatasourceNameForServer = sCube;
DatasourceType = 'VIEW';
DatasourceCubeView = cViewName;


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: METADATA PROCEDURE                                                   #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: METADATA PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


CELLPUTN(vValue, sCube, vVersion, vPeriod, 'Product PL', vRateType, vLob, vdept, vLoc, vProduct, vfeature, 'Completed Trips', 'Amount');




# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
