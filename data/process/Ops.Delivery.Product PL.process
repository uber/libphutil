###################################################
# Allocation by Del Dim/ Features
###################################################


## Retrive Alloc Base Account 
sAllocAcc = CELLGETS(cAllocCube, vVersion, vPeriod, vLOB, 'Total Location Incl Discontinued', '0000', 'Unspecified Fulfillment type', 'Unspecified Merchant Type', 'Unspecified Order Category', 'Unspecified Merchant Segment', vGLOperational, 'Mapping for Alloc TI');

IF(sAllocAcc @= 'No Allocate');

   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   CELLINCREMENTN(vValue, cTargetCube, vVersion, vPeriod, cTargetSource, vRateType, vLOB, vDepartment, vLocation, 'Unspecified Fulfillment type', 'Unspecified Merchant Type', 'Unspecified Order Category', 'Unspecified Merchant Segment', 'Unspecified Delivery Features', vGLOperational, 'Amount');

ELSE;

   nAllocTotal = CELLGETN(cTargetCube, vVersion, vPeriod, 'FDS', vRateType, vLOB, '0000', vLocation, cFulFilConsol, cMerchTypeConsol, cOrdCatConsol, cDelMerchSegConsol, cDelFeatureConsol, sAllocAcc, 'Amount');
   ## Conduct Allocations by Product / Feature 

   IF(nAllocTotal <> 0);
      Dim1Count = 1;
      Dim1Size = DIMSIZ(cFulFilDim);
      WHILE(Dim1Count <= Dim1Size);
         sFulFil = DIMNM(cFulFilDim, Dim1Count);
         IF(ELLEV(cFulFilDim, sFulFil) = 0 & ELISANC(cFulFilDim, cFulFilConsol, sFulFil) = 1);
            nAllocF = CELLGETN(cTargetCube, vVersion, vPeriod, 'FDS', vRateType, vLOB, '0000', vLocation, sFulFil, cMerchTypeConsol, cOrdCatConsol, cDelMerchSegConsol, cDelFeatureConsol, sAllocAcc, 'Amount');
            IF(nAllocF <> 0);
               Dim2Count = 1;
               Dim2Size = DIMSIZ(cMerchTypeDim);
               WHILE(Dim2Count <= Dim2Size);
                  sMerchType = DIMNM(cMerchTypeDim, Dim2Count);
                  IF(ELLEV(cMerchTypeDim, sMerchType) = 0 & ELISANC(cMerchTypeDim, cMerchTypeConsol, sMerchType) = 1);
                     nAllocM = CELLGETN(cTargetCube, vVersion, vPeriod, 'FDS', vRateType, vLOB, '0000', vLocation, sFulFil, sMerchType, cOrdCatConsol, cDelMerchSegConsol, cDelFeatureConsol, sAllocAcc, 'Amount');
                     IF(nAllocM <> 0);
                        Dim3Count = 1;
                        Dim3Size = DIMSIZ(cOrdCatDim);
                        WHILE(Dim3Count <= Dim3Size);
                           sOrdCat = DIMNM(cOrdCatDim, Dim3Count);
                           IF(ELLEV(cOrdCatDim, sOrdCat) = 0 & ELISANC(cOrdCatDim, cOrdCatConsol, sOrdCat) = 1);
                              nAllocO = CELLGETN(cTargetCube, vVersion, vPeriod, 'FDS', vRateType, vLOB, '0000', vLocation, sFulFil, sMerchType, sOrdCat, cDelMerchSegConsol, cDelFeatureConsol, sAllocAcc, 'Amount');
                              IF(nAllocO <> 0);
                                 Dim4Count = 1;
                                 Dim4Size = DIMSIZ(cDelMerchSegDim);
                                 WHILE(Dim4Count <= Dim4Size);
                                    sMerchSeg = DIMNM(cDelMerchSegDim, Dim4Count);
                                    IF(ELLEV(cDelMerchSegDim, sMerchSeg) = 0 & ELISANC(cDelMerchSegDim, cDelMerchSegConsol, sMerchSeg) = 1);
                                       nAllocS = CELLGETN(cTargetCube, vVersion, vPeriod, 'FDS', vRateType, vLOB, '0000', vLocation, sFulFil, sMerchType, sOrdCat, sMerchSeg, cDelFeatureConsol, sAllocAcc, 'Amount');
                                       IF(nAllocS <> 0);
                                          Dim5Count = 1;
                                          Dim5Size = DIMSIZ(cDelFeatureDim);
                                          WHILE(Dim5Count <= Dim5Size);
                                             sDelFeat = DIMNM(cDelFeatureDim, Dim5Count);
                                             IF(ELLEV(cDelFeatureDim, sDelFeat) = 0 & ELISANC(cDelFeatureDim, cDelFeatureConsol, sDelFeat) = 1);
                                                nAllocF = CELLGETN(cTargetCube, vVersion, vPeriod, 'FDS', vRateType, vLOB, '0000', vLocation, sFulFil, sMerchType, sOrdCat, sMerchSeg, sDelFeat, sAllocAcc, 'Amount');
                                                IF(nAllocF <> 0);
                                                   nAllocPerc = nAllocF \ nAllocTotal;
                                                   nAllocVal = vValue * nAllocPerc;
                                                   # ================= TAPTOOLS: START GENERATED CODE =================== #
