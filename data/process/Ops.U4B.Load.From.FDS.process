# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsStarted = nDataProcedureRecordsStarted + 1;
IF(nMetadataProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: END METADATA PROCEDURE');
   nMetadataProcedureEndTime = NOW();
ENDIF;
IF(nDataProcedureStartTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: START DATA PROCEDURE');
   nDataProcedureStartTime = NOW();
ENDIF;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****


# Month

IF(pLevel @= 'Month');
   sPeriod = SUBST(vPeriod, 1, 7);
ELSEIF(pLevel @= 'Day');
   sPeriod = vPeriod;
ELSE;
   sPeriod = 'WS ' | vPeriod;
ENDIF;

IF(SUBSETELEMENTEXISTS('Period', cSubset, sPeriod) = 0);
   ITEMSKIP;
ENDIF;

#Metric
sMetric = vMetric;

# Location
sDim = 'Location';
IF(vLocation @= '\N' % vLocation @= '');
   ITEMSKIP;
ENDIF;
sLocation = 'V' | vLocation;

IF(DIMIX(sDim, sLocation) = 0);
   ITEMSKIP;
ENDIF;

# LOB
IF(vLob @= '\N' % vLob @= '' % DIMIX('Line of Business', vLob) = 0);
   ITEMSKIP;
ENDIF;

IF(vProduct @= '\N' % vProduct @= '');
   vProduct = 'Unspecified U4B Product';
ENDIF;

IF(vChannel @= '\N' % vChannel @= '');
   vChannel = 'Unspecified U4B Sales Channel';
ENDIF;

IF(vSegment @= '\N' % vSegment @= '');
   vSegment = 'Unspecified U4B Org Segment';
ENDIF;

IF(vProfile @= '\N' % vProfile @= '');
   vProfile = 'Unspecified U4B Trip Profile';
ENDIF;

IF(vSegment @= 'IS');
   vSegment = 'Unspecified U4B Org Segment';
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Clear Target View
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
#Scanning the Input to find metrics  to be zeroed out

IF(DIMIX('U4B Ops Metrics', sMetric) = 0);
   ITEMSKIP;
ENDIF;


IF(SCAN(sMetric, cMetricString) = 0);
   cMetricString = cMetricString | sMetric | '|';
   SUBSETDELETEALLELEMENTS('U4B Ops Metrics', cSubset);
   SUBSETELEMENTINSERT('U4B Ops Metrics', cSubset, sMetric, 1);
   VIEWZEROOUT(cCube, cViewName);
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Load Data
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

sDim = 'Rate Type';
p = 1;
WHILE(p <= DIMSIZ(sDim));
   sRateType = DIMNM(sDim, p);
   IF(ELLEV(sDim, sRateType) = 0);
      # ================= TAPTOOLS: START GENERATED CODE =================== #
      nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
      # ================= TAPTOOLS: END GENERATED CODE ===================== #
      CELLINCREMENTN(vValue, cCube, 'Actual', sPeriod, 'FDS', sRateType, vLob, '0000', sLocation, vSegment, vProduct, vChannel, vProfile, sMetric, 'Amount');
      cRecordCount = cRecordCount + 1;
   ENDIF;
   p = p + 1;
END;
# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsCompleted = nDataProcedureRecordsCompleted + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
