# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROPERTIES                                                           #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
{
    "DataSource": {
        "Type": "ASCII",
        "asciiDecimalSeparator": ".",
        "asciiDelimiterChar": ",",
        "asciiDelimiterType": "Character",
        "asciiHeaderRecords": 1,
        "asciiQuoteCharacter": "\"",
        "asciiThousandSeparator": ",",
        "dataSourceNameForClient": "uploadfile.csv.blb",
        "dataSourceNameForServer": "uploadfile.csv.blb"
    },
    "HasSecurityAccess": false,
    "Name": "Ops.Load.Completed.Trips.Adj.From.File",
    "Parameters": [
        {
            "Name": "pFileName",
            "Prompt": "",
            "Type": "String",
            "Value": ""
        },
        {
            "Name": "pLevel",
            "Prompt": "",
            "Type": "String",
            "Value": ""
        },
        {
            "Name": "pForceLoad",
            "Prompt": "",
            "Type": "String",
            "Value": ""
        }
    ],
    "UIData": "CubeAction=1511\fDataAction=1503\fCubeLogChanges=0\f",
    "Variables": [
        {
            "EndByte": 0,
            "Name": "vLocation",
            "Position": 1,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vLob",
            "Position": 2,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vMetric",
            "Position": 3,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vPeriod",
            "Position": 4,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vValue",
            "Position": 5,
            "StartByte": 0,
            "Type": "Numeric"
        }
    ],
    "VariablesUIData": [
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
        "VarType=33\fColType=827\f",
        "IgnoredInputVarName=V6\fVarType=32\fColType=1165\f"
    ]
}
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROPERTIES                                                             #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

###########################################
#INITIALIZE CONSTANTS
###########################################

cSystemInfoCube = 'System Info';
cRand = NUMBERTOSTRING(RAND());
cView = '}zTemp.' | GETPROCESSNAME() | '.' | cRand;
cSubset = '}zTemp.' | GETPROCESSNAME() | '.' | cRand;
cSrcPath = CELLGETS('TAP System Info', 'Data Path', 'Value') | '/model_upload/';
cFilesLocalPath = CELLGETS('TAP System Info', 'Files Local Path', 'Value');
cFileArchivePath = cFilesLocalPath | '/model_upload_archive/';
cFileName = pFileName;
sAddedJLs = '';

cDepartment = '0000';
cVersion = 'Actual';
cMeasure = 'Amount';
cSource = 'Ops Adjustment';
cClientDim = '}Clients';
sSkippedRecord = '';
nRecord = 0;
cPeriodMetricLOBString = '';
cInstance = CELLGETS('TAP System Info', 'Instance Name', 'Value');
cMonthEndPeriod = CELLGETS('Admin Play Book', 'Oracle Sync', 'Current Actual Month');
cMonthEndStatus = CELLGETS('Admin Play Book', 'Oracle Sync', 'Status');

#Export File for Error Handling
cTimeStamp = TIMST(NOW(), '\Y\m\d\h\i\s');
cExportFilePath = CELLGETS('TAP System Info', 'Files Shared Path', 'Value') | '/' | CELLGETS('TAP System Info', 'Service Name', 'Value');
cExportFileName = 'ops_completed_trips_adj_load_exceptions_' | cRand | '_' | cTimeStamp | '.csv';
cExportFile = cExportFilePath | '/' | cExportFileName;

sClient = TM1USER();

LOGOUTPUT('Info', sClient);

cErrCube = 'Process Error log';

cMetricsDim = 'Process Item';

cPipeline = 'Metric_Adjustment';

cErrCubeView = GETPROCESSNAME() | '_' | NUMBERTOSTRING(RAND());

cErrDimSubset = cErrCubeView;

sErrItemCnt = 0;

sLevel = LOWER(pLevel);
sForceLoad = LOWER(pForceLoad);

nStart = 1;
nCurPos = 1;

#######################
#Clear Error log prior to data load
#######################

#Create Target view to clear

IF(VIEWEXISTS(cErrCube, cErrCubeView) = 1);

   VIEWDESTROY(cErrCube, cErrCubeView);

ENDIF;


VIEWCREATE(cErrCube, cErrCubeView, 1);

IF(SUBSETEXISTS(cMetricsDim, cErrDimSubset) = 1);

   SUBSETDESTROY(cMetricsDim, cErrDimSubset);

ENDIF;

SUBSETCREATE(cMetricsDim, cErrDimSubset, 1);

SUBSETELEMENTINSERT(cMetricsDim, cErrDimSubset, cPipeline, 1);

VIEWSUBSETASSIGN(cErrCube, cErrCubeView, cMetricsDim, cErrDimSubset);


IF(SUBSETEXISTS(cClientDim, cErrDimSubset) = 1);

   SUBSETDESTROY(cClientDim, cErrDimSubset);

ENDIF;

SUBSETCREATE(cClientDim, cErrDimSubset, 1);

SUBSETELEMENTINSERT(cClientDim, cErrDimSubset, sClient, 1);

VIEWSUBSETASSIGN(cErrCube, cErrCubeView, cClientDim, cErrDimSubset);

VIEWZEROOUT(cErrCube, cErrCubeView);


###########################################
# Setup Archive path
###########################################
IF(FILEEXISTS(cFileArchivePath) = 0);

   sBatchMkdir = 'mkdir "' | cFileArchivePath | '"';

   EXECUTECOMMAND(sBatchMkdir, 1);

ENDIF;

#Turning Logging on

cDLogging = CELLGETS('}CubeProperties', 'Delivery', 'Logging');
cMLogging = CELLGETS('}CubeProperties', 'Mobility', 'Logging');
cOLogging = CELLGETS('}CubeProperties', 'Ops', 'Logging');


CELLPUTS('YES', '}CubeProperties', 'Delivery', 'Logging');
CELLPUTS('YES', '}CubeProperties', 'Mobility', 'Logging');
CELLPUTS('YES', '}CubeProperties', 'Ops', 'Logging');

###########################################
#DEFINE DATASOURCE
###########################################
DatasourceType = 'CHARACTERDELIMITED';
DatasourceNameForServer = cSrcPath | cFileName;

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: METADATA PROCEDURE                                                   #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: METADATA PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

nRecord = nRecord + 1;
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Transformation
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

# Month

IF(sLevel @= 'month');
   sPeriod = SUBST(vPeriod, 1, 7);
ENDIF;


IF(sForceLoad @<> 'epm');

   IF(sPeriod @= cMonthEndPeriod & cMonthEndStatus @= 'Close');
      sMsg = 'Current Month is closed for Adjustments. Check at Line - ' | NUMBERTOSTRING(nRecord);

      sErrItemCnt = sErrItemCnt + 1;

      sItem = IF(LONG(NUMBERTOSTRING(sErrItemCnt)) < 5, 'Item_' | FILL('0', 5 - LONG(NUMBERTOSTRING(sErrItemCnt))) | NUMBERTOSTRING(sErrItemCnt), 'Item_' | NUMBERTOSTRING(sErrItemCnt));

      CELLPUTS(sMsg, cErrCube, cPipeline, sClient, sItem, 'Message');

      CELLPUTN(1, cErrCube, cPipeline, sClient, sItem, 'Value');

      sSkippedRecord = sSkippedRecord | 'Current Month is closed for Adjustments. Check at Line - ' | NUMBERTOSTRING(nRecord) | ', ';
      ITEMSKIP;
   ENDIF;

   IF(cMonthEndStatus @= 'Close');
      sMsg = 'Adjustments are closed. Check at Line - ' | NUMBERTOSTRING(nRecord);

      sErrItemCnt = sErrItemCnt + 1;

      sItem = IF(LONG(NUMBERTOSTRING(sErrItemCnt)) < 5, 'Item_' | FILL('0', 5 - LONG(NUMBERTOSTRING(sErrItemCnt))) | NUMBERTOSTRING(sErrItemCnt), 'Item_' | NUMBERTOSTRING(sErrItemCnt));

      CELLPUTS(sMsg, cErrCube, cPipeline, sClient, sItem, 'Message');

      CELLPUTN(1, cErrCube, cPipeline, sClient, sItem, 'Value');
      sSkippedRecord = sSkippedRecord | 'Adjustments are closed. Check at Line - ' | NUMBERTOSTRING(nRecord) | ',  ';
      ITEMSKIP;
   ENDIF;

   IF(sPeriod @<> cMonthEndPeriod);
      sMsg = 'Can post for only current actual month. Check at Line - ' | NUMBERTOSTRING(nRecord);

      sErrItemCnt = sErrItemCnt + 1;

      sItem = IF(LONG(NUMBERTOSTRING(sErrItemCnt)) < 5, 'Item_' | FILL('0', 5 - LONG(NUMBERTOSTRING(sErrItemCnt))) | NUMBERTOSTRING(sErrItemCnt), 'Item_' | NUMBERTOSTRING(sErrItemCnt));

      CELLPUTS(sMsg, cErrCube, cPipeline, sClient, sItem, 'Message');

      CELLPUTN(1, cErrCube, cPipeline, sClient, sItem, 'Value');
      sSkippedRecord = sSkippedRecord | 'Can post for only current actual month. Check at Line - ' | NUMBERTOSTRING(nRecord) | ', ';
      ITEMSKIP;
   ENDIF;
ENDIF;

# Location

IF(ELLEV('Location', vLocation) <> 0);
   sLocation = vLocation;
ELSE;
   sLocation = 'v' | vLocation;
ENDIF;

IF(DIMIX('Location', sLocation) = 0);
   sMsg = 'Invalid Location at Line - ' | NUMBERTOSTRING(nRecord);

   sErrItemCnt = sErrItemCnt + 1;

   sItem = IF(LONG(NUMBERTOSTRING(sErrItemCnt)) < 5, 'Item_' | FILL('0', 5 - LONG(NUMBERTOSTRING(sErrItemCnt))) | NUMBERTOSTRING(sErrItemCnt), 'Item_' | NUMBERTOSTRING(sErrItemCnt));

   CELLPUTS(sMsg, cErrCube, cPipeline, sClient, sItem, 'Message');

   CELLPUTN(1, cErrCube, cPipeline, sClient, sItem, 'Value');

   sSkippedRecord = sSkippedRecord | 'Invalid Location at Line - ' | NUMBERTOSTRING(nRecord) | ', ';
   ITEMSKIP;

ENDIF;

#LoB
sLOB = vLOB;

IF(DIMIX('Line of Business', sLOB) = 0);
   sMsg = 'Invalid LoB at Line - ' | NUMBERTOSTRING(nRecord);

   sErrItemCnt = sErrItemCnt + 1;

   sItem = IF(LONG(NUMBERTOSTRING(sErrItemCnt)) < 5, 'Item_' | FILL('0', 5 - LONG(NUMBERTOSTRING(sErrItemCnt))) | NUMBERTOSTRING(sErrItemCnt), 'Item_' | NUMBERTOSTRING(sErrItemCnt));

   CELLPUTS(sMsg, cErrCube, cPipeline, sClient, sItem, 'Message');

   CELLPUTN(1, cErrCube, cPipeline, sClient, sItem, 'Value');
   sSkippedRecord = sSkippedRecord | 'Invalid LoB at Line - ' | NUMBERTOSTRING(nRecord) | ', ';
   ITEMSKIP;

ELSEIF(ELISANC('Line of Business', 'Delivery', sLOB) = 1);
   cCube = 'Delivery';
ELSEIF(ELISANC('Line of Business', 'Mobility', sLOB) = 1);
   cCube = 'Mobility';
ELSEIF(ELISANC('Line of Business', 'Freight', sLOB) = 1);
   cCube = 'Ops';
ELSE;
   sMsg = 'Invalid LoB at Line - ' | NUMBERTOSTRING(nRecord);

   sErrItemCnt = sErrItemCnt + 1;

   sItem = IF(LONG(NUMBERTOSTRING(sErrItemCnt)) < 5, 'Item_' | FILL('0', 5 - LONG(NUMBERTOSTRING(sErrItemCnt))) | NUMBERTOSTRING(sErrItemCnt), 'Item_' | NUMBERTOSTRING(sErrItemCnt));

   CELLPUTS(sMsg, cErrCube, cPipeline, sClient, sItem, 'Message');

   CELLPUTN(1, cErrCube, cPipeline, sClient, sItem, 'Value');
   sSkippedRecord = sSkippedRecord | 'Valid LoB but LOB is not part of the Delivery\Mobility\Ops hierarchy at Line - ' | NUMBERTOSTRING(nRecord) | ', ';
   ITEMSKIP;
ENDIF;

# Metric
sMetric = TRIM(vMetric);

IF(sMetric @<> 'Completed Trips');
   sMsg = 'Invalid Metric at Line - ' | NUMBERTOSTRING(nRecord);

   sErrItemCnt = sErrItemCnt + 1;

   sItem = IF(LONG(NUMBERTOSTRING(sErrItemCnt)) < 5, 'Item_' | FILL('0', 5 - LONG(NUMBERTOSTRING(sErrItemCnt))) | NUMBERTOSTRING(sErrItemCnt), 'Item_' | NUMBERTOSTRING(sErrItemCnt));

   CELLPUTS(sMsg, cErrCube, cPipeline, sClient, sItem, 'Message');

   CELLPUTN(1, cErrCube, cPipeline, sClient, sItem, 'Value');
   sSkippedRecord = sSkippedRecord | 'Invalid Metric at Line - ' | NUMBERTOSTRING(nRecord) | ', ';
   ITEMSKIP;
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Clear Target View
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
#Scanning the Input to find Period , LOB and metric combination to be zeroed out

IF(SCAN(sPeriod | '_' | sMetric | '_' | sLOB, cPeriodMetricLOBString) = 0);
   IF(LONG(cPeriodMetricLOBString) = 0);
      cPeriodMetricLOBString = sPeriod | '_' | sMetric | '_' | sLOB;
   ELSE;
      cPeriodMetricLOBString = cPeriodMetricLOBString | '|' | sPeriod | '_' | sMetric | '_' | sLOB;
   ENDIF;

   sLoopString = TRIM(cPeriodMetricLOBString);
   sLoopString = sLoopString | IF(SUBST(sLoopString, LONG(sLoopString), 1) @<> '|', '|', '');


   WHILE(nCurPos <= LONG(sLoopString));
      sCurChar = SUBST(sLoopString, nCurPos, 1);
      IF(sCurChar @= '|');
         sPeriodMetricLOBElement = SUBST(sLoopString, nStart, nCurPos - nStart);
         LOGOUTPUT('INFO', sPeriodMetricLOBElement);
         nSplit_1 = SCAN('_', sPeriodMetricLOBElement);
         sPeriodElement = SUBST(sPeriodMetricLOBElement, 1, (nSplit_1 - 1));

         sMetricLOBElement = SUBST(sPeriodMetricLOBElement, (nSplit_1 + 1), LONG(sPeriodMetricLOBElement) - nSplit_1);
         nSplit_2 = SCAN('_', sMetricLOBElement);
         sMetricElement = SUBST(sMetricLOBElement, 1, (nSplit_2 - 1));
         sLOBElement = SUBST(sMetricLOBElement, (nSplit_2 + 1), LONG(sMetricLOBElement) - nSplit_2);

         cRandomIntA = NUMBERTOSTRING(INT(RAND() * 100000));
         cViewName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
         cSubsetName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;

         VIEWCREATE(cCube, cViewName, 1);
         nCtr = 1;
         nMax = CUBEDIMENSIONCOUNTGET(cCube);
         WHILE(nCtr <= nMax);
            sDim = TABDIM(cCube, nCtr);
            IF(sDim @= 'Version');
               sElement = 'Actual';
               SUBSETCREATE(sDim, cSubsetName, 1);
               SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
               VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
            ELSEIF(sDim @= 'Period');
               sElement = sPeriodElement;
               SUBSETCREATE(sDim, cSubsetName, 1);
               SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
               VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
            ELSEIF(sDim @= 'Source');
               sElement = cSource;
               SUBSETCREATE(sDim, cSubsetName, 1);
               SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
               VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
            ELSEIF(sDim @= 'Line of Business');
               sElement = sLOBElement;
               SUBSETCREATE(sDim, cSubsetName, 1);
               SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
               VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
            ELSEIF(sDim @= 'Delivery Ops Metrics');
               sElement = sMetricElement;
               SUBSETCREATE(sDim, cSubsetName, 1);
               SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
               VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
            ELSEIF(sDim @= 'Mobility Ops Metrics');
               sElement = sMetricElement;
               SUBSETCREATE(sDim, cSubsetName, 1);
               SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
               VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
            ELSEIF(sDim @= 'Ops Metrics');
               sElement = sMetricElement;
               SUBSETCREATE(sDim, cSubsetName, 1);
               SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
               VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
            ELSE;
               sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({TM1SUBSETALL([ ' | sDim | '] )}, 0)}, ASC)}';
               SUBSETCREATEBYMDX(cSubsetName, sMdx, 1);
               VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
            ENDIF;
            nCtr = nCtr + 1;
         END;
         VIEWZEROOUT(cCube, cViewName);
         nStart = nCurPos + 1;
      ENDIF;
      nCurPos = nCurPos + 1;
   END;
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Load Data
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

sDim = 'Rate Type';
p = 1;
WHILE(p <= DIMSIZ(sDim));
   sRateType = DIMNM(sDim, p);
   IF(ELLEV(sDim, sRateType) = 0);
      IF(cCube @= 'Delivery');

         CELLINCREMENTN(vValue, cCube, cVersion, sPeriod, cSource, sRatetype, sLOB, cDepartment, sLocation, 'Unspecified Fulfillment type', 'Unspecified Merchant Type', 'Unspecified Order Category', ' Unspecified Merchant Segment', 'Unspecified Delivery Features', vMetric, cMeasure);
      ELSEIF(cCube @= 'Mobility');

         CELLINCREMENTN(vValue, cCube, cVersion, sPeriod, cSource, sRatetype, sLOB, cDepartment, sLocation, 'Unspecified Product Type', 'Unspecified Mobility Features', vMetric, cMeasure);
      ELSEIF(cCube @= 'Ops');

         CELLINCREMENTN(vValue, cCube, cVersion, sPeriod, cSource, sRatetype, sLocation, sLOB, 'Unspecified Product Type', vMetric, cMeasure);
      ENDIF;
   ENDIF;
   #sSkippedRecord='load loop';
   p = p + 1;
END;


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: EPILOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

#****End: Generated Statements****'

#################################################
#Update Load Success Status if reached this point
#################################################
IF(sErrItemCnt = 0);

   CELLPUTS('INFO: File "' | pFileName | '" successfully uploaded"', cErrCube, cPipeline, sClient, 'Total_Items', 'Message');

ENDIF;

#######################
#Archive uploaded file
#######################

sDim = '}Clients';

sName = LOWER(ATTRS(sDim, sClient, 'Caption'));

sEmail = LOWER(ATTRS(sDim, sClient, 'Email'));

sClientDV = SUBST(sName, SCAN('/', sName) + 1, LONG(sName));

sArchiveFileName = sClientDV | TIMST(NOW(), '\Y\m\d\h\i\s') | '_' | cFileName;

IF(FILEEXISTS(cFileArchivePath) = 1);

   sMovBatch = 'mv "' | cSrcPath | cFileName | '" "' | cFileArchivePath | sArchiveFileName | '"';

   EXECUTECOMMAND(sMovBatch, 1);

ENDIF;

########################
#Send Email notification
########################

IF(sSkippedRecord @= '' & nRecord > 0);
   sHTML = '<body>Adjustments loaded successfully</body>';
   LOGOUTPUT('Info', 'Adjustments loaded successfully by : ' | sName | ' - ' | pFilename);

ELSE;
   sHTML = '<body>Errors while loading adjustments : ' | sSkippedRecord | '</body>';
   LOGOUTPUT('Info', 'Errors while loading adjustments by : ' | sName | ' - ' | pFilename);
   LOGOUTPUT('Info', 'Skipped Records - ' | sSkippedRecord);
ENDIF;


# HA Check to ensure that the batch is called only from one instance
sBatchTriggerFlag = CELLGETS('TAP System Info', 'Trigger Batch From TI', 'Value');
IF(UPPER(sBatchTriggerFlag) @= 'YES');
   IF(SCAN('.com', sEmail) <> 0);

      EXECUTEPROCESS('System.Send Email'
         , 'pFrom', 'Ops@uber.com'
         , 'pTo', sEmail
         , 'pSubject', cInstance | ' :  Adjustment Load Status'
         , 'phtmlContent', sHTML
      );

   ENDIF;

ENDIF;

IF(sForceLoad @= 'epm' % cMonthEndStatus @= 'Open');

   sProcess = 'Ops.Load.Ops.Adjustments.From.Delivery';
   EXECUTEPROCESS(sProcess
      , 'pVersion', 'Actual'
      , 'pPeriod', cMonthEndPeriod
   );

   sProcess = 'Ops.Load.Ops.Adjustments.From.Mobility';
   EXECUTEPROCESS(sProcess
      , 'pVersion', 'Actual'
      , 'pPeriod', cMonthEndPeriod
   );

   # HA Check to ensure that the batch is called only from one instance
   sBatchTriggerFlag = CELLGETS('TAP System Info', 'Trigger Batch From TI', 'Value');
   IF(UPPER(sBatchTriggerFlag) @= 'YES');
      EXECUTEPROCESS('Ops.DIQ.GL Reporting.Sync'
         , 'pInstance', 'PAC'
         , 'pProcess', 'DIQ.Call.Batch'
         , 'pParams', '[{"Name":"pDIQBatch","Value":"Batch - 1109"}]'
      );

      # Copy data from FDS Incl Adj to Product PL in Moblity and Delivery Cubes
      EXECUTEPROCESS('Ops.DIQ.GL Reporting.Sync'
         , 'pInstance', 'PAC'
         , 'pProcess', 'DIQ.Call.Batch'
         , 'pParams', '[{"Name":"pDIQBatch","Value":"Batch - 1150"}]'
      );

   ENDIF;

ENDIF;

#Reinstating original logging status

CELLPUTS(cDLogging, '}CubeProperties', 'Delivery', 'Logging');
CELLPUTS(cMLogging, '}CubeProperties', 'Mobility', 'Logging');
CELLPUTS(cOLogging, '}CubeProperties', 'Ops', 'Logging');

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: EPILOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #