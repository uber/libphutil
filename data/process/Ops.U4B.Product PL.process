#****Begin: Generated Statements***
#****End: Generated Statements****


###################################################
# Allocation by U4B Dim/ Features
###################################################


## Skip variables based on user inputted source  
sSource = CELLGETS(cAllocCube, vVersion, vPeriod, '5001', 'Total Location Incl Discontinued', '0000', 'Unspecified U4B Trip Profile', 'Unspecified U4B Sales Channel', 'Unspecified U4B Org Segment', 'Unspecified U4B Product', vMetric, 'Source');
IF(sSource @= 'Oracle U4B Mob/Del' & vLOB @= '5001');
   ITEMSKIP;
ELSEIF(sSource @= 'Oracle U4B 5001' & vLOB @<> '5001');
   ITEMSKIP;
ENDIF;

# Variables for 5001
IF(vLOB @= '5001');
   sLOB = cLOBConsol;
   sLocation = cLocationConsol;
ELSE;
   sLOB = vLOB;
   sLocation = vLocation;
ENDIF;


## Retrive Alloc Base Account 
sAllocAcc = CELLGETS(cAllocCube, vVersion, vPeriod, '5001', cLocationConsol, '0000', 'Unspecified U4B Trip Profile', 'Unspecified U4B Sales Channel', 'Unspecified U4B Org Segment', 'Unspecified U4B Product', vMetric, 'Mapping for Alloc TI');

IF(sAllocAcc @= 'No Allocate');

   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   CELLINCREMENTN(vValue, cTargetCube, vVersion, vPeriod, cTargetSource, vRateType, vLOB, '0000', vLocation, 'Unspecified U4B Org Segment', 'Unspecified U4B Product', 'Unspecified U4B Sales Channel', 'Unspecified U4B Trip Profile', vMetric, 'Amount');

ELSE;

   nAllocTotal = CELLGETN(cStagingCube, vVersion, vPeriod, 'FDS', vRateType, 'Total Currency', sLOB, '0000', sLocation, cU4BOrgConsol, cU4BProductConsol, cU4BSalesConsol, cU4BTripConsol, sAllocAcc, 'Amount');
   ## Conduct Allocations by Product / Feature 

   IF(nAllocTotal <> 0);
      Sub1Count = 1;
      Sub1Size = SUBSETGETSIZE(cU4BOrgDim, sSubsetName);
      WHILE(Sub1Count <= Sub1Size);
         sU4BOrg = SUBSETGETELEMENTNAME(cU4BOrgDim, sSubsetName, Sub1Count);
         nAllocO = CELLGETN(cStagingCube, vVersion, vPeriod, 'FDS', vRateType, 'Total Currency', sLOB, '0000', sLocation, sU4BOrg, cU4BProductConsol, cU4BSalesConsol, cU4BTripConsol, sAllocAcc, 'Amount');
         IF(nAllocO <> 0);
            Sub2Count = 1;
            Sub2Size = SUBSETGETSIZE(cU4BProductDim, sSubsetName);
            WHILE(Sub2Count <= Sub2Size);
               sU4BProduct = SUBSETGETELEMENTNAME(cU4BProductDim, sSubsetName, Sub2Count);
               nAllocP = CELLGETN(cStagingCube, vVersion, vPeriod, 'FDS', vRateType, 'Total Currency', sLOB, '0000', sLocation, sU4BOrg, sU4BProduct, cU4BSalesConsol, cU4BTripConsol, sAllocAcc, 'Amount');
               IF(nAllocP <> 0);
                  Sub3Count = 1;
                  Sub3Size = SUBSETGETSIZE(cU4BSalesDim, sSubsetName);
                  WHILE(Sub3Count <= Sub3Size);
                     sU4BSales = SUBSETGETELEMENTNAME(cU4BSalesDim, sSubsetName, Sub3Count);
                     nAllocS = CELLGETN(cStagingCube, vVersion, vPeriod, 'FDS', vRateType, 'Total Currency', sLOB, '0000', sLocation, sU4BOrg, sU4BProduct, sU4BSales, cU4BTripConsol, sAllocAcc, 'Amount');
                     IF(nAllocS <> 0);
                        Sub4Count = 1;
                        Sub4Size = SUBSETGETSIZE(cU4BTripDim, sSubsetName);
                        WHILE(Sub4Count <= Sub4Size);
                           sU4BTrip = SUBSETGETELEMENTNAME(cU4BTripDim, sSubsetName, Sub4Count);
                           nAllocT = CELLGETN(cStagingCube, vVersion, vPeriod, 'FDS', vRateType, 'Total Currency', sLOB, '0000', sLocation, sU4BOrg, sU4BProduct, sU4BSales, sU4BTrip, sAllocAcc, 'Amount');
                           IF(nAllocT <> 0);
                              nAllocPerc = nAllocT \ nAllocTotal;
                              nAllocVal = vValue * nAllocPerc;
                              CELLINCREMENTN(nAllocVal, cTargetCube, vVersion, vPeriod, cTargetSource, vRateType, vLOB, '0000', vLocation, sU4BOrg, sU4BProduct, sU4BSales, sU4BTrip, vMetric, 'Amount');

                           ENDIF;
                           Sub4Count = Sub4Count + 1;
                        END;
                     ENDIF;
                     Sub3Count = Sub3Count + 1;
                  END;
               ENDIF;
               Sub2Count = Sub2Count + 1;
            END;
         ENDIF;
         Sub1Count = Sub1Count + 1;
      END;
   ELSE;
      # ================= TAPTOOLS: START GENERATED CODE =================== #
      nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
      # ================= TAPTOOLS: END GENERATED CODE ===================== #
      CELLINCREMENTN(vValue, cTargetCube, vVersion, vPeriod, cTargetSource, vRateType, vLOB, '0000', vLocation, 'Unspecified U4B Org Segment', 'Unspecified U4B Product', 'Unspecified U4B Sales Channel', 'Unspecified U4B Trip Profile', vMetric, 'Amount');
   ENDIF;

ENDIF;










# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsCompleted = nDataProcedureRecordsCompleted + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
