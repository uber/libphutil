#****End: Generated Statements****

cApp = CELLGETS('TAP System Info', 'Service Name', 'Value');

IF(cApp @= 'ops-1' & SCAN('netr', pTable) = 0);
   PROCESSBREAK();
ENDIF;

IF(cApp @= 'ops' & SCAN('netr', pTable) > 0);
   PROCESSBREAK();
ENDIF;

# Process to load Delivery Financial Metrics from FDS to Delivery Staging cube
# Constants
cCube = 'U4B Staging';
cCubeMap = 'Operational PL Mapping';
nRecords = 1;

cMetricString = '';

cUser = CELLGETS('System Info', 'SQL User Name GL Transactions', 'String');
cPassword = CELLGETS('System Info', 'SQL Password GL Transactions', 'String');


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Set Query
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

DatasourceUsername = cUser;
DatasourcePassword = cPassword;
sQuery = EXPAND('SELECT * FROM "%pTable%"');
DatasourceQuery = sQuery;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Subsets for View Zero Out
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cRandomIntA = NUMBERTOSTRING(INT(RAND() * 100000));
cSubset = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
cViewName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
VIEWCREATE(cCube, cViewName, 1);


nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(cCube);

WHILE(nCtr <= nMax);
   sDim = TABDIM(cCube, nCtr);

   IF(sDim @= 'Version');
      sElement = 'Actual';
      SUBSETCREATE(sDim, cSubset, 1);
      SUBSETELEMENTINSERT(sDim, cSubset, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Period');
      SUBSETCREATE(sDim, cSubset, 1);
      IF(pStartDate @<> '' & pEndDate @<> '' & pLevel @= 'Day');
         nStartday = DAYNO(SUBST(pStartDate, 1, 10));
         nEndday = DAYNO(SUBST(pEndDate, 1, 10));
         WHILE(nStartday <= nEndDay);
            sDay = DATE(nStartday, 1);
            SUBSETELEMENTINSERT(sDim, cSubset, sDay, 1);
            nStartday = nStartday + 1;
         END;
      ENDIF;
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Source');
      sElement = 'FDS';
      SUBSETCREATE(sDim, cSubset, 1);
      SUBSETELEMENTINSERT(sDim, cSubset, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Rate Type');
      sElement = pRateType;
      SUBSETCREATE(sDim, cSubset, 1);
      SUBSETELEMENTINSERT(sDim, cSubset, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'U4B Ops Metrics');
      sMDX = '{TM1DRILLDOWNMEMBER( {[U4B Ops Metrics].[GAAP Contribution], [U4B Ops Metrics].[Total Incentives]}, ALL, RECURSIVE )}';
      SUBSETCREATEBYMDX(cSubset, sMDX, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'U4B Staging Measure');
      sElement = 'Amount';
      SUBSETCREATE(sDim, cSubset, 1);
      SUBSETELEMENTINSERT(sDim, cSubset, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSE;
      sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({TM1SUBSETALL([ ' | sDim | '] )}, 0)}, ASC)}';
      SUBSETCREATEBYMDX(cSubset, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ENDIF;

   nCtr = nCtr + 1;
END;


VIEWZEROOUT(cCube, cViewName);
# ================= TAPTOOLS: START GENERATED CODE =================== #
nPrologProcedureEndTime = NOW();
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "' | DatasourceType | '"');
