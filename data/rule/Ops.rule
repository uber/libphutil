['Version' : 'Actual', 'Line of Business':'2001', 'Product Type' : 'Eats'] = N:

   IF(
      ELISANC('OPS Metric', 'Rides and Eats Metrics', !OPS Metric) = 1 % ELISANC('OPS Metric', 'Eats Only Metrics', !OPS Metric)=1
   ,
     DB('Eats Ops', !Version, !Period, !Source, !Rate Type, !Location, 'Total Eats Product Type', 'Total Eats Restaurant Type', !Ops Metric, 'Amount')
   ,
      STET
   );

