    "DataSource": {
        "Type": "None"
    },
    "HasSecurityAccess": false,
    "Name": "Global.Dim.Period.Day.Week.Build Hierarchy",
    "Parameters": [
        {
            "Name": "pTapQueueAdd",
            "Prompt": "OPT: Queue Enable (Y or N)",
            "Type": "String",
            "Value": ""
        },
        {
            "Name": "pTapQueueGroupId",
            "Prompt": "OPT: Queue Job ID (Unique)",
            "Type": "String",
            "Value": ""
        },
        {
            "Name": "pTapQueueJobId",
            "Prompt": "OPT: Queue Group ID (Shared)",
            "Type": "String",
            "Value": ""
        },
        {
            "Name": "pTapQueuePriority",
            "Prompt": "OPT: Queue Priority -100 to 100 (Priority)",
            "Type": "String",
            "Value": ""
        }
    ],
    "UIData": "CubeAction=1511\fDataAction=1503\fCubeLogChanges=0\f",
    "Variables": [],
    "VariablesUIData": []
}
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROPERTIES                                                             #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

# ==================================================================== #
# Globals
# ==================================================================== #

cDim = 'Period';

cRand = NUMBERTOSTRING(ROUND(RAND() * 100000));
cRand = FILL('0', 6 - LONG(cRand)) | cRand;

cView = EXPAND('zzTemp.%cRand%');
cSub = EXPAND('zzTemp.%cRand%');


# ==================================================================== #
# Create Top Element
# ==================================================================== #

cTopEle='Total Time - Week Day';

DIMENSIONELEMENTINSERT(cDim, DIMNM(cDim, 1), cTopEle, 'C');

# ==================================================================== #
# Day and week mapping
# ==================================================================== #

sDim = cDim;
sHier = EXPAND('%sDim%');

sSub = cSub | '.Week_Input';
sMDX = EXPAND('{FILTER({TM1SORT( {TM1FILTERBYPATTERN( { [%sDim%].[%sDim%].Members }, "????-??-??")}, ASC)}, [%sDim%].[End of Period] >= 43101.000000)}');

SUBSETCREATE(sHier, sSub, 1);
SUBSETMDXSET(sHier, sSub, sMDX);
SUBSETMDXSET(sHier, sSub, '');

i = 1;
WHILE(i <= SUBSETGETSIZE(sHier, sSub));
   sEleLeaf = SUBSETGETELEMENTNAME(sHier, sSub, i);

   # Year/Half Element Relationship
   
   sElePar = ATTRS(sDim, sEleLeaf, 'Week Element'); 
   sElePar = 'WD ' | SUBST(sElePar,4,10);

   IF(sElePar@<>'');

	   DIMENSIONELEMENTINSERT(cDim, '', sElePar, 'C');
	   DIMENSIONELEMENTCOMPONENTADD(cDim, sElePar, sEleLeaf, 1);

   ENDIF;
   i = i + 1;
END;

# ================= TAPTOOLS: START GENERATED CODE =================== #
# ================= TAPTOOLS: END GENERATED CODE ===================== #

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
