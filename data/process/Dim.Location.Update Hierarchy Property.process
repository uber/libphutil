# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# ==================================================================== #
# Globals
# ==================================================================== #

cDim = 'Location';
cCube = '}HierarchyProperties';
sHier = 'CustomLeaf';

# ==================================================================== #
# Update Day Hierarchy Properties
# ==================================================================== #

sHierDim = EXPAND('%cDim%:%sHier%');

CELLPUTS(EXPAND('Total Location'), cCube, sHierDim, 'hierarchy0', 'defaultMember');
CELLPUTS('Total', cCube, sHierDim, 'hierarchy0', 'level000');
CELLPUTS('All', cCube, sHierDim, 'hierarchy0', 'level001');
CELLPUTS('Super Region', cCube, sHierDim, 'hierarchy0', 'level002');
CELLPUTS('Mega Region', cCube, sHierDim, 'hierarchy0', 'level003');
CELLPUTS('Region', cCube, sHierDim, 'hierarchy0', 'level004');
CELLPUTS('Sub Region', cCube, sHierDim, 'hierarchy0', 'level005');
CELLPUTS('Territory', cCube, sHierDim, 'hierarchy0', 'level006');
CELLPUTS('Planning Unit', cCube, sHierDim, 'hierarchy0', 'level007');
CELLPUTS('City', cCube, sHierDim, 'hierarchy0', 'level008');

REFRESHMDXHIERARCHY(sHierDim);

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
