#****End: Generated Statements****

# Process to load data in Mobility/Delivery cubes using upload UI

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Define Constants
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cDepartment = '0000';
cVersion = 'Actual';
cMeasure = 'Amount';
cSource = 'Ops Adjustment';
sSkippedRecord = '';
nRecord = 0;
cPeriodMetricLOBString = '';
cInstance = CELLGETS('TAP System Info', 'Instance Name', 'Value');
cMonthEndPeriod = CELLGETS('Admin Play Book', 'Oracle Sync', 'Current Actual Month');
cMonthEndStatus = CELLGETS('Admin Play Book', 'Oracle Sync', 'Status');


sPassword = 'corpfin';
IF(pPWord @<> sPassword);
   PROCESSQUIT;
ENDIF;

nStart = 1;
nCurPos = 1;

cUser = CELLGETS('System Info', 'SQL User Name GL Transactions', 'String');
cPassword = CELLGETS('System Info', 'SQL Password GL Transactions', 'String');

#Turning Logging on

cDLogging = CELLGETS('}CubeProperties', 'Delivery', 'Logging');
cMLogging = CELLGETS('}CubeProperties', 'Mobility', 'Logging');
cOLogging = CELLGETS('}CubeProperties', 'Ops', 'Logging');

# ================= TAPTOOLS: START GENERATED CODE =================== #
nPrologProcedureDataOperations = nPrologProcedureDataOperations + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #
CELLPUTS('YES', '}CubeProperties', 'Delivery', 'Logging');
# ================= TAPTOOLS: START GENERATED CODE =================== #
nPrologProcedureDataOperations = nPrologProcedureDataOperations + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #
CELLPUTS('YES', '}CubeProperties', 'Mobility', 'Logging');
# ================= TAPTOOLS: START GENERATED CODE =================== #
nPrologProcedureDataOperations = nPrologProcedureDataOperations + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #
CELLPUTS('YES', '}CubeProperties', 'Ops', 'Logging');

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Set Query
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

DatasourceUsername = cUser;
DatasourcePassword = cPassword;
sQuery = EXPAND('SELECT * FROM "%pTable%"');
DatasourceQuery = sQuery;




# ================= TAPTOOLS: START GENERATED CODE =================== #
nPrologProcedureEndTime = NOW();
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "' | DatasourceType | '"');
