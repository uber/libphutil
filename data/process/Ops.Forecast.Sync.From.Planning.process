# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

# ==================================================================== #
# === Process: OPS.Forecast.Sync.From.Planning
# === Purpose: Import Forecast data from Planning
# ==================================================================== #


# ==================================================================== #
# Define Constants
# ==================================================================== #

cVersion = TRIM(pVersion);
cPlanVersion = TRIM(pPlanVersion);
cPeriod = TRIM(pPeriod);
cInstance = TRIM(pInstance);

cImportCube = 'Ops';
cTAPSysInfoCube = 'TAP System Info';
cTapAppInfoCube = 'Tap Application Info';

cDimensionDelim = '&';
cElementStartDelim = ':';
cElementDelim = '+';
cFilter = '';
cSkipRules = 0;
cSkipCons = 1;
cZeroSource = 0;
cDebug = 0;

cPlanVersionDim = 'Plan Version';
cPlanModelDim = 'Plan Model';
cModelEle1 = 'Adjustment';
cModelEle2 = 'Cost Model';
cPlanActDim = 'Account';
cActEle1 = 'Net Inflows';
cActEle2 = 'OPS Model';
cMsrEle1 = 'Amount';

IF(pLevel @= 'Month');
   cExportCube = 'PL Forecast';
   cPlanMonthDim = 'Month';
   cPlanMsrDim = 'PL Forecast Measure';
ELSE;
   cExportCube = 'PL Forecast MWM';
   cPlanMonthDim = 'Period';
   cPlanMsrDim = 'PL Forecast MWM Measure';
ENDIF;

# ==================================================================== #
## Find current date to skip forecast data load
# ==================================================================== #

# Find today's day number: 0 - Sunday, 1 - Monday, 2 - Tuesday, 3 - Wednesday etc

nWeekday = MOD(DAYNO(TODAY) + 21915, 7);

# 2. Find the difference from today to the to beginning of week (Monday)

IF(nWeekday = 0);
   # Force Sunday to 7 so the difference works
   nWeekday = 7;
ENDIF;
nDiff = 1 - nWeekday;

# 3. Offset today's date by the difference found to get the beginning of the week's date

cCurrWeek = 'WS ' | TIMST(NOW() + nDiff, '\Y-\m-\d');



# ==================================================================== #
# Script Variables
# ==================================================================== #

cSyncFrom = LOWER(pInstance);

cServer = CELLGETS(cTapAppInfoCube, cSyncFrom, 'Endpoint');
cPortNumber = '443';

cPath = CELLGETS(cTAPSysInfoCube, 'Files Shared Path', 'Value') | '/ops';
cPythonExe = CELLGETS(cTAPSysInfoCube, 'Python Executable', 'Value');

cScriptRun = CELLGETS(cTAPSysInfoCube, 'Scripts Local Path', 'Value') | '/data-move.py';

cBatchUser = CELLGETS(cTAPSysInfoCube, 'Batch Username', 'Value');
cBatchPassword = CELLGETS(cTAPSysInfoCube, 'Batch Password', 'Value');
cBatchNamespace = CELLGETS(cTAPSysInfoCube, 'Batch Namespace', 'Value');

cFilePath = '/var/tm1/' | cSyncFrom | '/files/shared/ops/';

cFileName = LOWER(cExportCube | '_' | 'export.txt');

cView = '';

cFilter = cPlanVersionDim | cElementStartDelim | pPlanVersion | cDimensionDelim | cPlanMonthDim | cElementStartDelim | pPeriod | cDimensionDelim | cPlanModelDim | cElementStartDelim | cModelEle1 | cElementDelim | cModelEle2 | cDimensionDelim | cPlanActDim | cElementStartDelim | cActEle1 | cElementDelim | cActEle2 | cDimensionDelim | cPlanMsrDim | cElementStartDelim | cMsrEle1;


#cFilter = 'Plan Version : Plan 3 & Plan Model : Adjustment';

# ==================================================================== #
# Create Export Process Variables
# ==================================================================== #

cTemplateScriptRun = '%cPythonExe% "%cScriptRun%"  
--server="%cServer%" 
--port="%cPortNumber%" 
--user="%cBatchUser%" 
--password=''%cBatchPassword%'' 
--namespace="%cBatchNamespace%" 
--pCube="%cExportCube%" 
--pView="%cView%" 
--pFilter="%cFilter%" 
--pDimensionDelim="%cDimensionDelim%" 
--pElementStartDelim="%cElementStartDelim%" 
--pElementDelim="%cElementDelim%" 
--pSkipRules="%cSkipRules%" 
--pSkipCons="%cSkipCons%" 
--pZeroSource="%cZeroSource%" 
--pFilePath="%cFilePath%" 
--pFileName="%cFileName%" 
--pDebug="%cDebug%" 
 ';

# ==================================================================== #
# Run Command
# ==================================================================== #

sCommand = EXPAND(cTemplateScriptRun);
EXECUTECOMMAND(sCommand, 1);

# ==================================================================== #
# Break if no file
# ==================================================================== #
cPath = CELLGETS('TAP System Info', 'Files Shared Path', 'Value');
sFile = cPath | '/ops/';
sFile = sFile | cFileName;

IF(FILEEXISTS(sFile) = 0);
   PROCESSERROR();
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Target View Zero Out
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cRandomIntA = NUMBERTOSTRING(INT(RAND() * 100000));

cViewName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
cSubsetName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;

VIEWCREATE(cImportCube, cViewName, 1);
nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(cImportCube);
WHILE(nCtr <= nMax);
   sDim = TABDIM(cImportCube, nCtr);
   IF(sDim @= 'Version');
      sElement = pVersion;
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cImportCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Period');
      sElement = pPeriod;
      sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({Descendants([ ' | sDim | '].[' | sElement | '])}, 0)}, ASC)}';
      SUBSETCREATEBYMDX(cSubsetName, sMdx, 1);
      VIEWSUBSETASSIGN(cImportCube, cViewName, sDim, cSubsetName);
   ENDIF;

   nCtr = nCtr + 1;
END;

VIEWZEROOUT(cImportCube, cViewName);

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Define Source
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#


sBaseFilesPath = CELLGETS('TAP System Info', 'Files Shared Path', 'Value');

sFilePath = sBaseFilesPath | '/ops/';
sFile = sFilePath | cFileName;

DatasourceNameForClient = sFile;
DatasourceNameForServer = sFile;

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: METADATA PROCEDURE                                                   #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****



# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: METADATA PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# ==================================================================== #
# Load Forecast Data
# ==================================================================== #

IF(v6 @= 'BPO Contacts');
   v6 = 'Support Contacts - Virtual';
   v7 = 'BPO';
ELSEIF(v6 @= 'COE Contacts');
   v6 = 'Support Contacts - Virtual';
   v7 = 'COE';
ELSEIF(v6 @= 'Pre-FT Greenlight Contacts');
   v6 = 'Support Contacts - Greenlight';
   v7 = 'PRE-FT';
ELSEIF(v6 @= 'Post-FT Greenlight Contacts');
   v6 = 'Support Contacts - Greenlight';
   v7 = 'POST-FT';
ENDIF;


IF(pLevel @= 'Month');
   IF(DIMIX('Rate Type', v9) = 0 % DIMIX('OPS Metric', v6) = 0);

      ITEMSKIP;
   ENDIF;
ELSE;
   IF(DIMIX('Rate Type', v8) = 0 % DIMIX('OPS Metric', v5) = 0);
      ITEMSKIP;
   ENDIF;
   IF(DIMIX('Period', v2) < DIMIX('Period', cCurrWeek));
      ITEMSKIP;
   ENDIF;
ENDIF;


IF(pLevel @= 'Month');
   CELLINCREMENTN(v11, cImportCube, cVersion, v2, v8, v9, v5, v3, v7, v6, 'Amount');
ELSE;
   CELLINCREMENTN(STRINGTONUMBER(v10), cImportCube, cVersion, v2, v7, v8, v4, v3, v6, v5, 'Amount');
ENDIF;







# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
