# Process to load MAPC metrics to Ops cube

nTimeNow = NOW;
sTimeStart = TIMST(nTimeNow, '\Y\m\d\h\i\s');

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Define Constants
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

TRUE = 1;
FALSE = 0;
nAutoCleanup = TRUE;
nDecimalValue = 0.0000000001;

cCube = 'Ops';
cVersion = 'Actual';
cRateType = 'USD';
cMeasure = 'Amount';
cSource = 'FDS';
cSourceAdj = 'Ops Adjustment';
cProductType = 'Unspecified Product Type';

sDimVersion = 'Version';
sDimPeriod = 'Period';
sDimSource = 'Source';
sDimLocation = 'Location';
sDimLob = 'Line of Business';
sDimOpsMetric = 'Ops Metric';
sDimMeas = 'Ops Measure';

###Record count dashboard
cRecordCount = 0;
cLoaddate = TODAY(1);
cCubeDash = 'Dashboard';
cRCube = 'Ops';
rMetric = 'Operational';
##

cPeriodString = '';

cUser = CELLGETS('System Info', 'SQL User Name GL Transactions', 'String');
cPassword = CELLGETS('System Info', 'SQL Password GL Transactions', 'String');

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Set Query
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

DatasourceUsername = cUser;
DatasourcePassword = cPassword;
sQuery = EXPAND('SELECT * FROM "%pTable%"');
DatasourceQuery = sQuery;

#==============================================================================
# Target View Formation
#==============================================================================

sView = 'zTempTI' | GETPROCESSNAME | sTimeStart | NUMBERTOSTRING(RAND());
sSub = sView;
sSubAltHier = sView | '_AltHier';
sSubLeaf = sView | '_Leaf';

IF(VIEWEXISTS(cCube, sView) = 1);
   VIEWDESTROY(cCube, sView);
ENDIF;
VIEWCREATE(cCube, sView, 1);

nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(cCube);
sMDX = '';

WHILE(nCtr <= nMax);

   sDim = TABDIM(cCube, nCtr);

   IF(SUBSETEXISTS(sDim, sSub) = 1);
      SUBSETDESTROY(sDim, sSub);
   ENDIF;
   SUBSETCREATE(sDim, sSub, 1);

   IF(sDim @= sDimVersion);
      sMDX = '{[' | sDim | '].[Actual]}';

   ELSEIF(sDim @= sDimPeriod);
      sMDX = '';

   ELSEIF(sDim @= sDimSource);
      sMDX = '{[' | sDim | '].[FDS], [' | sDim | '].[Ops Adjustment]}';

   ELSEIF(sDim @= sDimOpsMetric);
      #sMDX = '{TM1FILTERBYLEVEL( TM1DRILLDOWNMEMBER( {[' | sDim | '].[MAPC Metrics]}, ALL, RECURSIVE ), 0 )}';
      sMDX = '{[' | sDim | '].[Active Users], [' | sDim | '].[New Users], [' | sDim | '].[Unique Users], [' | sDim | '].[Unique New Users], [' | sDim | '].[X-Platform Users], [' | sDim | '].[X-Platform New Users]}';

   ELSEIF(sDim @= sDimMeas);
      sMDX = '{[' | sDim | '].[Amount]}';

   ELSE;
      sMDX = '{TM1FILTERBYLEVEL({TM1SUBSETALL([' | sDim | '])}, 0)}';
   ENDIF;

   IF(sMDX @<> '');
      SUBSETMDXSET(sDim, sSub, sMDX);
      SUBSETMDXSET(sDim, sSub, '');
   ENDIF;

   VIEWSUBSETASSIGN(cCube, sView, sDim, sSub);

   nCtr = nCtr + 1;
END;

VIEWEXTRACTSKIPZEROESSET(cCube, sView, TRUE);
VIEWEXTRACTSKIPRULEVALUESSET(cCube, sView, TRUE);
VIEWEXTRACTSKIPCALCSSET(cCube, sView, TRUE);


##### Subset creation for clearing out data stored against alternate hierarchies of Location and LOB dimensions #####

### Location dimension ###
sDim = sDimLocation;
IF(SUBSETEXISTS(sDim, sSubAltHier) = 1);
   SUBSETDESTROY(sDim, sSubAltHier);
ENDIF;
SUBSETCREATE(sDim, sSubAltHier, 1);

sMDX = '{[' | sDim | '].[Total Location], {TM1FILTERBYPATTERN( {TM1SUBSETALL( [' | sDim | '] )}, "*(Mega Region)")}, {TM1FILTERBYPATTERN( {TM1SUBSETALL( [' | sDim | '] )}, "Country -*")}}';
SUBSETMDXSET(sDim, sSubAltHier, sMDX);
SUBSETMDXSET(sDim, sSubAltHier, '');

nLocationAltHierCount = SUBSETGETSIZE(sDim, sSubAltHier);
nLocationMainHierCount = SUBSETGETSIZE(sDim, sSub);

# Create subset
IF(SUBSETEXISTS(sDim, sSubLeaf) = 1);
   SUBSETDESTROY(sDim, sSubLeaf);
ENDIF;
SUBSETCREATE(sDim, sSubLeaf, 1);


### Line of Business dimension ###
sDim = sDimLob;
IF(SUBSETEXISTS(sDim, sSubAltHier) = 1);
   SUBSETDESTROY(sDim, sSubAltHier);
ENDIF;
SUBSETCREATE(sDim, sSubAltHier, 1);

sMDX = '{[' | sDim | '].[Total Rides & Eats], [' | sDim | '].[Delivery ex M&A], [' | sDim | '].[Mobility ex M&A], [' | sDim | '].[Total Careem]}';
SUBSETMDXSET(sDim, sSubAltHier, sMDX);
SUBSETMDXSET(sDim, sSubAltHier, '');

nLobAltHierCount = SUBSETGETSIZE(sDim, sSubAltHier);
nLobMainHierCount = SUBSETGETSIZE(sDim, sSub);

# Get Leaf level Mobility LOB Element
IF(SUBSETEXISTS(sDim, sSubLeaf) = 1);
   SUBSETDESTROY(sDim, sSubLeaf);
ENDIF;
SUBSETCREATE(sDim, sSubLeaf, 1);

nElemCount = 0;
sMDX = '{TM1FILTERBYLEVEL( TM1DRILLDOWNMEMBER( {[' | sDim | '].[Mobility ex M&A]}, ALL, RECURSIVE ), 0 )}';
SUBSETMDXSET(sDim, sSubLeaf, sMDX);
nElemCount = SUBSETMDXSET(sDim, sSubLeaf, '');
IF(nElemCount > 0);
   sMobilityLeaf = SUBSETGETELEMENTNAME(sDim, sSubLeaf, 1);
ENDIF;

# Get Leaf level Delivery LOB Element
nElemCount = 0;
sMDX = '{TM1FILTERBYLEVEL( TM1DRILLDOWNMEMBER( {[' | sDim | '].[Delivery ex M&A]}, ALL, RECURSIVE ), 0 )}';
SUBSETMDXSET(sDim, sSubLeaf, sMDX);
nElemCount = SUBSETMDXSET(sDim, sSubLeaf, '');
IF(nElemCount > 0);
   sDeliveryLeaf = SUBSETGETELEMENTNAME(sDim, sSubLeaf, 1);
ENDIF;

### Ops Metric dimension ###
sDim = sDimOpsMetric;
nOpsMetricCount = SUBSETGETSIZE(sDim, sSub);





# ================= TAPTOOLS: START GENERATED CODE =================== #
nPrologProcedureEndTime = NOW();
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "' | DatasourceType | '"');
