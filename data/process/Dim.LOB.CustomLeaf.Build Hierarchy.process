# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #

# ================= TAPTOOLS: START GENERATED CODE =================== #
sProcessName = GETPROCESSNAME();
IF(sProcessName @<> 'TAP.Call.Queue.Add Job To Queue' & sProcessName @<> 'TAP.CubeSaveData' & sProcessName @<> 'TAP.Call.Save' & sProcessName @<> 'TAP.Call.Recurring' & sProcessName @<> 'DIQ.Call.Batch' & sProcessName @<> 'TAP.Call.Save.Wrapper' & sProcessName @<> 'TAP.Call.CubeSaveData.Wrapper' & sProcessName @<> 'TAP.Call.Tests' & sProcessName @<> 'TAP.Call.Init' & sProcessName @<> 'TAP.Call.Export Application Stats' & sProcessName @<> 'TAP.Cube.Export Data to File' & SCAN('}drill', LOWER(sProcessName)) = 0);
   sBlock.Execution.Status = CELLGETS('TAP System Info', 'Block Process Execution', 'Value');
   IF(UPPER(sBlock.Execution.Status) @= 'YES');
      sBlock.Epilog.Execution = 'Yes';
      PROCESSBREAK;
   ENDIF;
ENDIF;
LOGOUTPUT('DEBUG', 'PARAMETER: pDebug: "' | NUMBERTOSTRING(pDebug) | '"');
LOGOUTPUT('DEBUG', 'PROGRESS: START PROLOG PROCEDURE');
nMetadataProcedureRecordsStarted = 0;
nMetadataProcedureRecordsSkipped = 0;
nMetadataProcedureRecordsRejected = 0;
nMetadataProcedureRecordsCompleted = 0;
nDataProcedureRecordsStarted = 0;
nDataProcedureRecordsSkipped = 0;
nDataProcedureRecordsRejected = 0;
nDataProcedureRecordsCompleted = 0;
nPrologProcedureDataOperations = 0;
nDataProcedureDataOperations = 0;
nTotalDataOperations = 0;
nPrologProcedureMetadataOperations = 0;
nMetadataProcedureMetadataOperations = 0;
nDataProcedureMetadataOperations = 0;
nEpilogProcedureMetadataOperations = 0;
nTotalProcedureMetadataOperations = 0;
nPrologProcedureStartTime = NOW();
nPrologProcedureEndTime = 0;
nMetadataProcedureStartTime = 0;
nMetadataProcedureEndTime = 0;
nDataProcedureStartTime = 0;
nDataProcedureEndTime = 0;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****


# ==================================================================== #
# Globals
# ==================================================================== #

pSourceDim = 'Line of Business';
pTargetDim = 'Line of Business:CustomLeaf';


EXECUTEPROCESS('Bedrock.Dim.Hierarchy.Unwind.All'
   , 'pDimension', pTargetDim
   , 'pDebug', pDebug
);

# ==================================================================== #
# Create N-level elements in target hierarchy
# ==================================================================== #

nSourceDimSize = DIMSIZ(pSourceDim);
nIndex = 1;
WHILE(nIndex <= nSourceDimSize);
   sElName = DIMNM(pSourceDim, nIndex);
   sElType = DTYPE(pSourceDim, sElName);

   IF(pDebug <= 1);
      # ================= TAPTOOLS: START GENERATED CODE =================== #
      nPrologProcedureMetadataOperations = nPrologProcedureMetadataOperations + 1;
      # ================= TAPTOOLS: END GENERATED CODE ===================== #
      DIMENSIONELEMENTINSERT(pTargetDim, '', sElName, sElType);
   ENDIF;
   nIndex = nIndex + 1;
END;

# ==================================================================== #
# Assign data source
# ==================================================================== #

DatasourceNameForServer = pSourceDim;
DatasourceNameForClient = pSourceDim;
DatasourceType = 'SUBSET';
DatasourceDimensionSubset = 'All';

# ================= TAPTOOLS: START GENERATED CODE =================== #
nPrologProcedureEndTime = NOW();
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "' | DatasourceType | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceNameForServer: "' | DatasourceNameForServer | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceCubeView: "' | DatasourceCubeView | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceDimensionSubset: "' | DatasourceDimensionSubset | '"');
LOGOUTPUT('DEBUG', 'PROGRESS: END PROLOG PROCEDURE');
# ================= TAPTOOLS: END GENERATED CODE ===================== #

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: METADATA PROCEDURE                                                   #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #

# ================= TAPTOOLS: START GENERATED CODE =================== #
nMetadataProcedureRecordsStarted = nMetadataProcedureRecordsStarted + 1;
IF(nMetadataProcedureStartTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: START METADATA PROCEDURE');
   nMetadataProcedureStartTime = NOW();
ENDIF;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****


# ==================================================================== #
# Build hierarchy - Add Elements to target hierarchy
# ==================================================================== #


IF(pDebug <= 1);
   sElType = DTYPE(pSourceDim, vLOB);
   IF(sELTYPE @= 'C' & ELCOMPN(pSourceDim, vLOB) > 0);
      nChildren = ELCOMPN(pSourceDim, vLOB);
      IF(vLOB @= 'Total Rides & Eats' % vLOB @= 'Total Careem' % vLOB @= 'Delivery ex M&A' % vLOB @= 'Mobility ex M&A');
         # ================= TAPTOOLS: START GENERATED CODE =================== #
         nMetadataProcedureMetadataOperations = nMetadataProcedureMetadataOperations + 1;
         # ================= TAPTOOLS: END GENERATED CODE ===================== #
         DIMENSIONELEMENTINSERT(pTargetDim, '', vLOB | ' Input', 'N');
         # ================= TAPTOOLS: START GENERATED CODE =================== #
         nMetadataProcedureMetadataOperations = nMetadataProcedureMetadataOperations + 1;
         # ================= TAPTOOLS: END GENERATED CODE ===================== #
         DIMENSIONELEMENTCOMPONENTADD(pTargetDim, vLOB, vLOB | ' Input', 1);
      ENDIF;
      nCount = 1;
      WHILE(nCount <= nChildren);
         sChildElement = ELCOMP(pSourceDim, vLOB, nCount);
         sChildWeight = ELWEIGHT(pSourceDim, vLOB, sChildElement);
         # ================= TAPTOOLS: START GENERATED CODE =================== #
         nMetadataProcedureMetadataOperations = nMetadataProcedureMetadataOperations + 1;
         # ================= TAPTOOLS: END GENERATED CODE ===================== #
         DIMENSIONELEMENTCOMPONENTADD(pTargetDim, vLOB, sChildElement, sChildWeight);
         nCount = nCount + 1;
      END;
   ENDIF;
ENDIF;

# ================= TAPTOOLS: START GENERATED CODE =================== #
nMetadataProcedureRecordsCompleted = nMetadataProcedureRecordsCompleted + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: METADATA PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: EPILOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #

# ================= TAPTOOLS: START GENERATED CODE =================== #
IF(sBlock.Epilog.Execution @= 'Yes');
   LOGOUTPUT('ERROR', 'Block Process Execution Flag is Yes in TAP System Info Cube. Skipping this process...');
   PROCESSERROR;
ENDIF;
IF(nPrologProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "NULL"');
   LOGOUTPUT('DEBUG', 'PROGRESS: END PROLOG PROCEDURE');
   nPrologProcedureEndTime = NOW();
ENDIF;
IF(nMetadataProcedureStartTime > 0 & nMetadataProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: END METADATA PROCEDURE');
   nMetadataProcedureEndTime = NOW();
ENDIF;
IF(nDataProcedureStartTime > 0 & nDataProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: END DATA PROCEDURE');
   nDataProcedureEndTime = NOW();
ENDIF;
LOGOUTPUT('DEBUG', 'PROGRESS: START EPILOG PROCEDURE');
nEpilogProcedureStartTime = NOW();
# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****

# ================= TAPTOOLS: START GENERATED CODE =================== #
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: PrologProcedureRuntime: "' | NUMBERTOSTRING(ROUNDP((nPrologProcedureEndTime - nPrologProcedureStartTime) * 86400, 2)) | '"');
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: PrologProcedureMetadataOperations: "' | NUMBERTOSTRING(nPrologProcedureMetadataOperations) | '"');
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: PrologProcedureDataOperations: "' | NUMBERTOSTRING(nPrologProcedureDataOperations) | '"');

LOGOUTPUT('DEBUG', 'PROCESS_METRIC: MetadataProcedureRuntime: "' | NUMBERTOSTRING(ROUNDP((nMetadataProcedureEndTime - nMetadataProcedureStartTime) * 86400, 2)) | '"');
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: MetadataProcedureMetadataOperations: "' | NUMBERTOSTRING(nMetadataProcedureMetadataOperations) | '"');
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: MetadataProcedureRecordsStarted: "' | NUMBERTOSTRING(nMetadataProcedureRecordsStarted) | '"');
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: MetadataProcedureRecordsSkipped: "' | NUMBERTOSTRING(nMetadataProcedureRecordsSkipped) | '"');
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: MetadataProcedureRecordsRejected: "' | NUMBERTOSTRING(nMetadataProcedureRecordsRejected) | '"');
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: MetadataProcedureRecordsCompleted: "' | NUMBERTOSTRING(nMetadataProcedureRecordsCompleted) | '"');

LOGOUTPUT('DEBUG', 'PROCESS_METRIC: DataProcedureRuntime: "' | NUMBERTOSTRING(ROUNDP((nDataProcedureEndTime - nDataProcedureStartTime) * 86400, 2)) | '"');
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: DataProcedureMetadataOperations: "' | NUMBERTOSTRING(nDataProcedureMetadataOperations) | '"');
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: DataProcedureDataOperations: "' | NUMBERTOSTRING(nDataProcedureDataOperations) | '"');
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: DataProcedureRecordsStarted: "' | NUMBERTOSTRING(nDataProcedureRecordsStarted) | '"');
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: DataProcedureRecordsSkipped: "' | NUMBERTOSTRING(nDataProcedureRecordsSkipped) | '"');
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: DataProcedureRecordsRejected: "' | NUMBERTOSTRING(nDataProcedureRecordsRejected) | '"');
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: DataProcedureRecordsCompleted: "' | NUMBERTOSTRING(nDataProcedureRecordsCompleted) | '"');

LOGOUTPUT('DEBUG', 'PROCESS_METRIC: EpilogProcedureRuntime: "' | NUMBERTOSTRING(ROUNDP((NOW() - nEpilogProcedureStartTime) * 86400, 2)) | '"');
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: EpilogProcedureMetadataOperations: "' | NUMBERTOSTRING(nEpilogProcedureMetadataOperations) | '"');

nTotalDataOperations = nPrologProcedureDataOperations + nDataProcedureDataOperations;
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: TotalDataOperations: "' | NUMBERTOSTRING(nTotalDataOperations) | '"');
nTotalMetadataOperations = nPrologProcedureMetadataOperations + nMetadataProcedureMetadataOperations + nDataProcedureMetadataOperations + nEpilogProcedureMetadataOperations;
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: TotalMetadataOperations: "' | NUMBERTOSTRING(nTotalMetadataOperations) | '"');
LOGOUTPUT('DEBUG', 'PROGRESS: END EPILOG PROCEDURE');
# ================= TAPTOOLS: END GENERATED CODE ===================== #

