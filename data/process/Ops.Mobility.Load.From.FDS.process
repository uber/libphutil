# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# Constants

cCube = 'Mobility';
nRecords = 1;

cMetricString = '';

cUser = CELLGETS('System Info', 'SQL User Name GL Transactions', 'String');
cPassword = CELLGETS('System Info', 'SQL Password GL Transactions', 'String');


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Set Query
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

DatasourceUsername = cUser;
DatasourcePassword = cPassword;
sQuery = EXPAND('SELECT * FROM "%pTable%"');
DatasourceQuery = sQuery;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Subsets for View Zero Out
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cRandomIntA = NUMBERTOSTRING(INT(RAND() * 100000));
cSubset = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
cViewName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
VIEWCREATE(cCube, cViewName, 1);


nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(cCube);

WHILE(nCtr <= nMax);
   sDim = TABDIM(cCube, nCtr);

   IF(sDim @= 'Version');
      sElement = 'Actual';
      SUBSETCREATE(sDim, cSubset, 1);
      SUBSETELEMENTINSERT(sDim, cSubset, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Period');
      SUBSETCREATE(sDim, cSubset, 1);
      IF(pStartDate @<> '' & pEndDate @<> '' & pLevel @= 'Day');
         nStartday = DAYNO(SUBST(pStartDate, 1, 10));
         nEndday = DAYNO(SUBST(pEndDate, 1, 10));
         WHILE(nStartday <= nEndDay);
            sDay = DATE(nStartday, 1);
            SUBSETELEMENTINSERT(sDim, cSubset, sDay, 1);
            nStartday = nStartday + 1;
         END;
      ENDIF;
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Source');
      sElement = 'FDS';
      SUBSETCREATE(sDim, cSubset, 1);
      SUBSETELEMENTINSERT(sDim, cSubset, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Mobility Ops Metrics');
      SUBSETCREATE(sDim, cSubset, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Mobility Staging Measure');
      sElement = 'Amount';
      SUBSETCREATE(sDim, cSubset, 1);
      SUBSETELEMENTINSERT(sDim, cSubset, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Rate Type');
      sMDX = '{TM1SubsetToSet([Rate Type], ''All Rate Types'')}';
      SUBSETCREATEBYMDX(cSubset, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSE;
      sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({TM1SUBSETALL([ ' | sDim | '] )}, 0)}, ASC)}';
      SUBSETCREATEBYMDX(cSubset, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ENDIF;

   nCtr = nCtr + 1;
END;


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: METADATA PROCEDURE                                                   #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: METADATA PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# Month

IF(pLevel @= 'Month');
   sPeriod = SUBST(vPeriod, 1, 7);
ELSEIF(pLevel @= 'Day');
   sPeriod = vPeriod;
ELSE;
   sPeriod = 'WS ' | vPeriod;
ENDIF;


IF(SUBSETELEMENTEXISTS('Period', cSubset, sPeriod) = 0);
   ITEMSKIP;
ENDIF;

#Metric
sMetric = vMetric;
vFeature = '';

# Location
sDim = 'Location';
IF(vLocation @= '\N' % vLocation @= '' % vLob @= '\N');
   ITEMSKIP;
ENDIF;
sLocation = 'V' | vLocation;

IF(DIMIX('Location', sLocation) = 0);
   ITEMSKIP;
ENDIF;

# LOB
IF(vLob @= '\N' % vLob @= '' % DIMIX('Line of Business', vLob) = 0);
   ITEMSKIP;
ENDIF;

# Product
IF(vProduct @= '\N' % vProduct @= '');
   vProduct = 'Unspecified product type';
ELSEIF(vProduct @= 'Others');
   vProduct = 'Other';
ENDIF;


# Features

IF(vAir @= '\N' % vAir @= '' % vMem @= '\N' % vMem @= '' % vRes @= '\N' % vRes @= '' % vU4B @= '\N' % vU4B @= '' % vU4BH @= '\N' % vu4BH @= '' % vZir @= '\N' % vZir @= '');
   vFeature = 'Unspecified Mobility Features';
ENDIF;

IF(vAir @= '1' % vAir @= 'True');
   sAir = 'T';
ELSE;
   sAir = 'F';
ENDIF;

IF(vMem @= '1' % vMem @= 'True');
   sMem = 'T';
ELSE;
   sMem = 'F';
ENDIF;

IF(vRes @= '1' % vRes @= 'True');
   sRes = 'T';
ELSE;
   sRes = 'F';
ENDIF;

IF(vZir @= '1' % vZir @= 'True');
   sZir = 'T';
ELSE;
   sZir = 'F';
ENDIF;

IF(vU4B @= '1' % vU4B @= 'True');
   sU4B = 'T';
ELSE;
   sU4B = 'F';
ENDIF;

IF(vU4BH @= '1' % vU4BH @= 'True');
   sU4BH = 'T';
ELSE;
   sU4BH = 'F';
ENDIF;


IF(vFeature @<> 'Unspecified Mobility Features');
   vFeature = 'Air(' | sAir | ') Mem(' | sMem | ') Res(' | sRes | ') U4B(' | sU4B | ') U4BH(' | sU4BH | ') Zir(' | sZir | ')';
ENDIF;


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Clear Target View
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
#Scanning the Input to find metrics  to be zeroed out

IF(DIMIX('Mobility Ops Metrics', sMetric) = 0);
   ITEMSKIP;
ENDIF;


IF(SCAN(sMetric, cMetricString) = 0);
   cMetricString = cMetricString | sMetric | '|';
   SUBSETDELETEALLELEMENTS('Mobility Ops Metrics', cSubset);
   SUBSETELEMENTINSERT('Mobility Ops Metrics', cSubset, sMetric, 1);
   VIEWZEROOUT(cCube, cViewName);
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Load Data
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

sDim = 'Rate Type';
p = 1;
sSubset = 'All Rate Types';
count = SUBSETGETSIZE(sDim, sSubset);
WHILE(p <= count);
   sRateType = SUBSETGETELEMENTNAME(sDim, sSubset, p);
   IF(ELLEV(sDim, sRateType) = 0);
      CELLPUTN(vValue, cCube, 'Actual', sPeriod, 'FDS', sRateType, vLob, '0000', sLocation, vProduct, vFeature, sMetric, 'Amount');
   ENDIF;
   p = p + 1;
END;












# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: EPILOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


sProcess = 'Ops.Mobility.From Day Month';

EXECUTEPROCESS(sProcess
   , 'pStartDate', pStartDate
   , 'pEndDate', pEndDate
   , 'pMetrics', cMetricString
);
);
sProcess = 'Ops.Load.Completed.Trips.From.Mobility';

EXECUTEPROCESS(sProcess
   , 'pVersion', 'Actual'
   , 'pStartDate', pStartDate
   , 'pEndDate', pEndDate
);


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: EPILOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #