# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROPERTIES                                                           #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
{
    "DataSource": {
        "Type": "TM1CubeView",
        "dataSourceNameForClient": "Mobility",
        "dataSourceNameForServer": "Mobility",
        "view": "ztemp_test"
    },
    "HasSecurityAccess": false,
    "Name": "Temp_Mobility Forecast.Perform Actuals Copy On Version Snapshot",
    "Parameters": [
        {
            "Name": "pTargetVersion",
            "Prompt": "",
            "Type": "String",
            "Value": ""
        }
    ],
    "UIData": "CubeAction=1511\fDataAction=1503\fCubeLogChanges=0\f",
    "Variables": [
        {
            "EndByte": 0,
            "Name": "vVersion",
            "Position": 1,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vPeriod",
            "Position": 2,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vSource",
            "Position": 3,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vRateType",
            "Position": 4,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vLineofBusiness",
            "Position": 5,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vDepartment",
            "Position": 6,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vLocation",
            "Position": 7,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vProductType",
            "Position": 8,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vMobilityFeatures",
            "Position": 9,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vMobilityOpsMetrics",
            "Position": 10,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vMobilityMeasure",
            "Position": 11,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vValue",
            "Position": 12,
            "StartByte": 0,
            "Type": "Numeric"
        }
    ],
    "VariablesUIData": [
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
