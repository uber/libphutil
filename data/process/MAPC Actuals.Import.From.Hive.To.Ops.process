# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****

#Exclude unnecessary source data combination

IF(vLOB @= 'Online Food Delivery ex M&A' % vSource @= 'FDS+Ops Adjustment');
   ITEMSKIP;
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Clear Target View
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
#Scanning the Input to find Period to be zeroed out

IF(SCAN(vPeriod, cPeriodString) = 0);
   cPeriodString = cPeriodString | vPeriod | '|';
   SUBSETDELETEALLELEMENTS(sDimPeriod, sSub);
   SUBSETELEMENTINSERT(sDimPeriod, sSub, vPeriod, 1);

   ### Clear out numbers from main hierachies of Location and LOB dimensions ###
   VIEWZEROOUT(cCube, sView);

   ### Clear out numbers from alternate hierachies of Location and LOB dimensions ###
   nCounterLoc = 1;
   WHILE(nCounterLoc <= nLocationAltHierCount);
      sLoc = SUBSETGETELEMENTNAME(sDimLocation, sSubAltHier, nCounterLoc);

      nCounterLob = 1;
      WHILE(nCounterLob <= nLobAltHierCount);
         sLob = SUBSETGETELEMENTNAME(sDimLob, sSubAltHier, nCounterLob);

         nCounterMetric = 1;
         WHILE(nCounterMetric <= nOpsMetricCount);
            sMetric = SUBSETGETELEMENTNAME(sDimOpsMetric, sSub, nCounterMetric);

            # ================= TAPTOOLS: START GENERATED CODE =================== #
            nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
            # ================= TAPTOOLS: END GENERATED CODE ===================== #
            CELLPUTN(0, cCube, cVersion, vPeriod, cSource, cRateType, 'CustomLeaf:' | sLoc | ' Input', 'CustomLeaf:' | sLob | ' Input', cProductType, sMetric, cMeasure);
            # ================= TAPTOOLS: START GENERATED CODE =================== #
            nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
            # ================= TAPTOOLS: END GENERATED CODE ===================== #
            CELLPUTN(0, cCube, cVersion, vPeriod, cSourceAdj, cRateType, 'CustomLeaf:' | sLoc | ' Input', 'CustomLeaf:' | sLob | ' Input', cProductType, sMetric, cMeasure);

            nCounterMetric = nCounterMetric + 1;
         END;

         nCounterLob = nCounterLob + 1;
      END;

      nCounterLoc = nCounterLoc + 1;
   END;

   ### Clear out numbers from main hierachy of Location and alternate hierarchy of LOB dimension ###
   nCounterLoc = 1;
   WHILE(nCounterLoc <= nLocationMainHierCount);
      sLoc = SUBSETGETELEMENTNAME(sDimLocation, sSub, nCounterLoc);

      nCounterLob = 1;
      WHILE(nCounterLob <= nLobAltHierCount);
         sLob = SUBSETGETELEMENTNAME(sDimLob, sSubAltHier, nCounterLob);

         nCounterMetric = 1;
         WHILE(nCounterMetric <= nOpsMetricCount);
            sMetric = SUBSETGETELEMENTNAME(sDimOpsMetric, sSub, nCounterMetric);

            # ================= TAPTOOLS: START GENERATED CODE =================== #
            nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
            # ================= TAPTOOLS: END GENERATED CODE ===================== #
            CELLPUTN(0, cCube, cVersion, vPeriod, cSource, cRateType, sLoc, 'CustomLeaf:' | sLob | ' Input', cProductType, sMetric, cMeasure);
            # ================= TAPTOOLS: START GENERATED CODE =================== #
            nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
            # ================= TAPTOOLS: END GENERATED CODE ===================== #
            CELLPUTN(0, cCube, cVersion, vPeriod, cSourceAdj, cRateType, sLoc, 'CustomLeaf:' | sLob | ' Input', cProductType, sMetric, cMeasure);

            nCounterMetric = nCounterMetric + 1;
         END;

         nCounterLob = nCounterLob + 1;
      END;

      nCounterLoc = nCounterLoc + 1;
   END;

   ### Clear out numbers from alternate hierachiy of Location and main hierarchy of LOB dimension ###
   nCounterLoc = 1;
   WHILE(nCounterLoc <= nLocationAltHierCount);
      sLoc = SUBSETGETELEMENTNAME(sDimLocation, sSubAltHier, nCounterLoc);

      nCounterLob = 1;
      WHILE(nCounterLob <= nLobMainHierCount);
         sLob = SUBSETGETELEMENTNAME(sDimLob, sSub, nCounterLob);

         nCounterMetric = 1;
         WHILE(nCounterMetric <= nOpsMetricCount);
            sMetric = SUBSETGETELEMENTNAME(sDimOpsMetric, sSub, nCounterMetric);

            # ================= TAPTOOLS: START GENERATED CODE =================== #
            nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
            # ================= TAPTOOLS: END GENERATED CODE ===================== #
            CELLPUTN(0, cCube, cVersion, vPeriod, cSource, cRateType, 'CustomLeaf:' | sLoc | ' Input', sLob, cProductType, sMetric, cMeasure);
            # ================= TAPTOOLS: START GENERATED CODE =================== #
            nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
            # ================= TAPTOOLS: END GENERATED CODE ===================== #
            CELLPUTN(0, cCube, cVersion, vPeriod, cSourceAdj, cRateType, 'CustomLeaf:' | sLoc | ' Input', sLob, cProductType, sMetric, cMeasure);

            nCounterMetric = nCounterMetric + 1;
         END;

         nCounterLob = nCounterLob + 1;
      END;

      nCounterLoc = nCounterLoc + 1;
   END;

ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Load Data
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

IF(ELLEV('Line of Business', vLOB) > 0 & ELLEV('Location', vLocation) > 0);

   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   CELLPUTN(vValue, cCube, cVersion, vPeriod, vSource, cRateType, 'CustomLeaf:' | vLocation | ' Input', 'CustomLeaf:' | vLOB | ' Input', cProductType, vMetric, cMeasure);
   cRecordCount = cRecordCount + 1;

   #### X-Platform metrics are always present at M&A level, Total Rides & Eats level in LOB dimension and at city level, country level & above in Location dimension ###
   ### Since we dont have numbers at leaf LOB level, the numbers at higher levels (calculated via rules from Alternate hierarchy) are not fed ###
   ### Hence putting in a small decimal value at leaf level element for X-Platform MAPC metrics so that the C level elements are fed naturally ###
   IF((vMetric @= 'X-Platform Users' % vMetric @= 'X-Platform New Users') & SUBST(vLocation, 1, 10) @= 'Country - ');

      # Get the 7 series country element 
      nElemCount = 0;
      sMDX = '{TM1FILTERBYPATTERN( {TM1FILTERBYLEVEL( TM1DRILLDOWNMEMBER( {[' | sDimLocation | '].[' | vLocation | ']}, ALL, RECURSIVE ), 0 )}, "7*")}';
      SUBSETMDXSET(sDimLocation, sSubLeaf, sMDX);
      nElemCount = SUBSETMDXSET(sDimLocation, sSubLeaf, '');
      IF(nElemCount > 0);
         sCountryLeaf = SUBSETGETELEMENTNAME(sDimLocation, sSubLeaf, 1);

         IF(vLOB @= 'Mobility ex M&A');
            # ================= TAPTOOLS: START GENERATED CODE =================== #
            nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
            # ================= TAPTOOLS: END GENERATED CODE ===================== #
            CELLPUTN(nDecimalValue, cCube, cVersion, vPeriod, vSource, cRateType, sCountryLeaf, sMobilityLeaf, cProductType, vMetric, cMeasure);
         ELSEIF(vLOB @= 'Delivery ex M&A');
            # ================= TAPTOOLS: START GENERATED CODE =================== #
            nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
            # ================= TAPTOOLS: END GENERATED CODE ===================== #
            CELLPUTN(nDecimalValue, cCube, cVersion, vPeriod, vSource, cRateType, sCountryLeaf, sDeliveryLeaf, cProductType, vMetric, cMeasure);
         ENDIF;

      ENDIF;
   ENDIF;


ELSEIF(ELLEV('Line of Business', vLOB) > 0 & ELLEV('Location', vLocation) = 0);

   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   CELLPUTN(vValue, cCube, cVersion, vPeriod, vSource, cRateType, vLocation, 'CustomLeaf:' | vLOB | ' Input', cProductType, vMetric, cMeasure);
   cRecordCount = cRecordCount + 1;
ELSEIF(ELLEV('Line of Business', vLOB) = 0 & ELLEV('Location', vLocation) > 0);

   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   CELLPUTN(vValue, cCube, cVersion, vPeriod, vSource, cRateType, 'CustomLeaf:' | vLocation | ' Input', vLOB, cProductType, vMetric, cMeasure);
   cRecordCount = cRecordCount + 1;

   #### Ops Adjustment are present at leaf LOB level & at Country level and futheron maybe at the higher levels in LOB & Location dimensions.###
   ### Since we dont have numbers at leaf city level, the numbers at Country level (calculated via rules from Alternate hierarchy) and higher are not fed ###
   ### Hence putting in a small decimal value at leaf level element for 'Ops Adjustment' so that the C level elements are fed naturally ###
   IF(vSource @= 'Ops Adjustment' & SUBST(vLocation, 1, 10) @= 'Country - ');

      # Get the 7 series country element 
      nElemCount = 0;
      sMDX = '{TM1FILTERBYPATTERN( {TM1FILTERBYLEVEL( TM1DRILLDOWNMEMBER( {[' | sDimLocation | '].[' | vLocation | ']}, ALL, RECURSIVE ), 0 )}, "7*")}';
      SUBSETMDXSET(sDimLocation, sSubLeaf, sMDX);
      nElemCount = SUBSETMDXSET(sDimLocation, sSubLeaf, '');
      IF(nElemCount > 0);
         sCountryLeaf = SUBSETGETELEMENTNAME(sDimLocation, sSubLeaf, 1);
         # ================= TAPTOOLS: START GENERATED CODE =================== #
         nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
         # ================= TAPTOOLS: END GENERATED CODE ===================== #
         CELLPUTN(nDecimalValue, cCube, cVersion, vPeriod, vSource, cRateType, sCountryLeaf, vLOB, cProductType, vMetric, cMeasure);
      ENDIF;
   ENDIF;

ELSE;

   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   CELLPUTN(vValue, cCube, cVersion, vPeriod, vSource, cRateType, vLocation, vLOB, cProductType, vMetric, cMeasure);
   cRecordCount = cRecordCount + 1;
ENDIF;



# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsCompleted = nDataProcedureRecordsCompleted + 1;
