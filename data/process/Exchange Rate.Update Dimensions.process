# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROPERTIES                                                           #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
{
    "DataSource": {
        "Type": "None"
    },
    "HasSecurityAccess": false,
    "Name": "Exchange Rate.Update Dimensions",
    "Parameters": [],
    "UIData": "CubeAction=1511\fDataAction=1503\fCubeLogChanges=0\f",
    "Variables": [],
    "VariablesUIData": []
}
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROPERTIES                                                             #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# ==================================================================== #
# Step 1: Update Dimensions
# ==================================================================== #

# ==================================================================== #
# Currency
# ==================================================================== #

sDimFrom = 'PAC.Currency';
sDimTo = 'Currency';
sElePar = 'Total Currency';

# Delete elements not in sDimFrom
i = DIMSIZ(sDimTo);
WHILE(i > 0);
   sEle = DIMNM(sDimTo, i);
   IF(DTYPE(sDimTo, sEle) @= 'N' & DIMIX(sDimFrom, sEle) = 0);
      DIMENSIONELEMENTDELETEDIRECT(sDimTo, sEle);
   ENDIF;
   i = i - 1;
END;

# Add elements not in sDimFrom
i = 1;
WHILE(i <= DIMSIZ(sDimFrom));
   sEle = DIMNM(sDimFrom, i);
   IF(DTYPE(sDimFrom, sEle) @= 'N' & DIMIX(sDimTo, sEle) = 0);
      DIMENSIONELEMENTINSERTDIRECT(sDimTo, '', sEle, 'N');
      DIMENSIONELEMENTCOMPONENTADDDIRECT(sDimTo, sElePar, sEle, 1);
   ENDIF;
   i = i + 1;
END;

# ==================================================================== #
# Currency To
# ==================================================================== #

sDimFrom = 'PAC.Currency To';
sDimTo = 'Currency To';
sElePar = 'Total Currency To';

# Delete elements not in sDimFrom
i = DIMSIZ(sDimTo);
WHILE(i > 0);
   sEle = DIMNM(sDimTo, i);
   IF(DTYPE(sDimTo, sEle) @= 'N' & DIMIX(sDimFrom, sEle) = 0);
      DIMENSIONELEMENTDELETEDIRECT(sDimTo, sEle);
   ENDIF;
   i = i - 1;
END;

# Add elements not in sDimFrom
i = 1;
WHILE(i <= DIMSIZ(sDimFrom));
   sEle = DIMNM(sDimFrom, i);
   IF(DTYPE(sDimFrom, sEle) @= 'N' & DIMIX(sDimTo, sEle) = 0);

      DIMENSIONELEMENTINSERTDIRECT(sDimTo, '', sEle, 'N');
      DIMENSIONELEMENTCOMPONENTADDDIRECT(sDimTo, sElePar, sEle, 1);
   ENDIF;
   i = i + 1;
END;

# ==================================================================== #
# Rate Type Dimension
# ==================================================================== #

sDimFrom = 'PAC.Rate Type';
sDimTo = 'Rate Type';
sElePar = 'FX Rates';

# Delete elements not in sDimFrom
i = DIMSIZ(sDimTo);
WHILE(i > 0);
   sEle = DIMNM(sDimTo, i);
   sEle = IF(sEle @= 'No Rate Type', 'Input Rate Type', sEle);
   IF(DTYPE(sDimTo, sEle) @= 'N' & DIMIX(sDimFrom, sEle) = 0);
      DIMENSIONELEMENTDELETEDIRECT(sDimTo, sEle);
   ENDIF;
   i = i - 1;
END;

sRateTypeAdded = '';
# Add elements not in sDimFrom
i = 1;
WHILE(i <= DIMSIZ(sDimFrom));
   sEle = DIMNM(sDimFrom, i);
   sArchivalType = ATTRS(sDimFrom, sEle, 'Archival Type');
   sEle = IF(sEle @= 'Input Rate Type', 'No Rate Type', sEle);

   IF(DTYPE(sDimFrom, sEle) @= 'N' & DIMIX(sDimTo, sEle) = 0 & TRIM(sArchivalType) @= '');
      DIMENSIONELEMENTINSERTDIRECT(sDimTo, '', sEle, 'N');
      DIMENSIONELEMENTCOMPONENTADDDIRECT(sDimTo, sElePar, sEle, 1);

      sRateTypeAdded = sRateTypeAdded | sEle | '|';

   ENDIF;
   i = i + 1;
END;
#####
sLoopString = TRIM(sRateTypeAdded);
sA = '';
# If at least one rate type is present (using 1 below to factor in | separator)
IF(LONG(sLoopString) > 1);

   sLoopString = sLoopString | IF(SUBST(sLoopString, LONG(sLoopString), 1) @<> '|', '|', '');
   nStart = 1;
   nCurPos = 1;

   WHILE(nCurPos <= LONG(sLoopString));
      sCurChar = SUBST(sLoopString, nCurPos, 1);
      IF(sCurChar @= '|');
         sRateType = SUBST(sLoopString, nStart, nCurPos - nStart);
         nExists = SCAN(LOWER(sRateType), LOWER(sA));
         IF(nExists = 0);
            sA = sA | IF(SUBST(sA, LONG(sA), 1) @<> '|', '|', '') | sRateType;
         ENDIF;
         nStart = nCurPos + 1;
      ENDIF;
      nCurPos = nCurPos + 1;
   END;

ENDIF;

IF(TRIM(sA) @<> '');
   CELLPUTS(sA, 'Admin Playbook', 'Exchange Rate Sync', 'Added Rate Types');
ENDIF;


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
