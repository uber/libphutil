#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
# Allocate GL Operational based on Delivery FDS
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

# Summary: This process allocates Oracle data by Del Dimensions / Features that is recieved from FDS. 
# Non-FDS data points will be allocated based on User specified login in the Mobility PL Allocation cube. 

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
## Initialise Constants               ##
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cSourceCube = 'ANALYTICS.GL Operational';
cTargetCube = 'Delivery';
cAllocCube = 'Delivery PL Allocation';

cRand = NUMBERTOSTRING(ROUND(RAND() * 100000));
cRand = FILL('0', 6 - LONG(cRand)) | cRand;
cRand = NUMBERTOSTRING(NOW()) | '.' | cRand;
cRandomIntA = cRand;
cViewName = 'zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
cSubsetName = 'zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;

cDimOpsAcc = 'GL Operational';
cDimFDSAcc = 'Operational PL FDS Metrics';
cDimDelAcc = 'Delivery Ops Metrics';

cFulFilDim = 'Delivery Fulfillment Type';
cMerchTypeDim = 'Delivery Merchant Type';
cDelMerchSegDim = 'Delivery Merchant Segment';
cDelFeatureDim = 'Delivery Features';
cOrdCatDim = 'Delivery Order Category';

cVersion = pVersion;
cMeasure = 'Amount';
cTargetSource = 'Product PL';
cFulFilConsol = 'Total Fulfillment Type';
cMerchTypeConsol = 'Total Merchant Type';
cOrdCatConsol = 'Total Order Category';
cDelMerchSegConsol = 'Total Merchant Segment';
cDelFeatureConsol = 'All Delivery Features';
cSourceConsol = 'Total External Excl Sig Adj';
cLocationConsol = 'Total Location Incl Discontinued';
cDeptConsol = 'Total Org';
cLOBConsol = 'Delivery';
cOpsLOBConsol = 'Delivery';
cGLAccountConsol = 'Ops P&L';
cProductConsol = 'Total Product Type';

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
## Clear Target             ##
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cRandomIntA = NUMBERTOSTRING(INT(RAND() * 100000 * RAND()));
cViewName = 'zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
cSubsetName = 'zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;

cCube = cTargetCube;
VIEWCREATE(cCube, cViewName, 1);
nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(cCube);
WHILE(nCtr <= nMax);
   sDim = TABDIM(cCube, nCtr);
   IF(sDim @= 'Version');
      sElement = pVersion;
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Period');
      IF(DTYPE(sDim, pMonth) @= 'N');
         sElement = pMonth;
         SUBSETCREATE(sDim, cSubsetName, 1);
         SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
         VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
      ELSE;
         sMDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[ ' | sDim | '].[ ' | pMonth | ']}, ALL, RECURSIVE )}, 0)}';
         SUBSETCREATEBYMDX(cSubsetName, sMdx, 1);
         VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
      ENDIF;
   ELSEIF(sDim @= 'Source');
      sElement1 = cTargetSource;
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement1, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Delivery Ops Metrics');
      IF(DTYPE(sDim, pAccount) @= 'N');
         sElement = pAccount;
         SUBSETCREATE(sDim, cSubsetName, 1);
         SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
         VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
      ELSE;
         sMDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[ ' | sDim | '].[ ' | pAccount | ']}, ALL, RECURSIVE )}, 0)}';
         SUBSETCREATEBYMDX(cSubsetName, sMdx, 1);
         VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
      ENDIF;
   ELSEIF(sDim @= 'Rate Type');
      IF(pRateType @= '');
         sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({TM1SUBSETALL([ ' | sDim | '] )}, 0)}, ASC)}';
         SUBSETCREATEBYMDX(cSubsetName, sMdx, 1);
      ELSE;
         sElement = pRateType;
         SUBSETCREATE(sDim, cSubsetName, 1);
         SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      ENDIF;
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Delivery Measure');
      sElement = 'Amount';
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSE;
      sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({TM1SUBSETALL([ ' | sDim | '] )}, 0)}, ASC)}';
      SUBSETCREATEBYMDX(cSubsetName, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ENDIF;
   nCtr = nCtr + 1;
END;

VIEWEXTRACTSKIPRULEVALUESSET(cCube, cViewName, 1);
VIEWEXTRACTSKIPCALCSSET(cCube, cViewName, 1);
VIEWEXTRACTSKIPZEROESSET(cCube, cViewName, 1);

VIEWZEROOUT(cCube, cViewName);

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
## Create Source View                 ##
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cRand = NUMBERTOSTRING(ROUND(RAND() * 100000));
cRand = FILL('0', 6 - LONG(cRand)) | cRand;
cRand = NUMBERTOSTRING(NOW()) | '.' | cRand;
cRandomIntA1 = cRand;
cViewName1 = GETPROCESSNAME() | '.' | cRandomIntA;
cSubsetName1 = GETPROCESSNAME() | '.' | cRandomIntA;

cCube = cSourceCube;
VIEWCREATE(cCube, cViewName1, 1);
nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(cCube);
WHILE(nCtr <= nMax);
   sDim = TABDIM(cCube, nCtr);
   IF(sDim @= 'ANALYTICS.Version');
      sElement = pVersion;
      SUBSETCREATE(sDim, cSubsetName1, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName1, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
   ELSEIF(sDim @= 'ANALYTICS.Month');
      IF(DTYPE(sDim, pMonth) @= 'N');
         sElement = pMonth;
         SUBSETCREATE(sDim, cSubsetName1, 1);
         SUBSETELEMENTINSERT(sDim, cSubsetName1, sElement, 1);
         VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
      ELSE;
         sMDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { ( [ ' | sDim | '  ].[ ' | pMonth | ' ] )}, ALL, RECURSIVE)}, 0)}';
         SUBSETCREATEBYMDX(cSubsetName1, sMdx, 1);
         VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName1);
      ENDIF;
   ELSEIF(sDim @= 'ANALYTICS.GL Operational');
      IF(DTYPE(sDim, pAccount) @= 'N');
         sElement = pAccount;
         SUBSETCREATE(sDim, cSubsetName1, 1);
         SUBSETELEMENTINSERT(sDim, cSubsetName1, sElement, 1);
         VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
      ELSE;
         sMDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { ( [ ' | sDim | '  ].[ ' | pAccount | ' ] )}, ALL, RECURSIVE)}, 0)}';
         SUBSETCREATEBYMDX(cSubsetName1, sMdx, 1);
         VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
      ENDIF;
   ELSEIF(sDim @= 'ANALYTICS.Product Type');
      sElement = cProductConsol;
      SUBSETCREATE(sDim, cSubsetName1, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName1, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
   ELSEIF(sDim @= 'ANALYTICS.Source');
      sElement = cSourceConsol;
      SUBSETCREATE(sDim, cSubsetName1, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName1, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
   ELSEIF(sDim @= 'ANALYTICS.Location');
      sMDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { ( [ ' | sDim | '  ].[ ' | cLocationConsol | ' ] )}, ALL, RECURSIVE)}, 0)}';
      SUBSETCREATEBYMDX(cSubsetName1, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
   ELSEIF(sDim @= 'ANALYTICS.Department');
      sMDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { ( [ ' | sDim | '  ].[ ' | cDeptConsol | ' ] )}, ALL, RECURSIVE)}, 0)}';
      SUBSETCREATEBYMDX(cSubsetName1, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
   ELSEIF(sDim @= 'ANALYTICS.Account');
      sElement = cGLAccountConsol;
      SUBSETCREATE(sDim, cSubsetName1, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName1, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
   ELSEIF(sDim @= 'ANALYTICS.Line of Business');
      sMDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { ( [ ' | sDim | '  ].[ ' | cLOBConsol | ' ] )}, ALL, RECURSIVE)}, 0)}';
      SUBSETCREATEBYMDX(cSubsetName1, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
   ELSEIF(sDim @= 'ANALYTICS.Rate Type');
      IF(pRateType @= '');
         sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({TM1SUBSETALL([ ' | sDim | '] )}, 0)}, ASC)}';
         SUBSETCREATEBYMDX(cSubsetName1, sMdx, 1);
      ELSE;
         sMDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { ( [ ' | sDim | '  ].[ ' | pRateType | ' ] )}, ALL, RECURSIVE)}, 0)}';
         SUBSETCREATEBYMDX(cSubsetName1, sMdx, 1);
      ENDIF;
      VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
   ELSEIF(sDim @= 'ANALYTICS.GL Operational Measure');
      sElement = 'Amount';
      SUBSETCREATE(sDim, cSubsetName1, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName1, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
   ELSE;
      sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({TM1SUBSETALL([ ' | sDim | '] )}, 0)}, ASC)}';
      SUBSETCREATEBYMDX(cSubsetName1, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
   ENDIF;

   nCtr = nCtr + 1;
END;

VIEWEXTRACTSKIPRULEVALUESSET(cCube, cViewName1, 1);
VIEWEXTRACTSKIPCALCSSET(cCube, cViewName1, 0);
VIEWEXTRACTSKIPZEROESSET(cCube, cViewName1, 1);

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
## Set View as DataSource             ##
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

DatasourceNameForServer = cSourceCube;
DatasourceType = 'VIEW';
DatasourceCubeView = cViewName1;
# ================= TAPTOOLS: START GENERATED CODE =================== #
nPrologProcedureEndTime = NOW();
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "' | DatasourceType | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceNameForServer: "' | DatasourceNameForServer | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceCubeView: "' | DatasourceCubeView | '"');
