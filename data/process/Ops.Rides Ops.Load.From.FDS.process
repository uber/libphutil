nDataProcedureStartTime = 0;
nDataProcedureEndTime = 0;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****

# Process to load Rides opartional metrics from FDS to Rid Ops cube
# Also loads MAPC metrics data into MAPC cube


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Define Constants
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cCube = 'Rides Ops';
cCubeMapc = 'MAPC';
sDimOpsMetric = 'Ops Metric';
cVersion = 'Actual';
cRateType = 'USD';
cMeasure = 'Amount';
cSource = 'FDS';
cMapcMetricConsol = 'MAPC Metrics';
nRecords = 1;
###Record count dashboard
cRecordCount = 0;
cLoaddate = TODAY(1);
cCubeDash = 'Dashboard';
cRCube = 'Rides Ops';
mDash = 'Dashboard Measure';
rMetric = 'Operational';
##

cMetricString = '';
cMapcMetricString = '';

nDate = NOW;
NEWDATEFORMATTER('', 'PST', 'serial', 'full', 'datetime', '');
sOutputString = FORMATDATE(nDate, 0);



cUser = CELLGETS('System Info', 'SQL User Name GL Transactions', 'String');
cPassword = CELLGETS('System Info', 'SQL Password GL Transactions', 'String');


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Set Query
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

DatasourceUsername = cUser;
DatasourcePassword = cPassword;
sQuery = EXPAND('SELECT * FROM "%pTable%"');
DatasourceQuery = sQuery;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Subsets for View Zero Out
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cRandomIntA = NUMBERTOSTRING(INT(RAND() * 100000));
cSubset = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | 'test';
cViewName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
VIEWCREATE(cCube, cViewName, 1);

nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(cCube);

WHILE(nCtr <= nMax);
   sDim = TABDIM(cCube, nCtr);

   IF(sDim @= 'Version');
      sElement = 'Actual';
      SUBSETCREATE(sDim, cSubset, 1);
      SUBSETELEMENTINSERT(sDim, cSubset, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);

   ELSEIF(sDim @= 'Period');
      SUBSETCREATE(sDim, cSubset, 1);

      IF(pLevel @= 'Month');
         sPeriod = SUBST(pStartDate, 1, 7);
         WHILE(ATTRN(sDim, sPeriod, 'Start of Period') <= ATTRN(sDim, SUBST(pEndDate, 1, 7), 'Start of Period'));
            SUBSETELEMENTINSERT(sDim, cSubset, sPeriod, 1);
            sPeriod = ATTRS(sDim, sPeriod, 'Next Period');
         END;
      ELSEIF(pLevel @= 'Week');
         nPeriod = DAYNO(SUBST(pStartDate, 1, 10));
         nEndPeriod = DAYNO(SUBST(pEndDate, 1, 10));

         WHILE(nPeriod <= nEndPeriod);
            sDay = DATE(nPeriod, 1);
            nPar = ELPARN(sDim, sDay);
            cnt = 1;
            WHILE(cnt <= nPar);
               sPar = ELPAR(sDim, sDay, cnt);
               IF(ELISANC(sDim, 'Total Time - Week Day', sPar) = 1);
                  sWeek = 'WS ' | SUBST(sPar, 4, 10);
                  SUBSETELEMENTINSERT(sDim, cSubset, sWeek, 1);
               ENDIF;
               cnt = cnt + 1;
            END;
            nPeriod = DAYNO(SUBST(ATTRS(sDim, sWeek, 'Next Period'), 4, 10));
         END;

      ENDIF;

      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);

   ELSEIF(sDim @= 'Source');
      sElement = 'FDP';
      SUBSETCREATE(sDim, cSubset, 1);
      SUBSETELEMENTINSERT(sDim, cSubset, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);

   ELSEIF(sDim @= 'Rides Ops Metric');
      SUBSETCREATE(sDim, cSubset, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);

   ELSE;
      sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({TM1SUBSETALL([ ' | sDim | '] )}, 0)}, ASC)}';
      SUBSETCREATEBYMDX(cSubset, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ENDIF;

   nCtr = nCtr + 1;
END;

### MAPC cube zero out view formation ###

IF(VIEWEXISTS(cCubeMapc, cViewName) = 1);
   VIEWDESTROY(cCubeMapc, cViewName);
ENDIF;
VIEWCREATE(cCubeMapc, cViewName, 1);

nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(cCubeMapc);
sMDX = '';

WHILE(nCtr <= nMax);
   sDim = TABDIM(cCubeMapc, nCtr);

   IF(sDim @= 'Line of Business' % sDim @= 'Product Type' % sDim @= 'Ops Metric' % sDim @= 'MAPC Measure');

      IF(SUBSETEXISTS(sDim, cSubset) = 1);
         SUBSETDESTROY(sDim, cSubset);
      ENDIF;
      SUBSETCREATE(sDim, cSubset, 1);

      IF(sDim @= 'Line of Business');
         sMDX = '{[' | sDim | '].[1001]}';

      ELSEIF(sDim @= 'Ops Metric');
         sMDX = '';

      ELSEIF(sDim @= 'MAPC Measure');
         sMDX = '{[' | sDim | '].[Amount]}';

      ELSE;
         sMDX = '{TM1FILTERBYLEVEL({TM1SUBSETALL([' | sDim | '])}, 0)}';
      ENDIF;

      IF(sMDX @<> '');
         SUBSETMDXSET(sDim, cSubset, sMDX);
         SUBSETMDXSET(sDim, cSubset, '');
      ENDIF;

   ENDIF;

   VIEWSUBSETASSIGN(cCubeMapc, cViewName, sDim, cSubset);

   nCtr = nCtr + 1;
END;


# ================= TAPTOOLS: START GENERATED CODE =================== #
nPrologProcedureEndTime = NOW();
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "' | DatasourceType | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceNameForServer: "' | DatasourceNameForServer | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceCubeView: "' | DatasourceCubeView | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceDimensionSubset: "' | DatasourceDimensionSubset | '"');
LOGOUTPUT('DEBUG', 'PROGRESS: END PROLOG PROCEDURE');
# ================= TAPTOOLS: END GENERATED CODE ===================== #

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
