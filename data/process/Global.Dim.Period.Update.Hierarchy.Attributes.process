# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROPERTIES                                                           #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
{
    "DataSource": {
        "Type": "None"
    },
    "HasSecurityAccess": false,
    "Name": "Global.Dim.Period.Update.Hierarchy.Attributes",
    "Parameters": [
        {
            "Name": "pTapQueueAdd",
            "Prompt": "OPT: Queue Enable (Y or N)",
            "Type": "String",
            "Value": ""
        },
        {
            "Name": "pTapQueueGroupId",
            "Prompt": "OPT: Queue Job ID (Unique)",
            "Type": "String",
            "Value": ""
        },
        {
            "Name": "pTapQueueJobId",
            "Prompt": "OPT: Queue Group ID (Shared)",
            "Type": "String",
            "Value": ""
        },
        {
            "Name": "pTapQueuePriority",
            "Prompt": "OPT: Queue Priority -100 to 100 (Priority)",
            "Type": "String",
            "Value": ""
        }
    ],
    "UIData": "CubeAction=1511\fDataAction=1503\fCubeLogChanges=0\f",
    "Variables": [],
    "VariablesUIData": []
}
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROPERTIES                                                             #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

# ==================================================================== #
# Globals
# ==================================================================== #

cDimMonth = 'Period';

cRand = NUMBERTOSTRING(ROUND(RAND() * 100000));
cRand = FILL('0', 6 - LONG(cRand)) | cRand;

cView = EXPAND('zzTemp.%cRand%');
cSub = EXPAND('zzTemp.%cRand%');

# ==================================================================== #
# Create Subsets
# ==================================================================== #

sDim = cDimMonth;
sHier = EXPAND('%sDim%');

sSub = cSub | '.Year';
sMDX = EXPAND('{TM1SORT( {TM1FILTERBYPATTERN( { [%sDim%].[%sDim%].Members }, "????")}, ASC)}');
SUBSETCREATE(sHier, sSub, 0);
SUBSETMDXSET(sHier, sSub, sMDX);
SUBSETMDXSET(sHier, sSub, '');

sSub = cSub | '.Half';
sMDX = EXPAND('{TM1SORT( {TM1FILTERBYPATTERN( { [%sDim%].[%sDim%].Members }, "????-H?")}, ASC)}');
SUBSETCREATE(sHier, sSub, 0);
SUBSETMDXSET(sHier, sSub, sMDX);
SUBSETMDXSET(sHier, sSub, '');

sSub = cSub | '.Quarter';
sMDX = EXPAND('{TM1SORT( {TM1FILTERBYPATTERN( { [%sDim%].[%sDim%].Members }, "????-Q?")}, ASC)}');
SUBSETCREATE(sHier, sSub, 0);
SUBSETMDXSET(sHier, sSub, sMDX);
SUBSETMDXSET(sHier, sSub, '');

# ==================================================================== #
# Update Attribute - Year
# ==================================================================== #

i = 1;
sDim = cDimMonth;
sSub = cSub | '.Year';
sHier = EXPAND('%sDim%');


WHILE(i <= SUBSETGETSIZE(sHier, sSub));
   sEle = SUBSETGETELEMENTNAME(sHier, sSub, i);

   sAttr = 'Input Type';
   sAttrVal = 'Year';
   ATTRPUTS(sAttrVal, sHier, sEle, sAttr);

   sAttr = 'Year';
   sAttrVal = SUBST(sEle, 1, 4);
   ATTRPUTS(sAttrVal, sHier, sEle, sAttr);

   i = i + 1;
END;

# ==================================================================== #
# Update Attribute - Half
# ==================================================================== #

i = 1;
sDim = cDimMonth;
sSub = cSub | '.Half';
sHier = EXPAND('%sDim%');

WHILE(i <= SUBSETGETSIZE(sHier, sSub));
   sEle = SUBSETGETELEMENTNAME(sHier, sSub, i);

   sAttr = 'Input Type';
   sAttrVal = 'Half';
   ATTRPUTS(sAttrVal, sHier, sEle, sAttr);

   sAttr = 'Month Name';
   sAttrVal = 'H' | SUBST(sEle, 7, 1);
   ATTRPUTS(sAttrVal, sHier, sEle, sAttr);

   sAttr = 'Year';
   sAttrVal = SUBST(sEle, 1, 4);
   ATTRPUTS(sAttrVal, sHier, sEle, sAttr);

   sAttr = 'Half';
   sAttrVal = 'H' | SUBST(sEle, 7, 1);
   ATTRPUTS(sAttrVal, sHier, sEle, sAttr);

   i = i + 1;
END;

# ==================================================================== #
# Update Attribute - Quarter
# ==================================================================== #

i = 1;
sDim = cDimMonth;
sSub = cSub | '.Quarter';
sHier = EXPAND('%sDim%');

WHILE(i <= SUBSETGETSIZE(sHier, sSub));
   sEle = SUBSETGETELEMENTNAME(sHier, sSub, i);

   sAttr = 'Input Type';
   sAttrVal = 'Quarter';
   ATTRPUTS(sAttrVal, sHier, sEle, sAttr);

   sAttr = 'Month Name';
   sAttrVal = 'Q' | SUBST(sEle, 7, 1);
   ATTRPUTS(sAttrVal, sHier, sEle, sAttr);

   sAttr = 'Year';
   sAttrVal = SUBST(sEle, 1, 4);
   ATTRPUTS(sAttrVal, sHier, sEle, sAttr);

   sAttr = 'Half';
   IF(NUMBR(SUBST(sEle, 7, 1)) <= 2);
      sAttrVal = 'H1';
   ELSE;
      sAttrVal = 'H2';
   ENDIF;
   ATTRPUTS(sAttrVal, sHier, sEle, sAttr);

   sAttr = 'Quarter';
   sAttrVal = 'Q' | SUBST(sEle, 7, 1);
   ATTRPUTS(sAttrVal, sHier, sEle, sAttr);

   i = i + 1;
END;


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
