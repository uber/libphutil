        "query": "select * from \"pipe.rides_ops_tm1_monthly_operational.20200603063746.7FDSJN\"",
        "userName": "epm",
        "usesUnicode": true
    },
    "HasSecurityAccess": false,
    "Name": "Ops.Load.From.Upload.UI",
    "Parameters": [
        {
            "Name": "pTable",
