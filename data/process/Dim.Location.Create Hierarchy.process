cDim = 'Location';

# ==================================================================== #
# Create Hierarchies
# ==================================================================== #

sDim = cDim;

sHier = 'CustomLeaf';
IF(HIERARCHYEXISTS(sDim, sHier) = 0);
   HIERARCHYCREATE(sDim, sHier);
ENDIF;


