# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #

# ================= TAPTOOLS: START GENERATED CODE =================== #
sProcessName = GETPROCESSNAME();
IF(sProcessName @<> 'TAP.Call.Queue.Add Job To Queue' & sProcessName @<> 'TAP.CubeSaveData' & sProcessName @<> 'TAP.Call.Save' & sProcessName @<> 'TAP.Call.Save.Wrapper' & sProcessName @<> 'TAP.Call.CubeSaveData.Wrapper' & sProcessName @<> 'TAP.Call.Tests' & sProcessName @<> 'TAP.Call.Init' & sProcessName @<> 'TAP.Call.Export Application Stats' & sProcessName @<> 'TAP.Cube.Export Data to File' & SCAN('}drill', LOWER(sProcessName)) = 0);
   sSDA.Status = CELLGETS('TAP System Info', 'Block Process Execution', 'Value');
   IF(sSDA.Status @= 'Yes');
      PROCESSBREAK;
   ENDIF;
ENDIF;
LOGOUTPUT('DEBUG', 'PARAMETER: pVersion: "' | pVersion | '"');
LOGOUTPUT('DEBUG', 'PARAMETER: pMonth: "' | pMonth | '"');
LOGOUTPUT('DEBUG', 'PARAMETER: pRateType: "' | pRateType | '"');
LOGOUTPUT('DEBUG', 'PROGRESS: START PROLOG PROCEDURE');
nMetadataProcedureRecordsStarted = 0;
nMetadataProcedureRecordsSkipped = 0;
nMetadataProcedureRecordsRejected = 0;
nMetadataProcedureRecordsCompleted = 0;
nDataProcedureRecordsStarted = 0;
nDataProcedureRecordsSkipped = 0;
nDataProcedureRecordsRejected = 0;
nDataProcedureRecordsCompleted = 0;
nPrologProcedureDataOperations = 0;
nDataProcedureDataOperations = 0;
nTotalDataOperations = 0;
nPrologProcedureMetadataOperations = 0;
nMetadataProcedureMetadataOperations = 0;
nDataProcedureMetadataOperations = 0;
nEpilogProcedureMetadataOperations = 0;
nTotalProcedureMetadataOperations = 0;
nPrologProcedureStartTime = NOW();
nPrologProcedureEndTime = 0;
nMetadataProcedureStartTime = 0;
nMetadataProcedureEndTime = 0;
nDataProcedureStartTime = 0;
nDataProcedureEndTime = 0;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****

#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
# Mobility / Product PL Wrapper
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

# Summary: Wrapper process to run allocation procedure in parallel. 

# ==================================================================== #
# Globals
# ==================================================================== #

cVersion = TRIM(pVersion);
cMonth = TRIM(pMonth);
cRateType = TRIM(pRateType);
cAccount = 'Ops PL';

cRand = NUMBERTOSTRING(ROUND(RAND() * 100000));
cRand = FILL('0', 6 - LONG(cRand)) | cRand;
cRand = NUMBERTOSTRING(NOW()) | '.' | cRand;

cSub = '}zTemp.' | cRand;

cPythonExe = CELLGETS('TAP System Info', 'Python Executable', 'Value');

cScriptRun = CELLGETS('TAP System Info', 'Scripts Shared Path', 'Value');
cScriptRun = cScriptRun | '/tap/tap-runti-in-parallel.py';

cBatchUser = CELLGETS('TAP System Info', 'Batch Username', 'Value');
cBatchPassword = CELLGETS('TAP System Info', 'Batch Password', 'Value');
cBatchNamespace = CELLGETS('TAP System Info', 'Batch Namespace', 'Value');
cServer = CELLGETS('TAP Application Info', CELLGETS('TAP System Info', 'Service Name', 'Value'), 'Endpoint');
cPort = '443';
cThreads = '10';

cTemplateScriptRun = '%cPythonExe% %cScriptRun% --server ''%cServer%'' --port %cPort% --user ''%cBatchUser%'' --password ''%cBatchPassword%'' --namespace ''%cBatchNamespace%'' --threads ''%cThreads%'' %sProcess%';
cTemplateProcess = '--process ''Ops.Mobility.Product PL'' pVersion ''%cVersion%'' pMonth ''%sMonth%'' pRateType ''%sRateType%'' pAccount ''%cAccount%'' ';

# ==================================================================== #
# Create Source Subsets
# ==================================================================== #

# Month
sDim = 'Month';
sSub = cSub;
sEleAnc = IF(cMonth @= '', 'Total Month', cMonth);

IF(SUBSETEXISTS(sDim, sSub) = 0);
   SUBSETCREATE(sDim, sSub);
ENDIF;
SUBSETDELETEALLELEMENTS(sDim, sSub);

IF(DTYPE(sDim, sEleAnc) @= 'N');
   sEle = sEleAnc;
   SUBSETELEMENTINSERT(sDim, sSub, sEle, SUBSETGETSIZE(sDim, sSub) + 1);
ELSE;
   i = 1;
   WHILE(i <= DIMSIZ(sDim));
      sEle = DIMNM(sDim, i);
      IF(DTYPE(sDim, sEle) @= 'N' & ELISANC(sDim, sEleAnc, sEle) = 1);
         SUBSETELEMENTINSERT(sDim, sSub, sEle, SUBSETGETSIZE(sDim, sSub) + 1);
      ENDIF;
      i = i + 1;
   END;
ENDIF;

# Rate Type
sDim = 'Rate Type';
sSub = cSub;
sEleAnc = IF(cRateType @= '', 'FX Rates', cRateType);

IF(SUBSETEXISTS(sDim, sSub) = 0);
   SUBSETCREATE(sDim, sSub);
ENDIF;
SUBSETDELETEALLELEMENTS(sDim, sSub);

IF(DTYPE(sDim, sEleAnc) @= 'N');
   sEle = sEleAnc;
   SUBSETELEMENTINSERT(sDim, sSub, sEle, SUBSETGETSIZE(sDim, sSub) + 1);
ELSE;
   i = 1;
   WHILE(i <= DIMSIZ(sDim));
      sEle = DIMNM(sDim, i);
      IF(DTYPE(sDim, sEle) @= 'N' & ELISANC(sDim, sEleAnc, sEle) = 1);
         SUBSETELEMENTINSERT(sDim, sSub, sEle, SUBSETGETSIZE(sDim, sSub) + 1);
      ENDIF;
      i = i + 1;
   END;
ENDIF;


# ==================================================================== #
# Iterate Subset, Setup parallel execution
# ==================================================================== #

sSub = cSub;
sProcess = '';
nCount = 0;
i = 1;
WHILE(i <= SUBSETGETSIZE('Rate Type', sSub));
   sRateType = SUBSETGETELEMENTNAME('Rate Type', sSub, i);

   p = 1;
   WHILE(p <= SUBSETGETSIZE('Month', sSub));
      nCount = nCount + 1;

      sMonth = SUBSETGETELEMENTNAME('Month', sSub, p);
      sProcess = sProcess | EXPAND(cTemplateProcess);

      IF(MOD(nCount, 100) = 0);
         sCommand = EXPAND(cTemplateScriptRun);

         # Logging + Strip Passwords + Execute Python
         LOGOUTPUT('INFO', 'PYTHON SCRIPT EXECUTION -- START -- SYNCHRONOUS');
         sLogCommand = IF(LONG(sCommand) > 600, SUBST(sCommand, 1, 600) | '. . . (600 char max)', sCommand);
         nPassStartInd = SCAN('--password', sLogCommand);
         nPassEndInd = SCAN('--namespace', sLogCommand);
         sLogCommand = SUBST(sLogCommand, 1, nPassStartInd - 1) | SUBST(sLogCommand, nPassEndInd, LONG(sLogCommand));
         LOGOUTPUT('INFO', EXPAND('PYTHON SCRIPT COMMAND: %sLogCommand%'));
         EXECUTECOMMAND(sCommand, 1);
         LOGOUTPUT('INFO', 'PYTHON SCRIPT EXECUTION -- COMPLETE');
         sProcess = '';
      ENDIF;

      p = p + 1;
   END;

   i = i + 1;
END;

sCommand = EXPAND(cTemplateScriptRun);

# Logging + Strip Password
LOGOUTPUT('INFO', 'PYTHON SCRIPT EXECUTION -- START -- ASYNCHRONOUS');
sLogCommand = IF(LONG(sCommand) > 600, SUBST(sCommand, 1, 600) | '. . . (600 char max)', sCommand);
nPassStartInd = SCAN('--password', sLogCommand);
nPassEndInd = SCAN('--namespace', sLogCommand);
sLogCommand = SUBST(sLogCommand, 1, nPassStartInd - 1) | SUBST(sLogCommand, nPassEndInd, LONG(sLogCommand));
LOGOUTPUT('INFO', EXPAND('PYTHON SCRIPT COMMAND: %sLogCommand%'));

EXECUTECOMMAND(sCommand, 0);
# ================= TAPTOOLS: START GENERATED CODE =================== #
nPrologProcedureEndTime = NOW();
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "' | DatasourceType | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceNameForServer: "' | DatasourceNameForServer | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceCubeView: "' | DatasourceCubeView | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceDimensionSubset: "' | DatasourceDimensionSubset | '"');
LOGOUTPUT('DEBUG', 'PROGRESS: END PROLOG PROCEDURE');
# ================= TAPTOOLS: END GENERATED CODE ===================== #

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
