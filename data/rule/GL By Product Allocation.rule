FORMAT==100
##====================================================##
# V1 Product P&L
# Initial version is just core rides
# The below rule file assumes no difference in Location
##====================================================##

FEEDSTRINGS;
Skipcheck;

['Other']= STET;

['Allocation Method Override'] =S:
  IF(!month @= '2018-11', continue,
  DB('GL By Product Allocation', !Version, '2018-11', !Line of Business, !Location, !Product Type, !Account, 'Allocation Method Override'));

#== Override logic, If there is a vlue in the overide measure then override the value

['Allocation Method'] =S:
  IF(DB('GL By Product Allocation',!Version,!Month,!Line of Business,!Location, 'Unspecified Product Type',!Account,'Allocation Method Override') @<> '',
    DB('GL By Product Allocation',!Version,!Month,!Line of Business,!Location, 'Unspecified Product Type',!Account,'Allocation Method Override'), Continue);

#== Base version assumes no location logic (will change this once we have a more clear understanding)
#== If override is blank use account L1 (level +1)

#['Location' : 'Location' :'Total Location Incl Discontinued','Allocation Method'] = S:
#  IF( DB('GL By Product Allocation',!Version,!Month,!Line of Business,!Location,!Product Type, !Account ,'Allocation Method Override') @= '',
#    DB('GL By Product Allocation',!Version,!Month,!Line of Business,!Location,!Product Type,ATTRS('Account', !Account, 'Account L1') ,'Allocation Method'), Continue);

#== Use UberX if there is no value, focus on V1 is core rides
#== eg allocation method is trips, there is no trips in a city but there are values, we will allocate all $'s to UberX
#== Allocation method 'Actual' will be a straight push from OPS to GL

['UberX','Allocation %'] = N:
 IF(  DB('GL By Product Allocation',!Version,!Month, 'Core Rides','Total Location Incl Discontinued', 'Unspecified Product Type', !Account ,'Allocation Method') @<> 'Actual',
   IF( DB('Ops',!Version,!Month,'Total Source', 'USD', !Location,IF(Elisanc('Account', 'Net Inflows', !Account) =1,!Line of Business, 'Core Rides'),
   'Total Product Type Excl Other',
    DB('GL By Product Allocation',!Version,!Month,!Line of Business,'Total Location Incl Discontinued', 'Unspecified Product Type', !Account ,'Allocation Method'),
    'Amount') = 0,
    1, Continue), Continue);

#== Allocation % !Product Type/'Total Product Type' to get a %
#== TI will use % for calc
#== % unspecified product, source

['Allocation %'] =N:

  DB('Ops',!Version,!Month, 'Total Source', 'USD', !Location,
  IF(Elisanc('Account', 'Net Inflows', !Account) =1  ,!Line of Business, 'Core Rides'),
  !Product Type,
   DB('GL By Product Allocation',!Version,!Month,!Line of Business,'Total Location Incl Discontinued', 'Unspecified Product Type', !Account ,'Allocation Method'),
   'Amount') \

  DB('Ops',!Version,!Month, 'Total Source', 'USD',!Location,
  IF(Elisanc('Account', 'Net Inflows', !Account) =1,!Line of Business, 'Core Rides'),
  'Total Product Type Excl Other',
   DB('GL By Product Allocation',!Version,!Month,!Line of Business,'Total Location Incl Discontinued', 'Unspecified Product Type', !Account ,'Allocation Method'),
   'Amount');








