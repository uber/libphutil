   LOGOUTPUT('ERROR', 'Block Process Execution Flag is Yes in TAP System Info Cube. Skipping this process...');
   PROCESSERROR;
ENDIF;
IF(nPrologProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "NULL"');
   LOGOUTPUT('DEBUG', 'PROGRESS: END PROLOG PROCEDURE');
   nPrologProcedureEndTime = NOW();
ENDIF;
IF(nMetadataProcedureStartTime > 0 & nMetadataProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: END METADATA PROCEDURE');
