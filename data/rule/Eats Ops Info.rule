FEEDSTRINGS;
SKIPCHECK;

['Net Inflows','Last Updated']=S: DB('Eats Ops Info','41105',!Period,'Last Updated');

['Source Table'] = S:
   IF(DB('Eats Ops Info',!Eats Ops Metric,!Period,'Source Table Override') @<> '',
      DB('Eats Ops Info',!Eats Ops Metric,!Period,'Source Table Override'), CONTINUE);

['Source Table'] = S:
   IF(ATTRS('Period', !Period, 'Level') @= 'Month', DB('Eats Ops Info',!Eats Ops Metric,'2018-01','Source Table Override'), DB('Eats Ops Info',!Eats Ops Metric,'WS 2018-01-01','Source Table Override'));

