# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

################################################################################
##~~                        UBER MARVEL TM1                                ~~##
################################################################################

# Cube.OPS.Load.Monthly - Process to load Unique Drivers/Riders at monthly Total Loc level from FDS to OPS Monthly cube

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
## Populate Process Audit
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

NumericGlobalVariable ( 'DataMinorErrorCount' );
NumericGlobalVariable ( 'MetadataMinorErrorCount' );
NumericGlobalVariable ( 'PrologMinorErrorCount' );

ExecuteProcess('System.Process.Log',
    'pPosition', 'Prolog'
  , 'pProcess', getProcessName
  , 'pParam', 'pTable'
  , 'pParamVal',  pTable
  , 'pDelim', '++'
  , 'pDebug', pDebug);

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Define Constants
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cCube = 'OPS Monthly';
cVersion ='Actual';
cRateType = 'USD';
cMeasure = 'Amount';
cSysInfo = 'System Info';
cMetricZero='N';
cOPSSource ='FDP';

nRecords =1;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Set Query
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

sQuery = EXPAND('SELECT * FROM "%pTable%"');

DATASOURCEQUERY = sQuery;

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: METADATA PROCEDURE                                                   #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****





# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: METADATA PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# For the correct month
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

sMonth = SubSt(vMonth,1,7);

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Clear Data
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

If (cMetricZero@='N');

  sLoc='0000';
  sFilter = 'Version:' | cVersion | '&OPS Metric:' | vMetric | '&Month:' | sMonth | '&Location:' | sLoc;
  sProcess = 'Bedrock.Cube.Data.Clear';
  ExecuteProcess ( sProcess,
   'pCube', cCube,
     'pView', '',
     'pFilter', sFilter
    ,'pDebug' , pDebug
  );

 cMetricZero='Y';

EndIf;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Transformation
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

sDim='Flow Type';
sFlowType=vFlowType;
If (vFlowType @= '\N' % vFlowType @= ''%vFlowType @= 'None'% DIMIX (sDim,sFlowType) = 0);
   sFlowType='Not Specified';
EndIf;

sDim='Vehicle Type';
If (vCarType@='\N' % vCarType@='');
   sCarType='Not Specified';
   sLOB='0000';
Else;
   sLOB = ATTRS(sDim,vCarType,'LOB');
   sCarType=vCarType;
EndIf;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Load Data
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

CellIncrementN(Value, cCube,cVersion,sMonth,cRatetype,cOPSSource,'0000',sLOB,sFlowType,sCarType,vMetric, cMeasure );

nRecords = nRecords +1;

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: EPILOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Load Monthly by Age
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

ExecuteProcess ( 'OPS.Monthly By Age.Load.From.OPS Monthly'
  , 'pVersion', cVersion 
  , 'pDebug', pDebug );

ExecuteProcess ( 'OPS.Monthly By Age.Load.From.OPS Monthly.Booking'
  , 'pVersion', cVersion 
  , 'pDebug', pDebug );

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
## Process Log
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

sErrors = NumberToString(DataMinorErrorCount + MetadataMinorErrorCount + PrologMinorErrorCount);

ExecuteProcess('System.Process.Log',
    'pPosition', 'Epilog'
  , 'pProcess', getProcessName
  , 'pProcessSuccess', sErrors
  , 'pRecords', NumberToString(nRecords)
  , 'pDebug', 0);



# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: EPILOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #