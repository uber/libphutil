        },
        {
            "Name": "pMetric",
            "Prompt": "",
            "Type": "String",
            "Value": "Eats Only Metrics"
        },
        {
            "Name": "pMeasure",
            "Prompt": "",
            "Type": "String",
            "Value": "Amount"
        }
    ],
    "UIData": "CubeAction=1511\fDataAction=1503\fCubeLogChanges=0\f",
    "Variables": [],
    "VariablesUIData": [
        "IgnoredInputVarName=Version\fVarType=32\fColType=1165\f",
        "IgnoredInputVarName=Period\fVarType=32\fColType=1165\f",
        "IgnoredInputVarName=Source\fVarType=32\fColType=1165\f",
        "IgnoredInputVarName=V4\fVarType=32\fColType=1165\f",
        "IgnoredInputVarName=Location\fVarType=32\fColType=1165\f",
        "IgnoredInputVarName=V6\fVarType=32\fColType=1165\f",
        "IgnoredInputVarName=V7\fVarType=32\fColType=1165\f",
        "IgnoredInputVarName=V8\fVarType=32\fColType=1165\f",
