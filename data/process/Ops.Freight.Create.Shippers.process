# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


cDim = 'Freight Shipper';

cDebug = 0;

# ==================================================================== #
# Create Dimension
# ==================================================================== #


sDim = cDim;

IF(DIMENSIONEXISTS(sDim) = 0);
   DIMENSIONCREATE(sDim);
ENDIF;


# ==================================================================== #
# Create Attributes 
# ==================================================================== #

sAttr = 'Shipper Name';
ATTRINSERT(sDim, '', sAttr, 'A');

sAttr = 'First Load Date,';
ATTRINSERT(sDim, '', sAttr, 'S');


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Define Source
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
cUser = CELLGETS('System Info', 'SQL User Name GL Transactions', 'String');
cPassword = CELLGETS('System Info', 'SQL Password GL Transactions', 'String');


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Set Query
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

DatasourceUsername = cUser;
DatasourcePassword = cPassword;
sQuery = EXPAND('SELECT * FROM "%pTable%"');
DatasourceQuery = sQuery;








# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: METADATA PROCEDURE                                                   #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# ==================================================================== #
# Create Shippers with Segments
# ==================================================================== #

cParent = 'Total Freight Shipper';

DIMENSIONELEMENTINSERTDIRECT(sDim, '', cParent, 'C');
DIMENSIONELEMENTINSERTDIRECT(sDim, '', vMasterSegment, 'C');
DIMENSIONELEMENTINSERTDIRECT(sDim, '', vMasterUUID, 'N');
DIMENSIONELEMENTCOMPONENTADDDIRECT(sDim, cParent, vMasterSegment, 1);
DIMENSIONELEMENTCOMPONENTADDDIRECT(sDim, vMasterSegment, vMasterUUID, 1);




# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: METADATA PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****




# ==================================================================== #
# Update Attributes 
# ==================================================================== #

sAttr = 'Shipper Name';
IF(DIMIX('Freight Shipper', vMasterName) = 0);
   ATTRPUTS(vMasterName, sDim, vMasterUUID, sAttr);
ELSE;
   ITEMSKIP;
ENDIF;
sAttr = 'First Load Date,';
ATTRPUTS(vShipperDFL, sDim, vMasterUUID, sAttr);

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
