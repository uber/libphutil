# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****

################################################################################
## System.SendEmail
##
## This process is used to kickoff a Python script that sends an email with
## HTML content to an email address or multiple email address.
##
## pFrom:         Email address used to send this email.
## pTo:           String of email(s) to send content to separated by a pipe.
## pSubject:      The subject of the email. HTML is not suppported.
## pHTMLContent:  HTML content to be used in the body of the email. Exclude
##                commas as this breaks the script command.
##
################################################################################

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
## Initialise Constants               
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cCube = 'TAP System Info';
cInstance = CELLGETS(cCube, 'Application Name', 'Value');
cServer = CELLGETS(cCube, 'Service Name', 'Value');
cPythonExe = CELLGETS(cCube, 'Python Executable', 'Value');
cScriptPath = CELLGETS(cCube, 'Scripts Local Path', 'Value');
cScript = cScriptPath | '/sendemail.py';
cLogsPath = CELLGETS(cCube, 'Logs Path', 'Value') | '/sendemail.log';

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
## Validate Parameters         
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

IF(pFrom @= '');
   pFrom = cInstance | '@uber.com';
ENDIF;

sEmailsArg = '--to_emails ';
IF(pTo @= '');
   PROCESSQUIT;
ELSEIF(SCAN('|', pTo) > 0);
   sSubst = pTo;
   WHILE(SCAN('|', sSubst) <> 0);
      n = SCAN('|', sSubst);
      sEmail = CHAR(34) | SUBST(sSubst, 1, n - 1) | CHAR(34);
      sSubst = SUBST(sSubst, n + 1, LONG(sSubst));
      sEmailsArg = sEmailsArg | sEmail | ' ';
      IF(SCAN('|', sSubst) = 0);
         sEmailsArg = sEmailsArg | CHAR(34) | '%sSubst%' | CHAR(34);
      ENDIF;
   END;
ELSE;
   sEmailsArg = sEmailsArg | ' "%pTo%"';
ENDIF;
sEmailsArg = EXPAND(sEmailsArg);


sHTMLContent = CHAR(39) | pHTMLContent | CHAR(39);

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
## Prepare Command and Execute       
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cScriptTemplate = '%cPythonExe% "%cScript%" 
--from_email "%pFrom%" 
%sEmailsArg% 
--subject "%pSubject%" 
--html_content %sHTMLContent% 
--logs_path "%cLogsPath%" 
--triggering_app "%cServer%"
';

sCommand = EXPAND(cScriptTemplate);

LOGOUTPUT('INFO', 'PYTHON SCRIPT EXECUTION -- START -- ASYNCHRONOUS');
sLogCommand = IF(LONG(sCommand) > 600, SUBST(sCommand, 1, 600) | '. . . (600 char max)', sCommand);
LOGOUTPUT('INFO', EXPAND('PYTHON SCRIPT COMMAND: %sLogCommand%'));
EXECUTECOMMAND(sCommand, 0);
# ================= TAPTOOLS: START GENERATED CODE =================== #
nPrologProcedureEndTime = NOW();
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "' | DatasourceType | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceNameForServer: "' | DatasourceNameForServer | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceCubeView: "' | DatasourceCubeView | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceDimensionSubset: "' | DatasourceDimensionSubset | '"');
LOGOUTPUT('DEBUG', 'PROGRESS: END PROLOG PROCEDURE');
# ================= TAPTOOLS: END GENERATED CODE ===================== #

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
