# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
## Skip variables based on user inputted source  
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

sSource = CELLGETS(cAllocCube, vVersion, vMonth, '5001', 'Total Location Incl Discontinued', '0000', 'Unspecified U4B Trip Profile', 'Unspecified U4B Sales Channel', 'Unspecified U4B Org Segment', 'Unspecified U4B Product', vMetric, 'Source');
IF(sSource @= 'Oracle U4B Mob/Del' & vLOB @= '5001');
   ITEMSKIP;
ELSEIF(sSource @= 'Oracle U4B 5001' & vLOB @<> '5001');
   ITEMSKIP;
ENDIF;

# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Determine Mobility/Delivery U4B proportions
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

IF(ELISANC(cDimLOB, cMobilityLOBConsol, vLOB) = 1);
   IF(vLOB @<> cU4BLOB);
      nTotFeature = CELLGETN(cCubeMobility, vVersion, vMonth, 'FDS', vRateType, vLob, '0000', vLoc, 'Total Mobility Product Type', 'All Mobility Features', vMetric, 'Amount');
      IF(nTotFeature <> 0);
         nU4B = CELLGETN(cCubeMobility, vVersion, vMonth, 'FDS', vRateType, vLob, '0000', vLoc, 'Total Mobility Product Type', 'U4B+U4BH', vMetric, 'Amount');
         nU4BPerc = nU4B \ nTotFeature;
      ELSE;
         sFDSmetric = vMetric | '_fds';
         sparFDSmetric = ATTRS(cDimAccount, vMetric, 'GL Operational L1') | '_fds';
         IF(DIMIX(cDimMobMetric, sFDSmetric) <> 0);
            nTotFeature_fds = CELLGETN(cCubeMobility, vVersion, vMonth, 'FDS', vRateType, vLob, '0000', vLoc, 'Total Mobility Product Type', 'All Mobility Features', sFDSmetric, 'Amount');
            nU4B_fds = CELLGETN(cCubeMobility, vVersion, vMonth, 'FDS', vRateType, vLob, '0000', vLoc, 'Total Mobility Product Type', 'U4B+U4BH', sFDSmetric, 'Amount');
            nU4BPerc = nU4B_fds \ nTotFeature_fds;
         ELSEIF(DIMIX(cDimMobMetric, sparFDSmetric) <> 0);
            nTotFeature_par_fds = CELLGETN(cCubeMobility, vVersion, vMonth, 'FDS', vRateType, vLob, '0000', vLoc, 'Total Mobility Product Type', 'All Mobility Features', sparFDSmetric, 'Amount');
            nU4B_par_fds = CELLGETN(cCubeMobility, vVersion, vMonth, 'FDS', vRateType, vLob, '0000', vLoc, 'Total Mobility Product Type', 'U4B+U4BH', sparFDSmetric, 'Amount');
            nU4BPerc = nU4B_par_fds \ nTotFeature_par_fds;
         ELSE;
            nU4BPerc = 0;
         ENDIF;
      ENDIF;
      nVal = nU4BPerc * vValue;
   ENDIF;
ELSEIF(ELISANC(cDimLOB, cDeliveryLOBConsol, vLOB) = 1);
   nTotFeature = CELLGETN(cCubeDelivery, vVersion, vMonth, 'FDS', vRateType, vLob, '0000', vLoc, cFulFilConsol, cMerchTypeConsol, cOrdCatConsol, cDelMerchSegConsol, 'All Delivery Features', vMetric, 'Amount');
   IF(nTotFeature <> 0);
      nU4B = CELLGETN(cCubeDelivery, vVersion, vMonth, 'FDS', vRateType, vLob, '0000', vLoc, cFulFilConsol, cMerchTypeConsol, cOrdCatConsol, cDelMerchSegConsol, 'U4B', vMetric, 'Amount');
      nU4BPerc = nU4B \ nTotFeature;
   ELSE;
      sFDSmetric = vMetric | '_fds';
      sparFDSmetric = ATTRS(cDimAccount, vMetric, 'GL Operational L1') | '_fds';
      IF(DIMIX(cDimDelMetric, sFDSmetric) <> 0);
         nTotFeature_fds = CELLGETN(cCubeDelivery, vVersion, vMonth, 'FDS', vRateType, vLob, '0000', vLoc, cFulFilConsol, cMerchTypeConsol, cOrdCatConsol, cDelMerchSegConsol, 'All Delivery Features', sFDSmetric, 'Amount');
         nU4B_fds = CELLGETN(cCubeDelivery, vVersion, vMonth, 'FDS', vRateType, vLob, '0000', vLoc, cFulFilConsol, cMerchTypeConsol, cOrdCatConsol, cDelMerchSegConsol, 'U4B', sFDSmetric, 'Amount');
         nU4BPerc = nU4B_fds \ nTotFeature_fds;
      ELSEIF(DIMIX(cDimDelMetric, sparFDSmetric) <> 0);
         nTotFeature_par_fds = CELLGETN(cCubeDelivery, vVersion, vMonth, 'FDS', vRateType, vLob, '0000', vLoc, cFulFilConsol, cMerchTypeConsol, cOrdCatConsol, cDelMerchSegConsol, 'All Delivery Features', sparFDSmetric, 'Amount');
         nU4B_par_fds = CELLGETN(cCubeDelivery, vVersion, vMonth, 'FDS', vRateType, vLob, '0000', vLoc, cFulFilConsol, cMerchTypeConsol, cOrdCatConsol, cDelMerchSegConsol, 'U4B', sparFDSmetric, 'Amount');
         nU4BPerc = nU4B_par_fds \ nTotFeature_par_fds;
      ELSE;
         nU4BPerc = 0;
      ENDIF;
   ENDIF;
   nVal = nU4BPerc * vValue;
ENDIF;

# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# U4B component 
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

IF(vLOB @= cU4BLOB);
   nVal = vValue;
ENDIF;

# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Populate U4B Oracle Financial 
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

IF(CELLISUPDATEABLE('U4B', vVersion, vMonth, 'Oracle', vRateType, vLob, vDept, vLoc, 'Unspecified U4B Org Segment', 'Unspecified U4B Product', 'Unspecified U4B Sales Channel', 'Unspecified U4B Trip Profile', vMetric, 'Amount') = 1);
   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
