# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsStarted = nDataProcedureRecordsStarted + 1;
IF(nMetadataProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: END METADATA PROCEDURE');
   nMetadataProcedureEndTime = NOW();
ENDIF;
IF(nDataProcedureStartTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: START DATA PROCEDURE');
   nDataProcedureStartTime = NOW();
ENDIF;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****


# Month

IF(pLevel @= 'Month');
   sPeriod = SUBST(vPeriod, 1, 7);
ELSEIF(pLevel @= 'Day');
   sPeriod = vPeriod;
ELSE;
   sPeriod = 'WS ' | vPeriod;
ENDIF;

IF(SUBSETELEMENTEXISTS('Period', cSubset, sPeriod) = 0);
   ITEMSKIP;
ENDIF;

#Metric
sMetric = vMetric;

# Location
sDim = 'Location';
IF(vLocation @= '\N' % vLocation @= '');
   ITEMSKIP;
ENDIF;
sLocation = 'V' | vLocation;

IF(DIMIX(sDim, sLocation) = 0);
   ITEMSKIP;
ENDIF;

# LOB
IF(vLob @= '\N' % vLob @= '' % DIMIX('Line of Business', vLob) = 0);
   ITEMSKIP;
ENDIF;

#Delivery Fulfillment Type

IF(vFul @= '\N' % vFul @= '');
   vFul = 'Unspecified Fulfillment type';
ENDIF;

IF(vMerType @= '\N' % vMerType @= '');
   vMerType = 'Unspecified Merchant Type';
ENDIF;

IF(vOrder @= '\N' % vOrder @= '');
   vOrder = 'Unspecified Order Category';
ENDIF;

IF(vSeg @= '\N' % vSeg @= '');
   vSeg = 'Unspecified Merchant Size';
ENDIF;

# Exceptions

sDim = 'Delivery Fulfillment Type';

IF(DIMIX(sDim, vFul) = 0);
   IF(SCAN(vFul, sException) = 0);
      sException = sException | sDim | '-' | vFul | ', ';
   ENDIF;
ENDIF;

sDim = 'Delivery Merchant Type';

IF(DIMIX(sDim, vMerType) = 0);
   IF(SCAN(vMerType, sException) = 0);
      sException = sException | sDim | '-' | vMerType | ', ';
   ENDIF;
ENDIF;

sDim = 'Delivery Order Category';

IF(DIMIX(sDim, vOrder) = 0);
   IF(SCAN(vOrder, sException) = 0);
      sException = sException | sDim | '-' | vOrder | ', ';
   ENDIF;
ENDIF;

sDim = 'Delivery Merchant Segment';

IF(DIMIX(sDim, vSeg) = 0);
   IF(SCAN(vSeg, sException) = 0);
      sException = sException | sDim | '-' | vSeg | ', ';
   ENDIF;
ENDIF;

# Features

sFeature = '';

IF(vDir @= '\N' % vDir @= '' % vMem @= '\N' % vMem @= '' % vU4B @= '\N' % vU4B @= '');
   sFeature = 'Unspecified Delivery Features';
ENDIF;

IF(vDir @= '1' % UPPER(vDir) @= 'TRUE');
   sDir = 'T';
ELSE;
   sDir = 'F';
ENDIF;

IF(vMem @= '1' % UPPER(vMem) @= 'TRUE');
   sMem = 'T';
ELSE;
   sMem = 'F';
ENDIF;

IF(vU4B @= '1' % UPPER(vU4B) @= 'TRUE');
   sU4B = 'T';
ELSE;
   sU4B = 'F';
ENDIF;

IF(sFeature @<> 'Unspecified Delivery Features');
   sFeature = 'Dir(' | sDir | ') Mem(' | sMem | ') U4B(' | sU4B | ')';
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Clear Target View
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
#Scanning the Input to find metrics  to be zeroed out

IF(DIMIX('Delivery Ops Metrics', sMetric) = 0);
   ITEMSKIP;
ENDIF;

IF(sMetric @= 'Completed Trips');
   nTrips = 1;
ELSEIF(sMetric @= 'Completed Trips - Rides Insurance CM' % sMetric @= 'P2 P2P Miles' % sMetric @= 'P3 P2P Miles' % sMetric @= 'P2 Non-P2P Miles' % sMetric @= 'P3 Non-P2P Miles');
   nMiles = 1;
ELSEIF(sMetric @= 'P2P Miles');
   np2pmiles = 1;
ENDIF;

IF(SCAN(sMetric, cMetricString) = 0);
   cMetricString = cMetricString | sMetric | '|';
   SUBSETDELETEALLELEMENTS('Delivery Ops Metrics', cSubset);
   SUBSETELEMENTINSERT('Delivery Ops Metrics', cSubset, sMetric, 1);
   VIEWZEROOUT(cCube, cViewName);
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Load Data
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

sDim = 'Rate Type';
p = 1;
WHILE(p <= DIMSIZ(sDim));
   sRateType = DIMNM(sDim, p);
   IF(ELLEV(sDim, sRateType) = 0);
      # ================= TAPTOOLS: START GENERATED CODE =================== #
      nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
      # ================= TAPTOOLS: END GENERATED CODE ===================== #
      CELLPUTN(vValue, cCube, 'Actual', sPeriod, 'FDS', sRateType, vLob, '0000', sLocation, vFul, vMerType, vOrder, vSeg, sFeature, sMetric, 'Amount');
      #cRecordCount = cRecordCount + 1;
   ENDIF;
   p = p + 1;
END;











# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsCompleted = nDataProcedureRecordsCompleted + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
