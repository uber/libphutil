# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #

# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsStarted = nDataProcedureRecordsStarted + 1;
IF(nMetadataProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: END METADATA PROCEDURE');
   nMetadataProcedureEndTime = NOW();
ENDIF;
IF(nDataProcedureStartTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: START DATA PROCEDURE');
   nDataProcedureStartTime = NOW();
ENDIF;
# ================= TAPTOOLS: END GENERATED CODE ===================== #


#****Begin: Generated Statements***
#****End: Generated Statements****

IF(vOpsMetric @= 'Active Riders');
   vOpsMetric = 'Active Users';
ELSEIF(vOpsMetric @= 'New Riders');
   vOpsMetric = 'New Users';
ENDIF;

# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #
CELLPUTN(vValue, sCube, vVersion, vPeriod, vSource, vRateType, vLocation, vLineofBusiness, vProductType, vOpsMetric, vOpsMeasure);


# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsCompleted = nDataProcedureRecordsCompleted + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
