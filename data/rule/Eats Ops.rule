###############################################################################
### Cube: Eats Ops
### Dimensions:
###     1: Version
###     2: Period
###     3: Source
###     4. Rate Type
###     5: Location
###     6: Eats Product Type
###     7. Eats Restaurant Type
###     8: Eats Ops Metric
###     9: Eats Ops Measure
###############################################################################

FEEDSTRINGS;
SKIPCHECK;

[ ] =
   IF(
      ATTRS ( 'Version', !Version, 'Active' ) @= ''
   ,
      STET
   ,
      CONTINUE
   );
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# Pull Oracle data for VC
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['Actual', 'Oracle', 'Unspecified Eats Product Type', 'Unspecified Restaurant Type', 'Amount'] = N:
   IF(
      ELISANC('Eats Ops Metric', 'GAAP Contribution', !Eats Ops Metric) = 1,
     DB('ANALYTICS.GL reporting', 'Actual', !Period, 'Total Source Excl Sig Adj', !Rate Type, '2001', !Location, 'Total Department', 'Unspecified Product Type', !Eats Ops Metric, 'Amount'),
     STET);

# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# Budget Data from Planning
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['Version' : {'2020 Plan',  'Forecast Excl Actuals'}] =  STET;

# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# PnL Data to be allocated
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['Actual',{'Product Resto PL', 'Oracle'},'Completed Deliveries'] = N: ['Actual','FDS','Completed Deliveries'];
['Source' : 'Product Resto PL'] =  STET;

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-  =-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Eats Ops Calculated Metrics: CPT
#=-=-=-=-=-=-=-=-=-=-=-=-=-=- =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['CPT', 'Amount'] = C: (['Existing Driver Incentives'] + ['Total Driver Payments']) \ ['Completed Deliveries'];

# =-=-=-=-=-=-=-=-=-=-=-=-=-=- =-=-=-=-=-=-=-=-=-=-=-=-=-=- =-=-=-= #
# POP, YOY, POP %, YOY %, % of Gross Bookings, % of Adjusted Net Revenue
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- =-=-=-=-=-=-=-=-=-=-=-=-=-=- =-=-=-= #

['% of Gross Bookings'] = ['Amount'] \ ['Gross Bookings','Amount'];

['% of Adjusted Net Revenue'] = ['Amount'] \ ['Adjusted Net Revenue'];

['PoP Growth'] =
   (
     ['Amount'] -
     DB('Eats Ops',!Version,ATTRS('Period', !Period, 'Period-1'),!Source,!Rate Type,!Location,!Eats Product Type,!Eats Restaurant Type,!Eats Ops Metric,'Amount')
   ) *
      IF(
      ATTRN('Eats Ops Metric', !Eats Ops Metric, 'Var Multiplier') = -1
      ,
      -1
      ,
      1);

['YoY Growth'] =
   IF(
     ELISANC('Period', 'Total Time - Month', !Period)=1,
   (
      ['Amount'] -
      DB('Eats Ops',!Version,ATTRS('Period', !Period, 'Year-1'),!Source,!Rate Type,!Location,!Eats Product Type,!Eats Restaurant Type,!Eats Ops Metric,'Amount')
   ) *
      IF(
      ATTRN('Eats Ops Metric', !Eats Ops Metric, 'Var Multiplier') = -1
      ,
      -1
      ,
      1)
     , 0);

['PoP Growth %'] =
  MIN(
    MAX(
         ['PoP Growth'] \
         ABS (DB('Eats Ops',!Version,ATTRS('Period', !Period, 'Period-1'),!Source,!Rate Type,!Location,!Eats Product Type,!Eats Restaurant Type,!Eats Ops Metric,'Amount'))
         ,
        -9.99
      )
   ,
    9.99
  );

['YoY Growth %'] =
   IF(
     ELISANC('Period', 'Total Time - Month', !Period)=1,
  MIN(
    MAX(
          ['YoY Growth'] \
          ABS (DB('Eats Ops',!Version,ATTRS('Period', !Period, 'Year-1'),!Source,!Rate Type,!Location,!Eats Product Type,!Eats Restaurant Type,!Eats Ops Metric,'Amount'))
          ,
         -9.99
        )
      ,
    9.99
  ),0);

#=-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-=-=-=-=-#
#>--- Amount Measure in (K) & (M)
#=-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-=-=-=-=-#

['Eats Ops Measure':'Amount (K)'] = C:
   ['Amount'] \ 1000;

['Eats Ops Measure':'Amount (M)'] = C:
    ['Amount'] \ 1000000;


# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# Consolidation  and N Level  Calcs
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['Actual', '% of Orders'] = ['Completed Deliveries'] \ DB('Eats Ops',!Version,!Period,!Source,!Rate Type,!Location,!Eats Product Type,'Total Eats Restaurant Type','Completed Deliveries',!Eats Ops Measure);

['Actual','% of Restos'] = ['Active Restaurants'] \ DB('Eats Ops',!Version,!Period,!Source,!Rate Type,!Location,!Eats Product Type,'Total Eats Restaurant Type','Active Restaurants',!Eats Ops Measure);

['Actual','% of GB'] = ['Gross Bookings'] \ DB('Eats Ops',!Version,!Period,!Source,!Rate Type,!Location,!Eats Product Type,'Total Eats Restaurant Type','Total Bookings',!Eats Ops Measure);

['Actual', 'TpE'] = IF(ATTRS('Period',!Period,'Level') @= 'Week', ['Completed Deliveries'] \ ['Weekly Active Eaters'], ['Completed Deliveries'] \ ['Active Eaters']);

['Actual', 'ANR Margin'] = ['Adjusted Net Revenue']\ ['Gross Bookings'];

['Actual','Avg. Basket Size'] = ['Fares'] \ ['Completed Deliveries'];

['Actual','Marketplace Fee %'] = 1 + ( ['MPF'] \ ['Fares'] );

['Actual','Promo % of GB'] = ['Total Eater Promos'] \ ['Gross Bookings'];

['Actual','TpR'] = ['Completed Deliveries'] \ ['Active Restaurants'];

['Actual', '% of Trips Promoed'] = ['Promo Trips'] \ ['Completed Deliveries'];


# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# Consolidation  Level  Calcs
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['Eats Ops Measure':'Amount' ] = C:
   IF(
      ATTRS('Eats Ops Metric', !Eats Ops Metric, 'Aggregate_Location_Flag') @= 'Y'
   ,
      IF(
         ELLEV('Period', !Period) > 0
      ,
         0
      ,
         IF(
            (ELLEV ('Location', !Location) > 0)
         ,
            DB('Eats Ops', !Version, !Period, !Source, !Rate Type, 'CustomLeaf':!Location | ' Input', !Eats Product Type, !Eats Restaurant Type, !Eats Ops Metric, 'Amount')
         ,
            STET
         )
      )
   ,
      CONTINUE
   );

# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# Leaf Level  Calcs
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['Eats Ops Measure' : 'Amount' ] = N:
   IF(
      ATTRS('Eats Ops Metric', !Eats OPS Metric, 'Fx_Flag') @= 'Y'
   ,
      DB('Eats Ops Staging', !Version, !Period, !Source, 'Total Currency', !Rate Type, !Location, !Eats Product Type, !Eats Restaurant Type, !Eats OPS Metric, 'Amount')
   ,
      STET
   );





FEEDERS;

['Actual', 'Completed Deliveries'] => ['% of Orders'] , ['TpE'], ['Avg. Basket Size'], ['TpR'], ['% of Trips Promoed'], ['% of GB'], ['ANR Margin'], ['Marketplace Fee %'], ['Promo % of GB'];

['Actual','Active Restaurants'] => ['% of Restos'];

['Actual','FDS','Completed Deliveries'] => ['Actual','Product Resto PL','Completed Deliveries'];
['Actual','FDS','Completed Deliveries'] => ['Actual','Oracle','Completed Deliveries'];

## Feed Ops

['Amount'] => DB('Ops',!Version,!Period,!Source,!Rate Type,!Location,'2001','Eats',!Eats Ops Metric,'Amount');

['Actual', 'FDS', 'Total Eats Product Type', 'Total Eats Restaurant Type', 'Completed Deliveries', 'Amount'] =>DB('Ops', 'Actual', !Period, 'FDS', !Rate Type, !Location, '2001', 'EATS', 'Completed Trips', 'Amount');

['Actual', 'FDS', 'Unspecified Eats Product Type', 'Unspecified Restaurant Type', 'Active Eaters', 'Amount'] =>DB('Ops', 'Actual', !Period, 'FDS', !Rate Type, !Location, '2001', 'EATS', 'Active Riders', 'Amount');

['Actual', 'FDS', 'Unspecified Eats Product Type', 'Unspecified Restaurant Type', 'Active Eaters L28', 'Amount'] =>DB('Ops', 'Actual', !Period, 'FDS', !Rate Type, !Location, '2001', 'EATS', 'Active Riders L28', 'Amount');

['Actual', 'FDS', 'Unspecified Eats Product Type', 'Unspecified Restaurant Type', 'Weekly Active Eaters', 'Amount'] =>DB('Ops', 'Actual', !Period, 'FDS', !Rate Type, !Location, '2001', 'EATS', 'Weekly Active Riders', 'Amount');

['Actual', 'FDS', 'Unspecified Eats Product Type', 'Unspecified Restaurant Type', 'New Eaters', 'Amount'] =>DB('Ops', 'Actual', !Period, 'FDS', !Rate Type, !Location, '2001', 'EATS', 'New Riders', 'Amount');

['Actual', 'FDS', 'Unspecified Eats Product Type', 'Unspecified Restaurant Type', 'New Eater Deliveries', 'Amount'] =>DB('Ops', 'Actual', !Period, 'FDS', !Rate Type, !Location, '2001', 'EATS', 'New Rider Trips', 'Amount');

['Actual', 'FDS', 'Unspecified Eats Product Type', 'Unspecified Restaurant Type', 'Resurrected Eaters', 'Amount'] =>DB('Ops', 'Actual', !Period, 'FDS', !Rate Type, !Location, '2001', 'EATS', 'Resurrected Riders', 'Amount');

['Actual', 'FDS', 'Unspecified Eats Product Type', 'Unspecified Restaurant Type', '84 Day Inactive Eaters', 'Amount'] =>DB('Ops', 'Actual', !Period, 'FDS', !Rate Type, !Location, '2001', 'EATS', '84 Day Inactive Riders', 'Amount');

['Actual', 'FDS', 'Unspecified Eats Product Type', 'Unspecified Restaurant Type', 'Continuing Eaters', 'Amount'] =>DB('Ops', 'Actual', !Period, 'FDS', !Rate Type, !Location, '2001', 'EATS', 'Continuing Riders', 'Amount');

['Actual', 'FDS', 'Unspecified Eats Product Type', 'Unspecified Restaurant Type', 'Continuing Eater Deliveries', 'Amount'] =>DB('Ops', 'Actual', !Period, 'FDS', !Rate Type, !Location, '2001', 'EATS', 'Continuing Rider Trips', 'Amount');

['Actual', 'FDS', 'Unspecified Eats Product Type', 'Unspecified Restaurant Type', 'Active Couriers', 'Amount'] =>DB('Ops', 'Actual', !Period, 'FDS', !Rate Type, !Location, '2001', 'EATS', 'Active Drivers', 'Amount');

['Actual', 'FDS', 'Unspecified Eats Product Type', 'Unspecified Restaurant Type', 'Active Couriers L28', 'Amount'] =>DB('Ops', 'Actual', !Period, 'FDS', !Rate Type, !Location, '2001', 'EATS', 'Active Drivers L28', 'Amount');

['Actual', 'FDS', 'Unspecified Eats Product Type', 'Unspecified Restaurant Type', 'Weekly Active Couriers', 'Amount'] =>DB('Ops', 'Actual', !Period, 'FDS', !Rate Type, !Location, '2001', 'EATS', 'Weekly Active Drivers', 'Amount');

['Actual', 'FDS', 'Unspecified Eats Product Type', 'Unspecified Restaurant Type', 'New Couriers', 'Amount'] =>DB('Ops', 'Actual', !Period, 'FDS', !Rate Type, !Location, '2001', 'EATS', 'New Drivers', 'Amount');

['Actual', 'FDS', 'Unspecified Eats Product Type', 'Unspecified Restaurant Type', 'New Courier Deliveries', 'Amount'] =>DB('Ops', 'Actual', !Period, 'FDS', !Rate Type, !Location, '2001', 'EATS', 'New Driver Trips', 'Amount');

['Actual', 'FDS', 'Unspecified Eats Product Type', 'Unspecified Restaurant Type', 'Continuing Couriers', 'Amount'] =>DB('Ops', 'Actual', !Period, 'FDS', !Rate Type, !Location, '2001', 'EATS', 'Continuing Drivers', 'Amount');

['Actual', 'FDS', 'Unspecified Eats Product Type', 'Unspecified Restaurant Type', 'Continuing Courier Deliveries', 'Amount'] =>DB('Ops', 'Actual', !Period, 'FDS', !Rate Type, !Location, '2001', 'EATS', 'Continuing Driver Trips', 'Amount');

['Actual', 'FDS', 'Unspecified Eats Product Type', 'Unspecified Restaurant Type', 'Rider Miles', 'Amount'] =>DB('Ops', 'Actual', !Period, 'FDS', !Rate Type, !Location, '2001', 'EATS', 'P2P Rider Miles', 'Amount');

