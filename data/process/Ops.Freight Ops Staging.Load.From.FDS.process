#****Begin: Generated Statements***
#****End: Generated Statements****


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Transformation
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

# Month and Week

IF(pLevel @= 'Month');
   sPeriod = SUBST(vPeriod, 1, 7);
ELSE;
   sPeriod = 'WS ' | vPeriod;
ENDIF;

# Location
sDim = 'Location';
IF(vArea @= '\N' % vArea @= '');
   ITEMSKIP;
ENDIF;

IF(vArea @= 'CANADA');
   sArea = 'v13';
ELSEIF(vArea @= 'US');
   sArea = 'v7';
ELSEIF(vArea @= 'EU');
   sArea = 'v34';
ENDIF;

# Currency
IF(vCurrency @= '\N' % vCurrency @= '');
   ITEMSKIP;
ENDIF;

# Freight Shipper
sDim = 'Freight Shipper';
IF(vShipperUUID @= '\N' % vShipperUUID @= '' % vShipperUUID @= 'None' % DIMIX('Freight Shipper', vShipperUUID) = 0);
   sShipperUUID = 'Unspecified Freight Shipper';
ELSE;
   sShipperUUID = vShipperUUID;
ENDIF;

# Freight Load Rate Type
sDim = 'Freight Load Rate Type';
IF(vLoadRateType @= '\N' % vLoadRateType @= '');
   sLoadRateType = 'Unspecified Freight Load Rate Type';
ELSE;
   sLoadRateType = vLoadRateType;
ENDIF;

#Freight Service Type
sDim = 'Freight Service Type';
IF(vServiceType @= '\N' % vServiceType @= '' % DIMIX('Freight Service Type', vServiceType) = 0);
   sServiceType = 'Unspecified Freight Service Type';
ELSE;
   sServiceType = vServiceType;
ENDIF;

# Freight Booking Channel
sDim = 'Freight Booking Channel';
IF(vChannel @= '\N' % vChannel @= '');
   sChannel = 'Unspecified Freight Booking Channel';
ELSE;
   sChannel = vChannel;
ENDIF;

# Freight Carrier Segment
sDim = 'Freight Carrier Segment';
IF(vCarrierSeg @= '\N' % vCarrierSeg @= '' % vCarrierSeg @= 'Unknown');
   sCarrierSeg = 'Unspecified Freight Carrier Segment';
ELSE;
   sCarrierSeg = vCarrierSeg;
ENDIF;


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Clear Target View
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
#Scanning the Input to find Period and metric combination to be zeroed out

sMetric = vMetric;

IF(SCAN(sPeriod | '$' | sMetric, cPeriodMetricString) = 0);

   IF(LONG(cPeriodMetricString) = 0);
      cPeriodMetricString = sPeriod | '$' | sMetric;
   ELSE;
      cPeriodMetricString = cPeriodMetricString | '|' | sPeriod | '$' | sMetric;
   ENDIF;

   sLoopString = TRIM(cPeriodMetricString);
   sLoopString = sLoopString | IF(SUBST(sLoopString, LONG(sLoopString), 1) @<> '|', '|', '');

   WHILE(nCurPos <= LONG(sLoopString));
      sCurChar = SUBST(sLoopString, nCurPos, 1);
      IF(sCurChar @= '|');
         sPeriodMetricElement = SUBST(sLoopString, nStart, nCurPos - nStart);
         nSplit = SCAN('$', sPeriodMetricElement);
         sPeriodElement = SUBST(sPeriodMetricElement, 1, (nSplit - 1));
         sMetricElement = SUBST(sPeriodMetricElement, (nSplit + 1), LONG(sPeriodMetricElement) - nSplit);

         cRandomIntA = NUMBERTOSTRING(INT(RAND() * 100000));
         cViewName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
         cSubsetName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
         VIEWCREATE(cCube, cViewName, 1);
         nCtr = 1;
         nMax = CUBEDIMENSIONCOUNTGET(cCube);
         WHILE(nCtr <= nMax);
            sDim = TABDIM(cCube, nCtr);
            IF(sDim @= 'Version');
               sElement = 'Actual';
               SUBSETCREATE(sDim, cSubsetName, 1);
               SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
               VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
            ELSEIF(sDim @= 'Period');
               sElement = sPeriodElement;
               SUBSETCREATE(sDim, cSubsetName, 1);
               SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
               VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
            ELSEIF(sDim @= 'Freight Ops Metric');
               sElement = sMetricElement;
               SUBSETCREATE(sDim, cSubsetName, 1);
               SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
               VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
            ELSE;
               sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({TM1SUBSETALL([ ' | sDim | '] )}, 0)}, ASC)}';
               SUBSETCREATEBYMDX(cSubsetName, sMdx, 1);
               VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
            ENDIF;
            nCtr = nCtr + 1;
         END;
         VIEWZEROOUT(cCube, cViewName);
         nStart = nCurPos + 1;
      ENDIF;
      nCurPos = nCurPos + 1;
   END;
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Load Data
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

IF(pLevel @= 'Month');
   vUSDValue = vValue * CELLGETN('Exchange Rate', cVersion, sPeriod, vCurrency, 'USD', 'Rate');
ELSE;
   sMonth = SUBST(sPeriod, 4, 7);
   vUSDValue = vValue * CELLGETN('Exchange Rate', cVersion, ATTRS('Period', sMonth, 'Period-1'), vCurrency, 'USD', 'Month End Rate');
ENDIF;

# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #
CELLINCREMENTN(vValue, cCube, cVersion, sPeriod, cSource, vCurrency, cRateType, sArea, sShipperUUID, sLoadRateType, sServiceType, sChannel, sCarrierSeg, vMetric, cMeasure);
cRecordCount = cRecordCount + 1;
# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #
CELLINCREMENTN(vUSDValue, cCube, cVersion, sPeriod, cSource, vCurrency, 'USD', sArea, sShipperUUID, sLoadRateType, sServiceType, sChannel, sCarrierSeg, vMetric, cMeasure);
cRecordCount = cRecordCount + 1;
# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #
CELLPUTS(sOutputstring, 'Freight Ops Info', vMetric, sPeriod, 'Last Updated');

# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsCompleted = nDataProcedureRecordsCompleted + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

