# BEGIN: EPILOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

# ==================================================================== #
# Run Ti 
# ==================================================================== #

cTemplateScriptRun = '%cPythonExe% %cScriptRun% %cScriptBatch% %cThreads% %cServiceName%';
sCommand = EXPAND(cTemplateScriptRun);
EXECUTECOMMAND(sCommand, 1);

LOGOUTPUT('INFO', 'PYTHON SCRIPT EXECUTION -- COMPLETED --> ' | sCommand);


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: EPILOG PROCEDURE                                                       #
