# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

# Process to load Eats financial metrics from FDS to Eats Ops Staging cube

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Define Constants
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cCube = 'Eats Ops Staging';
cVersion = 'Actual';
cRateType = 'No Rate Type';
cMeasure = 'Amount';
cSource = 'FDS';
nRecords = 1;

cMetricString = '';

nStart = 1;
nCurPos = 1;

nDate = NOW;
NEWDATEFORMATTER('', 'PST', 'serial', 'full', 'datetime', '');
sOutputString = FORMATDATE(nDate, 0);

cUser = CELLGETS('System Info', 'SQL User Name GL Transactions', 'String');
cPassword = CELLGETS('System Info', 'SQL Password GL Transactions', 'String');


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Set Query
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

DatasourceUsername = cUser;
DatasourcePassword = cPassword;
sQuery = EXPAND('SELECT * FROM "%pTable%"');
DatasourceQuery = sQuery;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Subsets for View Zero Out
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cRandomIntA = NUMBERTOSTRING(INT(RAND() * 100000));
cSubset = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
cViewName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
VIEWCREATE(cCube, cViewName, 1);

nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(cCube);

WHILE(nCtr <= nMax);
   sDim = TABDIM(cCube, nCtr);

   IF(sDim @= 'Version');
      sElement = 'Actual';
      SUBSETCREATE(sDim, cSubset, 1);
      SUBSETELEMENTINSERT(sDim, cSubset, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Period');
      SUBSETCREATE(sDim, cSubset, 1);
      IF(pStartDate @<> '' & pEndDate @<> '' & pLevel @= 'Day');
         nStartday = DAYNO(SUBST(pStartDate, 1, 10));
         nEndday = DAYNO(SUBST(pEndDate, 1, 10));
         WHILE(nStartday <= nEndDay);
            sDay = DATE(nStartday, 1);
            SUBSETELEMENTINSERT(sDim, cSubset, sDay, 1);
            nStartday = nStartday + 1;
         END;
      ENDIF;
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Eats Ops Metric');
      SUBSETCREATE(sDim, cSubset, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSE;
      sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({TM1SUBSETALL([ ' | sDim | '] )}, 0)}, ASC)}';
      SUBSETCREATEBYMDX(cSubset, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ENDIF;

   nCtr = nCtr + 1;
END;





# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: METADATA PROCEDURE                                                   #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: METADATA PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Transformation
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

# Month and Week

IF(pLevel @= 'Month');
   sPeriod = SUBST(vPeriod, 1, 7);
ELSEIF(pLevel @= 'Day');
   sPeriod = vPeriod;
ELSE;
   sPeriod = 'WS ' | vPeriod;
ENDIF;

IF(vMetric @= 'Basket');
   vMetric = '41105';
ENDIF;

IF(vMetric @= 'Booking Fees');
   vMetric = '41115';
ENDIF;

IF(vMetric @= 'Refunds');
   vMetric = '41519';
ENDIF;

IF(vMetric @= 'Restaurant Payments');
   vMetric = 'Restaurant Payment';
ENDIF;

# Location
sDim = 'Location';
IF(vLocation @= '\N' % vLocation @= '');
   ITEMSKIP;
ENDIF;
sLocation = 'V' | vLocation;

IF(DIMIX('Location', sLocation) = 0);
   ITEMSKIP;
ENDIF;

# Currency
IF(vCurrency @= '\N' % vCurrency @= '');
   ITEMSKIP;
ENDIF;

# Eats Product Type
sDim = 'Eats Product Type';
IF(vProductType @= '\N' % vProductType @= '' % vProductType @= 'None' % DIMIX(sDim, vProductType) = 0);
   sProductType = 'Unspecified Eats Product Type';
ELSE;
   sProductType = vProductType;
ENDIF;

# Eats Restaurant Type
sDim = 'Eats Restaurant Type';
IF(vRestType @= '\N' % vRestType @= '' % vRestType @= 'Not Classified');
   sRestType = 'Unspecified Restaurant Type';
ELSE;
   sRestType = vRestType;
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Clear Target View
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
#Scanning the Input to find  metrics to be zeroed out

IF(SCAN('_usd', vMetric) = 0);
   sMetric = vMetric;

   IF(SCAN(sMetric, cMetricString) = 0);
      cMetricString = cMetricString | sMetric | '|';
      SUBSETDELETEALLELEMENTS('Eats Ops Metric', cSubset);
      SUBSETELEMENTINSERT('Eats Ops Metric', cSubset, sMetric, 1);
      VIEWZEROOUT(cCube, cViewName);
   ENDIF;

ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Load Data
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

IF(ELISANC('Eats Ops Metric', 'Net Inflows', vMetric) = 0 & SCAN('_usd', vMetric) = 0);

   IF(pLevel @= 'Month');
      vUSDValue = vValue * CELLGETN('Exchange Rate', cVersion, sPeriod, vCurrency, 'USD', 'Rate');
   ELSEIF(pLevel @= 'Day');
      sMonth = SUBST(sPeriod, 1, 7);
      vUSDValue = vValue * CELLGETN('Exchange Rate', cVersion, ATTRS('Period', sMonth, 'Period-1'), vCurrency, 'USD', 'Month End Rate');
   ELSE;
      sMonth = SUBST(sPeriod, 4, 7);
      vUSDValue = vValue * CELLGETN('Exchange Rate', cVersion, ATTRS('Period', sMonth, 'Period-1'), vCurrency, 'USD', 'Month End Rate');
   ENDIF;

   CELLINCREMENTN(vValue, cCube, cVersion, sPeriod, cSource, vCurrency, cRateType, sLocation, sProductType, sRestType, vMetric, cMeasure);
   CELLINCREMENTN(vUSDValue, cCube, cVersion, sPeriod, cSource, vCurrency, 'USD', sLocation, sProductType, sRestType, vMetric, cMeasure);
   CELLPUTS(sOutputstring, 'Eats Ops Info', sMetric, sPeriod, 'Last Updated');

ELSEIF(SCAN('_usd', vMetric) = 0);

   CELLINCREMENTN(vValue, cCube, cVersion, sPeriod, cSource, vCurrency, cRateType, sLocation, sProductType, sRestType, vMetric, cMeasure);
   CELLPUTS(sOutputstring, 'Eats Ops Info', vMetric, sPeriod, 'Last Updated');
ELSE;
   nSep = SCAN('_usd', vMetric);
   sMetric = SUBST(vMetric, 1, (nSep - 1));
   IF(sMetric @= 'Basket');
      sMetric = '41105';
   ENDIF;

   IF(sMetric @= 'Booking Fees');
      sMetric = '41115';
   ENDIF;

   IF(sMetric @= 'Refunds');
      sMetric = '41519';
   ENDIF;

   IF(sMetric @= 'Restaurant Payments');
      sMetric = 'Restaurant Payment';
   ENDIF;
   CELLINCREMENTN(vValue, cCube, cVersion, sPeriod, cSource, vCurrency, 'USD', sLocation, sProductType, sRestType, sMetric, cMeasure);
ENDIF;

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: EPILOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


sProcess = 'Ops.Eats Ops Staging.From Day Month';
EXECUTEPROCESS(sProcess
   , 'pStartDate', pStartDate
   , 'pEndDate', pEndDate
   , 'pMetrics', cMetricString
);



# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: EPILOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #