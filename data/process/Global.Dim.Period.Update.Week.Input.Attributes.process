# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

cDim = 'Period';

cRand = NUMBERTOSTRING(ROUND(RAND() * 100000));
cRand = FILL('0', 6 - LONG(cRand)) | cRand;

cView = EXPAND('zzTemp.%cRand%');
cSub = EXPAND('zzTemp.%cRand%');

# ==================================================================== #
# Create Week Subsets
# ==================================================================== #

sDim = cDim;
sHier = EXPAND('%sDim%');

sSub = cSub | '.Week';
sMDX = EXPAND('{TM1SORT( {TM1FILTERBYPATTERN( { [%sDim%].[%sDim%].Members }, "WS ????-??-??")}, ASC)}');
SUBSETCREATE(sHier, sSub, 0);
SUBSETMDXSET(sHier, sSub, sMDX);
SUBSETMDXSET(sHier, sSub, '');

# ==================================================================== #
# Update Attribute - Week
# ==================================================================== #

i = 1;

sSub = cSub | '.Week';
sHier = EXPAND('%sDim%');

WHILE(i <= SUBSETGETSIZE(sHier, sSub));
   sEle = SUBSETGETELEMENTNAME(sHier, sSub, i);

   nYear = NUMBR(SUBST(sEle, 4, 4));


   sAttr = 'Year Element';
   sAttrVal = SUBST(sEle, 4, 4);
   ATTRPUTS(sAttrVal, sHier, sEle, sAttr);

   sAttr = 'Week Element';
   sAttrVal = SUBST(sEle, 1, 13);
   ATTRPUTS(sAttrVal, sHier, sEle, sAttr);

   sAttr = 'Level';
   sAttrVal = 'Input';
   ATTRPUTS(sAttrVal, sHier, sEle, sAttr);

   sAttr = 'Prior Period';
   nIndex = i - 1;
   IF(nIndex > 0 & nIndex <= SUBSETGETSIZE(sHier, sSub));
      sAttrVal = SUBSETGETELEMENTNAME(sHier, sSub, nIndex);
      ATTRPUTS(sAttrVal, sHier, sEle, sAttr);
   ENDIF;

   sAttr = 'Next Period';
   nIndex = i + 1;
   IF(nIndex > 0 & nIndex <= SUBSETGETSIZE(sHier, sSub));
      sAttrVal = SUBSETGETELEMENTNAME(sHier, sSub, nIndex);
      ATTRPUTS(sAttrVal, sHier, sEle, sAttr);
   ENDIF;

   sAttr = 'Calendar Day';
   nAttrVal = ATTRN(sHier, sEle, 'End of Period') - ATTRN(sHier, sEle, 'Start of Period') + 1;
   ATTRPUTN(nAttrVal, sHier, sEle, sAttr);

   sAttr = 'Business Day';
   p = ATTRN(sHier, sEle, 'Start of Period');
   nEnd = ATTRN(sHier, sEle, 'End of Period');
   nAttrVal = 0;
   WHILE(p <= nEnd);
      IF(MOD(p, 7) > 1 & MOD(p, 7) <= 6);
         nAttrVal = nAttrVal + 1;
      ENDIF;
      p = p + 1;
   END;
   ATTRPUTN(nAttrVal, sHier, sEle, sAttr);

   p = -25;
   WHILE(p <= 25);
      sSign = IF(p < 0, '-', '+');
      IF(p <> 0);
         sAttr = 'Period' | sSign | NUMBERTOSTRING(ABS(p));
         nIndex = i + p;
         IF(nIndex > 0 & nIndex <= SUBSETGETSIZE(sHier, sSub));
            sAttrVal = SUBSETGETELEMENTNAME(sHier, sSub, nIndex);
            ATTRPUTS(sAttrVal, sHier, sEle, sAttr);
         ENDIF;
      ENDIF;
      p = p + 1;
   END;

   p = -53;
   WHILE(p <= 53);
      sSign = IF(p < 0, '-', '+');
      IF(p <> 0);
         sAttr = 'Week' | sSign | NUMBERTOSTRING(ABS(p));
         nIndex = i + p;
         IF(nIndex > 0 & nIndex <= SUBSETGETSIZE(sHier, sSub));
            sAttrVal = SUBSETGETELEMENTNAME(sHier, sSub, nIndex);
            ATTRPUTS(sAttrVal, sHier, sEle, sAttr);
         ENDIF;
      ENDIF;
      p = p + 1;
   END;

   p = -10;
   WHILE(p <= 10);
      sSign = IF(p < 0, '-', '+');
      IF(p <> 0);
         sAttr = 'Year' | sSign | NUMBERTOSTRING(ABS(p));
         sYear = NUMBERTOSTRING(nYear + p);
         nIndex = i + (p * 12);
         IF(nIndex > 0 & nIndex <= SUBSETGETSIZE(sHier, sSub));
            sAttrVal = SUBSETGETELEMENTNAME(sHier, sSub, nIndex);
            ATTRPUTS(sAttrVal, sHier, sEle, sAttr);
         ENDIF;
      ENDIF;
      p = p + 1;
   END;

   i = i + 1;
END;



# ==================================================================== #
# Create WD Week Subsets
# ==================================================================== #

sDim = cDim;
sHier = EXPAND('%sDim%');

sSub = cSub | '.WDWeek';
sMDX = EXPAND('{TM1SORT( {TM1FILTERBYPATTERN( { [%sDim%].[%sDim%].Members }, "WD ????-??-??")}, ASC)}');
SUBSETCREATE(sHier, sSub, 1);
SUBSETMDXSET(sHier, sSub, sMDX);
SUBSETMDXSET(sHier, sSub, '');


# ==================================================================== #
# Update Attribute - WD Week
# ==================================================================== #

i = 1;

sSub = cSub | '.WDWeek';
sHier = EXPAND('%sDim%');

WHILE(i <= SUBSETGETSIZE(sHier, sSub));
   sEle = SUBSETGETELEMENTNAME(sHier, sSub, i);

   nYear = NUMBR(SUBST(sEle, 4, 4));


   sAttr = 'Year Element';
   sAttrVal = 'WD ' | SUBST(sEle, 4, 4);
   ATTRPUTS(sAttrVal, sHier, sEle, sAttr);

   sAttr = 'Week Element';
   sAttrVal = SUBST(sEle, 1, 13);
   ATTRPUTS(sAttrVal, sHier, sEle, sAttr);

   sAttr = 'Level';
   sAttrVal = 'Input';
   ATTRPUTS(sAttrVal, sHier, sEle, sAttr);

   sAttr = 'Prior Period';
   nIndex = i - 1;
   IF(nIndex > 0 & nIndex <= SUBSETGETSIZE(sHier, sSub));
      sAttrVal = SUBSETGETELEMENTNAME(sHier, sSub, nIndex);
      ATTRPUTS(sAttrVal, sHier, sEle, sAttr);
   ENDIF;

   sAttr = 'Next Period';
   nIndex = i + 1;
   IF(nIndex > 0 & nIndex <= SUBSETGETSIZE(sHier, sSub));
      sAttrVal = SUBSETGETELEMENTNAME(sHier, sSub, nIndex);
      ATTRPUTS(sAttrVal, sHier, sEle, sAttr);
   ENDIF;

   sAttr = 'Calendar Day';
   nAttrVal = ATTRN(sHier, sEle, 'End of Period') - ATTRN(sHier, sEle, 'Start of Period') + 1;
   ATTRPUTN(nAttrVal, sHier, sEle, sAttr);

   sAttr = 'Business Day';
   p = ATTRN(sHier, sEle, 'Start of Period');
   nEnd = ATTRN(sHier, sEle, 'End of Period');
   nAttrVal = 0;
   WHILE(p <= nEnd);
      IF(MOD(p, 7) > 1 & MOD(p, 7) <= 6);
         nAttrVal = nAttrVal + 1;
      ENDIF;
      p = p + 1;
   END;
   ATTRPUTN(nAttrVal, sHier, sEle, sAttr);

   p = -25;
   WHILE(p <= 25);
      sSign = IF(p < 0, '-', '+');
      IF(p <> 0);
         sAttr = 'Period' | sSign | NUMBERTOSTRING(ABS(p));
         nIndex = i + p;
         IF(nIndex > 0 & nIndex <= SUBSETGETSIZE(sHier, sSub));
            sAttrVal = SUBSETGETELEMENTNAME(sHier, sSub, nIndex);
            ATTRPUTS(sAttrVal, sHier, sEle, sAttr);
         ENDIF;
      ENDIF;
      p = p + 1;
   END;

   p = -53;
   WHILE(p <= 53);
      sSign = IF(p < 0, '-', '+');
      IF(p <> 0);
         sAttr = 'Week' | sSign | NUMBERTOSTRING(ABS(p));
         nIndex = i + p;
         IF(nIndex > 0 & nIndex <= SUBSETGETSIZE(sHier, sSub));
            sAttrVal = SUBSETGETELEMENTNAME(sHier, sSub, nIndex);
            ATTRPUTS(sAttrVal, sHier, sEle, sAttr);
         ENDIF;
      ENDIF;
      p = p + 1;
   END;

   p = -10;
   WHILE(p <= 10);
      sSign = IF(p < 0, '-', '+');
      IF(p <> 0);
         sAttr = 'Year' | sSign | NUMBERTOSTRING(ABS(p));
         sYear = NUMBERTOSTRING(nYear + p);
         nIndex = i + (p * 12);
         IF(nIndex > 0 & nIndex <= SUBSETGETSIZE(sHier, sSub));
            sAttrVal = SUBSETGETELEMENTNAME(sHier, sSub, nIndex);
            ATTRPUTS(sAttrVal, sHier, sEle, sAttr);
         ENDIF;
      ENDIF;
      p = p + 1;
   END;

   i = i + 1;
END;



