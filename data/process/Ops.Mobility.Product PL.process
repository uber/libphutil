# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
# Allocate GL Operational based on Mobility / Product PL 
#@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@

# Summary: This process allocates Oracle data by Product Type / Mobility Features that is recieved from FDS. 
# Non-FDS data points will be allocated based on User specified login in the Mobility PL Allocation cube. 

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
## Initialise Constants               ##
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cSourceCube = 'Mobility';
cTargetCube = 'Mobility';
cStagingCube = 'Mobility Staging';
cAllocCube = 'Mobility PL Allocation';
cCubeDash = 'Dashboard Info';

cStartTime = NOW();
cRand = NUMBERTOSTRING(ROUND(RAND() * 100000));
cRand = FILL('0', 6 - LONG(cRand)) | cRand;
cRand = NUMBERTOSTRING(NOW()) | '.' | cRand;
cRandomIntA = cRand;
cViewName = 'zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
cSubsetName = 'zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;

cDimFDSAcc = 'Operational PL FDS Metrics';
cDimMobAcc = 'Mobility Ops Metrics';
cDimProductType = 'Product Type';
cDimMobilityFeature = 'Mobility Features';

cVersion = pVersion;
cMeasure = 'Amount';
cTargetSource = 'Product PL';
cProductConsol = 'Total Mobility Product Type';
cMobilityConsol = 'All Mobility Features';
cSourceConsol = 'Oracle';
cLocationConsol = 'Total Location Incl Discontinued';
cDeptConsol = 'Total Department';
cLOBConsol = 'Mobility';
cOpsLOBConsol = 'Mobility';
cGLAccountConsol = 'Ops P&L';

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
## Clear Target             ##
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cRandomIntA = NUMBERTOSTRING(INT(RAND() * 100000 * RAND()));
cViewName = 'zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
cSubsetName = 'zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;

cCube = cTargetCube;
VIEWCREATE(cCube, cViewName, 1);
nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(cCube);
WHILE(nCtr <= nMax);
   sDim = TABDIM(cCube, nCtr);
   IF(sDim @= 'Version');
      sElement = pVersion;
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Period');
      IF(DTYPE(sDim, pMonth) @= 'N');
         sElement = pMonth;
         SUBSETCREATE(sDim, cSubsetName, 1);
         SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
         VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
      ELSE;
         sMDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[ ' | sDim | '].[ ' | pMonth | ']}, ALL, RECURSIVE )}, 0)}';
         SUBSETCREATEBYMDX(cSubsetName, sMdx, 1);
         VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
      ENDIF;
   ELSEIF(sDim @= 'Source');
      sElement1 = cTargetSource;
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement1, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Mobility Ops Metrics');
      IF(DTYPE(sDim, pAccount) @= 'N');
         sElement = pAccount;
         SUBSETCREATE(sDim, cSubsetName, 1);
         SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
         VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
      ELSE;
         sMDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[ ' | sDim | '].[ ' | pAccount | ']}, ALL, RECURSIVE )}, 0)}';
         SUBSETCREATEBYMDX(cSubsetName, sMdx, 1);
         VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
      ENDIF;
   ELSEIF(sDim @= 'Rate Type');
      IF(pRateType @= '');
         sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({TM1SUBSETALL([ ' | sDim | '] )}, 0)}, ASC)}';
         SUBSETCREATEBYMDX(cSubsetName, sMdx, 1);
      ELSE;
         sElement = pRateType;
         SUBSETCREATE(sDim, cSubsetName, 1);
         SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      ENDIF;
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Mobility Measure');
      sElement = 'Amount';
      SUBSETCREATE(sDim, cSubsetName, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSE;
      sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({TM1SUBSETALL([ ' | sDim | '] )}, 0)}, ASC)}';
      SUBSETCREATEBYMDX(cSubsetName, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ENDIF;
   nCtr = nCtr + 1;
END;

VIEWEXTRACTSKIPRULEVALUESSET(cCube, cViewName, 1);
VIEWEXTRACTSKIPCALCSSET(cCube, cViewName, 1);
VIEWEXTRACTSKIPZEROESSET(cCube, cViewName, 1);

VIEWZEROOUT(cCube, cViewName);

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
## Create Source View                 ##
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cRand = NUMBERTOSTRING(ROUND(RAND() * 100000));
cRand = FILL('0', 6 - LONG(cRand)) | cRand;
cRand = NUMBERTOSTRING(NOW()) | '.' | cRand;
cRandomIntA1 = cRand;
cViewName1 = GETPROCESSNAME() | '.' | cRandomIntA;
cSubsetName1 = GETPROCESSNAME() | '.' | cRandomIntA;

cCube = cSourceCube;
VIEWCREATE(cCube, cViewName1, 1);
nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(cCube);
WHILE(nCtr <= nMax);
   sDim = TABDIM(cCube, nCtr);
   IF(sDim @= 'Version');
      sElement = pVersion;
      SUBSETCREATE(sDim, cSubsetName1, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName1, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
   ELSEIF(sDim @= 'Period');
      IF(DTYPE(sDim, pMonth) @= 'N');
         sElement = pMonth;
         SUBSETCREATE(sDim, cSubsetName1, 1);
         SUBSETELEMENTINSERT(sDim, cSubsetName1, sElement, 1);
         VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
      ELSE;
         sMDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { ( [ ' | sDim | '  ].[ ' | pMonth | ' ] )}, ALL, RECURSIVE)}, 0)}';
         SUBSETCREATEBYMDX(cSubsetName1, sMdx, 1);
         VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName1);
      ENDIF;
   ELSEIF(sDim @= 'Mobility Ops Metrics');
      IF(DTYPE(sDim, pAccount) @= 'N');
         sElement = pAccount;
         SUBSETCREATE(sDim, cSubsetName1, 1);
         SUBSETELEMENTINSERT(sDim, cSubsetName1, sElement, 1);
         VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
      ELSE;
         sMDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { ( [ ' | sDim | '  ].[ ' | pAccount | ' ] )}, ALL, RECURSIVE)}, 0)}';
         SUBSETCREATEBYMDX(cSubsetName1, sMdx, 1);
         VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
      ENDIF;
   ELSEIF(sDim @= 'Product Type');
      sElement = cProductConsol;
      SUBSETCREATE(sDim, cSubsetName1, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName1, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
   ELSEIF(sDim @= 'Source');
      sElement = cSourceConsol;
      SUBSETCREATE(sDim, cSubsetName1, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName1, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
   ELSEIF(sDim @= 'Location');
      sMDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { ( [ ' | sDim | '  ].[ ' | cLocationConsol | ' ] )}, ALL, RECURSIVE)}, 0)}';
      SUBSETCREATEBYMDX(cSubsetName1, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
   ELSEIF(sDim @= 'Department');
      sMDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { ( [ ' | sDim | '  ].[ ' | cDeptConsol | ' ] )}, ALL, RECURSIVE)}, 0)}';
      SUBSETCREATEBYMDX(cSubsetName1, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
   ELSEIF(sDim @= 'Line of Business');
      sMDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { ( [ ' | sDim | '  ].[ ' | cLOBConsol | ' ] )}, ALL, RECURSIVE)}, 0)}';
      SUBSETCREATEBYMDX(cSubsetName1, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
   ELSEIF(sDim @= 'Rate Type');
      IF(pRateType @= '');
         sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({TM1SUBSETALL([ ' | sDim | '] )}, 0)}, ASC)}';
         SUBSETCREATEBYMDX(cSubsetName1, sMdx, 1);
      ELSE;
         sMDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( { ( [ ' | sDim | '  ].[ ' | pRateType | ' ] )}, ALL, RECURSIVE)}, 0)}';
         SUBSETCREATEBYMDX(cSubsetName1, sMdx, 1);
      ENDIF;
      VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
   ELSEIF(sDim @= 'Mobility Measure');
      sElement = 'Amount';
      SUBSETCREATE(sDim, cSubsetName1, 1);
      SUBSETELEMENTINSERT(sDim, cSubsetName1, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
   ELSE;
      sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({TM1SUBSETALL([ ' | sDim | '] )}, 0)}, ASC)}';
      SUBSETCREATEBYMDX(cSubsetName1, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName1, sDim, cSubsetName1);
   ENDIF;

   nCtr = nCtr + 1;
END;

VIEWEXTRACTSKIPRULEVALUESSET(cCube, cViewName1, 1);
VIEWEXTRACTSKIPCALCSSET(cCube, cViewName1, 0);
VIEWEXTRACTSKIPZEROESSET(cCube, cViewName1, 1);

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
## Set View as DataSource             ##
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

DatasourceNameForServer = cSourceCube;
DatasourceType = 'VIEW';
DatasourceCubeView = cViewName1;


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: METADATA PROCEDURE                                                   #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: METADATA PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****



###################################################
# Allocation by Product / Mobility Features
###################################################

## Retrive Alloc Base Account 
sAllocAcc = CELLGETS(cAllocCube, vVersion, vPeriod, vLOB, 'Total Location Incl Discontinued', '0000', 'Unspecified Product Type', vAccount, 'Mapping for Alloc TI');

IF(sAllocAcc @= 'No Allocate');

   CELLINCREMENTN(vValue, cTargetCube, vVersion, vPeriod, cTargetSource, vRateType, vLOB, vDepartment, vLocation, 'Unspecified Product Type', 'Unspecified Mobility Features', vAccount, 'Amount');

ELSE;

   ####Check if any allocation override present at country level
   sCountry = ATTRS('Location', vLocation, 'Country L1');
   IF(sCountry @<> '');
      sCountryAllocAcc = CELLGETS(cAllocCube, vVersion, vPeriod, vLOB, sCountry, '0000', 'Unspecified Product Type', vAccount, 'Mapping for Alloc TI');
      IF(sCountryAllocAcc @<> '');
         sAllocAcc = sCountryAllocAcc;
      ENDIF;
   ENDIF;


   nAllocTotal = CELLGETN(cStagingCube, vVersion, vPeriod, 'FDS', vRateType, 'Total Currency', vLOB, '0000', vLocation, cProductConsol, cMobilityConsol, sAllocAcc, 'Amount');
   ## Conduct Allocations by Product / Feature 

   IF(nAllocTotal <> 0);
      Dim1Count = 1;
      Dim1Size = DIMSIZ(cDimProductType);
      WHILE(Dim1Count <= Dim1Size);
         sProductType = DIMNM(cDimProductType, Dim1Count);
         IF(ELLEV(cDimProductType, sProductType) = 0 & ELISANC(cDimProductType, cProductConsol, sProductType) = 1);
            nAllocP = CELLGETN(cStagingCube, vVersion, vPeriod, 'FDS', vRateType, 'Total Currency', vLOB, '0000', vLocation, sProductType, cMobilityConsol, sAllocAcc, 'Amount');
            IF(nAllocP <> 0);
               Dim2Count = 1;
               Dim2Size = DIMSIZ(cDimMobilityFeature);
               WHILE(Dim2Count <= Dim2Size);
                  sMobilityFeature = DIMNM(cDimMobilityFeature, Dim2Count);
                  IF(ELLEV(cDimMobilityFeature, sMobilityFeature) = 0 & ELISANC(cDimMobilityFeature, cMobilityConsol, sMobilityFeature) = 1);
                     nAllocPM = CELLGETN(cStagingCube, vVersion, vPeriod, 'FDS', vRateType, 'Total Currency', vLOB, '0000', vLocation, sProductType, sMobilityFeature, sAllocAcc, 'Amount');
                     IF(nAllocPM <> 0);
                        nAllocPerc = nAllocPM \ nAllocTotal;
                        nAllocVal = vValue * nAllocPerc;
                        CELLINCREMENTN(nAllocVal, cTargetCube, vVersion, vPeriod, cTargetSource, vRateType, vLOB, '0000', vLocation, sProductType, sMobilityFeature, vAccount, 'Amount');
                     ENDIF;
                  ENDIF;
                  Dim2Count = Dim2Count + 1;
               END;
            ENDIF;
         ENDIF;
         Dim1Count = Dim1Count + 1;
      END;
   ELSE;
      CELLINCREMENTN(vValue, cTargetCube, vVersion, vPeriod, cTargetSource, vRateType, vLOB, vDepartment, vLocation, 'Unspecified Product Type', 'Unspecified Mobility Features', vAccount, 'Amount');
   ENDIF;

ENDIF;


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: EPILOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

IF(pRateType @<> '' & pAccount @<> '');

   CELLPUTN(nDataProcedureDataOperations, cCubeDash, cSourceCube, 'Oracle', pMonth, 'Actual', pRateType, pAccount, 'Allocated Records Count');
   CELLPUTN(nDataProcedureRecordsCompleted, cCubeDash, cSourceCube, 'Oracle', pMonth, 'Actual', pRateType, pAccount, 'Records Processed');
   nElapsedTime = ROUND((NOW - cStartTime) / 0.000011574074074074);
   CELLPUTN(nElapsedTime, cCubeDash, cSourceCube, 'Oracle', pMonth, 'Actual', pRateType, pAccount, 'Elapsed Time');
ENDIF;


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: EPILOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #