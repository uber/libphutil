# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsStarted = nDataProcedureRecordsStarted + 1;
IF(nMetadataProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: END METADATA PROCEDURE');
   nMetadataProcedureEndTime = NOW();
ENDIF;
IF(nDataProcedureStartTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: START DATA PROCEDURE');
   nDataProcedureStartTime = NOW();
ENDIF;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Transformation
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

# Month and Week

IF(pLevel @= 'Month');
   sPeriod = SUBST(vPeriod, 1, 7);
ELSEIF(pLevel @= 'Day');
   sPeriod = vPeriod;
ELSE;
   sPeriod = 'WS ' | vPeriod;
ENDIF;

IF(SCAN('_usd', vMetric) = 0);
   sMetric = vMetric;
ELSE;
   nSep = SCAN('_usd', vMetric);
   sMetric = SUBST(vMetric, 1, (nSep - 1));
ENDIF;

IF(sMetric @= 'Basket');
   sMetric = '41105';
ENDIF;

IF(sMetric @= 'Booking Fees');
   sMetric = '41115';
ENDIF;

IF(sMetric @= 'Refunds');
   sMetric = '41519';
ENDIF;

# Location
sDim = 'Location';
IF(vLocation @= '\N' % vLocation @= '');
   ITEMSKIP;
ENDIF;
sLocation = 'V' | vLocation;

IF(DIMIX('Location', sLocation) = 0);
   ITEMSKIP;
ENDIF;

# Currency
IF(vCurrency @= '\N' % vCurrency @= '');
   ITEMSKIP;
ENDIF;

# Eats Product Type
sDim = 'Eats Product Type';
IF(vProductType @= '\N' % vProductType @= '' % vProductType @= 'None' % DIMIX(sDim, vProductType) = 0);
   sProductType = 'Unspecified Eats Product Type';
ELSE;
   sProductType = vProductType;
ENDIF;

# Eats Restaurant Type
sDim = 'Eats Restaurant Type';
IF(vRestType @= '\N' % vRestType @= '' % vRestType @= 'Not Classified');
   sRestType = 'Unspecified Restaurant Type';
ELSE;
   sRestType = vRestType;
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Clear Target View
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
#Scanning the Input to find  metrics to be zeroed out

# Flag if Cash Gross Bookings metrics is loaded
IF(sMetric @= 'Cash Gross Bookings');
   nGLOPS = 1;
ENDIF;

IF(SCAN(sMetric, cMetricString) = 0);
   cMetricString = cMetricString | sMetric | '|';
   SUBSETDELETEALLELEMENTS('Eats Ops Metric', cSubset);
   SUBSETELEMENTINSERT('Eats Ops Metric', cSubset, sMetric, 1);
   VIEWZEROOUT(cCube, cViewName);
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Load Data
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

IF(ELISANC('Eats Ops Metric', 'Net Inflows', sMetric) = 0 & SCAN('_usd', vMetric) = 0);

   IF(pLevel @= 'Month');
      vUSDValue = vValue * CELLGETN('Exchange Rate', cVersion, sPeriod, vCurrency, 'USD', 'Rate');
   ELSEIF(pLevel @= 'Day');
      sMonth = SUBST(sPeriod, 1, 7);
      vUSDValue = vValue * CELLGETN('Exchange Rate', cVersion, ATTRS('Period', sMonth, 'Period-1'), vCurrency, 'USD', 'Month End Rate');
   ELSE;
      sMonth = SUBST(sPeriod, 4, 7);
      vUSDValue = vValue * CELLGETN('Exchange Rate', cVersion, ATTRS('Period', sMonth, 'Period-1'), vCurrency, 'USD', 'Month End Rate');
   ENDIF;

   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   CELLINCREMENTN(vValue, cCube, cVersion, sPeriod, cSource, vCurrency, cRateType, sLocation, sProductType, sRestType, sMetric, cMeasure);

   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   CELLINCREMENTN(vUSDValue, cCube, cVersion, sPeriod, cSource, vCurrency, 'USD', sLocation, sProductType, sRestType, sMetric, cMeasure);

   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   CELLPUTS(sOutputstring, 'Eats Ops Info', sMetric, sPeriod, 'Last Updated');

ELSEIF(SCAN('_usd', vMetric) = 0);


   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   CELLINCREMENTN(vValue, cCube, cVersion, sPeriod, cSource, vCurrency, cRateType, sLocation, sProductType, sRestType, sMetric, cMeasure);

   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   CELLPUTS(sOutputstring, 'Eats Ops Info', sMetric, sPeriod, 'Last Updated');
ELSE;


   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   CELLINCREMENTN(vValue, cCube, cVersion, sPeriod, cSource, vCurrency, 'USD', sLocation, sProductType, sRestType, sMetric, cMeasure);
ENDIF;

# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsCompleted = nDataProcedureRecordsCompleted + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

