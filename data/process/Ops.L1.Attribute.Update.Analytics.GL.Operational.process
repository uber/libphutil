cRand = NUMBERTOSTRING(ROUND(RAND() * 100000));
cRand = FILL('0', 6 - LONG(cRand)) | cRand;
cRand = NUMBERTOSTRING(NOW()) | '.' | cRand;
cRandomIntA = cRand;

# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Check if the Attribute Exists in the dimension and clear out before populating i
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

DimName = 'ANALYTICS.GL Operational';
AttrName = 'GL Operational L1';

IF(DIMIX('}ElementAttributes_ANALYTICS.GL Operational', 'GL Operational L1') = 0);
   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nPrologProcedureMetadataOperations = nPrologProcedureMetadataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   ATTRINSERT(DimName, '', AttrName, 'S');
ELSE;

   # -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
   # Zero out the FDS Attribute of Mobilty , Delivery and U4B Ops metrics before update
   # -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

   sCube = '}ElementAttributes_ANALYTICS.GL Operational';

   TargetViewName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | ' Target';
   TargetSubsetName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA | ' Target';

   #### Zero out GL Operational L1 attribute of Analytics.GL Operational

   VIEWCREATE(sCube, TargetViewName, 1);

   sDim = 'ANALYTICS.GL Operational';
   sMdx = EXPAND('{TM1DRILLDOWNMEMBER( {[%sDim%].[Ops PL]}, ALL, RECURSIVE )}, 0)}');
   SUBSETCREATEBYMDX(TargetSubsetName, sMdx, 1);
   SUBSETMDXSET(sDim, TargetSubsetName, '');
   VIEWSUBSETASSIGN(sCube, TargetViewName, sDim, TargetSubsetName);

   sDim = '}ElementAttributes_ANALYTICS.GL Operational';
   SUBSETCREATE(sDim, TargetSubsetName, 1);
   SUBSETELEMENTINSERT(sDim, TargetSubsetName, 'GL Operational L1', 1);
   VIEWSUBSETASSIGN(sCube, TargetViewName, sDim, TargetSubsetName);

   VIEWZEROOUT(sCube, TargetViewName);

ENDIF;


# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#
# Populate the GL Operational L1 element
# -=-=-=-=-=-=-==-=-==-===-==-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=-=-= -=-=-=-=-=-=-=-=#

sDim = 'ANALYTICS.GL Operational';
sSub = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
SUBSETCREATEBYMDX(sSub, EXPAND('{TM1DRILLDOWNMEMBER( {[%sDim%].[Ops PL]}, ALL, RECURSIVE )}, 0)}'), sDim, 1);

nSubSiz = SUBSETGETSIZE(sDim, sSub);
i = 1;

WHILE(i <= nSubSiz);
   sEle = SUBSETGETELEMENTNAME(sDim, sSub, i);
   IF(sEle @<> 'Ops PL');
      IF((ELISANC(sDim, 'Core Support', sEle) = 1 % sEle @= 'Allocated Support Costs') & ELLEV(sDim, sEle) = 0);
         sPar = 'Support Services';
         # ================= TAPTOOLS: START GENERATED CODE =================== #
         nPrologProcedureMetadataOperations = nPrologProcedureMetadataOperations + 1;
         # ================= TAPTOOLS: END GENERATED CODE ===================== #
         ATTRPUTS(sPar, sDim, sEle, 'GL Operational L1');
      ELSE;
         sPar = ELPAR(sDim, sEle, 1);
         # ================= TAPTOOLS: START GENERATED CODE =================== #
         nPrologProcedureMetadataOperations = nPrologProcedureMetadataOperations + 1;
         # ================= TAPTOOLS: END GENERATED CODE ===================== #
         ATTRPUTS(sPar, sDim, sEle, 'GL Operational L1');
      ENDIF;
   ENDIF;
   i = i + 1;
END;


