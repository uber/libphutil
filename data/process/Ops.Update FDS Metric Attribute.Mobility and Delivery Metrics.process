# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROPERTIES                                                           #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
{
    "DataSource": {
        "Type": "TM1CubeView",
        "dataSourceNameForClient": "Operational PL Mapping",
        "dataSourceNameForServer": "Operational PL Mapping",
        "view": "Default"
    },
    "HasSecurityAccess": false,
    "Name": "Ops.Update FDS Metric Attribute.Mobility and Delivery Metrics",
    "Parameters": [],
    "UIData": "CubeAction=1511\fDataAction=1503\fCubeLogChanges=0\f",
    "Variables": [
        {
            "EndByte": 0,
            "Name": "vMsr",
            "Position": 3,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vMetric",
            "Position": 1,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vLob",
            "Position": 2,
            "StartByte": 0,
            "Type": "String"
        },
        {
            "EndByte": 0,
            "Name": "vValue",
            "Position": 4,
            "StartByte": 0,
            "Type": "String"
        }
    ],
    "VariablesUIData": [
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f",
        "VarType=32\fColType=827\f"
    ]
}
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROPERTIES                                                             #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****



#############################################
# Mobility
#############################################

cCube = '}ElementAttributes_Mobility Ops Metrics';

cRandomIntA = NUMBERTOSTRING(INT(RAND() * 100000));
cSubset = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
cViewName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;

VIEWCREATE(cCube, cViewName, 1);

nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(cCube);


WHILE(nCtr <= nMax);
   vDim = TABDIM(cCube, nCtr);
   IF(vDim @= '}ElementAttributes_Mobility Ops Metrics');
      SUBSETCREATE(vDim, cSubset);
      SUBSETELEMENTINSERT(vDim, cSubset, 'FDS', 1);
      SUBSETELEMENTINSERT(vDim, cSubset, 'FDS Metric', 1);
      VIEWSUBSETASSIGN(cCube, cViewName, vDim, cSubset);
   ELSE;
      sMDX = '{TM1SUBSETALL([ ' | vDim | '] )}';
      SUBSETCREATEBYMDX(cSubset, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, vDim, cSubset);
   ENDIF;
   nCtr = nCtr + 1;
END;

VIEWZEROOUT(cCube, cViewName);


#############################################
# Delivery
#############################################

cCube1 = '}ElementAttributes_Delivery Ops Metrics';

cRandomIntA = NUMBERTOSTRING(INT(RAND() * 100000));
cSubset1 = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
cViewName1 = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;

VIEWCREATE(cCube1, cViewName1, 1);

nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(cCube1);


WHILE(nCtr <= nMax);
   vDim = TABDIM(cCube1, nCtr);
   IF(vDim @= '}ElementAttributes_Delivery Ops Metrics');
      SUBSETCREATE(vDim, cSubset1);
      SUBSETELEMENTINSERT(vDim, cSubset1, 'FDS', 1);
      VIEWSUBSETASSIGN(cCube1, cViewName1, vDim, cSubset1);
   ELSE;
      sMDX = '{TM1SUBSETALL([ ' | vDim | '] )}';
      SUBSETCREATEBYMDX(cSubset1, sMdx, 1);
      VIEWSUBSETASSIGN(cCube1, cViewName1, vDim, cSubset1);
   ENDIF;
   nCtr = nCtr + 1;
END;

VIEWZEROOUT(cCube1, cViewName1);

#############################################
# Source View
#############################################

cCube2 = 'Operational PL Mapping';

cRandomIntA = NUMBERTOSTRING(INT(RAND() * 100000));
cSubset2 = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
cViewName2 = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;

VIEWCREATE(cCube2, cViewName2, 1);

nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(cCube2);

WHILE(nCtr <= nMax);
   vDim = TABDIM(cCube2, nCtr);
   IF(vDim @= 'Operational PL Mapping Measure');
      SUBSETCREATE(vDim, cSubset2);
      SUBSETELEMENTINSERT(vDim, cSubset2, 'Tm1 Metric', 1);
      VIEWSUBSETASSIGN(cCube2, cViewName2, vDim, cSubset2);
   ELSEIF(vDim @= 'Line of business');
      SUBSETCREATE(vDim, cSubset2);
      SUBSETELEMENTINSERT(vDim, cSubset2, 'Mobility', 1);
      SUBSETELEMENTINSERT(vDim, cSubset2, 'Delivery', 1);
      VIEWSUBSETASSIGN(cCube2, cViewName2, vDim, cSubset2);
   ELSE;
      sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({TM1SUBSETALL([ ' | vDim | '] )}, 0)}, ASC)}';
      SUBSETCREATEBYMDX(cSubset2, sMdx, 1);
      VIEWSUBSETASSIGN(cCube2, cViewName2, vDim, cSubset2);
   ENDIF;
   nCtr = nCtr + 1;
END;


DatasourceNameForServer = cCube2;
DatasourceType = 'VIEW';
DatasourceCubeView = cViewName2;





# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: METADATA PROCEDURE                                                   #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: METADATA PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


IF(vLob @= 'Mobility');

   IF(DIMIX('Mobility Ops Metrics', vValue) <> 0);
      CELLPUTS(vMetric, '}ElementAttributes_Mobility ops Metrics', vValue, 'FDS Metric');
   ENDIF;

   IF(DIMIX('Mobility Ops Metrics', vValue) <> 0 & ELLEV('Mobility Ops Metrics', vValue) = 0);
      CELLPUTS(vMetric, '}ElementAttributes_Mobility ops Metrics', vValue, 'FDS');
   ENDIF;

ELSEIF(vLob @= 'Delivery');

   IF(DIMIX('Delivery Ops Metrics', vValue) <> 0);
      CELLPUTS(vMetric, '}ElementAttributes_Delivery ops Metrics', vValue, 'FDS Metric');
   ENDIF;

   IF(DIMIX('Delivery Ops Metrics', vValue) <> 0 & ELLEV('Delivery Ops Metrics', vValue) = 0);
      CELLPUTS(vMetric, '}ElementAttributes_Delivery ops Metrics', vValue, 'FDS');
   ENDIF;

ENDIF;





# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
