# ================= TAPTOOLS: START GENERATED CODE =================== #
sProcessName = GETPROCESSNAME();
IF(sProcessName @<> 'TAP.Call.Queue.Add Job To Queue' & sProcessName @<> 'TAP.CubeSaveData' & sProcessName @<> 'TAP.Call.Save' & sProcessName @<> 'TAP.Call.Recurring' & sProcessName @<> 'DIQ.Call.Batch' & sProcessName @<> 'TAP.Call.Save.Wrapper' & sProcessName @<> 'TAP.Call.CubeSaveData.Wrapper' & sProcessName @<> 'TAP.Call.Tests' & sProcessName @<> 'TAP.Call.Init' & sProcessName @<> 'TAP.Call.Export Application Stats' & sProcessName @<> 'TAP.Cube.Export Data to File' & SCAN('}drill', LOWER(sProcessName)) = 0);
   sBlock.Execution.Status = CELLGETS('TAP System Info', 'Block Process Execution', 'Value');
   IF(UPPER(sBlock.Execution.Status) @= 'YES');
      sBlock.Epilog.Execution = 'Yes';
      PROCESSBREAK;
   ENDIF;
ENDIF;
LOGOUTPUT('DEBUG', 'PARAMETER: pMonth: "' | pMonth | '"');
LOGOUTPUT('DEBUG', 'PARAMETER: pMonthDelim: "' | pMonthDelim | '"');
LOGOUTPUT('DEBUG', 'PROGRESS: START PROLOG PROCEDURE');
nMetadataProcedureRecordsStarted = 0;
nMetadataProcedureRecordsSkipped = 0;
nMetadataProcedureRecordsRejected = 0;
nMetadataProcedureRecordsCompleted = 0;
nDataProcedureRecordsStarted = 0;
nDataProcedureRecordsSkipped = 0;
nDataProcedureRecordsRejected = 0;
nDataProcedureRecordsCompleted = 0;
nPrologProcedureDataOperations = 0;
nDataProcedureDataOperations = 0;
nTotalDataOperations = 0;
nPrologProcedureMetadataOperations = 0;
nMetadataProcedureMetadataOperations = 0;
nDataProcedureMetadataOperations = 0;
nEpilogProcedureMetadataOperations = 0;
nTotalProcedureMetadataOperations = 0;
nPrologProcedureStartTime = NOW();
nPrologProcedureEndTime = 0;
nMetadataProcedureStartTime = 0;
nMetadataProcedureEndTime = 0;
nDataProcedureStartTime = 0;
nDataProcedureEndTime = 0;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****

######################################################################################################
# Process to copy MAPC forecast data from Analytics.GL Operational to Ops cube
######################################################################################################

pMonth = TRIM(pMonth);
IF(pMonth @= '');
   LOGOUTPUT('ERROR', 'Month can not be blank');
   PROCESSERROR;
ENDIF;

nTimeNow = NOW;
sTimeStart = TIMST(nTimeNow, '\Y\m\d\h\i\s');

TRUE = 1;
FALSE = 0;
nAutoCleanup = TRUE;
nTotalRecords = 0;

sSrcCube = 'Analytics.GL Operational';
sTgtCube = 'Ops';

### Set Dimension Variables
sDimSrcVersion = 'Analytics.Version';
sDimSrcMonth = 'Analytics.Month';
sDimSrcSource = 'Analytics.Source';
sDimSrcRateType = 'Analytics.Rate Type';
sDimSrcLob = 'Analytics.Line of Business';
sDimSrcDept = 'Analytics.Department';
sDimSrcLoc = 'Analytics.Location';
sDimSrcProductType = 'Analytics.Product Type';
sDimSrcAccount = 'Analytics.Account';
sDimSrcGLOperational = 'Analytics.GL Operational';
sDimSrcMeas = 'Analytics.GL Operational Measure';

sDimTgtVersion = 'Version';
sDimTgtPeriod = 'Period';
sDimTgtSource = 'Source';
sDimTgtOpsMetric = 'Ops Metric';

sSrcView = 'zTempTI' | GETPROCESSNAME | sTimeStart | NUMBERTOSTRING(RAND());
sSrcSub = sSrcView;

sTgtView = sSrcView | '_Target';
sTgtSub = sTgtView;

#==============================================================================
# SOURCE VIEW
#==============================================================================

IF(VIEWEXISTS(sSrcCube, sSrcView) = TRUE);
   VIEWDESTROY(sSrcCube, sSrcView);
ENDIF;
VIEWCREATE(sSrcCube, sSrcView, nAutoCleanup);

nDim = 1;
sDim = TABDIM(sSrcCube, nDim);

WHILE(sDim @<> '');

   IF(SUBSETEXISTS(sDim, sSrcSub) = TRUE);
      SUBSETDESTROY(sDim, sSrcSub);
   ELSE;
      SUBSETCREATE(sDim, sSrcSub, nAutoCleanup);
   ENDIF;
   VIEWSUBSETASSIGN(sSrcCube, sSrcView, sDim, sSrcSub);

   IF(sDim @= sDimSrcVersion);
      sMDX = '{[' | sDim | '].[Forecast Excl Actuals]}';

   ELSEIF(sDim @= sDimSrcMonth);
      sMDX = '';
      IF(SCAN(pMonthDelim, pMonth) > 0);
         sMonths = pMonth;
         sDelimIndex = SCAN(pMonthDelim, sMonths);
         WHILE(sDelimIndex > 0);
            sMonth = SUBST(sMonths, 1, sDelimIndex - 1);
            IF(DIMIX(sDim, sMonth) > 0);
               sMDX = sMDX | 'TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | sDim | '].[' | sMonth | ']}, ALL, RECURSIVE )}, 0),';
            ENDIF;
            sMonths = SUBST(sMonths, sDelimIndex + 1, LONG(sMonths));
            sDelimIndex = SCAN(pMonthDelim, sMonths);
         END;
         IF(TRIM(sMonths) @<> '');
            sMonth = sMonths;
            IF(DIMIX(sDim, sMonth) > 0);
               sMDX = sMDX | 'TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | sDim | '].[' | sMonth | ']}, ALL, RECURSIVE )}, 0),';
            ENDIF;
         ENDIF;

         sMDX = '{' | SUBST(sMDX, 1, LONG(sMDX) - 1) | '}';
      ELSE;
         sMDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | sDim | '].[' | pMonth | ']}, ALL, RECURSIVE )}, 0)}';
      ENDIF;

   ELSEIF(sDim @= sDimSrcSource);
      sMDX = '{[' | sDim | '].[Planning]}';

   ELSEIF(sDim @= sDimSrcRateType);
      sMDX = '{[' | sDim | '].[USD]}';

   ELSEIF(sDim @= sDimSrcLob);
      sMDX = '{[' | sDim | '].[1001], [' | sDim | '].[2001]}';

   ELSEIF(sDim @= sDimSrcDept);
      sMDX = '{TM1FILTERBYLEVEL( TM1DRILLDOWNMEMBER( {[' | sDim | '].[Total Department]}, ALL, RECURSIVE ), 0 )}';

   ELSEIF(sDim @= sDimSrcLoc);
      sMDX = '{TM1FILTERBYLEVEL( TM1DRILLDOWNMEMBER( {[' | sDim | '].[Total Location Incl Discontinued]}, ALL, RECURSIVE ), 0 )}';

   ELSEIF(sDim @= sDimSrcProductType);
      sMDX = '{[' | sDim | '].[Unspecified Product Type]}';

   ELSEIF(sDim @= sDimSrcAccount);
      IF(ELISCOMP(sDim, 'Active_Restaurants', 'MAPC Metrics') = 1);
         sMDX = '{Except({TM1FILTERBYLEVEL( TM1DRILLDOWNMEMBER( {[' | sDim | '].[MAPC Metrics]}, ALL, RECURSIVE ), 0 )}, {[' | sDim | '].[Active_Restaurants]})}';
      ELSEIF(ELISCOMP(sDim, 'Active Restaurants', 'MAPC Metrics') = 1);
         sMDX = '{Except({TM1FILTERBYLEVEL( TM1DRILLDOWNMEMBER( {[' | sDim | '].[MAPC Metrics]}, ALL, RECURSIVE ), 0 )}, {[' | sDim | '].[Active Restaurants]})}';
      ELSE;
         sMDX = '{TM1FILTERBYLEVEL( TM1DRILLDOWNMEMBER( {[' | sDim | '].[MAPC Metrics]}, ALL, RECURSIVE ), 0 )}';
      ENDIF;

   ELSEIF(sDim @= sDimSrcGLOperational);
      sMDX = '{TM1FILTERBYLEVEL( TM1DRILLDOWNMEMBER( {[' | sDim | '].[Ops PL]}, ALL, RECURSIVE ), 0 )}';

   ELSEIF(sDim @= sDimSrcMeas);
      sMDX = '{[' | sDim | '].[Amount]}';

   ELSE;
      sMDX = '{TM1FILTERBYLEVEL({TM1SUBSETALL([' | sDim | '])}, 0)}';

   ENDIF;

   IF(sMDX @<> '');
      SUBSETMDXSET(sDim, sSrcSub, sMDX);
      SUBSETMDXSET(sDim, sSrcSub, '');
   ENDIF;

   nDim = nDim + 1;
   sDim = TABDIM(sSrcCube, nDim);

END;

VIEWEXTRACTSKIPZEROESSET(sSrcCube, sSrcView, TRUE);
VIEWEXTRACTSKIPRULEVALUESSET(sSrcCube, sSrcView, FALSE);
VIEWEXTRACTSKIPCALCSSET(sSrcCube, sSrcView, FALSE);

DatasourceType = 'View';
DatasourceNameForServer = sSrcCube;
DatasourceCubeView = sSrcView;


#==============================================================================
# Target VIEW - Zero out forecast data against 'Planning' Source
#==============================================================================

IF(VIEWEXISTS(sTgtCube, sTgtView) = TRUE);
   VIEWDESTROY(sTgtCube, sTgtView);
ENDIF;
VIEWCREATE(sTgtCube, sTgtView, nAutoCleanup);

nDim = 1;
sDim = TABDIM(sTgtCube, nDim);

WHILE(sDim @<> '');

   IF(SUBSETEXISTS(sDim, sTgtSub) = TRUE);
      SUBSETDESTROY(sDim, sTgtSub);
   ELSE;
      SUBSETCREATE(sDim, sTgtSub, nAutoCleanup);
   ENDIF;
   VIEWSUBSETASSIGN(sTgtCube, sTgtView, sDim, sTgtSub);

   IF(sDim @= sDimTgtVersion);
      sMDX = '{[' | sDim | '].[Forecast Excl Actuals]}';

   ELSEIF(sDim @= sDimTgtPeriod);
      sMDX = '';
      IF(SCAN(pMonthDelim, pMonth) > 0);
         sMonths = pMonth;
         sDelimIndex = SCAN(pMonthDelim, sMonths);
         WHILE(sDelimIndex > 0);
            sMonth = SUBST(sMonths, 1, sDelimIndex - 1);
            IF(DIMIX(sDim, sMonth) > 0);
               sMDX = sMDX | 'TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | sDim | '].[' | sMonth | ']}, ALL, RECURSIVE )}, 0),';
            ENDIF;
            sMonths = SUBST(sMonths, sDelimIndex + 1, LONG(sMonths));
            sDelimIndex = SCAN(pMonthDelim, sMonths);
         END;
         IF(TRIM(sMonths) @<> '');
            sMonth = sMonths;
            IF(DIMIX(sDim, sMonth) > 0);
               sMDX = sMDX | 'TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | sDim | '].[' | sMonth | ']}, ALL, RECURSIVE )}, 0),';
            ENDIF;
         ENDIF;

         sMDX = '{' | SUBST(sMDX, 1, LONG(sMDX) - 1) | '}';
      ELSE;
         sMDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | sDim | '].[' | pMonth | ']}, ALL, RECURSIVE )}, 0)}';
      ENDIF;

   ELSEIF(sDim @= sDimTgtSource);
      sMDX = '{[' | sDim | '].[Planning]}';

   ELSEIF(sDim @= sDimTgtOpsMetric);
      sMDX = '{TM1FILTERBYLEVEL( TM1DRILLDOWNMEMBER( {[' | sDim | '].[MAPC Metrics]}, ALL, RECURSIVE ), 0 )}';

   ELSE;
      sMDX = '{TM1FILTERBYLEVEL({TM1SUBSETALL([' | sDim | '])}, 0)}';

   ENDIF;

   IF(sMDX @<> '');
      SUBSETMDXSET(sDim, sTgtSub, sMDX);
      SUBSETMDXSET(sDim, sTgtSub, '');
   ENDIF;

   nDim = nDim + 1;
   sDim = TABDIM(sTgtCube, nDim);

END;

VIEWEXTRACTSKIPZEROESSET(sTgtCube, sTgtView, TRUE);
VIEWEXTRACTSKIPRULEVALUESSET(sTgtCube, sTgtView, TRUE);
VIEWEXTRACTSKIPCALCSSET(sTgtCube, sTgtView, TRUE);

VIEWZEROOUT(sTgtCube, sTgtView);


# ================= TAPTOOLS: START GENERATED CODE =================== #
nPrologProcedureEndTime = NOW();
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "' | DatasourceType | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceNameForServer: "' | DatasourceNameForServer | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceCubeView: "' | DatasourceCubeView | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceDimensionSubset: "' | DatasourceDimensionSubset | '"');
LOGOUTPUT('DEBUG', 'PROGRESS: END PROLOG PROCEDURE');
# ================= TAPTOOLS: END GENERATED CODE ===================== #

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
