# ================= TAPTOOLS: START GENERATED CODE =================== #
IF(sBlock.Epilog.Execution @= 'Yes');
   LOGOUTPUT('ERROR', 'Block Process Execution Flag is Yes in TAP System Info Cube. Skipping this process...');
   PROCESSERROR;
ENDIF;
IF(nPrologProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "NULL"');
   LOGOUTPUT('DEBUG', 'PROGRESS: END PROLOG PROCEDURE');
   nPrologProcedureEndTime = NOW();
ENDIF;
IF(nMetadataProcedureStartTime > 0 & nMetadataProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: END METADATA PROCEDURE');
   nMetadataProcedureEndTime = NOW();
ENDIF;
IF(nDataProcedureStartTime > 0 & nDataProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: END DATA PROCEDURE');
   nDataProcedureEndTime = NOW();
ENDIF;
LOGOUTPUT('DEBUG', 'PROGRESS: START EPILOG PROCEDURE');
nEpilogProcedureStartTime = NOW();
# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****

IF(LONG(sException) > 0);
   LOGOUTPUT('INFO', 'New elements data coming from FDS. Please check with Product team and add them to TM1');
   LOGOUTPUT('INFO', 'New Elements : ' | sException);
ENDIF;


IF(np2pmiles = 1);

   sProcess = 'Ops.Delivery.From Day Month';
   EXECUTEPROCESS(sProcess
      , 'pStartDate', pStartDate
      , 'pEndDate', pEndDate
      , 'pMetrics', cMetricString
   );
ENDIF;


IF(nTrips = 1);

   sProcess = 'Ops.Delivery.From Day Month';

   EXECUTEPROCESS(sProcess
      , 'pStartDate', pStartDate
      , 'pEndDate', pEndDate
      , 'pMetrics', cMetricString
   );

   #Month Data Sync to Ops
   sProcess = 'Ops.Load.Completed.Trips.From.Delivery';
   EXECUTEPROCESS(sProcess
      , 'pVersion', 'Actual'
      , 'pStartDate', pStartDate
      , 'pEndDate', pEndDate
   );

   #Day/Week Data Sync to Ops
   sProcess = 'Ops.Load.Completed.Trips.Day.Week.From.Delivery';
   RUNPROCESS(sProcess
      , 'pVersion', 'Actual'
      , 'pStartDate', pStartDate
      , 'pEndDate', pEndDate
   );

   # Copying completed trips data on 2nd day of the month from FDS metric to Reported metric in Ops cube
   nDay = NUMBR(SUBST(TODAY(1), 9, 2));
   cMonth = ATTRS('Period', SUBST(TODAY(1), 1, 7), 'Prior Period');
   IF(nDay = 1 % nDay = 2);
      EXECUTEPROCESS('Bedrock.Cube.Data.Copy.IntraCube'
         , 'pCube', 'Ops'
         , 'pFilter', 'Version:Actual & Period:' | cMonth | ' & Source:FDS & Line of Business:Delivery & Ops Metric: Completed Trips'
         , 'pElementMapping', 'Source: FDS->Reported'
      );
   ENDIF;

ENDIF;

##Record Count update
CELLINCREMENTN(cRecordCount, cCubeDash, cRCube, 'FDS', cLoaddate, 'Actual', 'No Rate Type', rMetric);
# ================= TAPTOOLS: START GENERATED CODE =================== #
LOGOUTPUT('DEBUG', 'PROCESS_METRIC: PrologProcedureRuntime: "' | NUMBERTOSTRING(ROUNDP((nPrologProcedureEndTime - nPrologProcedureStartTime) * 86400, 2)) | '"');
