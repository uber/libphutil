### Populate the FDS attribute in Mobility, Delivery and U4b Ops Metrics


IF(vLOB @= 'Mobility' & vValue @<> '');

   IF(DIMIX('Mobility Ops Metrics', vValue) > 0);
      # ================= TAPTOOLS: START GENERATED CODE =================== #
      nDataProcedureMetadataOperations = nDataProcedureMetadataOperations + 1;
      # ================= TAPTOOLS: END GENERATED CODE ===================== #
      ATTRPUTS(vFDSMetric, 'Mobility Ops Metrics', vValue, 'FDS');
   ENDIF;

   IF(DIMIX('U4B Ops Metrics', vValue) > 0);
      # ================= TAPTOOLS: START GENERATED CODE =================== #
      nDataProcedureMetadataOperations = nDataProcedureMetadataOperations + 1;
      # ================= TAPTOOLS: END GENERATED CODE ===================== #
      ATTRPUTS(vFDSMetric, 'U4B Ops Metrics', vValue, 'FDS');
   ENDIF;

ENDIF;

IF(vLOB @= 'Delivery' & vValue @<> '');

   IF(DIMIX('Delivery Ops Metrics', vValue) > 0);
      # ================= TAPTOOLS: START GENERATED CODE =================== #
      nDataProcedureMetadataOperations = nDataProcedureMetadataOperations + 1;
      # ================= TAPTOOLS: END GENERATED CODE ===================== #
      ATTRPUTS(vFDSMetric, 'Delivery Ops Metrics', vValue, 'FDS');
   ENDIF;

   IF(DIMIX('U4B Ops Metrics', vValue) > 0);
      # ================= TAPTOOLS: START GENERATED CODE =================== #
      nDataProcedureMetadataOperations = nDataProcedureMetadataOperations + 1;
      # ================= TAPTOOLS: END GENERATED CODE ===================== #
      ATTRPUTS(vFDSMetric, 'U4B Ops Metrics', vValue, 'FDS');
   ENDIF;

ENDIF;
