# ================= TAPTOOLS: END GENERATED CODE ===================== #
#****Begin: Generated Statements***
#****End: Generated Statements****

cRand = NUMBERTOSTRING(ROUND(RAND() * 100000));
cRand = FILL('0', 6 - LONG(cRand)) | cRand;
cRand = NUMBERTOSTRING(NOW()) | '.' | cRand;

TarAttrcub = '}ElementAttributes_' | pTargetDim;
SouAttrcube = '}ElementAttributes_' | pSourceDim;
DimSizSouAttrcube = DIMSIZ(SouAttrcube);

###Create Target Subset to Unwind Hierarchy
cRandomIntA = cRand | pTargetDim;
IF(DIMIX(pTargetDim, pHierarchy) > 0);
   TargetMDX = '{TM1DRILLDOWNMEMBER( {TM1FILTERBYPATTERN( {TM1SUBSETALL( [' | pTargetDim | '] )}, "' | pHierarchy | '")}, ALL, RECURSIVE )}';
   TargetSub = 'zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
   SUBSETDESTROY(pTargetDim, TargetSub);
   SUBSETCREATEBYMDX(TargetSub, TargetMDX, 0);
   SUBSETMDXSET(pTargetDim, TargetSub, '');

   ##Logic to remove Existing Consolidation in Target Dim
   i = 1;
   TarSubZiz = SUBSETGETSIZE(pTargetdim, TargetSub);
   WHILE(i <= TarSubZiz);
      Ele = SUBSETGETELEMENTNAME(pTargetdim, TargetSub, i);
      IF(ELCOMPN(pTargetdim, Ele) > 0);
         parent = Ele;
         CompN = ELCOMPN(pTargetdim, parent);
         k = 1;
         WHILE(k <= CompN);
            Child = ELEMENTCOMPONENT(pTargetdim, '', Parent, 1);
            IF(ELEMENTISANCESTOR(pTargetdim, '', parent, Child) > 0);
               # ================= TAPTOOLS: START GENERATED CODE =================== #
               nPrologProcedureMetadataOperations = nPrologProcedureMetadataOperations + 1;
               # ================= TAPTOOLS: END GENERATED CODE ===================== #
               DIMENSIONELEMENTCOMPONENTDELETE(pTargetDim, Parent, Child);
            ENDIF;
            k = K + 1;
         END;
         IF(ELCOMPN(pTargetdim, Child) > 0);
            Parent = Child;
         ENDIF;
      ELSE;
         IF(ELEMENTISANCESTOR(pTargetdim, '', parent, Child) > 0);
            # ================= TAPTOOLS: START GENERATED CODE =================== #
            nPrologProcedureMetadataOperations = nPrologProcedureMetadataOperations + 1;
            # ================= TAPTOOLS: END GENERATED CODE ===================== #
            DIMENSIONELEMENTCOMPONENTDELETE(pTargetDim, Parent, Child);
         ENDIF;
      ENDIF;
      i = i + 1;
   END;
ENDIF;

###Create Source Subset
cRandomIntA = cRand | pSourceDim;
SourceMDX = '{TM1DRILLDOWNMEMBER( {TM1FILTERBYPATTERN( {TM1SUBSETALL( [' | pSourceDim | '] )}, "' | pHierarchy | '")}, ALL, RECURSIVE )}';
SourceSub = 'zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
SUBSETDESTROY(pSourceDim, SourceSub);
SUBSETCREATEBYMDX(SourceSub, SourceMDX, 0);
SUBSETMDXSET(pSourceDim, SourceSub, '');


### Assign Data Source ###
DatasourceNameForServer = pSourceDim;
DatasourceNameForClient = pSourceDim;
DatasourceType = 'SUBSET';
DatasourceDimensionSubset = SourceSub;

# ================= TAPTOOLS: START GENERATED CODE =================== #
nPrologProcedureEndTime = NOW();
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "' | DatasourceType | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceNameForServer: "' | DatasourceNameForServer | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceCubeView: "' | DatasourceCubeView | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceDimensionSubset: "' | DatasourceDimensionSubset | '"');
LOGOUTPUT('DEBUG', 'PROGRESS: END PROLOG PROCEDURE');
