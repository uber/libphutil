   nMetadataProcedureEndTime = NOW();
ENDIF;
IF(nDataProcedureStartTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: START DATA PROCEDURE');
   nDataProcedureStartTime = NOW();
ENDIF;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****


# Month

IF(pLevel @= 'Month');
   sPeriod = SUBST(vPeriod, 1, 7);
ELSEIF(pLevel @= 'Day');
   sPeriod = vPeriod;
ELSE;
   sPeriod = 'WS ' | vPeriod;
ENDIF;

IF(SUBSETELEMENTEXISTS('Period', cSubset, sPeriod) = 0);
   ITEMSKIP;
ENDIF;

vFeature = '';

IF(SCAN('_usd', vMetric) = 0);
   sMetric_fds = vMetric;
ELSE;
   nSep = SCAN('_usd', vMetric);
   sMetric_fds = SUBST(vMetric, 1, (nSep - 1));
ENDIF;

# Lookup for TM1 Metric. TM1 <> FDS Mapping

sMetric = CELLGETS(cCubeMap, sMetric_fds, 'Mobility', 'TM1 Metric');

# Location
sDim = 'Location';
IF(vLocation @= '\N' % vLocation @= '');
   ITEMSKIP;
ENDIF;
sLocation = 'V' | vLocation;

IF(DIMIX('Location', sLocation) = 0);
   ITEMSKIP;
ENDIF;

# LOB
IF(vLob @= '\N' % vLob @= '' % DIMIX('Line of Business', vLob) = 0);
   ITEMSKIP;
ENDIF;

# Currency
IF(vCurrency @= '\N' % vCurrency @= '');
   ITEMSKIP;
ENDIF;

# Features
IF(vAir @= '\N' % vAir @= '' % vMem @= '\N' % vMem @= '' % vRes @= '\N' % vRes @= '' % vU4B @= '\N' % vU4B @= '' % vU4BH @= '\N' % vu4BH @= '' % vZir @= '\N' % vZir @= '');
   vFeature = 'Unspecified Mobility Features';
ENDIF;


# Product
IF(vProduct @= '\N' % vProduct @= '');
   vProduct = 'Unspecified product type';
ENDIF;


# Features

IF(vAir @= '1' % vAir @= 'True');
   sAir = 'T';
ELSE;
   sAir = 'F';
ENDIF;

IF(vMem @= '1' % vMem @= 'True');
   sMem = 'T';
ELSE;
   sMem = 'F';
ENDIF;

IF(vRes @= '1' % vRes @= 'True');
   sRes = 'T';
ELSE;
   sRes = 'F';
ENDIF;

IF(vZir @= '1' % vZir @= 'True');
   sZir = 'T';
ELSE;
   sZir = 'F';
ENDIF;

IF(vU4B @= '1' % vU4B @= 'True');
   sU4B = 'T';
ELSE;
   sU4B = 'F';
ENDIF;

IF(vU4BH @= '1' % vU4BH @= 'True');
   sU4BH = 'T';
ELSE;
   sU4BH = 'F';
ENDIF;


IF(vFeature @<> 'Unspecified Mobility Features');
   vFeature = 'Air(' | sAir | ') Mem(' | sMem | ') Res(' | sRes | ') U4B(' | sU4B | ') U4BH(' | sU4BH | ') Zir(' | sZir | ')';
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Clear Target View
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
#Scanning the Input to find metrics  to be zeroed out

vDim = 'Mobility Ops Metrics';
IF((DIMIX(vDim, sMetric) = 0) % (DTYPE(vDim, sMetric) @= 'C') % DTYPE(vDim, sMetric | '_fds') @= 'C');
   ITEMSKIP;
ENDIF;



#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Load Data
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
IF(vProduct @= 'Others');
   vProduct = 'Other';
ENDIF;

IF(SCAN('_usd', vMetric) = 0);
   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   CELLINCREMENTN(vValue, cCube, 'Actual', sPeriod, 'FDS', 'No Rate Type', vCurrency, vLob, '0000', sLocation, vProduct, vFeature, sMetric, 'Amount');
  cRecordCount = cRecordCount + 1;
ELSE;
   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   CELLINCREMENTN(vValue, cCube, 'Actual', sPeriod, 'FDS', 'USD', vCurrency, vLob, '0000', sLocation, vProduct, vFeature, sMetric, 'Amount');
   cRecordCount = cRecordCount + 1;
ENDIF;







# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsCompleted = nDataProcedureRecordsCompleted + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

