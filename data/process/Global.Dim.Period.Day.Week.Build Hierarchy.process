# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: EPILOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# ==================================================================== #
# WD and Year mapping
# ==================================================================== #

sDim = cDim;
sHier = EXPAND('%sDim%');

sSub = cSub | '.Year_Week_Input';
sMDX = EXPAND('{TM1SORT( {TM1FILTERBYPATTERN( { [%sDim%].[%sDim%].Members }, "WD ????-??-??")}, ASC)}');

SUBSETCREATE(sHier, sSub, 1);
SUBSETMDXSET(sHier, sSub, sMDX);
SUBSETMDXSET(sHier, sSub, '');

i = 1;
WHILE(i <= SUBSETGETSIZE(sHier, sSub));
   sEleLeaf = SUBSETGETELEMENTNAME(sHier, sSub, i);
   sWDyear='WD ' | SUBST(sEleLeaf,4,4);
   DIMENSIONELEMENTINSERTDIRECT(cDim, '', sWDYear, 'C');
   DIMENSIONELEMENTCOMPONENTADDDIRECT(cDim, sWDYear, sEleLeaf, 1);
   DIMENSIONELEMENTCOMPONENTADDDIRECT(cDim, cTopEle, sWDYear, 1);


   i=i+1;
END;

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: EPILOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #