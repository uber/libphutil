nMetadataProcedureEndTime = 0;
nDataProcedureStartTime = 0;
nDataProcedureEndTime = 0;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****


# Constants

cCube = 'Delivery';
nRecords = 1;
sException = '';
nTrips = 0;
nMiles = 0;
np2pmiles = 0;

###Record count dashboard
cRecordCount = 0;
cLoaddate = TODAY(1);
cCubeDash = 'Dashboard';
cRCube = 'Delivery';
mDash = 'Dashboard Measure';
rMetric = 'Operational';
##

cMetricString = '';

cUser = CELLGETS('System Info', 'SQL User Name GL Transactions', 'String');
cPassword = CELLGETS('System Info', 'SQL Password GL Transactions', 'String');
cMonthEndPeriod = CELLGETS('Admin Play Book', 'Oracle Sync', 'Current Actual Month');
cMonthEndStatus = CELLGETS('Admin Play Book', 'Oracle Sync', 'Status');

IF(cMonthEndStatus @= 'Close');
   pStartDate = SUBST(pEndDate, 1, 7) | '-01';
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Set Query
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

DatasourceUsername = cUser;
DatasourcePassword = cPassword;
sQuery = EXPAND('SELECT * FROM "%pTable%"');
DatasourceQuery = sQuery;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Subsets for View Zero Out
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cRandomIntA = NUMBERTOSTRING(INT(RAND()));
cSubset = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
cViewName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
VIEWCREATE(cCube, cViewName, 1);


nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(cCube);

WHILE(nCtr <= nMax);
   sDim = TABDIM(cCube, nCtr);

   IF(sDim @= 'Version');
      sElement = 'Actual';
      SUBSETCREATE(sDim, cSubset, 1);
      SUBSETELEMENTINSERT(sDim, cSubset, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Period');
      SUBSETCREATE(sDim, cSubset, 1);
      IF(pStartDate @<> '' & pEndDate @<> '' & pLevel @= 'Day');
         nStartday = DAYNO(SUBST(pStartDate, 1, 10));
         nEndday = DAYNO(SUBST(pEndDate, 1, 10));
         WHILE(nStartday <= nEndDay);
            sDay = DATE(nStartday, 1);
            SUBSETELEMENTINSERT(sDim, cSubset, sDay, 1);
            nStartday = nStartday + 1;
         END;
      ENDIF;
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Source');
      sElement = 'FDS';
      SUBSETCREATE(sDim, cSubset, 1);
      SUBSETELEMENTINSERT(sDim, cSubset, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Delivery Ops Metric');
      SUBSETCREATE(sDim, cSubset, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Delivery Staging Measure');
      sElement = 'Amount';
      SUBSETCREATE(sDim, cSubset, 1);
      SUBSETELEMENTINSERT(sDim, cSubset, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Rate Type');
      sMDX = '{TM1FILTERBYLEVEL( {TM1SUBSETALL( [Rate Type] )}, 0)}';
      SUBSETCREATEBYMDX(cSubset, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSE;
      sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({TM1SUBSETALL([ ' | sDim | '] )}, 0)}, ASC)}';
      SUBSETCREATEBYMDX(cSubset, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ENDIF;

   nCtr = nCtr + 1;
END;

# ================= TAPTOOLS: START GENERATED CODE =================== #
nPrologProcedureEndTime = NOW();
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "' | DatasourceType | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceNameForServer: "' | DatasourceNameForServer | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceCubeView: "' | DatasourceCubeView | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceDimensionSubset: "' | DatasourceDimensionSubset | '"');
LOGOUTPUT('DEBUG', 'PROGRESS: END PROLOG PROCEDURE');
