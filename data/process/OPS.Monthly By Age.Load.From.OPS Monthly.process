# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

################################################################################
##~~                        UBER MARVEL TM1                                ~~##
################################################################################

# Cube.OPS.Load.Monthly - Process to load Unique Drivers/Riders at monthly Total Loc level from FDS to OPS Monthly cube

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
## Populate Process Audit
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

NumericGlobalVariable ( 'DataMinorErrorCount' );
NumericGlobalVariable ( 'MetadataMinorErrorCount' );
NumericGlobalVariable ( 'PrologMinorErrorCount' );

ExecuteProcess('System.Process.Log',
    'pPosition', 'Prolog'
  , 'pProcess', getProcessName
  , 'pParam', 'pVersion'
  , 'pParamVal',  pVersion
  , 'pDelim', '++'
  , 'pDebug', pDebug);

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Define Constants
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cSourceCube = 'OPS Monthly';
cTargetCube = 'OPS Monthly by Age';
cDim = 'Location';
nRecords = 1;

cRandomIntA = NumberToString( INT( RAND( ) * 100000 ));
cViewName = '}zTemp.'|getProcessName()|'.'|cRandomIntA;
cSubsetName = '}zTemp.'|getProcessName()|'.'|cRandomIntA;

cVersion = pVersion;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Clear Target View
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

sTargetFilter = 'Version:' | cVersion;

ExecuteProcess ( 'Bedrock.Cube.Data.Clear'
  , 'pCube', cTargetCube
  , 'pView', ''
  , 'pFilter', sTargetFilter
  , 'pDimensionDelim', '&'
  , 'pElementStartDelim', ':'
  , 'pElementDelim', '+'
  , 'pDestroyTempObj', 1
  , 'pDebug', pDebug
);

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Create Source View
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

ExecuteProcess('Bedrock.Cube.ViewAndSubsets.Create'
  , 'pCube', cSourceCube
  , 'pSuppressZero', 1
  , 'pSuppressConsol', 0
  , 'pSuppressRules', 1
  , 'pDimensions', 'EVERY'
  , 'pDelimiter', '&'
  , 'pView', cViewName
  , 'pSubset', cSubsetName
  , 'pDebug', pDebug
);

sDim = 'Version' ;
sElement = cVersion ;
SubsetElementInsert ( sDim, cSubsetName , sElement , 1 ) ;

sDim = 'Month';
ExecuteProcess ( 'Bedrock.Dim.Sub.Create.Leaf'
  , 'pDimension', sDim
  , 'pSubset', cSubsetName
);

sDim = 'Rate Type';
ExecuteProcess ( 'Bedrock.Dim.Sub.Create.Leaf'
  , 'pDimension', sDim
  , 'pSubset', cSubsetName
);

sDim = 'OPS Source' ;
sElement = 'FDP' ;
SubsetElementInsert ( sDim, cSubsetName , sElement , 1 ) ;

sDim = 'Location';
ExecuteProcess ( 'Bedrock.Dim.Sub.Create.Leaf'
  , 'pDimension', sDim
  , 'pSubset', cSubsetName
);

sDim = 'Line of Business';
ExecuteProcess ( 'Bedrock.Dim.Sub.Create.Leaf'
  , 'pDimension', sDim
  , 'pSubset', cSubsetName
);

sDim = 'Flow Type';
ExecuteProcess ( 'Bedrock.Dim.Sub.Create.Leaf'
  , 'pDimension', sDim
  , 'pSubset', cSubsetName
);

sDim = 'Car Type';
ExecuteProcess ( 'Bedrock.Dim.Sub.Create.Leaf'
  , 'pDimension', sDim
  , 'pSubset', cSubsetName
);

sDim = 'OPS Metric';

#sElement = cMetric ;
#SubsetElementInsert ( sDim, cSubsetName , sElement , 1 ) ;

ExecuteProcess ( 'Bedrock.Dim.Sub.Create.Leaf'
  , 'pDimension', sDim
  , 'pSubset', cSubsetName
);

sDim = 'OPS Monthly Measure';
ExecuteProcess ( 'Bedrock.Dim.Sub.Create.Leaf'
  , 'pDimension', sDim
  , 'pSubset', cSubsetName
);

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Set Datasource
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

DISABLEMTQVIEWCONSTRUCT();

DatasourceNameForServer = cSourceCube;
DataSourceType = 'VIEW';
DatasourceCubeview=cViewName;




# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: METADATA PROCEDURE                                                   #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****






# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: METADATA PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Get Launch Month
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

sLaunchMonth = ATTRS ( cDim, vLocation, 'Launch Month' );
IF ( sLaunchMonth @<> '' );

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Transformation
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

  nLocYear = StringToNumber ( SUBST ( sLaunchMonth, 5, 4 ) );
  nLocPeriod = ATTRN ( 'Period', SUBST ( sLaunchMonth, 1, 3 ), 'MonthN' );
  nLocMonth = nLocYear * 12 + nLocPeriod;
  nDataYear = StringToNumber ( ATTRS('Month',vMonth,'Year') );
  nDataPeriod = StringToNumber(subst(vMonth,6,2));
  nDataMonth = nDataYear * 12 + nDataPeriod;

  IF ( nLocMonth <= nDataMonth );
    sAge = NumberToString ( nDataMonth - nLocMonth + 1 );

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Load Data
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

    CellPutN ( Value, cTargetCube, vVersion, vRateType, vLocation, FILL ( '0', 3 - LONG ( sAge ) ) | sAge, vLOB, vFlowType, vVehicleType, vMetric, vMeasure );

  EndIf;

EndIf;

nRecords = nrecords+1;




# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: EPILOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

ExecuteProcess ( 'Bedrock.Cube.ViewAndSubsets.Delete'
  , 'pCube', cSourceCube
  , 'pView', cViewName
  , 'pSubset', cSubsetName
  , 'pMode', 1
  , 'pDebug', pDebug
);

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
## Process Log
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

sErrors = NumberToString(DataMinorErrorCount + MetadataMinorErrorCount + PrologMinorErrorCount);

ExecuteProcess('System.Process.Log',
    'pPosition', 'Epilog'
  , 'pProcess', getProcessName
  , 'pProcessSuccess', sErrors
  , 'pRecords', NumberToString(nRecords)
  , 'pDebug', 0);


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: EPILOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #