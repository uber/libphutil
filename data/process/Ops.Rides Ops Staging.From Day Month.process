# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROPERTIES                                                           #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
{
    "DataSource": {
        "Type": "TM1CubeView",
        "dataSourceNameForClient": "Rides Ops Staging",
        "dataSourceNameForServer": "Rides Ops Staging",
        "view": "Default"
    },
    "HasSecurityAccess": false,
    "Name": "Ops.Rides Ops Staging.From Day Month",
    "Parameters": [
        {
            "Name": "pMetrics",
            "Prompt": "",
