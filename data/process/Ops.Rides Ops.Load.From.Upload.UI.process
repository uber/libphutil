            "Value": "pipe.ops_tm1_monthly_financials.20200219215020.EIX8JN"
        },
        {
            "Name": "pLevel",
            "Prompt": "",
            "Type": "String",
            "Value": "Month"
        }
    ],
    "UIData": "CubeAction=1511\fDataAction=1503\fCubeLogChanges=0\f",
    "Variables": [
        {
