###############################################################################
### Cube: OPS Monthly
### Dimensions:
###     1: Version
###     2: Month
###     3: Rate Type
###     4. OPS Source
###     5: Location
###     6: Line of Business
###     7: Flow Type
###     8. Car Type
###     9: OPS Metric
###     10: OPS Monthly Measure
###############################################################################

FEEDSTRINGS;
SKIPCHECK;

[ ] = S: IF ( ATTRS ( 'Version', !Version, 'Active' ) @= '', STET, CONTINUE );

# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# Completed Trips Calcs
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['% Surge Trips', 'Amount'] =
	['Surge Trips'] \ ['Completed Trips'];

['Average Fare', 'Amount'] = C:
	['Total Bookings'] \ ['Completed Trips'];

['OPS Flow Type':'Not Specified','Product Type':'Unspecified Product Type','Average Fare', 'Amount'] = N:
	['Total Product Type','Total Bookings'] \ ['Total by Flow Type','Total Product Type','Completed Trips'];

['Average ETA (mins)', 'Amount'] = ['ETA Minutes'] \ ['Completed Trips'];

# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# Riders Calcs
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['Trips / Rider', 'Amount'] =
	['Completed Trips'] \ ['Unique Riders'];

['Bookings / Rider', 'Amount'] =
	['Total Bookings'] \ ['Unique Riders'];

['Trips / New Rider', 'Amount'] =
	['New Rider Trips'] \ ['New Riders'];

['Trips / Continuing Rider', 'Amount'] =
	['Continuing Rider Trips'] \ ['Continuing Riders'];

['Trips / Reactived Rider', 'Amount'] =
	['Reactived Rider Trips'] \ ['Reactived Riders'];

['Churned Riders',  'Amount'] =
	['Unique Riders'] - DB ( 'OPS Monthly', !Version, ATTRS ( 'Month' , !Month , 'Period-1' ), !Rate Type ,'FDP', !Location, !Line of business, !OPS Flow Type, !Product Type, 'Unique Riders','Amount') - ['New Riders'];

['Churned Riders %', 'Amount'] =
	['Churned Riders'] \ ['Unique Riders'];

['Churned Drivers %', 'Amount'] =
	['Churned Drivers'] \ ['Unique Drivers'];

# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# Drivers  Calcs
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['Trips / Driver', 'Amount'] =
	['Completed Trips'] \ ['Unique Drivers'];

['Bookings / Driver' ,'Amount'] =
	['Total Bookings'] \ ['Unique Drivers'];

['Trips / New Driver', 'Amount'] =
	['New Driver Trips'] \ ['New Drivers'];

['Trips / Continuing Driver', 'Amount'] =
	['Continuing Driver Trips'] \ ['Continuing Drivers'];

['Trips / Reactived Driver', 'Amount'] =
	['Reactived Driver Trips'] \ ['Reactived Drivers'];

['Churned Drivers', 'Amount'] =
	['Unique Drivers'] - DB ( 'OPS Monthly', !Version, ATTRS ( 'Month' , !Month , 'Period-1' ), !Rate Type ,'FDP', !Location, !Line of business, !OPS Flow Type, !Product Type, 'Unique Drivers','Amount' ) - ['New Drivers'];

['Supply Hours / Driver', 'Amount'] = ['Driver Supply Minutes'] \ ['Unique Drivers'] \ 60;

# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# Supply Min  Calcs
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['Trips / Hour', 'Amount'] =
	['Completed Trips'] \ ( ['Driver Supply Minutes'] \ 60 );

['Bookings / Hour', 'Amount'] =
	['Total Bookings'] \ ( ['Driver Supply Minutes'] \ 60 );


# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# Other  Calcs
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #


['Completed %', 'Amount'] =
	['Completed Trips'] \ ['Requests'];

['Inflows / Bookings %' ,'Amount'] =
	['Net Inflows'] \ ['Total Bookings'];


['Actual','Total Bookings', 'Amount'] = IF ( ELLEV ( 'Month', !Month ) > 0, STET, CONTINUE );


# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# Measure  Calcs
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['MoM Amount Growth'] = ['Amount'] - DB('OPS Monthly', !Version, ATTRS ( 'Month' , !Month , 'Period-1' ), !Rate Type ,'FDP', !Location, !Line of business, !OPS Flow Type, !Product Type, !OPS Metric,'Amount');

['MoM Amount Growth %'] = ['MoM Amount Growth'] \ DB('OPS Monthly', !Version, ATTRS ( 'Month' , !Month , 'Period-1' ), !Rate Type ,'FDP', !Location, !Line of business, !OPS Flow Type, !Product Type, !OPS Metric,'Amount');

['YoY Amount Multiple'] = ['Amount'] \ DB('OPS Monthly', !Version, ATTRS ( 'Month' , !Month , 'Year-1' ), !Rate Type ,'FDP', !Location, !Line of business, !OPS Flow Type, !Product Type, !OPS Metric,'Amount');

['12 Month Amount CMGR %'] = IF ( ['YoY Amount Multiple'] <> 0, ( ['YoY Amount Multiple'] ^ ( 1 / 12 ) ) - 1, CONTINUE );

# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# Consol  Calcs
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
## Consolidate across OPS Metric because of location 0 value

['Location:Total Location', {
   'Unique Drivers',
   'Unique Riders',
   'Reactived Drivers',
  'Reactived Riders'}, {'Amount'}] =C:   IF ( ELLEV ( 'Month', !Month ) > 0, 0, CONTINUE );

['Location:Total Location', {
   'Unique Drivers',
   'Unique Riders'}, {'Amount'}] =C : ['Location':'0'];

['Location:Total Location', {
   'Continuing Riders',
   'Continuing Rider Trips',
'Continuing Drivers',
   'Continuing Driver Trips',
   'New Drivers',
   'New Riders', 'New Driver Trips',
   'New Rider Trips'}, {'Amount'}] = C:   IF (
ATTRS ( 'Month', !Month, 'Year') @< '2017', ['Location':'0'], STET) ;

['Location:Total Location', 'Reactived Drivers'] = ConsolidateChildren ( 'OPS Metric' );
['Location:Total Location', 'Reactived Driver Trips'] = ConsolidateChildren ( 'OPS Metric' );
['Location:Total Location', 'Reactived Riders'] = ConsolidateChildren ( 'OPS Metric' );
['Location:Total Location', 'Reactived Rider Trips'] = ConsolidateChildren ( 'OPS Metric' );

['Actual', 'Amount','OPS Flow Type':'Not Specified','Product Type':'Unspecified Product Type','USD','uReporting','41105']= N: IF (
DIMIX ( 'Month', !Month ) < DIMIX ('Month', 'Dec 2014' ),['Total Bookings Vertica','Total Product Type','FDP'],continue);

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- #
FEEDERS;
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- #


['Completed Trips'] =>
	['% Surge Trips'],
	['Total by Flow Type','Total Product Type','Average Fare'],

	['Completed %'],
	['Trips / Hour'],
	['Average ETA (mins)'];

['Unique Riders'] =>
	['Trips / Rider'],
	['Bookings / Rider'],
	['Churned Riders'];

['Unique Drivers'] =>
	['Trips / Driver'],
	['Bookings / Driver'],
	['Churned Drivers'],
	['Supply Hours / Driver'];

['Total Bookings'] =>
	['Bookings / Hour'],
	['Inflows / Bookings %'];

['New Riders'] =>
	['Trips / New Rider'], ['Churned Riders'];
['Continuing Riders'] =>
	['Trips / Continuing Rider'];
['Reactived Riders'] =>
	['Trips / Reactived Rider'];

['Churned Riders'] => ['Churned Riders %'];

['New Drivers'] =>
	['Trips / New Driver'], ['Churned Drivers'], ['Churned Drivers %'];
['Continuing Drivers'] =>
	['Trips / Continuing Driver'];
['Reactived Drivers'] =>
	['Trips / Reactived Driver'];

['Churned Drivers'] => ['Churned Drivers %'];

['Bookings GL', 'Amount'] => ['Total Bookings', 'Amount'];
['Total Bookings Vertica','FDP','Total Product Type','Amount'] => ['41105','uReporting','OPS Flow Type':'Not Specified','Product Type':'Unspecified Product Type', 'Amount'];

['Amount'] => ['MoM Amount Growth'], ['MoM Amount Growth %'], ['YoY Amount Multiple'], ['12 Month Amount CMGR %'];

['Budget', 'Amount','Completed Trips', 'Total Source excl Variance']=> ['Budget', 'Amount','Net Inflows', 'Variance','OPS Flow Type':'Not Specified','Product Type':'Unspecified Product Type'];




