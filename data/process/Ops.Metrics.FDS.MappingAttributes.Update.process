nEpilogProcedureStartTime = NOW();
# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****


### Update the _fds metrics with correct name 

sDim = 'Mobility Ops Metrics';

i = 1;
WHILE(i <= DIMSIZ(sDim));
   sEle = DIMNM(sDim, i);
   IF(DTYPE(sDim, sEle) @= 'N' & SCAN('_FDS', UPPER(sEle)) > 0);
      sElement = SUBST(sEle, 1, LONG(sEle) - 4);
      # ================= TAPTOOLS: START GENERATED CODE =================== #
      nEpilogProcedureMetadataOperations = nEpilogProcedureMetadataOperations + 1;
      # ================= TAPTOOLS: END GENERATED CODE ===================== #
      ATTRPUTS(sElement, sDim, sEle, 'FDS');
   ENDIF;
   i = i + 1;
END;

sDim = 'Delivery Ops Metrics';

i = 1;
WHILE(i <= DIMSIZ(sDim));
   sEle = DIMNM(sDim, i);
   IF(DTYPE(sDim, sEle) @= 'N' & SCAN('_FDS', UPPER(sEle)) > 0);
      sElement = SUBST(sEle, 1, LONG(sEle) - 4);
      # ================= TAPTOOLS: START GENERATED CODE =================== #
      nEpilogProcedureMetadataOperations = nEpilogProcedureMetadataOperations + 1;
      # ================= TAPTOOLS: END GENERATED CODE ===================== #
      ATTRPUTS(sElement, sDim, sEle, 'FDS');
   ENDIF;
   i = i + 1;
END;

sDim = 'U4B Ops Metrics';

i = 1;
WHILE(i <= DIMSIZ(sDim));
   sEle = DIMNM(sDim, i);
   IF(DTYPE(sDim, sEle) @= 'N' & SCAN('_FDS', UPPER(sEle)) > 0);
      sElement = SUBST(sEle, 1, LONG(sEle) - 4);
