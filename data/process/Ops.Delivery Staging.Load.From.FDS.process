   CELLINCREMENTN(vValue, cCube, 'Actual', sPeriod, 'FDS', 'No Rate Type', vCurrency, vLob, '0000', sLocation, vFul, vMerType, vOrder, vSeg, sFeature, sMetric, 'Amount');
ELSE;
   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   CELLINCREMENTN(vValue, cCube, 'Actual', sPeriod, 'FDS', 'USD', vCurrency, vLob, '0000', sLocation, vFul, vMerType, vOrder, vSeg, sFeature, sMetric, 'Amount');
ENDIF;





# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsCompleted = nDataProcedureRecordsCompleted + 1;
