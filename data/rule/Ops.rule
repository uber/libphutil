
###############################################################################
### Cube: Ops
### Dimensions:
###     1: Version
###     2: Period
###     3: Source
###     4. Rate Type
###     5: Location
###     6: Line of Business
###     7. Product Type
###     8: Ops Metric
###     9: Ops Measure
###############################################################################

FEEDSTRINGS;
SKIPCHECK;

['Reported'] = STET;

['Forecast Excl Actuals'] = 
  IF
      ( 
         ATTRN('Period', !Period, 'End of Period') > ATTRN('Period', DB('Admin Playbook', 'Oracle Sync', 'Current Actual Month'), 'End of Period') 
          % ELLEV('Period', !Period) > 0
      ,
         CONTINUE
      ,
         STET
      );

# ==========================#
# Calculate Avg. Fare
# ==========================#

['Actual', 'Avg. Fare', 'Amount'] = C: ['Fares'] \ ['Completed Trips'];

['Actual', 'TPU', 'Amount'] = C:  ['Completed Trips'] \ ['Active Users'];

['Actual', 'X-Platform Users %', 'Amount'] = ['X-Platform Users'] \ DB('Ops',!Version, !Period, !Source,!Rate Type, 'Total Location By Country', !Line of Business,!Product Type, 'X-Platform Users','Amount');

['Actual', 'P3 Miles Per Trip', 'Amount'] = C: ['Total P3 Miles'] \ ['Completed Trips - Rides Insurance CM'];

['Actual', 'P2 Miles Per Trip', 'Amount'] = C: ['Total P2 Miles'] \ ['Completed Trips - Rides Insurance CM'];

['Actual', 'Total Miles per Trip', 'Amount'] = C: ['Total Mileage (Mileage Type)'] \ ['Completed Trips - Rides Insurance CM'];

# =-=-=-=-=-=-=-=-=-=-=-=-=-=- =-=-=-=-=-=-=-=-#
# STET Freight monthly completed trips - 2020 onwards
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

['Actual','FDS','Line of Business' : '8001','Completed Trips','Amount'] = N:
   IF(
      ELISANC('Period', 'Total Time - Month', !Period)=1 &
      DIMIX('Period', !Period) >= DIMIX('Period', '2020-01')
   ,
      STET
   ,
      CONTINUE
   );

# Completed Trips via TI process after this date
['Actual',{'FDS','Ops Adjustment'},'Line of Business' : {'1001', '1002', '2001', '2004', '2006'} ,'Completed Trips','Amount'] = N:
IF ( Elisanc ( 'Period', 'Total Time - Month', !Period) = 1 & DAYNO ( SUBST (!Period, 1, 4) | '-' | SUBST (!Period, 6, 2) | '-' | '01') > 22705 %
    Elisanc ( 'Period', 'Total Time - Week', !Period) = 1 & DAYNO ( SUBST (!Period, 4, 4) | '-' | SUBST (!Period, 9, 2) | '-' | SUBST (!Period, 12, 2)) > 22732 %
 Elisanc ( 'Period', 'Total Time - Day', !Period) = 1   ,
  STET,
CONTINUE);

['Actual','Ops Post Reported Adjs','Completed Trips','Amount']=IF( ELISANC('Period','Total Time - Month', !Period)=1 & DAYNO ( SUBST (!Period, 1, 4) | '-' | SUBST (!Period, 6, 2) | '-' | '01') < DAYNO(TIMST(NOW(),'\Y-\m') | '-01') , ['FDS'] - ['Reported'],STET);

# =-=-=-=-=-=-=-=-=-=-=-=-=-=- =-=-=-#
# Skip Support Contacts - loading via process
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- #

[{'Support Contacts - Virtual', 'Support Contacts - Greenlight', 'Support Contacts - Automation'}] = N: STET;

# =-=-=-=-=-=-=-=-=-=-=-=-=-=- =-=-=-=-=-=-=-=-=-=-=-=-=-=- =-=-=-= #
# POP, YOY, POP %, YOY %, % of Gross Bookings, % of Adjusted Net Revenue , Per Trip Calculation
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- =-=-=-=-=-=-=-=-=-=-=-=-=-=- =-=-=-= #

['% of Gross Bookings'] = ['Amount'] \ ['Gross Bookings','Amount'];

['% of Adjusted Net Revenue'] = ['Amount'] \ ['Adjusted Net Revenue', 'Amount'];

['Ops Measure':'Per Trip'] =
   ['Ops Measure':'Amount'] \
   ['Ops Metric':'Completed Trips', 'Ops Measure':'Amount'];

['Ops Measure':'Per P3 Mile'] =
   ['Ops Measure':'Amount'] \
   ['Ops Metric':'Total P3 Miles', 'Ops Measure':'Amount'];

['Ops Measure':'Per P2 Mile'] =
   ['Ops Measure':'Amount'] \
   ['Ops Metric':'Total P2 Miles', 'Ops Measure':'Amount'];

['Ops Measure':'Per Mile'] =
   ['Ops Measure':'Amount'] \
   ['Ops Metric':'Total Mileage (Mileage Type)', 'Ops Measure':'Amount'];


['PoP Growth'] =
   (
     ['Amount'] -
     DB('Ops',!Version,ATTRS('Period', !Period, 'Period-1'),!Source,!Rate Type,!Location,!Line of Business,!Product Type,!Ops Metric,'Amount')
   ) *
      IF(
      ATTRN('Ops Metric', !Ops Metric, 'Var Multiplier') = -1
      ,
      -1
      ,
      1);

['YoY Growth'] =
   IF(
     ELISANC('Period', 'Total Time - Month', !Period)=1,
   (
      ['Amount'] -
      DB('Ops',!Version,ATTRS('Period', !Period, 'Year-1'),!Source,!Rate Type,!Location,!Line of Business,!Product Type,!Ops Metric,'Amount')
   ) *
      IF(
      ATTRN('Ops Metric', !Ops Metric, 'Var Multiplier') = -1
      ,
      -1
      ,
      1),0);

['PoP Growth %'] =
  MIN(
    MAX(
         ['PoP Growth'] \
         ABS (DB('Ops',!Version,ATTRS('Period', !Period, 'Period-1'),!Source,!Rate Type,!Location,!Line of Business,!Product Type,!Ops Metric,'Amount'))
         ,
        -9.99
      )
   ,
    9.99
  );

['YoY Growth %'] =
   IF(
     ELISANC('Period', 'Total Time - Month', !Period)=1,
  MIN(
    MAX(
          ['YoY Growth'] \
          ABS (DB('Ops',!Version,ATTRS('Period', !Period, 'Year-1'),!Source,!Rate Type,!Location,!Line of Business,!Product Type,!Ops Metric,'Amount'))
          ,
         -9.99
        )
      ,
    9.99
  ),0);


#=-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-=-=-=-=-#
#>--- Amount Measure in (K) & (M)
#=-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-=-=-=-=-#

['Ops Measure':'Amount (K)'] = C:
   ['Amount'] \ 1000;

['Ops Measure':'Amount (M)'] = C:
    ['Amount'] \ 1000000;

# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# Eats C-level rules
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['Actual', 'Line of Business':'2001', 'TpE'] = C: IF(ATTRS('Period',!Period,'Level') @= 'Week', ['Completed Trips'] \ ['Weekly Active Riders'], ['Completed Trips'] \ ['Active Users']);

['Actual', 'Line of Business':'2001', 'ANR Margin'] = C: ['Adjusted Net Revenue']\ ['Total Bookings'];

['Actual',  'Line of Business':'2001', 'Avg. Basket Size'] = C: ['Fares'] \ ['Completed Trips'];

['Actual',  'Line of Business':'2001', 'Marketplace Fee %'] = C: 1 + ( ['MPF'] \ ['Fares'] );

['Actual',  'Line of Business':'2001',  'Promo % of GB'] = C: ['Promos'] \ ['Total Bookings'];

['Actual',  'Line of Business':'2001', 'TpR'] = C: ['Completed Trips'] \ ['Active Restaurants'];

['Actual',  'Line of Business':'2001', '% of Trips Promoed'] = C: ['Promo Trips'] \ ['Completed Trips'];

['Actual','CPT', 'Amount'] =  (['Existing Driver Incentives'] + ['Total Driver Payments']) \ ['Completed Trips'];



['Actual', 'Line of Business':'8001', 'Load Margin'] = ['Gross Bookings - Shipper Revenue'] - ['Carrier Payout'];

['Actual', 'Line of Business':'8001', 'Shipper Revenue per Load'] = ['Gross Bookings - Shipper Revenue'] \ ['Completed Trips'];

['Actual', 'Line of Business':'8001', 'OTP per OTD Carrier'] = ['OTP Carrier'] \ ['OTD Carrier'];

['Actual', 'Line of Business':'8001', 'OTP per OTD Customer'] = ['OTP Customer'] \ ['OTD Customer'];

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# Period C-level Rule for MAPC metrics 
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- #

### Quarter should reflect the average of deduped values of its months for MAPC metrics
[{'Actual', 'Forecast Excl Actuals', 'Forecast'}, 'Ops Measure':'Amount'] = C:
   IF(
      ELISANC ('Ops Metric', 'MAPC Metrics',!Ops Metric) > 0 & ELLEV('Period', !Period) > 0
   ,
      IF(
        UPPER(DB('}ElementAttributes_Period', !Period, 'Input Type')) @= 'QUARTER' 
      ,
        CONSOLIDATECHILDREN('Period') \ CONSOLIDATEDCOUNTUNIQUE(2, 'Period', '', !Version, !Period, !Source, !Rate Type, !Location, !Line of Business, !Product Type, !Ops Metric, !Ops Measure)
      ,
        CONTINUE
      )
   ,
      CONTINUE
   );

### H1 should reflect Q2 deduped value for MAPC metrics
[{'Actual', 'Forecast Excl Actuals', 'Forecast'}, 'Ops Measure':'Amount'] = C:
   IF(
      ELISANC ('Ops Metric', 'MAPC Metrics',!Ops Metric) > 0 & ELLEV('Period', !Period) > 0
   ,
      IF(
        UPPER(DB('}ElementAttributes_Period', !Period, 'Month Name')) @= 'H1'  
      ,
        DB('Ops', !Version, SUBST(!Period, 1, 4) | '-Q2', !Source, !Rate Type, !Location, !Line of Business, !Product Type, !Ops Metric, !Ops Measure)
      ,
        CONTINUE
      )
   ,
      CONTINUE
   );

# H2 & FY should reflect Q4 deduped value for MAPC metrics
[{'Actual', 'Forecast Excl Actuals', 'Forecast'}, 'Ops Measure':'Amount'] = C:
   IF(
      ELISANC ('Ops Metric', 'MAPC Metrics',!Ops Metric) > 0 & ELLEV('Period', !Period) > 0
   ,
      IF(
        ( UPPER(DB('}ElementAttributes_Period', !Period, 'Month Name')) @= 'H2' % UPPER(DB('}ElementAttributes_Period', !Period, 'Input Type')) @= 'YEAR' )
      ,
        DB('Ops', !Version, SUBST(!Period, 1, 4) | '-Q4', !Source, !Rate Type, !Location, !Line of Business, !Product Type, !Ops Metric, !Ops Measure)
      ,
        0
      )
   ,
      CONTINUE
   );


# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
#Source C-level Rule
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

[{'Actual', 'Forecast Excl Actuals'}, 'Ops Measure':'Amount'] = C: IF(ELLEV('Source',!Source)>0 & ELISANC ('Ops Metric', 'MAPC Metrics',!Ops Metric) > 0,CONSOLIDATECHILDREN('Source'),CONTINUE);


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# C-level Rules for MAPC metrics Actuals
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['Actual', 'Ops Measure':'Amount'] = C:
   IF(
      ELISANC ('Ops Metric', 'MAPC Metrics',!Ops Metric) > 0 
   ,
      IF(
            (!Line of Business @= 'Total Rides & Eats' % !Line of Business @= 'Delivery ex M&A' % !Line of Business @= 'Mobility ex M&A' % !Line of Business @= 'Total Careem') &
            (ELLEV ('Location', !Location) > 0)
         ,
            DB('Ops', !Version, !Period, !Source, !Rate Type,  'CustomLeaf':!Location | ' Input', 'CustomLeaf':!Line of Business | ' Input', !Product Type, !Ops Metric, 'Amount')
         ,
          CONTINUE
      )
   ,
      CONTINUE
   );
   
['Actual', 'Ops Measure':'Amount'] = C:
   IF(
      ELISANC ('Ops Metric', 'MAPC Metrics',!Ops Metric) > 0 
   ,
      IF(
            (!Line of Business @= 'Total Rides & Eats' % !Line of Business @= 'Delivery ex M&A' % !Line of Business @= 'Mobility ex M&A' % !Line of Business @= 'Total Careem') &
            (ELLEV ('Location', !Location) = 0)
         ,
            DB('Ops', !Version, !Period, !Source, !Rate Type,  !Location, 'CustomLeaf':!Line of Business | ' Input', !Product Type, !Ops Metric, 'Amount')
         ,
          CONTINUE
      )
   ,
      CONTINUE
   );
   
['Actual', 'Ops Measure':'Amount', 'Source':'Ops Adjustment'] = C:
   IF(
      ELISANC ('Ops Metric', 'MAPC Metrics',!Ops Metric) > 0 
   ,
      IF(
            ELLEV ('Line of Business', !Line of Business) = 0 &
            ELLEV ('Location', !Location) > 0
         ,
            DB('Ops', !Version, !Period, !Source, !Rate Type,  'CustomLeaf':!Location | ' Input', !Line of Business, !Product Type, !Ops Metric, 'Amount')
         ,
          CONTINUE
      )
   ,
      CONTINUE
   );   
   
['Actual', 'Ops Measure':'Amount', 'Source':'FDS'] = C:
   IF(
      ELISANC ('Ops Metric', 'MAPC Metrics',!Ops Metric) > 0 
       & !Ops Metric @<> 'Active Drivers' & !Ops Metric @<> 'New Drivers' & !Ops Metric @<> 'Continuing Drivers'
   ,
      IF(
            ELLEV ('Line of Business', !Line of Business) = 0 &
            ELLEV ('Location', !Location) > 0
         ,
            DB('Ops', !Version, !Period, !Source, !Rate Type,  'CustomLeaf':!Location | ' Input', !Line of Business, !Product Type, !Ops Metric, 'Amount')
         ,
          CONTINUE
      )
   ,
      CONTINUE
   );   
   

# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
#Total Rides & Eats C-level rules For Actuals
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['Ops Measure':'Amount','Actual' ] = C:
   IF(
      ATTRS('Ops Metric', !Ops Metric, 'Aggregate_LOB_Flag') @= 'Y' &
      ATTRS('Ops Metric', !Ops Metric, 'Aggregate_Location_Flag') @= 'Y'
   ,
      IF(
         ELLEV('Period', !Period) > 0
      ,
         0
     ,
         IF(
            (!Line of Business @= 'Total Rides & Eats' % !Line of Business @= 'Total Careem') &
            (ELLEV ('Location', !Location) > 0)
         ,
            DB('Ops', !Version, !Period, !Source, !Rate Type,  'CustomLeaf':!Location | ' Input', 'CustomLeaf:' | !Line of Business | 'Input', !Product Type, !Ops Metric, 'Amount')
         ,
          CONTINUE
        )
      )
   ,
      CONTINUE
   );

['Ops Measure':'Amount','Actual' ] = C:
   IF(
      ATTRS('Ops Metric', !Ops Metric, 'Aggregate_LOB_Flag') @= 'Y'
   ,
      IF(
         ELLEV('Period', !Period) > 0
      ,
         0
     ,
         IF(
             (!Line of Business @= 'Total Rides & Eats')
         ,
            DB('Ops', !Version, !Period, !Source, !Rate Type, !Location, 'CustomLeaf: Total Rides & Eats Input', !Product Type, !Ops Metric, 'Amount')
         ,
           CONTINUE
        )
      )
   ,
      CONTINUE
   );


['Ops Measure':'Amount',  'Line of Business':'1001','Actual','FDS'] = C:
   IF(
      ATTRS('Ops Metric', !Ops Metric, 'Aggregate_Location_Flag') @= 'Y'
   ,
      IF(
         ELLEV('Period', !Period) > 0
      ,
         0
      ,
         IF(
            (ELLEV ('Location', !Location) > 0)
         ,
            DB('Rides Ops', !Version, !Period, !Source, !Rate Type, !Location,  'Total Rides Flow Type','Total Rides Car Type', !Ops Metric, 'Amount')
         ,
            STET
         )
      )
   ,
      CONTINUE
   );

['Ops Measure':'Amount',  'Line of Business':'2001','Actual','FDS'] = C:
   IF(
      ATTRS('Ops Metric', !Ops Metric, 'Aggregate_Location_Flag') @= 'Y'
   ,
      IF(
         ELLEV('Period', !Period) > 0
      ,
         0
     ,
         IF(
            (ELLEV ('Location', !Location) > 0)
         ,
            DB('Eats Ops', !Version, !Period, !Source, !Rate Type, !Location,  'Total Eats Product Type','Total Eats Restaurant Type', !Ops Metric, 'Amount')
         ,
            STET
        )
      )
   ,
      CONTINUE
   );

['Ops Measure':'Amount','Actual'] = C:

   IF(
      ATTRS('Ops Metric', !Ops Metric, 'Aggregate_LOB_Flag') @= 'Y' &
      ATTRS('Ops Metric', !Ops Metric, 'Aggregate_Location_Flag') @= 'Y'
   ,
      IF(
           ELLEV('Line of Business', !Line of Business) > 0 %  ELLEV('Location', !Location) > 0
           ,
           IF(
               SCAN('Rides', !Line of Business) = 0 & SCAN('Eats', !Line of Business) = 0
               ,
                  0
               ,
               CONSOLIDATECHILDREN('Line of Business')
            )
     ,
      STET
     )
   ,
     CONTINUE
   );

['Ops Measure':'Amount','Actual'] = C:

   IF(
      ATTRS('Ops Metric', !Ops Metric, 'Aggregate_LOB_Flag') @= 'Y' &
      ATTRS('Ops Metric', !Ops Metric, 'Aggregate_Location_Flag') @<> 'Y'
   ,
      IF(
           ELLEV('Line of Business', !Line of Business) > 0
      ,
         0
     ,
      STET
     )
   ,
      CONTINUE
   );

['Ops Measure':'Amount','Actual'] = C:

   IF(
      ATTRS('Ops Metric', !Ops Metric, 'Aggregate_LOB_Flag') @<> 'Y' &
      ATTRS('Ops Metric', !Ops Metric, 'Aggregate_Location_Flag') @= 'Y'
   ,
      IF(
         ELLEV('Location', !Location) > 0
      ,
         0
     ,
      STET
     )
   ,
      STET
   );


##############################################################
# MAPC metrics rules for Forecast Excl Actuals version
##############################################################

['Forecast Excl Actuals', 'Planning', 'USD', 'Ops Measure':'Amount'] = C:
   IF(
      ELISANC ('Ops Metric', 'MAPC Metrics',!Ops Metric) > 0
   ,
      IF(
            SUBST(!Location, 1, 10) @= 'Country - '  &
            ELLEV('Line Of Business', !Line of Business) = 0
          ,
           STET
          ,
           CONTINUE
        )
   ,
      CONTINUE
   );

['Forecast Excl Actuals', 'Planning', 'USD', 'Ops Measure':'Amount'] = C:
   IF(
      !Ops Metric @= 'Active Drivers' % !Ops Metric @= 'New Drivers' % !Ops Metric @= 'Continuing Drivers'
   ,
         IF(
            ( SUBST(!Location, LONG(!Location) - 12, 13) @= '(Mega Region)' % !Location @= 'Total Location' ) &
            ELLEV('Line Of Business', !Line of Business) = 0
          ,
           DB('MAPC', !Version, !Period, !Source, !Rate Type,  'CustomLeaf':!Location | ' Input', !Line of Business, !Product Type, !Ops Metric, 'Amount')
          ,
           CONTINUE
        )
   ,
      CONTINUE
   );
   
['Forecast Excl Actuals', 'Planning', 'USD', 'Ops Measure':'Amount'] = C:
   IF(
      ELISANC ('Ops Metric', 'MAPC Metrics',!Ops Metric) > 0
   ,
         IF(
            ( SUBST(!Location, LONG(!Location) - 12, 13) @= '(Mega Region)' % !Location @= 'Total Location' ) &
            ELLEV('Line Of Business', !Line of Business) = 0
          ,
           DB('Ops', !Version, !Period, !Source, !Rate Type,  'CustomLeaf':!Location | ' Input', !Line of Business, !Product Type, !Ops Metric, 'Amount')
          ,
           CONTINUE
        )
   ,
      CONTINUE
   );    
      
['Forecast Excl Actuals', 'Planning', 'USD', 'Ops Measure':'Amount'] = C:
   IF(
       !Ops Metric @= 'Active Drivers' % !Ops Metric @= 'New Drivers' % !Ops Metric @= 'Continuing Drivers'
   ,
         IF(
            ( SUBST(!Location, 1, 10) @= 'Country - ' % SUBST(!Location, LONG(!Location) - 12, 13) @= '(Mega Region)' % !Location @= 'Total Location' ) & 
            (!Line of Business @= 'Total Rides & Eats' % !Line of Business @= 'Delivery ex M&A' % !Line of Business @= 'Mobility ex M&A') 
          ,
           DB('MAPC', !Version, !Period, !Source, !Rate Type,  'CustomLeaf':!Location | ' Input', 'CustomLeaf':!Line of Business | ' Input', !Product Type, !Ops Metric, 'Amount')
          ,
           CONTINUE
        )
   ,
      CONTINUE
   ); 

['Forecast Excl Actuals', 'Planning', 'USD', 'Ops Measure':'Amount'] = C:
   IF(
      ELISANC ('Ops Metric', 'MAPC Metrics',!Ops Metric) > 0
   ,
         IF(
            ( SUBST(!Location, 1, 10) @= 'Country - ' % SUBST(!Location, LONG(!Location) - 12, 13) @= '(Mega Region)' % !Location @= 'Total Location' ) & 
            (!Line of Business @= 'Total Rides & Eats' % !Line of Business @= 'Delivery ex M&A' % !Line of Business @= 'Mobility ex M&A') 
          ,
           DB('Ops', !Version, !Period, !Source, !Rate Type,  'CustomLeaf':!Location | ' Input', 'CustomLeaf':!Line of Business | ' Input', !Product Type, !Ops Metric, 'Amount')
          ,
           CONTINUE
        )
   ,
      CONTINUE
   ); 
   
['Forecast Excl Actuals', 'Planning', 'USD', 'Ops Measure':'Amount'] = C:

   IF(
      ELISANC ('Ops Metric', 'MAPC Metrics',!Ops Metric) > 0
   ,
      IF(
           ELLEV('Line of Business', !Line of Business) > 0 %  ELLEV('Location', !Location) > 0
           ,
           IF(
               SCAN('Rides', !Line of Business) = 0 & SCAN('Eats', !Line of Business) = 0
               ,
                  0
               ,
               CONSOLIDATECHILDREN('Line of Business')
            )
     ,
      CONTINUE
     )
   ,
     CONTINUE
   );
  

####################################################################################################################
# Forecast Consolidation to have either Actuals OR Forecast Excl Actuals based on the current month for MAPC metrics
####################################################################################################################

['Version':'Forecast', 'Ops Measure':'Amount'] = C:
   IF
   (
      ELISANC ('Ops Metric', 'MAPC Metrics',!Ops Metric) > 0    
    ,      
        IF
          (
             ATTRN('Period', !Period, 'End of Period') > ATTRN('Period', DB('Admin Playbook', 'Oracle Sync', 'Current Actual Month'), 'End of Period')
          ,
             ['Version':'Forecast Excl Actuals']
          ,
             ['Version':'Actual']
          )
    ,
      CONTINUE
   );

# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# Rides N-level rules
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['Version' : 'Actual', 'Line of Business':'1002', 'Product Type' : {'Expresspool', 'Pool'},'FDS'] = N :

   IF(
      ELISANC('OPS Metric', 'Rides and Eats Metrics', !OPS Metric) = 1 % ELISANC('OPS Metric', 'Rides Only Metrics', !OPS Metric)=1
   ,
      DB('Rides Ops', !Version, !Period, !Source, !Rate Type, !Location, 'Total Rides Flow Type', !Product Type, !Ops Metric, 'Amount')
   ,
      CONTINUE
   );

['Version' : 'Actual', 'Line of Business':'1001','FDS'] = N :

   IF(
      ELISANC('OPS Metric', 'Rides and Eats Metrics', !OPS Metric) = 1 % ELISANC('OPS Metric', 'Rides Only Metrics', !OPS Metric)=1
   ,
      IF((!Product Type @<> 'Expresspool' & !Product Type @<> 'Pool')
      ,
         DB('Rides Ops', !Version, !Period, !Source, !Rate Type, !Location, 'Total Rides Flow Type', !Product Type, !Ops Metric, 'Amount')
      ,
         STET
      )
   ,
      CONTINUE
   );

# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #
# Eats N-level rules
# =-=-=-=-=-=-=-=-=-=-=-=-=-=- #

['Version' : 'Actual', 'Line of Business':'2001', 'Product Type' : 'Eats', 'Completed Trips'] = N:
   DB('Eats Ops', !Version, !Period, !Source, !Rate Type, !Location, 'Total Eats Product Type', 'Total Eats Restaurant Type', 'Completed Deliveries', 'Amount');

['Version' : 'Actual', 'Line of Business':'2001', 'Product Type' : 'Eats', 'Active Riders L28'] = N:
   DB('Eats Ops', !Version, !Period, !Source, !Rate Type, !Location, 'Total Eats Product Type', 'Total Eats Restaurant Type', 'Active Eaters L28', 'Amount');

['Version' : 'Actual', 'Line of Business':'2001', 'Product Type' : 'Eats', 'Weekly Active Riders'] = N:
   DB('Eats Ops', !Version, !Period, !Source, !Rate Type, !Location, 'Total Eats Product Type', 'Total Eats Restaurant Type', 'Weekly Active Eaters', 'Amount');

['Version' : 'Actual', 'Line of Business':'2001', 'Product Type' : 'Eats', 'New Rider Trips'] = N:
   DB('Eats Ops', !Version, !Period, !Source, !Rate Type, !Location, 'Total Eats Product Type', 'Total Eats Restaurant Type', 'New Eater Deliveries', 'Amount');

['Version' : 'Actual', 'Line of Business':'2001', 'Product Type' : 'Eats', 'Resurrected Riders'] = N:
   DB('Eats Ops', !Version, !Period, !Source, !Rate Type, !Location, 'Total Eats Product Type', 'Total Eats Restaurant Type', 'Resurrected Eaters', 'Amount');

['Version' : 'Actual', 'Line of Business':'2001', 'Product Type' : 'Eats', '84 Day Inactive Riders'] = N:
   DB('Eats Ops', !Version, !Period, !Source, !Rate Type, !Location, 'Total Eats Product Type', 'Total Eats Restaurant Type', '84 Day Inactive Eaters', 'Amount');

['Version' : 'Actual', 'Line of Business':'2001', 'Product Type' : 'Eats', 'Continuing Rider Trips'] = N:
   DB('Eats Ops', !Version, !Period, !Source, !Rate Type, !Location, 'Total Eats Product Type', 'Total Eats Restaurant Type', 'Continuing Eater Deliveries', 'Amount');

['Version' : 'Actual', 'Line of Business':'2001', 'Product Type' : 'Eats', 'Active Drivers'] = N:
   DB('Eats Ops', !Version, !Period, !Source, !Rate Type, !Location, 'Total Eats Product Type', 'Total Eats Restaurant Type', 'Active Couriers', 'Amount');

['Version' : 'Actual', 'Line of Business':'2001', 'Product Type' : 'Eats', 'Active Drivers L28'] = N:
