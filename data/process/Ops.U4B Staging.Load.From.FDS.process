nDataProcedureRecordsStarted = nDataProcedureRecordsStarted + 1;
IF(nMetadataProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: END METADATA PROCEDURE');
   nMetadataProcedureEndTime = NOW();
ENDIF;
IF(nDataProcedureStartTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: START DATA PROCEDURE');
   nDataProcedureStartTime = NOW();
ENDIF;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****

IF(pLevel @= 'Month');
   sPeriod = SUBST(vPeriod, 1, 7);
ELSEIF(pLevel @= 'Day');
   sPeriod = vPeriod;
ELSE;
   sPeriod = 'WS ' | vPeriod;
ENDIF;

IF(SUBSETELEMENTEXISTS('Period', cSubset, sPeriod) = 0);
   ITEMSKIP;
ENDIF;

#sPeriod='2021-12-01';

IF(SCAN('_usd', vMetric) = 0);
   sMetric_fds = vMetric;
ELSE;
   nSep = SCAN('_usd', vMetric);
   sMetric_fds = SUBST(vMetric, 1, (nSep - 1));
ENDIF;

# Lookup for TM1 Metric. TM1 <> FDS Mapping

IF(ELISANC('Line of Business', 'Delivery', vLoB) = 1);
   sMetric = CELLGETS(cCubeMap, sMetric_fds, 'Delivery', 'TM1 Metric');
   vDim = 'Delivery Ops Metrics';
   IF((DIMIX(vDim, sMetric) = 0) % (DTYPE(vDim, sMetric) @= 'C') % DTYPE(vDim, sMetric | '_fds') @= 'C');
      ITEMSKIP;
   ENDIF;

ELSE;
   sMetric = CELLGETS(cCubeMap, sMetric_fds, 'Mobility', 'TM1 Metric');
   vDim = 'Mobility Ops Metrics';
   IF((DIMIX(vDim, sMetric) = 0) % (DTYPE(vDim, sMetric) @= 'C') % DTYPE(vDim, sMetric | '_fds') @= 'C');
      ITEMSKIP;
   ENDIF;
ENDIF;

# Location
sDim = 'Location';
IF(vLocation @= '\N' % vLocation @= '');
   ITEMSKIP;
ENDIF;
sLocation = 'V' | vLocation;

IF(DIMIX('Location', sLocation) = 0);
   ITEMSKIP;
ENDIF;

# LOB
IF(vLob @= '\N' % vLob @= '' % DIMIX('Line of Business', vLob) = 0);
   ITEMSKIP;
ENDIF;

# Currency
IF(vCurrency @= '\N' % vCurrency @= '');
   ITEMSKIP;
ENDIF;

IF(vProduct @= '\N' % vProduct @= '');
   vProduct = 'Unspecified U4B Product';
ENDIF;

IF(vChannel @= '\N' % vChannel @= '');
   vChannel = 'Unspecified U4B Sales Channel';
ENDIF;

IF(vSegment @= '\N' % vSegment @= '');
   vSegment = 'Unspecified U4B Org Segment';
ENDIF;

IF(vProfile @= '\N' % vProfile @= '');
   vProfile = 'Unspecified U4B Trip Profile';
ENDIF;

IF(vSegment @= 'IS');
   vSegment = 'Unspecified U4B Org Segment';
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Load Data
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

IF(SCAN('_usd', vMetric) = 0);
   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   CELLINCREMENTN(vValue, cCube, 'Actual', sPeriod, 'FDS', 'No Rate Type', vCurrency, vLob, '0000', sLocation, vSegment, vProduct, vChannel, vProfile, sMetric, 'Amount');
ELSE;
   # ================= TAPTOOLS: START GENERATED CODE =================== #
   nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
   # ================= TAPTOOLS: END GENERATED CODE ===================== #
   CELLINCREMENTN(vValue, cCube, 'Actual', sPeriod, 'FDS', 'USD', vCurrency, vLob, '0000', sLocation, vSegment, vProduct, vChannel, vProfile, sMetric, 'Amount');
ENDIF;





# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsCompleted = nDataProcedureRecordsCompleted + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

