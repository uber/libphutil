SKIPCHECK;

#=-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-=-=-=-=-#
##  Calcs are only true for rate types
#=-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-=-=-=-=-#

[{'Local','Rate Type':'No Rate Type'},'Amount'] = N: STET;


#=-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-=-=-=-=-#
##  Based on Rate Type ATTRS calc rate for specific month
#=-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-==-=-=-=-=-=-=-=-=-=-#

['Amount'] = N:
   DB('Exchange Rate',
   ATTRS('Rate Type', !Rate Type, 'Version'),
   IF(
      ATTRS('Rate Type', !Rate Type, 'Specific Month') @= ''
   ,
      IF(
         ATTRS('Rate Type', !Rate Type, 'Specific Year') @= ''
      ,
         IF(
            ATTRS('Rate Type', !Rate Type, 'Current Month -x') @=''
         ,
            ATTRS('Month', Subst( Today(1), 1, 7), 'Period-1')
         ,
            ATTRS('Month', !Month, ATTRS('Rate Type', !Rate Type, 'Current Month -x'))
         )
      ,
         ATTRS('Rate Type', !Rate Type, 'Specific Year') | '-' | SUBST(!Month, 6, 2)
      )
   ,
      ATTRS('Rate Type', !Rate Type, 'Specific Month')
   ),
   !Currency,'USD',
   ATTRS('Rate Type', !Rate Type, 'Exchange Rate'));

FEEDERS;
