# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #

# ================= TAPTOOLS: START GENERATED CODE =================== #
sProcessName = GETPROCESSNAME();
IF(sProcessName @<> 'TAP.Call.Queue.Add Job To Queue' & sProcessName @<> 'TAP.CubeSaveData' & sProcessName @<> 'TAP.Call.Save' & sProcessName @<> 'TAP.Call.Recurring' & sProcessName @<> 'DIQ.Call.Batch' & sProcessName @<> 'TAP.Call.Save.Wrapper' & sProcessName @<> 'TAP.Call.CubeSaveData.Wrapper' & sProcessName @<> 'TAP.Call.Tests' & sProcessName @<> 'TAP.Call.Init' & sProcessName @<> 'TAP.Call.Export Application Stats' & sProcessName @<> 'TAP.Cube.Export Data to File' & SCAN('}drill', LOWER(sProcessName)) = 0);
   sBlock.Execution.Status = CELLGETS('TAP System Info', 'Block Process Execution', 'Value');
   IF(UPPER(sBlock.Execution.Status) @= 'YES');
      sBlock.Epilog.Execution = 'Yes';
      PROCESSBREAK;
   ENDIF;
ENDIF;
LOGOUTPUT('DEBUG', 'PARAMETER: pCube: "' | pCube | '"');
LOGOUTPUT('DEBUG', 'PROGRESS: START PROLOG PROCEDURE');
nMetadataProcedureRecordsStarted = 0;
nMetadataProcedureRecordsSkipped = 0;
nMetadataProcedureRecordsRejected = 0;
nMetadataProcedureRecordsCompleted = 0;
nDataProcedureRecordsStarted = 0;
nDataProcedureRecordsSkipped = 0;
nDataProcedureRecordsRejected = 0;
nDataProcedureRecordsCompleted = 0;
nPrologProcedureDataOperations = 0;
nDataProcedureDataOperations = 0;
nTotalDataOperations = 0;
nPrologProcedureMetadataOperations = 0;
nMetadataProcedureMetadataOperations = 0;
nDataProcedureMetadataOperations = 0;
nEpilogProcedureMetadataOperations = 0;
nTotalProcedureMetadataOperations = 0;
nPrologProcedureStartTime = NOW();
nPrologProcedureEndTime = 0;
nMetadataProcedureStartTime = 0;
nMetadataProcedureEndTime = 0;
nDataProcedureStartTime = 0;
nDataProcedureEndTime = 0;
# ================= TAPTOOLS: END GENERATED CODE ===================== #
#****Begin: Generated Statements***
#****End: Generated Statements****

#############################################################################################################################################
#         Master process - This process will copy the historical data for the newly created rate type
#############################################################################################################################################


vCurrentYear = SUBST(TRIM(TODAY(1)), 1, 4);
sAddedRateTypes = CELLGETS('Admin Playbook', 'Exchange Rate Sync', 'Added Rate Types');
IF(pCube @= '');
   PROCESSERROR;
ENDIF;

IF(LONG(sAddedRateTypes) > 0);
   cPythonExe = CELLGETS('TAP System Info', 'Python Executable', 'Value');
   cScriptRun = CELLGETS('TAP System Info', 'Scripts Shared Path', 'Value');
   cScriptRun = cScriptRun | '/tap/tap-runtipro-in-parallel.py';
   cServer = CELLGETS('TAP Application Info', CELLGETS('TAP System Info', 'Service Name', 'Value'), 'Endpoint');
   cPort = '443';
   cThreads = '30';

   sProcessName = 'Cubes.Update For New Rate Type';

   sTemplateProcessAll = '';
   cTemplateScriptRun = '%cPythonExe% %cScriptRun% --server ''%cServer%'' --port %cPort% --threads ''%cThreads%'' %sTemplateProcessAll%';
   cTemplateProcess = '--process ''%sProcessName%'' pPeriod ''%sPeriod%'' pVersion ''Actual'' pRateType ''%sRateType%'' pCube ''%pCube%'' ';

   sLoopString = TRIM(sAddedRateTypes);
   sLoopString = sLoopString | IF(SUBST(sLoopString, LONG(sLoopString), 1) @<> '|', '|', '');

   nStart = 1;
   nCurPos = 1;
   WHILE(nCurPos <= LONG(sLoopString));
      sCurChar = SUBST(sLoopString, nCurPos, 1);
      IF(sCurChar @= '|');
         sRateType = SUBST(sLoopString, nStart, nCurPos - nStart);
         IF(TRIM(sRateType) @<> '');
            #Copy the the data for Months of Previous 4 years  
            sPeriod = NUMBERTOSTRING(STRINGTONUMBER(vCurrentYear));
            sTemplateProcessAll = sTemplateProcessAll | EXPAND(cTemplateProcess);
            i = 1;
            WHILE(i < 4);
               sPeriod = NUMBERTOSTRING(STRINGTONUMBER(sPeriod) - 1);
               sTemplateProcessAll = sTemplateProcessAll | EXPAND(cTemplateProcess);
               i = i + 1;
            END;
            #Copy the the data for Weeks of Previous 3 years 
            j = 1;
            sPeriod = NUMBERTOSTRING(STRINGTONUMBER(vCurrentYear));
            tPeriod = sPeriod;
            sPeriod = 'WEEK ' | tPeriod;
            sTemplateProcessAll = sTemplateProcessAll | EXPAND(cTemplateProcess);
            WHILE(j < 3);
               tPeriod = NUMBERTOSTRING(STRINGTONUMBER(tPeriod) - 1);
               sPeriod = 'WEEK ' | tPeriod;
               sTemplateProcessAll = sTemplateProcessAll | EXPAND(cTemplateProcess);
               j = j + 1;
            END;
            #Copy the the data for Days of Previous 2 years 
            k = 1;
            sPeriod = NUMBERTOSTRING(STRINGTONUMBER(vCurrentYear));
            tPeriod = sPeriod;
            sPeriod = 'Day ' | sPeriod;
            sTemplateProcessAll = sTemplateProcessAll | EXPAND(cTemplateProcess);
            WHILE(k < 2);
               tPeriod = NUMBERTOSTRING(STRINGTONUMBER(tPeriod) - 1);
               sPeriod = 'Day ' | tPeriod;
               sTemplateProcessAll = sTemplateProcessAll | EXPAND(cTemplateProcess);
               k = k + 1;
            END;
         ENDIF;
         nStart = nCurPos + 1;
      ENDIF;
      nCurPos = nCurPos + 1;
   END;

   IF(TRIM(sTemplateProcessAll) @<> '');
      sCommand = EXPAND(cTemplateScriptRun);
      LOGOUTPUT('INFO', 'Sample command : ' | SUBST(sCommand, 1, 200));
      EXECUTECOMMAND(sCommand, 1);

   ENDIF;

ENDIF;

# ================= TAPTOOLS: START GENERATED CODE =================== #
nPrologProcedureEndTime = NOW();
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "' | DatasourceType | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceNameForServer: "' | DatasourceNameForServer | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceCubeView: "' | DatasourceCubeView | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceDimensionSubset: "' | DatasourceDimensionSubset | '"');
LOGOUTPUT('DEBUG', 'PROGRESS: END PROLOG PROCEDURE');
# ================= TAPTOOLS: END GENERATED CODE ===================== #

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
