nIndex = 1;
nLimit = ELCOMPN(pSourceDim, vElement);
WHILE(nIndex <= nLimit);
   sElName = ELCOMP(pSourceDim, vElement, nIndex);
   sDecendant = ELEMENTCOMPONENT(pSourceDim, '', vElement, nIndex);
  IF( DIMIX ('}ElementAttributes_' | pSourceDim , sAlias ) > 0 );
     eleName = ATTRS(pSourceDim, sDecendant, sAlias );
     IF(eleName @= '' );
       eleName = sDecendant;
     ENDIF;
   else;
   
   eleName = sDecendant;
  ENDIF;
   nElWeight = ELWEIGHT(pSourceDim, vElement, sDecendant);
