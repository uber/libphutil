# END: PROPERTIES                                                             #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

cCube = 'Eats Ops';
CustomDrill = 1;


cRandomIntA = NUMBERTOSTRING(INT(RAND() * 100000 * RAND()));
cViewName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
cSubsetName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;

VIEWCREATE(cCube, cViewName);
nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(cCube);
WHILE(nCtr <= nMax);
   sDim = TABDIM(cCube, nCtr);
   IF(sDim @= 'Version');
      sElement = pVersion;
      SUBSETCREATE(sDim, cSubsetName);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Period');
      sElement = pPeriod;
      SUBSETCREATE(sDim, cSubsetName);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Source');
      sElement = pSource;
      SUBSETCREATE(sDim, cSubsetName);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Rate Type');
      sElement = pRateType;
      SUBSETCREATE(sDim, cSubsetName);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Location');
      sElement = pLocation;
      SUBSETCREATE(sDim, cSubsetName);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Eats Product Type');
      sElement = 'Total Eats Product Type';
      SUBSETCREATE(sDim, cSubsetName);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Eats Restaurant Type');
      sElement = 'Total Eats Restaurant Type';
      SUBSETCREATE(sDim, cSubsetName);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Eats Ops Metric');
      sElement = pMetric;
      SUBSETCREATE(sDim, cSubsetName);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ELSEIF(sDim @= 'Eats Ops Measure');
      sElement = pMeasure;
      SUBSETCREATE(sDim, cSubsetName);
      SUBSETELEMENTINSERT(sDim, cSubsetName, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubsetName);
   ENDIF;
   nCtr = nCtr + 1;
END;


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
## Set View as DataSource             ##
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

DISABLEMTQVIEWCONSTRUCT();

DatasourceNameForServer = cCube;
DatasourceType = 'VIEW';
DatasourceCubeView = cViewName;

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
