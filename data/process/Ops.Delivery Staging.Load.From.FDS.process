ENDIF;

IF(vU4B @= '1' % UPPER(vU4B) @= 'TRUE');
   sU4B = 'T';
ELSE;
   sU4B = 'F';
ENDIF;

IF(sFeature @<> 'Unspecified Delivery Features');
   sFeature = 'Dir(' | sDir | ') Mem(' | sMem | ') U4B(' | sU4B | ')';
ENDIF;


vDim = 'Delivery Ops Metrics';
IF((DIMIX(vDim, sMetric) = 0) % (DTYPE(vDim, sMetric) @= 'C') % DTYPE(vDim, sMetric | '_fds') @= 'C');
   ITEMSKIP;
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
