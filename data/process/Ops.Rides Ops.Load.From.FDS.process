# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #

# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsStarted = nDataProcedureRecordsStarted + 1;
IF(nMetadataProcedureEndTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: END METADATA PROCEDURE');
   nMetadataProcedureEndTime = NOW();
ENDIF;
IF(nDataProcedureStartTime = 0);
   LOGOUTPUT('DEBUG', 'PROGRESS: START DATA PROCEDURE');
   nDataProcedureStartTime = NOW();
ENDIF;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Transformation
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#


# Month and Week

IF(pLevel @= 'Month');
   sPeriod = SUBST(vPeriod, 1, 7);
ELSE;
   sPeriod = 'WS ' | SUBST(vPeriod, 1, 10);
ENDIF;


IF(SUBSETELEMENTEXISTS('Period', cSubset, sPeriod) = 0);
   ITEMSKIP;
ENDIF;


# Location
sDim = 'Location';
IF(vLocation @= '\N' % vLocation @= '');
   ITEMSKIP;
ENDIF;
sLocation = 'V' | vLocation;

IF((ELISANC(sDim, 'Total Location by Country', vLocation) = 1 & ELLEV(sDim, vLocation) <> 0) % (ELISANC(sDim, 'Custom Consolidations', vLocation) = 1 & ELLEV(sDim, vLocation) <> 0) % (ELISANC(sDim, 'Total Location', vLocation) = 1 & ELLEV(sDim, vLocation) <> 0) % SCAN('(Country)', vLocation) > 0);
   sLocation = vLocation;
ELSEIF(vLocation @= 'global');
   sLocation = 'Total Location';
ELSEIF(vLocation @= 'global_ex_sea_and_russia');
   sLocation = 'Total Location ex SEA & Russia';
ELSE;
   sLocation = 'V' | vLocation;
ENDIF;

IF(DIMIX('Location', sLocation) = 0);
   ITEMSKIP;
ENDIF;


# Flow Type
sDim = 'Rides Flow Type';
IF(vFlowType @= 'nemoearner');
   ITEMSKIP;
ELSEIF(vFlowType @= '\N' % vFlowType @= '' % vFlowType @= 'None');
   sFlowType = 'Unspecified Flow Type';
ELSE;
   sFlowType = vFlowType;
ENDIF;

# Car Type
sDim = 'Rides Car Type';
IF(vCarType @= 'uber_eats');
   ITEMSKIP;
ELSEIF(vCarType @= '\N' % vCarType @= '');
   sCarType = 'Not Specified';
ELSE;
   sCarType = vCarType;
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Clear Target View
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
#Scanning the Input to find Period and metric combination to be zeroed out
sMetric = vMetric;

IF(DIMIX('Rides Ops Metric', sMetric) = 0);
   ITEMSKIP;
ENDIF;

IF(pLevel @= 'Month');
   IF(sMetric @= 'Completed Trips' % sMetric @= 'Rider Miles');
      nGLOPS = 1;
   ENDIF;
ENDIF;

IF(SCAN(sMetric, cMetricString) = 0);
   cMetricString = cMetricString | sMetric | '|';
   SUBSETDELETEALLELEMENTS('Rides Ops Metric', cSubset);
   SUBSETELEMENTINSERT('Rides Ops Metric', cSubset, sMetric, 1);
   VIEWZEROOUT(cCube, cViewName);
ENDIF;

### MAPC cube view zero out ###
IF(pLevel @= 'Month' & SCAN(sMetric, cMapcMetricString) = 0 & ELISCOMP(sDimOpsMetric, sMetric, cMapcMetricConsol) = 1);
   cMapcMetricString = cMapcMetricString | sMetric | '|';
   SUBSETDELETEALLELEMENTS(sDimOpsMetric, cSubset);
   SUBSETELEMENTINSERT(sDimOpsMetric, cSubset, sMetric, 1);
   VIEWZEROOUT(cCubeMapc, cViewName);
ENDIF;


#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Load Data
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

IF(pLevel @= 'Month');
   IF(sMetric @= 'Active Riders L28' % sMetric @= 'Weekly Active Riders' % sMetric @= 'Active Drivers L28' % sMetric @= 'Weekly Active Drivers');
      ITEMSKIP;
   ENDIF;
ELSE;
   IF(sMetric @= 'Active Riders' % sMetric @= 'Active Drivers');
      ITEMSKIP;
   ENDIF;
ENDIF;

sDim = 'Rate Type';
p = 1;
WHILE(p <= DIMSIZ(sDim));
   sRateType = DIMNM(sDim, p);
   IF(ELLEV(sDim, sRateType) = 0);
      IF(ELLEV('Location', sLocation) > 0);
         # ================= TAPTOOLS: START GENERATED CODE =================== #
         nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
         # ================= TAPTOOLS: END GENERATED CODE ===================== #
         CELLPUTN(vValue, cCube, cVersion, sPeriod, cSource, sRatetype, 'CustomLeaf:' | sLocation | ' Input', sFlowType, sCarType, vMetric, cMeasure);

         ### Uploading country level data into MAPC cube for MAPC metrics ###
         IF(pLevel @= 'Month' & sRateType @= 'USD' & SCAN('Country - ', sLocation) > 0 & ELISCOMP(sDimOpsMetric, sMetric, cMapcMetricConsol) = 1);
            # ================= TAPTOOLS: START GENERATED CODE =================== #
            nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
            # ================= TAPTOOLS: END GENERATED CODE ===================== #
            CELLPUTN(vValue, cCubeMapc, cVersion, sPeriod, cSource, sRateType, 'CustomLeaf:' | sLocation | ' Input', '1001', 'Unspecified Product Type', sMetric, 'Amount');
         ENDIF;

         cRecordCount = cRecordCount + 1;
      ELSE;
         # ================= TAPTOOLS: START GENERATED CODE =================== #
         nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
         # ================= TAPTOOLS: END GENERATED CODE ===================== #
         CELLPUTN(vValue, cCube, cVersion, sPeriod, cSource, sRatetype, sLocation, sFlowType, sCarType, vMetric, cMeasure);

         ### Uploading city level data into MAPC cube for MAPC metrics ###
         IF(pLevel @= 'Month' & sRateType @= 'USD' & ELISCOMP(sDimOpsMetric, sMetric, cMapcMetricConsol) = 1);
            IF(sCarType @<> 'Expresspool' & sCarType @<> 'Pool');
               # ================= TAPTOOLS: START GENERATED CODE =================== #
               nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
               # ================= TAPTOOLS: END GENERATED CODE ===================== #
               CELLINCREMENTN(vValue, cCubeMapc, cVersion, sPeriod, cSource, sRateType, sLocation, '1001', 'Unspecified Product Type', sMetric, 'Amount');
            ENDIF;
         ENDIF;

         cRecordCount = cRecordCount + 1;
         # ================= TAPTOOLS: START GENERATED CODE =================== #
         nDataProcedureDataOperations = nDataProcedureDataOperations + 1;
         # ================= TAPTOOLS: END GENERATED CODE ===================== #
         CELLPUTS(sOutputstring, 'Rides Ops Info', sMetric, sPeriod, 'Last Updated');
      ENDIF;
   ENDIF;
   p = p + 1;
END;


# ================= TAPTOOLS: START GENERATED CODE =================== #
nDataProcedureRecordsCompleted = nDataProcedureRecordsCompleted + 1;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
