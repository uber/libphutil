# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

######################################################################################################
# Process to copy MAPC Ops Adjustment to 'Ops Snapshot' cube
######################################################################################################


nTimeNow = NOW;
sTimeStart = TIMST(nTimeNow, '\Y\m\d\h\i\s');

pSnapshotVersion = TRIM(pSnapshotVersion);
pMonth = TRIM(pMonth);

sDim = 'Version';
sElement = pSnapshotVersion;
IF(DIMIX(sDim, sElement) = 0);
   LOGOUTPUT('INFO', sElement | ' does not exist in ' | sDim | ' Dimension');
   PROCESSQUIT;
ENDIF;

sDim = 'Period';
sElement = pMonth;
IF(DIMIX(sDim, sElement) = 0);
   LOGOUTPUT('INFO', sElement | ' does not exist in ' | sDim | ' Dimension');
   PROCESSQUIT;
ENDIF;

TRUE = 1;
FALSE = 0;
nAutoCleanup = TRUE;

sSrcCube = 'Ops Snapshot';
sTgtCube = 'Ops Snapshot';

### Set Dimension Variables
sDimVersion = 'Version';
sDimPeriod = 'Period';
sDimSource = 'Source';
sDimRateType = 'Rate Type';
sDimLoc = 'Location';
sDimLob = 'Line of Business';
sDimOpsMetric = 'Ops Metric';
sDimMeas = 'Ops Measure';

sSrcView = 'zTempTI' | GETPROCESSNAME | sTimeStart | NUMBERTOSTRING(RAND());
sSrcSub = sSrcView;


#==============================================================================
#  SOURCE VIEW
#==============================================================================
IF(VIEWEXISTS(sSrcCube, sSrcView) = TRUE);
   VIEWDESTROY(sSrcCube, sSrcView);
ENDIF;
VIEWCREATE(sSrcCube, sSrcView, nAutoCleanup);

nDim = 1;
sDim = TABDIM(sSrcCube, nDim);

WHILE(sDim @<> '');

   IF(SUBSETEXISTS(sDim, sSrcSub) = TRUE);
      SUBSETDESTROY(sDim, sSrcSub);
   ENDIF;
   SUBSETCREATE(sDim, sSrcSub, nAutoCleanup);
   VIEWSUBSETASSIGN(sSrcCube, sSrcView, sDim, sSrcSub);

   IF(sDim @= sDimVersion);
      sMDX = '{[' | sDim | '].[' | pSnapshotVersion | ']}';

   ELSEIF(sDim @= sDimPeriod);
      sMDX = '{[' | sDim | '].[' | pMonth | ']}';

   ELSEIF(sDim @= sDimSource);
      sMDX = '{[' | sDim | '].[Ops Adjustment]}';

   ELSEIF(sDim @= sDimRateType);
      sMDX = '{[' | sDim | '].[USD]}';

   ELSEIF(sDim @= sDimLoc);
      sMDX = '{[' | sDim | '].[Total Location], {TM1FILTERBYPATTERN( {TM1SUBSETALL( [' | sDim | '] )}, "*(Mega Region)*")}, {TM1FILTERBYPATTERN( {TM1SUBSETALL( [' | sDim | '] )}, "Country - *")}}';

   ELSEIF(sDim @= sDimLob);
      sMDX = '{[' | sDim | '].[1001], [' | sDim | '].[2001], [' | sDim | '].[Total Rides & Eats]}';

   ELSEIF(sDim @= sDimOpsMetric);
      sMDX = '{[' | sDim | '].[Active Riders], [' | sDim | '].[New Riders]}';
      
   ELSEIF(sDim @= 'Product Type');
      sMDX = '{[' | sDim | '].[Not Specified]}';    

   ELSEIF(sDim @= sDimMeas);
      sMDX = '{[' | sDim | '].[Amount]}';

   ELSE;
      sMDX = '{TM1FILTERBYLEVEL({TM1SUBSETALL([' | sDim | '])}, 0)}';

   ENDIF;

   IF(sMDX @<> '');
      SUBSETMDXSET(sDim, sSrcSub, sMDX);
      SUBSETMDXSET(sDim, sSrcSub, '');
   ENDIF;

   nDim = nDim + 1;
   sDim = TABDIM(sSrcCube, nDim);

END;

VIEWEXTRACTSKIPZEROESSET(sSrcCube, sSrcView, FALSE);
VIEWEXTRACTSKIPRULEVALUESSET(sSrcCube, sSrcView, FALSE);
VIEWEXTRACTSKIPCALCSSET(sSrcCube, sSrcView, FALSE);

DatasourceType = 'View';
DatasourceNameForServer = sSrcCube;
DatasourceCubeView = sSrcView;




# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: METADATA PROCEDURE                                                   #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #

#****Begin: Generated Statements***
#****End: Generated Statements****


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: METADATA PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****

IF(vOpsMetric @= 'Active Riders');
   vOpsMetric = 'Active Users';
ELSEIF(vOpsMetric @= 'New Riders');
   vOpsMetric = 'New Users';
ENDIF;

IF(ELLEV(sDimLoc, vLocation) = 0 & ELLEV(sDimLob, vLOB) = 0);

   CELLPUTN(vValue, sTgtCube, pSnapshotVersion, vPeriod, vSource, vRateType, vLocation, vLOB, vProductType, vOpsMetric, vMeasure);
ELSEIF(ELLEV(sDimLoc, vLocation) > 0 & ELLEV(sDimLob, vLOB) = 0);

   CELLPUTN(vValue, sTgtCube, pSnapshotVersion, vPeriod, vSource, vRateType, 'CustomLeaf:' | vLocation | ' Input', vLOB, vProductType, vOpsMetric, vMeasure);
ELSEIF(ELLEV(sDimLoc, vLocation) = 0 & ELLEV(sDimLob, vLOB) > 0);

   CELLPUTN(vValue, sTgtCube, pSnapshotVersion, vPeriod, vSource, vRateType, vLocation, 'CustomLeaf:' | vLOB | ' Input', vProductType, vOpsMetric, vMeasure);
ELSEIF(ELLEV(sDimLoc, vLocation) > 0 & ELLEV(sDimLob, vLOB) > 0);

   CELLPUTN(vValue, sTgtCube, pSnapshotVersion, vPeriod, vSource, vRateType, 'CustomLeaf:' | vLocation | ' Input', 'CustomLeaf:' | vLOB | ' Input', vProductType, vOpsMetric, vMeasure);
ENDIF;



# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
