# BEGIN: PROPERTIES                                                           #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
{
    "DataSource": {
        "Type": "TM1CubeView",
        "dataSourceNameForClient": "Eats Ops",
        "dataSourceNameForServer": "Eats Ops",
        "view": "Default"
    },
    "HasSecurityAccess": false,
    "Name": "}Drill_Eats_Ops_Drill",
    "Parameters": [
        {
            "Name": "cubename",
            "Prompt": "",
            "Type": "String",
            "Value": "Ops"
        },
        {
            "Name": "pVersion",
            "Prompt": "",
            "Type": "String",
            "Value": "Budget Variance"
        },
        {
            "Name": "pPeriod",
            "Prompt": "",
            "Type": "String",
            "Value": "Total Time - Month"
        },
        {
            "Name": "pSource",
            "Prompt": "",
            "Type": "String",
            "Value": "Total Source"
        },
        {
            "Name": "pRateType",
            "Prompt": "",
            "Type": "String",
            "Value": "FX Rates"
        },
        {
            "Name": "pLocation",
            "Prompt": "",
            "Type": "String",
            "Value": "DRG_NewLocations_Country"
        },
        {
            "Name": "pLOB",
            "Prompt": "",
            "Type": "String",
            "Value": "Total Line of Business"
        },
        {
            "Name": "pProductType",
            "Prompt": "",
