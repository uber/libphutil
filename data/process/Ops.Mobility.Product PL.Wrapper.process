    "DataSource": {
        "Type": "None"
    },
    "HasSecurityAccess": false,
    "Name": "Ops.Mobility.Product PL.Wrapper",
    "Parameters": [
        {
            "Name": "pVersion",
            "Prompt": "Version: N-Level",
            "Type": "String",
            "Value": "Actual"
        },
        {
            "Name": "pMonth",
            "Prompt": "Month: N-Level or C-Level, or BLANK;",
            "Type": "String",
            "Value": "2021-12"
        },
        {
            "Name": "pRateType",
            "Prompt": "Rate Type: N-Level, C-Level, or BLANK",
            "Type": "String",
            "Value": "USD"
        }
    ],
    "UIData": "CubeAction=1511\fDataAction=1503\fCubeLogChanges=0\f",
    "Variables": [],
    "VariablesUIData": []
}
