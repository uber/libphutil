# END: METADATA PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****




#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Transformation
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

# Month and Week

IF(pLevel @= 'Month');
   sPeriod = SUBST(vPeriod, 1, 7);
ELSE;
   sPeriod = 'WS ' | SUBST(vPeriod, 1, 10);
ENDIF;

IF(SUBSETELEMENTEXISTS('Period', cSubset, sPeriod) = 0);
   ITEMSKIP;
ENDIF;

# Location
sDim = 'Location';
IF(vLocation @= '\N' % vLocation @= '');
   ITEMSKIP;
ENDIF;
sLocation = 'V' | vLocation;

IF((ELISANC(sDim, 'Total Location by Country', vLocation) = 1 & ELLEV(sDim, vLocation) <> 0) % (ELISANC(sDim, 'Custom Consolidations', vLocation) = 1 & ELLEV(sDim, vLocation) <> 0) % (ELISANC(sDim, 'Total Location', vLocation) = 1 & ELLEV(sDim, vLocation) <> 0) % SCAN('(Country)', vLocation) > 0);
   sLocation = vLocation;
ELSEIF(vLocation @= 'global');
   sLocation = 'Total Location';
ELSEIF(vLocation @= 'global_ex_sea_and_russia');
   sLocation = 'Total Location ex SEA & Russia';
ELSE;
   sLocation = 'V' | vLocation;
ENDIF;

IF(DIMIX('Location', sLocation) = 0);
   ITEMSKIP;
ENDIF;

# Eats Product Type
sDim = 'Eats Product Type';
IF(vProductType @= '\N' % vProductType @= '' % vProductType @= 'None' % DIMIX(sDim, vProductType) = 0);
   sProductType = 'Unspecified Eats Product Type';
ELSE;
   sProductType = vProductType;
ENDIF;

# Eats Restaurant Type
sDim = 'Eats Restaurant Type';
IF(vRestType @= '\N' % vRestType @= '' % vRestType @= 'Not Classified');
   sRestType = 'Unspecified Restaurant Type';
ELSE;
   sRestType = vRestType;
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Clear Target View
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
#Scanning the Input to find Period and metric combination to be zeroed out
sMetric = vMetric;

IF(DIMIX('Eats Ops Metric', sMetric) = 0);
   ITEMSKIP;
ENDIF;

IF(pLevel @= 'Month');
   IF(sMetric @= 'Completed Deliveries' % sMetric @= 'Rider Miles');
      nGLOPS = 1;
   ENDIF;
ENDIF;

   IF(SCAN(sMetric, cMetricString) = 0);
      cMetricString = cMetricString | sMetric | '|';
      SUBSETDELETEALLELEMENTS('Eats Ops Metric', cSubset);
      SUBSETELEMENTINSERT('Eats Ops Metric', cSubset, sMetric, 1);
      VIEWZEROOUT(cCube, cViewName);
   ENDIF;



#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Load Data
# Adding Active Restaurants L28 to be skipped while loading for Month
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

IF(pLevel @= 'Month');
   IF(sMetric @= 'Active Eaters L28' % sMetric @= 'Weekly Active Eaters' % sMetric @= 'Active Couriers L28' % sMetric @= 'Weekly Active Couriers' % sMetric @='Active Restaurants L28');
      ITEMSKIP;
   ENDIF;
ELSE;
   IF(sMetric @= 'Active Eaters' % sMetric @= 'Active Couriers');
      ITEMSKIP;
   ENDIF;
ENDIF;

sDim = 'Rate Type';
p = 1;
WHILE(p <= DIMSIZ(sDim));
   sRateType = DIMNM(sDim, p);
   IF(ELLEV(sDim, sRateType) = 0);
      IF(ELLEV('Location', sLocation) > 0);
         CELLPUTN(vValue, cCube, cVersion, sPeriod, cSource, sRatetype, 'CustomLeaf:' | sLocation | ' Input', sProductType, sRestType, sMetric, cMeasure);
      ELSE;
         CELLPUTN(vValue, cCube, cVersion, sPeriod, cSource, sRatetype, sLocation, sProductType, sRestType, sMetric, cMeasure);
         CELLPUTS(sOutputstring, 'Eats Ops Info', sMetric, sPeriod, 'Last Updated');
      ENDIF;
   ENDIF;
   p = p + 1;
END;



# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
