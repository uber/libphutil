# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: PROLOG PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# Constants

cCube = 'Mobility Staging';
cCubeMap = 'Operational PL Mapping';
nRecords = 1;

cMetricString = '';

cUser = CELLGETS('System Info', 'SQL User Name GL Transactions', 'String');
cPassword = CELLGETS('System Info', 'SQL Password GL Transactions', 'String');

cApp = CELLGETS('TAP System Info', 'Service Name', 'Value');

IF(cApp @= 'ops-1' & SCAN('netr', pTable) = 0);
   PROCESSBREAK();
ENDIF;

IF(cApp @= 'ops' & SCAN('netr', pTable) > 0);
   PROCESSBREAK();
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Set Query
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

DatasourceUsername = cUser;
DatasourcePassword = cPassword;
sQuery = EXPAND('SELECT * FROM "%pTable%"');
DatasourceQuery = sQuery;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Subsets for View Zero Out
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

cRandomIntA = NUMBERTOSTRING(INT(RAND() * 100000));
cSubset = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
cViewName = '}zTemp.' | GETPROCESSNAME() | '.' | cRandomIntA;
VIEWCREATE(cCube, cViewName, 1);


nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(cCube);

WHILE(nCtr <= nMax);
   sDim = TABDIM(cCube, nCtr);

   IF(sDim @= 'Version');
      sElement = 'Actual';
      SUBSETCREATE(sDim, cSubset, 1);
      SUBSETELEMENTINSERT(sDim, cSubset, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Period');
      SUBSETCREATE(sDim, cSubset, 1);
      IF(pStartDate @<> '' & pEndDate @<> '' & pLevel @= 'Day');
         nStartday = DAYNO(SUBST(pStartDate, 1, 10));
         nEndday = DAYNO(SUBST(pEndDate, 1, 10));
         WHILE(nStartday <= nEndDay);
            sDay = DATE(nStartday, 1);
            SUBSETELEMENTINSERT(sDim, cSubset, sDay, 1);
            nStartday = nStartday + 1;
         END;
      ENDIF;
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Source');
      sElement = 'FDS';
      SUBSETCREATE(sDim, cSubset, 1);
      SUBSETELEMENTINSERT(sDim, cSubset, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Mobility Ops Metrics');
      sMDX = '{TM1FILTERBYLEVEL({TM1DRILLDOWNMEMBER( {[Mobility Ops Metrics].[GAAP Contribution]}, ALL, RECURSIVE )},0)}';
      SUBSETCREATEBYMDX(cSubset, sMDX, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Mobility Staging Measure');
      sElement = 'Amount';
      SUBSETCREATE(sDim, cSubset, 1);
      SUBSETELEMENTINSERT(sDim, cSubset, sElement, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSEIF(sDim @= 'Rate Type');
      SUBSETCREATE(sDim, cSubset, 1);
      SUBSETELEMENTINSERT(sDim, cSubset, pRateType, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ELSE;
      sMDX = '{TM1SORT( {TM1FILTERBYLEVEL({TM1SUBSETALL([ ' | sDim | '] )}, 0)}, ASC)}';
      SUBSETCREATEBYMDX(cSubset, sMdx, 1);
      VIEWSUBSETASSIGN(cCube, cViewName, sDim, cSubset);
   ENDIF;

   nCtr = nCtr + 1;
END;


VIEWZEROOUT(cCube, cViewName);

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: METADATA PROCEDURE                                                   #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: METADATA PROCEDURE                                                     #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# BEGIN: DATA PROCEDURE                                                       #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #


#****Begin: Generated Statements***
#****End: Generated Statements****


# Month

IF(pLevel @= 'Month');
   sPeriod = SUBST(vPeriod, 1, 7);
ELSEIF(pLevel @= 'Day');
   sPeriod = vPeriod;
ELSE;
   sPeriod = 'WS ' | vPeriod;
ENDIF;

IF(SUBSETELEMENTEXISTS('Period', cSubset, sPeriod) = 0);
   ITEMSKIP;
ENDIF;

vFeature = '';

IF(SCAN('_usd', vMetric) = 0);
   sMetric_fds = vMetric;
ELSE;
   nSep = SCAN('_usd', vMetric);
   sMetric_fds = SUBST(vMetric, 1, (nSep - 1));
ENDIF;

# Lookup for TM1 Metric. TM1 <> FDS Mapping

sMetric = CELLGETS(cCubeMap, sMetric_fds, 'Mobility', 'TM1 Metric');

# Location
sDim = 'Location';
IF(vLocation @= '\N' % vLocation @= '');
   ITEMSKIP;
ENDIF;
sLocation = 'V' | vLocation;

IF(DIMIX('Location', sLocation) = 0);
   ITEMSKIP;
ENDIF;

# LOB
IF(vLob @= '\N' % vLob @= '' % DIMIX('Line of Business', vLob) = 0);
   ITEMSKIP;
ENDIF;

# Currency
IF(vCurrency @= '\N' % vCurrency @= '');
   ITEMSKIP;
ENDIF;

# Features
IF(vAir @= '\N' % vAir @= '' % vMem @= '\N' % vMem @= '' % vRes @= '\N' % vRes @= '' % vU4B @= '\N' % vU4B @= '' % vU4BH @= '\N' % vu4BH @= '' % vZir @= '\N' % vZir @= '');
   vFeature = 'Unspecified Mobility Features';
ENDIF;


# Product
IF(vProduct @= '\N' % vProduct @= '');
   vProduct = 'Unspecified product type';
ENDIF;


# Features

IF(vAir @= '1' % vAir @= 'True');
   sAir = 'T';
ELSE;
   sAir = 'F';
ENDIF;

IF(vMem @= '1' % vMem @= 'True');
   sMem = 'T';
ELSE;
   sMem = 'F';
ENDIF;

IF(vRes @= '1' % vRes @= 'True');
   sRes = 'T';
ELSE;
   sRes = 'F';
ENDIF;

IF(vZir @= '1' % vZir @= 'True');
   sZir = 'T';
ELSE;
   sZir = 'F';
ENDIF;

IF(vU4B @= '1' % vU4B @= 'True');
   sU4B = 'T';
ELSE;
   sU4B = 'F';
ENDIF;

IF(vU4BH @= '1' % vU4BH @= 'True');
   sU4BH = 'T';
ELSE;
   sU4BH = 'F';
ENDIF;


IF(vFeature @<> 'Unspecified Mobility Features');
   vFeature = 'Air(' | sAir | ') Mem(' | sMem | ') Res(' | sRes | ') U4B(' | sU4B | ') U4BH(' | sU4BH | ') Zir(' | sZir | ')';
ENDIF;

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Clear Target View
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
#Scanning the Input to find metrics  to be zeroed out

vDim = 'Mobility Ops Metrics';
IF((DIMIX(vDim, sMetric) = 0) % (DTYPE(vDim, sMetric) @= 'C') % DTYPE(vDim, sMetric | '_fds') @= 'C');
   ITEMSKIP;
ENDIF;



#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Load Data
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
IF(vProduct @= 'Others');
   vProduct = 'Other';
ENDIF;

IF(SCAN('_usd', vMetric) = 0);
   CELLINCREMENTN(vValue, cCube, 'Actual', sPeriod, 'FDS', 'No Rate Type', vCurrency, vLob, '0000', sLocation, vProduct, vFeature, sMetric, 'Amount');
ELSE;
   CELLINCREMENTN(vValue, cCube, 'Actual', sPeriod, 'FDS', 'USD', vCurrency, vLob, '0000', sLocation, vProduct, vFeature, sMetric, 'Amount');
ENDIF;








# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: DATA PROCEDURE                                                         #
# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
