# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #

# ================= TAPTOOLS: START GENERATED CODE =================== #
sProcessName = GETPROCESSNAME();
IF(sProcessName @<> 'TAP.Call.Queue.Add Job To Queue' & sProcessName @<> 'TAP.CubeSaveData' & sProcessName @<> 'TAP.Call.Save' & sProcessName @<> 'TAP.Call.Recurring' & sProcessName @<> 'DIQ.Call.Batch' & sProcessName @<> 'TAP.Call.Save.Wrapper' & sProcessName @<> 'TAP.Call.CubeSaveData.Wrapper' & sProcessName @<> 'TAP.Call.Tests' & sProcessName @<> 'TAP.Call.Init' & sProcessName @<> 'TAP.Call.Export Application Stats' & sProcessName @<> 'TAP.Cube.Export Data to File' & SCAN('}drill', LOWER(sProcessName)) = 0);
   sBlock.Execution.Status = CELLGETS('TAP System Info', 'Block Process Execution', 'Value');
   IF(UPPER(sBlock.Execution.Status) @= 'YES');
      sBlock.Epilog.Execution = 'Yes';
      PROCESSBREAK;
   ENDIF;
ENDIF;
LOGOUTPUT('DEBUG', 'PARAMETER: pMonth: "' | pMonth | '"');
LOGOUTPUT('DEBUG', 'PARAMETER: pMonthDelim: "' | pMonthDelim | '"');
LOGOUTPUT('DEBUG', 'PROGRESS: START PROLOG PROCEDURE');
nMetadataProcedureRecordsStarted = 0;
nMetadataProcedureRecordsSkipped = 0;
nMetadataProcedureRecordsRejected = 0;
nMetadataProcedureRecordsCompleted = 0;
nDataProcedureRecordsStarted = 0;
nDataProcedureRecordsSkipped = 0;
nDataProcedureRecordsRejected = 0;
nDataProcedureRecordsCompleted = 0;
nPrologProcedureDataOperations = 0;
nDataProcedureDataOperations = 0;
nTotalDataOperations = 0;
nPrologProcedureMetadataOperations = 0;
nMetadataProcedureMetadataOperations = 0;
nDataProcedureMetadataOperations = 0;
nEpilogProcedureMetadataOperations = 0;
nTotalProcedureMetadataOperations = 0;
nPrologProcedureStartTime = NOW();
nPrologProcedureEndTime = 0;
nMetadataProcedureStartTime = 0;
nMetadataProcedureEndTime = 0;
nDataProcedureStartTime = 0;
nDataProcedureEndTime = 0;
# ================= TAPTOOLS: END GENERATED CODE ===================== #

#****Begin: Generated Statements***
#****End: Generated Statements****

########################################################################################################################################################
# Name: Process to zerou out forecast MAPC metrics (Active Riders & New Riders) at the alternate hierarchy of LOB and Location dimensions
#########################################################################################################################################################

pMonth = TRIM(pMonth);
IF(pMonth @= '');
   LOGOUTPUT('ERROR', 'Month can not be blank');
   PROCESSERROR;
ENDIF;

nTimeNow = NOW;
sTimeStart = TIMST(nTimeNow, '\Y\m\d\h\i\s');

#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#
# Define Constants
#=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-#

TRUE = 1;
FALSE = 0;

sCube = 'Ops';

sDimVersion = 'Version';
sDimPeriod = 'Period';
sDimSource = 'Source';
sDimRateType = 'Rate Type';
sDimLocation = 'Location';
sDimLob = 'Line of Business';
sDimProductType = 'Product Type';
sDimOpsMetric = 'Ops Metric';
sDimMeas = 'Ops Measure';

sAltHier = 'CustomLeaf';

#==============================================================================
# Source View Formation
#==============================================================================

sView = 'zTempTI' | GETPROCESSNAME | sTimeStart | NUMBERTOSTRING(RAND());
sSub = sView;

IF(VIEWEXISTS(sCube, sView) = 1);
   VIEWDESTROY(sCube, sView);
ENDIF;
VIEWCREATE(sCube, sView, 1);

nCtr = 1;
nMax = CUBEDIMENSIONCOUNTGET(sCube);
sMDX = '';

WHILE(nCtr <= nMax);

   sDim = TABDIM(sCube, nCtr);

   IF(SUBSETEXISTS(sDim, sSub) = 1);
      SUBSETDESTROY(sDim, sSub);
   ENDIF;
   SUBSETCREATE(sDim, sSub, 1);

   IF(sDim @= sDimVersion);
      sMDX = '{[' | sDim | '].[Forecast Excl Actuals]}';

   ELSEIF(sDim @= sDimPeriod);
      sMDX = '';
      IF(SCAN(pMonthDelim, pMonth) > 0);
         sMonths = pMonth;
         sDelimIndex = SCAN(pMonthDelim, sMonths);
         WHILE(sDelimIndex > 0);
            sMonth = SUBST(sMonths, 1, sDelimIndex - 1);
            IF(DIMIX(sDim, sMonth) > 0);
               sMDX = sMDX | 'TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | sDim | '].[' | sMonth | ']}, ALL, RECURSIVE )}, 0),';
            ELSE;
               LOGOUTPUT('ERROR', 'Month: ' | sMonth | ' is invalid');
            ENDIF;
            sMonths = SUBST(sMonths, sDelimIndex + 1, LONG(sMonths));
            sDelimIndex = SCAN(pMonthDelim, sMonths);
         END;
         IF(TRIM(sMonths) @<> '');
            sMonth = sMonths;
            IF(DIMIX(sDim, sMonth) > 0);
               sMDX = sMDX | 'TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | sDim | '].[' | sMonth | ']}, ALL, RECURSIVE )}, 0),';
            ELSE;
               LOGOUTPUT('ERROR', 'Month: ' | sMonth | ' is invalid');
            ENDIF;
         ENDIF;

         IF(sMDX @= '');
            LOGOUTPUT('ERROR', 'Month: ' | pMonth | ' is invalid');
            PROCESSERROR;
         ELSE;
            sMDX = '{' | SUBST(sMDX, 1, LONG(sMDX) - 1) | '}';
         ENDIF;
      ELSE;
         IF(DIMIX(sDim, pMonth) > 0);
            sMDX = '{TM1FILTERBYLEVEL( {TM1DRILLDOWNMEMBER( {[' | sDim | '].[' | pMonth | ']}, ALL, RECURSIVE )}, 0)}';
         ELSE;
            LOGOUTPUT('ERROR', 'Month: ' | pMonth | ' is invalid');
            PROCESSERROR;
         ENDIF;
      ENDIF;

   ELSEIF(sDim @= sDimSource);
      sMDX = '{[' | sDim | '].[Planning]}';

   ELSEIF(sDim @= sDimRateType);
      sMDX = '{[' | sDim | '].[USD]}';

   ELSEIF(sDim @= sDimLocation);
      sMDX = '{[' | sDim | '].[Total Location], {TM1FILTERBYPATTERN( {TM1SUBSETALL( [' | sDim | '] )}, "*(Mega Region)")}, {TM1FILTERBYPATTERN( {TM1SUBSETALL( [' | sDim | '] )}, "Country -*")}}';

   ELSEIF(sDim @= sDimLob);
      sMDX = '{[' | sDim | '].[Total Rides & Eats], [' | sDim | '].[Delivery ex M&A], [' | sDim | '].[Mobility ex M&A], {TM1FILTERBYLEVEL( TM1DRILLDOWNMEMBER( {[' | sDim | '].[Total Rides & Eats]}, ALL, RECURSIVE ), 0 )}}';

   ELSEIF(sDim @= sDimProductType);
      sMDX = '{[' | sDim | '].[Unspecified Product Type]}';

   ELSEIF(sDim @= sDimOpsMetric);
      #sMDX = '{TM1FILTERBYLEVEL( TM1DRILLDOWNMEMBER( {[' | sDim | '].[MAPC Metrics]}, ALL, RECURSIVE ), 0 )}';
      sMDX = '{[' | sDim | '].[Active Users], [' | sDim | '].[New Users]}';

   ELSEIF(sDim @= sDimMeas);
      sMDX = '{[' | sDim | '].[Amount]}';

   ELSE;
      sMDX = '{TM1FILTERBYLEVEL({TM1SUBSETALL([' | sDim | '])}, 0)}';

   ENDIF;

   IF(sMDX @<> '');
      SUBSETMDXSET(sDim, sSub, sMDX);
      SUBSETMDXSET(sDim, sSub, '');
   ENDIF;

   VIEWSUBSETASSIGN(sCube, sView, sDim, sSub);

   nCtr = nCtr + 1;
END;

### Zero Unsuppressed view because we need to get all the intersections of the alternate hierarchy even though there might not be data present at the main hierarchy currently. 
### This is because the numbers might have been present earlier and forecast deduped metrics would have been calculated earlier. 
### If we zero suppress the view, then those intersections would not be cleared.
VIEWEXTRACTSKIPZEROESSET(sCube, sView, FALSE);
VIEWEXTRACTSKIPRULEVALUESSET(sCube, sView, FALSE);
VIEWEXTRACTSKIPCALCSSET(sCube, sView, FALSE);

DatasourceType = 'View';
DatasourceNameForServer = sCube;
DatasourceCubeView = sView;



# ================= TAPTOOLS: START GENERATED CODE =================== #
nPrologProcedureEndTime = NOW();
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceType: "' | DatasourceType | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceNameForServer: "' | DatasourceNameForServer | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceCubeView: "' | DatasourceCubeView | '"');
LOGOUTPUT('DEBUG', 'DATASOURCE: DatasourceDimensionSubset: "' | DatasourceDimensionSubset | '"');
LOGOUTPUT('DEBUG', 'PROGRESS: END PROLOG PROCEDURE');
# ================= TAPTOOLS: END GENERATED CODE ===================== #

# =-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-= #
# END: PROLOG PROCEDURE                                                       #
